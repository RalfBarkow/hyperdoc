;;;; Local HyperBook — a frozen SHOP3 offer, a DITA Play action and its run history.
(require :asdf)
(asdf:load-system "hyperbook/server")
(asdf:load-system "dreyeck/local-fedwiki-view")
(asdf:load-system "dreyeck/dita-story-item")
(asdf:load-system "dreyeck/authority-policy")
(load (merge-pathnames "publish-page.lisp" *load-truename*))

(defpackage #:fork-lineup
  (:use #:cl)
  (:local-nicknames (#:v #:html-inspector-views) (#:hb #:hyperbook)
                    (#:dita #:dreyeck/dita-story-item) (#:fork #:fedwiki-fork))
  (:export #:start #:prepare #:change-test-target #:page-url #:*book*))
(in-package #:fork-lineup)

(defparameter *directory* (uiop:pathname-directory-pathname *load-truename*))
(defvar *book* nil)
(defvar *lock* (sb-thread:make-mutex :name "Publication lineup"))
(defparameter *completed* '(:observe-local :fill-local :attach-local :verify-zip-discovery
                             :prepare-release :observe-target :publish-assets))

(defclass publication-book (hb:hyperbook)
  ((fixture :initarg :fixture :reader fixture) (server :initarg :server :reader server)
   (pages :initform (make-hash-table :test 'equal) :reader pages)
   (latest :accessor latest :initform nil) (runs :accessor runs :initform nil)))
(defclass offer (hb:page)
  ((plan :reader plan :initarg :plan) (evidence :reader evidence :initarg :evidence)
   (release :reader release-of :initarg :release) (revision :reader revision :initarg :revision)
   (result :accessor result :initform nil)))
(defclass publication-run (hb:page)
  ((offer :reader offer-of :initarg :offer) (receipt :accessor receipt :initform nil)
   (readback :accessor readback :initform nil) (revision :accessor revision :initform nil)
   (http-log :accessor http-log :initform nil) (next-plan :accessor next-plan :initform nil)
   (diagnostic :accessor diagnostic :initform nil)))
(defclass recent-changes (hb:page) ())

(defmethod hb:title-of ((book publication-book)) "FedWiki Publikation")
(defmethod hb:title-of ((page offer)) "Publikationsangebot")
(defmethod hb:title-of ((page publication-run)) "Ergebnis")
(defmethod hb:title-of ((page recent-changes)) "Recent Changes")
(defmethod hb:find-page ((book publication-book) id &key signal-error?)
  (or (gethash id (pages book))
      (when signal-error? (error 'hb:page-lookup-failure :hyperbook book :page-id id))))

(defun page-url (page)
  (let* ((book (if (typep page 'publication-book) page (hb:hyperbook-of page)))
         (slug (hyperbook/server::slug book)))
    (format nil "http://127.0.0.1:~D/~A~@[/~A~]"
            clog::*clog-port* slug (unless (eq book page) (hb:id-of page)))))

(defun new-id (prefix)
  (format nil "~A-~A" prefix (ironclad:byte-array-to-hex-string (ironclad:random-data 8))))

(defun source (book) (merge-pathnames "source/" (fixture book)))
(defun jar (book) (merge-pathnames "owner.jar" (fixture book)))
(defun step-of (plan)
  (destructuring-bind (((operator step))) (dreyeck/shop3:plans-of plan)
    (assert (and (eq :plan-only (dreyeck/shop3:execution-mode-of plan))
                 (eq operator 'shop3-planning-domains/publication::!propose-publication-step)))
    step))

(defun prepare (&optional (book *book*))
  "Freeze a new offer. Only observations occur here; rendering reuses the offer."
  (sb-thread:with-mutex (*lock*)
    (let* ((root (source book)) (release (fork:read-release root)) (slug (fork:release-slug release))
           (revision (fork:observe-target (fixture book) release))
           (assets (fork:verify-assets (fixture book) release))
           (page (dreyeck/local-fedwiki-view:make-local-fedwiki-view-page
                  root slug :wiki-id (format nil "fedwiki:~A" (car (last (pathname-directory (fixture book)))))))
           (workspace (dreyeck/local-fedwiki-view::ensure-page-attached-workspace-offer page))
           (archive (getf (dreyeck/fedwiki-assets:page-attached-asdf-discovery-observation root slug)
                          :asdf-archive))
           (ref (fork:release-reference release)))
      (assert (and assets workspace archive))
      (let* ((evidence (list (list :local-page-present (namestring (merge-pathnames (format nil "pages/~A" slug) root)))
                             (list :local-content-verified ref)
                             (list :local-attachment-verified (namestring (getf archive :zip)))
                             (list :local-zip-discovery-verified
                                   (format nil "~A ~A" (hb:id-of workspace) (getf archive :member)))
                             (list :release-reviewed ref)
                             (list :target-ready (fork:target-reference (fixture book) release revision))
                             (list :public-assets-verified assets)))
             (plan (shop3-planning-domains/publication:plan-next evidence :completed *completed*))
             (id (new-id "angebot"))
             (offer (make-instance 'offer :id id :hyperbook book :plan plan :release release
                                         :evidence evidence :revision revision)))
        (assert (eq :publish-page (step-of plan)))
        (setf (gethash id (pages book)) offer (latest book) offer)
        offer))))

(defun replan (run)
  (let* ((offer (offer-of run)) (receipt (receipt run)) (status (getf receipt :status))
         (fact (getf receipt :evidence)) (evidence (evidence offer))
         (key (car fact)))
    (cond ((member status '(:published :already-published))
           (assert (and (eq key :public-page-verified)
                        (equal (second fact)
                               (fork:target-reference (fixture (hb:hyperbook-of offer))
                                                      (release-of offer) (revision run)))))
           (shop3-planning-domains/publication:plan-next
            (cons fact evidence) :completed (cons :publish-page *completed*)))
          ((eq status :reconcile-target)
           (assert (eq key :target-conflict))
           (shop3-planning-domains/publication:plan-next
            (cons fact (remove-if (lambda (e) (member (first e) '(:target-ready :public-assets-verified)))
                                  evidence))
            :completed (remove :publish-assets *completed*))))))

(defun check-local-listener ()
  ;; CLOG may already be serving another catalog when this file is loaded.
  (let* ((port clog::*clog-port*)
         (listeners (uiop:run-program
                     (list "/usr/sbin/lsof" "-w" "-nP" "-a" "-p" (princ-to-string (sb-unix:unix-getpid))
                           (format nil "-iTCP:~D" port) "-sTCP:LISTEN" "-Fn")
                     :output :lines)))
    (assert (equal (remove-if-not (lambda (s) (uiop:string-prefix-p "n" s)) listeners)
                   (list (format nil "n127.0.0.1:~D" port))) ()
            "Der Publikations-Inspector benötigt einen lokalen Listener auf Port ~D." port)))

(defun play (offer)
  (sb-thread:with-mutex (*lock*)
    (when (result offer) (return-from play (result offer)))
    (check-local-listener)
    (let* ((book (hb:hyperbook-of offer))
           (id (new-id "lauf"))
           (run (make-instance 'publication-run :id id :hyperbook book :offer offer)))
      (with-open-file (trace (merge-pathnames "requests.jsonl" (fixture book)) :external-format :utf-8)
        (file-position trace :end)
        (handler-case
            (multiple-value-bind (receipt json revision)
                (fork:publish-page (plan offer) (fixture book) (source book) (revision offer) :cookie-jar (jar book))
              (setf (receipt run) receipt (readback run) json (revision run) revision
                    (next-plan run) (replan run)))
          (error (c) (setf (diagnostic run) (princ-to-string c))))
        (setf (http-log run) (loop for line = (read-line trace nil) while line collect (shasht:read-json line))))
      (setf (gethash id (pages book)) run (result offer) run)
      (push run (runs book))
      run)))

(defun change-test-target (text &optional (book *book*))
  "Operator control for the acceptance test, intentionally outside Play and outside its HTTP trace."
  (sb-thread:with-mutex (*lock*)
    (sb-thread:with-mutex (fork::*writer*)
      (let* ((release (fork:read-release (source book)))
             (page (nth-value 1 (fork:observe-target (fixture book) release)))
             (item (alexandria:copy-hash-table (aref (gethash "story" page) 0))))
        (setf (gethash "text" item) text)
        (assert (= 200 (fork::request (fixture book) (format nil "/page/~A/action" (fork:release-slug release))
                                     :action (alexandria:plist-hash-table
                                              (list "type" "edit" "id" (gethash "id" item) "item" item
                                                    "date" (* 1000 (- (get-universal-time) 2208988800))) :test 'equal)
                                     :cookie-jar (jar book))))
        (fork:observe-target (fixture book) release)))))

(defun start (&key (port 8080))
  (when (and *book* (uiop:process-alive-p (server *book*)))
    (return-from start (page-url (latest *book*))))
  (let* ((script (truename (merge-pathnames "../acceptance/run-publish-page.py" *directory*)))
         (proc (uiop:launch-program (list "python3" (namestring script) "--serve")
                                    :input :stream :output :stream :error-output :stream)))
    (handler-case
        (let* ((ready (read-line (uiop:process-info-output proc) nil))
               (root (or (and ready (uiop:absolute-pathname-p ready) (uiop:directory-exists-p ready))
                         (error "Testwiki konnte nicht starten. ~A ~A" ready
                                (uiop:slurp-stream-string (uiop:process-info-error-output proc)))))
               (book (make-instance 'publication-book :id "test-fedwiki-publish-page" :fixture root :server proc)))
          (setf (gethash "recent-changes" (pages book))
                (make-instance 'recent-changes :id "recent-changes" :hyperbook book))
          (prepare book)
          (unless (clog:is-running-p)
            (hyperbook/server:serve-catalog :host "127.0.0.1" :port port :development nil))
          (check-local-listener)
          (hb:register book)
          (setf *book* book)
          (page-url (latest book)))
      (error (c) (close (uiop:process-info-input proc)) (error c)))))

(load (merge-pathnames "lineup-views.lisp" *directory*))
