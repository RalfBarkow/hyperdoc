<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       name="kioskberrli-lifecycle"
       initial="declared">
  <state id="declared">
    <transition event="SOURCE_REVIEWED" target="source-inspected"/>
    <transition event="EVIDENCE_MISSING" target="unknown"/>
  </state>
  <state id="source-inspected">
    <transition event="OBSOLETE_OPTION_REMOVED" target="obsolete-option-corrected"/>
    <transition event="FAILURE_RECORDED" target="failed-with-evidence"/>
  </state>
  <state id="obsolete-option-corrected">
    <transition event="BUILD_ATTEMPTED" target="cross-host-build-blocked"/>
    <transition event="IMAGE_BUILD_SUCCEEDED" target="image-built"/>
  </state>
  <state id="cross-host-build-blocked">
    <transition event="BUILD_HOST_REJECTED" target="linux-builder-required"/>
    <transition event="FAILURE_RECORDED" target="failed-with-evidence"/>
  </state>
  <state id="linux-builder-required">
    <transition event="LINUX_BUILDER_AVAILABLE" target="image-built"/>
    <transition event="EVIDENCE_MISSING" target="linux-builder-required"/>
  </state>
  <state id="image-built">
    <transition event="FLASH_COMPLETED" target="sd-flashed"/>
    <transition event="EVIDENCE_MISSING" target="failed-with-evidence"/>
  </state>
  <state id="sd-flashed">
    <transition event="PI_BOOTED" target="first-boot-observed"/>
    <transition event="FAILURE_RECORDED" target="failed-with-evidence"/>
  </state>
  <state id="first-boot-observed">
    <transition event="NETWORK_OK" target="network-verified"/>
    <transition event="EVIDENCE_MISSING" target="failed-with-evidence"/>
  </state>
  <state id="network-verified">
    <transition event="KIOSK_SESSION_OK" target="kiosk-session-running"/>
    <transition event="FAILURE_RECORDED" target="failed-with-evidence"/>
  </state>
  <state id="kiosk-session-running">
    <transition event="LANDING_PAGE_OK" target="landing-page-visible"/>
    <transition event="EVIDENCE_MISSING" target="failed-with-evidence"/>
  </state>
  <state id="landing-page-visible">
    <transition event="EVIDENCE_RECORDED" target="maintenance-ready"/>
  </state>
  <state id="maintenance-ready">
    <transition event="FAILURE_RECORDED" target="failed-with-evidence"/>
  </state>
  <state id="failed-with-evidence">
    <transition event="SOURCE_REVIEWED" target="source-inspected"/>
  </state>
  <state id="unknown">
    <transition event="SOURCE_REVIEWED" target="source-inspected"/>
    <transition event="FAILURE_RECORDED" target="failed-with-evidence"/>
  </state>
</scxml>
