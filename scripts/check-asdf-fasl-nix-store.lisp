(require :asdf)
(in-package :cl-user)

(defun test-source (missing-p)
  (asdf:initialize-output-translations
   '(:output-translations :enable-user-cache :ignore-inherited-configuration))
  (let ((cache (uiop:ensure-directory-pathname (uiop:getenv "XDG_CACHE_HOME"))))
    (with-open-file (s (ensure-directories-exist (merge-pathnames "write-test" cache))
                       :direction :output :if-exists :error)
      (write-line "writable" s))
    (asdf:load-asd (merge-pathnames "faq-probe.asd" (pathname (uiop:getenv "FAQ_SOURCE_DIR"))))
    (let* ((file (asdf:find-component "faq-probe" "answer"))
           (source (asdf:component-pathname file))
           (output (first (asdf:output-files 'asdf:compile-op file))))
      (assert (uiop:subpathp output cache))
      (assert (not (probe-file output)))
      (format t "~&cache=~A writable; source=~A; predicted=~A~%" cache source output)
      (if missing-p
          (progn
            (assert (not (probe-file source)))
            (handler-case (progn (asdf:load-system "faq-probe")
                                 (error "Unexpected success with missing source."))
              (file-error (condition)
                (assert (uiop:pathname-equal (file-error-pathname condition) source))
                (assert (not (probe-file output)))
                (format t "PASS missing: ~S for ~A; no FASL~%"
                        (type-of condition) (file-error-pathname condition)))))
          (progn
            (asdf:load-system "faq-probe")
            (assert (= 42 (funcall 'faq-answer)))
            (let ((actual (truename output)))
              (assert (uiop:subpathp actual (truename cache)))
              (format t "PASS source: wrote ~A; loaded answer=42~%" actual)))))))

(defun test-wrapper-destinations ()
  ;; This process only computes pathnames. It never runs an ASDF compile or load operation.
  (let* ((component (asdf:find-component "salza2" "package"))
         (source (truename (asdf:component-pathname component)))
         (cache (uiop:ensure-directory-pathname (uiop:getenv "XDG_CACHE_HOME")))
         (nearby (compile-file-pathname source)))
    (assert (uiop:subpathp source #P"/nix/store/"))
    (flet ((destination (label)
             (let ((path (first (asdf:output-files 'asdf:compile-op component))))
               (format t "~&~A=~A~%" label path)
               path)))
      (let ((inherited (destination "inherited")))
        (assert (equal inherited nearby))
        (asdf:initialize-output-translations
         '(:output-translations :enable-user-cache :ignore-inherited-configuration))
        (let ((override (destination "override")))
          (assert (uiop:subpathp override cache))
          (assert (not (equal inherited override)))
          (asdf:initialize-output-translations)
          (assert (equal override (destination "no-argument")))
          (asdf:initialize-output-translations nil)
          (assert (equal inherited (destination "explicit-nil")))))
      (format t "PASS destinations: inherited = explicit-nil; override = no-argument~%"))))

(defun test-package ()
  ;; Do not initialize output translations in this process.
  (assert (not (find-package :salza2)))
  (let* ((system (asdf:find-system "salza2"))
         (file (asdf:find-component system "package"))
         (fasl (truename (first (asdf:output-files 'asdf:compile-op file)))))
    (assert (uiop:subpathp fasl #P"/nix/store/"))
    (format t "ASD=~A; existing FASL=~A~%" (asdf:system-source-file system) fasl)
    (let ((trace (with-output-to-string (stream)
                   (let ((*standard-output* stream) (*trace-output* stream) (*load-verbose* t))
                     (asdf:load-system system :verbose t)))))
      (write-string trace)
      (assert (search (format nil "loading ~S" fasl) trace)))
    (let ((gzip (uiop:symbol-call :salza2 :compress-data
                                  (make-array 1 :element-type '(unsigned-byte 8) :initial-element 42)
                                  (find-symbol "GZIP-COMPRESSOR" :salza2))))
      (assert (equalp (subseq gzip 0 2) #(31 139)))
      (format t "PASS packaged: ~A ~A; gzip header=1F8B~%"
              (asdf:component-name system) (asdf:component-version system)))))

(format t "~&case=~A SBCL=~A ASDF=~A~%" (first (uiop:command-line-arguments))
        (lisp-implementation-version) (asdf:asdf-version))
(let ((name (first (uiop:command-line-arguments))))
  (cond ((equal name "source") (test-source nil))
        ((equal name "destinations") (test-wrapper-destinations))
        ((equal name "packaged") (test-package))
        ((equal name "missing") (test-source t))
        (t (error "Unknown FAQ test ~S" name))))
