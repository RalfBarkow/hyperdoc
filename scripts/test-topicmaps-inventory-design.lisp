;;;; Inventory/design checks only; no validator or historical corpus execution.
(require :asdf)
(asdf:load-system "dreyeck/work/project/tests")
(load (asdf:system-relative-pathname "dreyeck" "dreyeck/tests/topicmaps-inventory-design.lisp"))
(uiop:with-temporary-file (:pathname marker)
  (let ((staged (uiop:ensure-directory-pathname (concatenate 'string (namestring marker) "-inventory/"))))
    (ensure-directories-exist staged)
    (unwind-protect
         (let ((verified nil))
           (progv (list (find-symbol "+PROJECT-CTM-FILE+" :dreyeck/work/project)
                        (find-symbol "+PROJECT-CTM-DIGEST-FILE+" :dreyeck/work/project))
                  (list (namestring (merge-pathnames "hyperdoc-project.ctm" staged))
                        (namestring (merge-pathnames "hyperdoc-project.ctm.sha256" staged)))
             (dreyeck/work/project:write-project-ctm)
             (dreyeck/work/project/tests:run-source-tests)
             (dreyeck/work/project/tests::run-inventory-design-tests)
             (setf verified (dreyeck/work/project::%octets (dreyeck/work/project:project-ctm-pathname))))
           (assert (equalp verified (sb-ext:string-to-octets (dreyeck/work/project:materialize-project-ctm) :external-format :utf-8)))
           (multiple-value-bind (path digest) (dreyeck/work/project:write-project-ctm)
             (assert (equalp verified (dreyeck/work/project::%octets path)))
             (format t "~&INVENTORY-CTM-WRITTEN ~A SHA256 ~A~%" path digest)))
      (uiop:delete-directory-tree staged :validate t :if-does-not-exist :ignore))))
