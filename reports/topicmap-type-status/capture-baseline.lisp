;; Run only against the unmodified PR #8 checkout; output directory must exist.
(require :asdf)
(asdf:load-system "dreyeck/pull-request-review/reading")
(asdf:load-system "dreyeck/work/reading")
(asdf:load-system "dreyeck/lisp-critic/reading")
(dolist (pair (list (cons "pr8" (dreyeck/topicmap:topicmap-projection-of (dreyeck/pull-request-review:example-reading)))
                   (cons "work" (dreyeck/work/reading:work-projection))
                   (cons "critic" (dreyeck/lisp-critic/reading:lisp-critic-genealogy-projection))))
  (let ((html (dreyeck/inspector/topicmap:render-topicmap-html :native-svg (cdr pair))))
    (with-open-file (out (merge-pathnames (concatenate 'string (car pair) ".svg.html")
                                        (uiop:ensure-directory-pathname (uiop:getenv "TOPICMAP_BASELINE_OUTPUT")))
                         :direction :output :if-exists :supersede :external-format :utf-8)
      (write-string html out))
    (format t "~&BASELINE-SVG ~A ~D octets~%" (car pair) (length (babel:string-to-octets html :encoding :utf-8)))))
