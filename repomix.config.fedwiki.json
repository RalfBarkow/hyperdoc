{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 2000000
  },
  "output": {
    "filePath": "repomix-output-hyperdoc.fedwiki.md",
    "style": "markdown",
    "parsableStyle": false,
    "compress": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "topFilesLength": 20,
    "includeFullDirectoryStructure": false,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 200,
      "includeDiffs": false,
      "includeLogs": false,
      "includeLogsCount": 50
    }
  },
  "include": [
    "AGENTS.md",
    "README.md",
    "hyperbook-fedwiki/**/*.lisp",
    "hyperdoc/fedwiki-materialization.lisp",
    "hyperdoc/localhost-fedwiki-page-pipeline.lisp",
    "hyperdoc/localhost-fedwiki-page-promotion-plans.lisp",
    "hyperdoc-explorer/localhost-fedwiki-page-promotion-plans.lisp",
    "hyperdoc-inspector/fedwiki-materialization.lisp",
    "hyperdoc-inspector/fedwiki-story-item-rendering-demo.lisp",
    "tools/fedwiki-materialization.lisp",
    "tools/journal-gate.lisp",
    "tools/testdata/journal-gate/**",
    "tests/fedwiki-*.lisp",
    "tests/localhost-fedwiki-*.lisp",
    "tests/playwright/fedwiki-*.spec.js",
    "hyperdoc/FedWiki*.html",
    "hyperdoc/Localhost FedWiki*.html",
    "hyperdoc/Story Neighborhood*.html",
    "hyperdoc/Journal*.html",
    "hyperdoc/Clickable commit IDs in FedWiki stories.html",
    "hyperdoc/Graphviz story item upstream assimilation example.html"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".direnv/**",
      ".cache/**",
      ".flake-deps/**",
      ".release-verifications/**",
      "node_modules/**",
      "test-results/**",
      "target/**",
      "result",
      "var/**",
      "repomix-output*.xml",
      "repomix-output*.md",
      ".DS_Store",
      "**/quicklisp.lisp",
      "**/*.fasl",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.ico",
      "deps/**/assets/**",
      "assets/dm6-elm/app.js"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
