{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 2000000
  },
  "output": {
    "filePath": "repomix-output-hyperdoc.roots.md",
    "style": "markdown",
    "parsableStyle": false,
    "compress": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "topFilesLength": 20,
    "includeFullDirectoryStructure": false,
    "splitOutput": 500000,
    "tokenBudget": 220000,
    "git": {
      "sortByChanges": false,
      "sortByChangesMaxCommits": 200,
      "includeDiffs": true,
      "includeLogs": false,
      "includeLogsCount": 50
    }
  },
  "include": [
    "AGENTS.md",
    "README.md",
    ".gitignore",
    "Makefile",
    "repomix.config.core.json",
    "repomix.config.roots.json",
    "tools/repomix-pack.sh",
    "tools/repomix-snapshot-manifest.sh",
    "hyperdoc/Codex handover for HyperDoc.html",
    "hyperdoc/Best handover to Codex for HyperDoc.html",
    "hyperbook.asd",
    "hyperdoc.asd",
    "hyperdoc-graham-roots-of-lisp.asd",
    "dev.sh",
    "flake.nix",
    "flake.lock",
    "package.json",
    "package-lock.json",
    "nix/roots-of-lisp-lynn-assets.nix",
    "nix/release/package.nix",
    "hyperdoc/package.lisp",
    "hyperdoc/core.lisp",
    "hyperdoc/defining.lisp",
    "hyperdoc/check-runner.lisp",
    "hyperdoc/example-core.lisp",
    "hyperdoc/example-source-artifacts.lisp",
    "hyperdoc/topics/registry.lisp",
    "hyperdoc-explorer/package.lisp",
    "hyperdoc-explorer/source-surfaces.lisp",
    "hyperdoc-explorer/explorer.lisp",
    "hyperdoc-explorer/code-pages.lisp",
    "hyperdoc-explorer/example-core.lisp",
    "hyperdoc-graham-roots-of-lisp/**",
    "tests/playwright/playwright.config.js",
    "tests/playwright/hyperdoc-inspector.js",
    "tests/playwright/roots-of-lisp-lynn-runner.spec.js"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": false,
    "customPatterns": [
      ".direnv/**",
      ".cache/**",
      ".flake-deps/**",
      ".release-verifications/**",
      "node_modules/**",
      "test-results/**",
      "target/**",
      "result",
      "var/**",
      "repomix-output*.xml",
      "repomix-output*.md",
      "repomix-output*.manifest.json",
      ".DS_Store",
      "**/quicklisp.lisp",
      "**/*.fasl",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.ico",
      "deps/**/assets/**",
      "assets/dm6-elm/app.js"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
