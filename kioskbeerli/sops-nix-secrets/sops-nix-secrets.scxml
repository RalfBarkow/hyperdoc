<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       name="kioskbeerli-sops-nix-secrets"
       initial="den-base-verified">
  <state id="den-base-verified">
    <transition event="TOOLS_AVAILABLE" target="tools-available"/>
    <transition event="MISSING_TOOLS" target="missing-tools"/>
  </state>
  <state id="tools-available">
    <transition event="AGE_IDENTITY_READY" target="age-identity-ready"/>
    <transition event="MISSING_TOOLS" target="missing-tools"/>
  </state>
  <state id="age-identity-ready">
    <transition event="RECIPIENTS_READY" target="recipients-ready"/>
    <transition event="PLAINTEXT_DETECTED" target="plaintext-detected"/>
  </state>
  <state id="recipients-ready">
    <transition event="POLICY_DRAFTED" target="policy-drafted"/>
    <transition event="PLAINTEXT_DETECTED" target="plaintext-detected"/>
  </state>
  <state id="policy-drafted">
    <transition event="SECRET_ENCRYPTED" target="secret-encrypted"/>
    <transition event="PLAINTEXT_DETECTED" target="plaintext-detected"/>
  </state>
  <state id="secret-encrypted">
    <transition event="SECRET_FILE_VERIFIED" target="secret-encrypted"/>
    <transition event="HOST_MODULE_PATCHED" target="host-module-patched"/>
    <transition event="PLAINTEXT_DETECTED" target="plaintext-detected"/>
  </state>
  <state id="host-module-patched">
    <transition event="FILES_STAGED" target="files-staged"/>
    <transition event="EVAL_FAILED" target="eval-failed"/>
  </state>
  <state id="files-staged">
    <transition event="ROOT_APPLIED" target="root-applied"/>
    <transition event="PLAINTEXT_DETECTED" target="plaintext-detected"/>
  </state>
  <state id="root-applied">
    <transition event="FLAKE_EVALUATED" target="flake-evaluated"/>
    <transition event="EVAL_FAILED" target="eval-failed"/>
  </state>
  <state id="flake-evaluated">
    <transition event="TEST_ACTIVATED" target="test-activated"/>
    <transition event="REBUILD_TEST_FAILED" target="rebuild-test-failed"/>
  </state>
  <state id="test-activated">
    <transition event="RUNTIME_SECRET_VERIFIED" target="runtime-secret-verified"/>
    <transition event="DECRYPTION_FAILED" target="decryption-failed"/>
  </state>
  <state id="runtime-secret-verified">
    <transition event="SWITCHED" target="switched"/>
    <transition event="REBUILD_TEST_FAILED" target="rebuild-test-failed"/>
  </state>
  <state id="switched">
    <transition event="REBOOT_VERIFIED" target="complete"/>
    <transition event="DECRYPTION_FAILED" target="decryption-failed"/>
  </state>
  <state id="complete">
    <transition event="MILESTONE_RECORDED" target="complete"/>
  </state>
  <state id="missing-tools">
    <transition event="TOOLS_AVAILABLE" target="tools-available"/>
  </state>
  <state id="plaintext-detected">
    <transition event="SECRET_ENCRYPTED" target="secret-encrypted"/>
  </state>
  <state id="eval-failed">
    <transition event="HOST_MODULE_PATCHED" target="host-module-patched"/>
  </state>
  <state id="rebuild-test-failed">
    <transition event="FLAKE_EVALUATED" target="flake-evaluated"/>
  </state>
  <state id="decryption-failed">
    <transition event="RUNTIME_SECRET_VERIFIED" target="runtime-secret-verified"/>
  </state>
</scxml>
