<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       name="kioskbeerli-pi-simulation"
       initial="plan-created">
  <state id="plan-created">
    <transition event="DEN_BASELINE_LOADED" target="den-baseline-loaded"/>
  </state>
  <state id="den-baseline-loaded">
    <transition event="SIM_FLAKE_GENERATED" target="sim-flake-generated"/>
    <transition event="SECRET_FIXTURE_BLOCKED" target="blocked-secret-fixture"/>
  </state>
  <state id="sim-flake-generated">
    <transition event="EVAL_PLANNED" target="eval-planned"/>
    <transition event="CROSS_ARCH_BLOCKED" target="blocked-cross-arch"/>
  </state>
  <state id="eval-planned">
    <transition event="EVAL_PASSED" target="eval-passed"/>
    <transition event="CROSS_ARCH_BLOCKED" target="blocked-cross-arch"/>
  </state>
  <state id="eval-passed">
    <transition event="VM_BUILD_PLANNED" target="vm-build-planned"/>
  </state>
  <state id="vm-build-planned">
    <transition event="VM_BUILT" target="vm-built"/>
    <transition event="VM_BUILD_FAILED" target="blocked-vm-build"/>
  </state>
  <state id="vm-built">
    <transition event="BOOT_BACKEND_DETECTED" target="boot-backend-detected"/>
    <transition event="NO_LINUX_BACKEND" target="blocked-no-linux-backend"/>
    <transition event="NO_KVM" target="blocked-no-kvm"/>
  </state>
  <state id="boot-backend-detected">
    <transition event="VM_BOOTED" target="vm-booted"/>
    <transition event="VM_BOOT_FAILED" target="blocked-vm-boot"/>
  </state>
  <state id="vm-booted">
    <transition event="PROBES_PASSED" target="probes-passed"/>
    <transition event="VM_BOOT_FAILED" target="blocked-vm-boot"/>
  </state>
  <state id="probes-passed">
    <transition event="SIMULATION_RECORDED" target="complete"/>
  </state>
  <state id="complete"/>
  <state id="blocked-no-linux-backend">
    <transition event="BOOT_BACKEND_DETECTED" target="boot-backend-detected"/>
  </state>
  <state id="blocked-no-kvm">
    <transition event="BOOT_BACKEND_DETECTED" target="boot-backend-detected"/>
  </state>
  <state id="blocked-cross-arch">
    <transition event="SIM_FLAKE_GENERATED" target="sim-flake-generated"/>
  </state>
  <state id="blocked-secret-fixture">
    <transition event="DEN_BASELINE_LOADED" target="den-baseline-loaded"/>
  </state>
  <state id="blocked-vm-build">
    <transition event="VM_BUILD_PLANNED" target="vm-build-planned"/>
  </state>
  <state id="blocked-vm-boot">
    <transition event="BOOT_BACKEND_DETECTED" target="boot-backend-detected"/>
  </state>
</scxml>
