{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 2000000
  },
  "output": {
    "filePath": "repomix-output-hyperdoc.validation.md",
    "style": "markdown",
    "parsableStyle": false,
    "compress": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "topFilesLength": 20,
    "includeFullDirectoryStructure": false,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 200,
      "includeDiffs": false,
      "includeLogs": false,
      "includeLogsCount": 50
    }
  },
  "include": [
    "AGENTS.md",
    "README.md",
    "*.asd",
    "package.lisp",
    "tests/package.lisp",
    "tests/test-runner.lisp",
    "tests/*smoke.lisp",
    "hyperdoc/check-runner.lisp",
    "hyperdoc-explorer/check-runner.lisp",
    "hyperdoc/HyperDoc Test Runner.html",
    "hyperdoc/ASDF Systems, Examples, and Tests in HyperDoc.html",
    "hyperdoc/Understanding ASDF Systems in HyperDoc.html"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".direnv/**",
      ".cache/**",
      ".flake-deps/**",
      ".release-verifications/**",
      "node_modules/**",
      "test-results/**",
      "target/**",
      "result",
      "var/**",
      "repomix-output*.xml",
      "repomix-output*.md",
      ".DS_Store",
      "**/quicklisp.lisp",
      "**/*.fasl",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.ico",
      "deps/**/assets/**",
      "assets/dm6-elm/app.js",
      "tests/dmx-annotations-smoke.lisp",
      "tests/dmx-mcp-smoke.lisp",
      "tests/dmx-topic-proxy-smoke.lisp"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
