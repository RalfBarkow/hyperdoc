(require :asdf)
(format t "~&P1 RUNTIME ~A ~A~%" (lisp-implementation-type) (lisp-implementation-version))
(asdf:load-system "hyperbook/fedwiki")
(assert (not (find-package "DREYECK/VERIFIED-EXAMPLE")))
(format t "~&P1 BASELINE LOADED~%")

(defvar *p1-items*
  (loop for (name json) in
        '(("lisp" "{\"type\":\"code\",\"id\":\"render-probe\",\"text\":\"(defun square (x) (* x x))\",\"language\":\"lisp\"}")
          ("missing" "{\"type\":\"code\",\"id\":\"render-probe\",\"text\":\"(defun square (x) (* x x))\"}")
          ("unknown" "{\"type\":\"code\",\"id\":\"render-probe\",\"text\":\"(defun square (x) (* x x))\",\"language\":\"p1-unknown-language\"}")
          ("escaping" "{\"type\":\"code\",\"id\":\"render-probe\",\"text\":\"<script>alert(1)</script>&\\\"'\",\"language\":\"lisp\"}"))
        collect (cons name (hyperbook/fedwiki::make-story-item (shasht:read-json json)))))
(defvar *p1-page* (make-instance 'hyperbook/fedwiki::fedwiki-page :id "p1-render-probe" :title "P1"))
(defvar *p1-before-methods* nil)
(defun p1-methods (item)
  (let ((methods (compute-applicable-methods #'hyperbook/fedwiki::render-story-item
                   (list :code item *p1-page*))))
    (format t "~&METHODS ~S~%"
            (mapcar (lambda (method)
                      (list :qualifiers (sb-mop:method-qualifiers method)
                            :specializers
                            (mapcar (lambda (s)
                                      (if (typep s 'sb-mop:eql-specializer)
                                          (list 'eql (sb-mop:eql-specializer-object s))
                                          (class-name s)))
                                    (sb-mop:method-specializers method)))) methods))
    methods))
(defun p1-stage (stage)
  (format t "~&===== ~A =====~%" stage)
  (dolist (entry *p1-items*)
    (let* ((name (car entry)) (item (cdr entry))
           (data (hyperbook/fedwiki::data-of item)))
      (format t "~&CASE ~A TYPE ~S CLASS ~S LANGUAGE ~S PRESENT ~S~%"
              name (hyperbook/fedwiki::item-type-of item) (class-name (class-of item))
              (and data (gethash "language" data))
              (and data (nth-value 1 (gethash "language" data))))
      (p1-methods item)
      (multiple-value-bind (html refs assets)
          (html-inspector-views:html-and-references
            (hyperbook/fedwiki::render-story-item :code item *p1-page*))
        (format t "HTML ~S~%REFS ~S ASSETS ~S~%" html
                (mapcar (lambda (ref)
                          (list :id (car ref) :id-in-html (not (null (search (car ref) html)))
                                :eq-item (eq (cdr ref) item)
                                :eq-resolved (eq (cdr (assoc (car ref) refs :test #'equal)) item))) refs)
                assets)
        (with-open-file (out (format nil "/tmp/hyperdoc-p1/~A-~A.html" stage name)
                             :direction :output :if-exists :supersede)
          (write-string html out))
        (assert (if (string= stage "before")
                    (and (= 1 (length refs)) (eq item (cdar refs)))
                    (null refs)))))
    (format t "DATA-HTML ~S~%"
            (html-inspector-views:view-html (hyperbook/fedwiki::👀data (cdr entry))))))
(setf *p1-before-methods* (p1-methods (cdar *p1-items*)))
(p1-stage "before")
(asdf:load-system "dreyeck/verified-example")
(format t "~&P1 EXPLICIT LOAD DONE~%")
(dolist (name '("hyperbook/fedwiki" "dreyeck/verified-example" "html-inspector-views"))
  (format t "~&SOURCE ~A ~A~%" name (asdf:system-source-directory name)))
(p1-stage "after")
(let ((methods (p1-methods (cdar *p1-items*))))
  (format t "DEFAULT-METHOD-IDENTICAL-AND-NEXT ~S~%"
          (equal (rest methods) *p1-before-methods*))
  (assert (equal (rest methods) *p1-before-methods*)))
(let* ((json (shasht:read-json "{\"type\":\"code\",\"id\":\"marked-probe\",\"text\":\"<script>untrusted</script>\",\"hyperdocExample\":\"p1-no-grant\"}"))
       (item (hyperbook/fedwiki::make-story-item json)))
  (multiple-value-bind (html refs)
      (html-inspector-views:html-and-references
        (hyperbook/fedwiki::render-story-item :code item *p1-page*))
    (format t "~&MARKED-UNKNOWN HTML ~S REFS ~S~%" html refs)
    (assert (search "NOT-APPROVED; execution disabled" html))
    (assert (null refs))))
(format t "~&P1-PASS No server started. No example text evaluated.~%")
