;;;; Contract counter-probes on PR #32 (e1ab2f570ee793e301c5af706cbcf2fc984c02a9), plans only, no network.
;;;; PR_TREE = an unmodified extraction of that commit (run-review.sh provides it). Same probe ids as probes31.lisp.
;;;; Every probe goes through the public entry PLAN-LINK-RESOLUTION. Prints one line per probe, prefixed P32.
(require :asdf)
(asdf:load-asd (merge-pathnames "dreyeck.asd" (uiop:ensure-directory-pathname (uiop:getenv "PR_TREE"))))
(asdf:load-system "dreyeck/work/fedwiki-link-resolution")
(in-package #:dreyeck/work/fedwiki-link-resolution)
(setf *print-pretty* nil)
(defun cands (&rest sites) (candidate-facts :l (cons '(:origin . :origin) (mapcar (lambda (s) (cons s :journal)) sites))))
(defun st (facts &rest sites) (append '((origin :origin)) (apply #'cands sites) facts))
(defun show (id label state tasks)
  (let ((r (handler-case (plan-link-resolution state tasks) (error (c) (format t "~&P32 ~A ~A: ERROR ~A~%" id label c) nil))))
    (when r (format t "~&P32 ~A ~A: plans=~D outcomes=~S steps=~S added=~S~%" id label (length (dreyeck/shop3:plans-of r))
                    (mapcar (lambda (o) (getf o :outcome)) (plan-outcomes r state))
                    (mapcar (lambda (p) (mapcar (lambda (s) (if (eq (first s) '!request) (list '!request (third s)) (first s))) p)) (dreyeck/shop3:plans-of r))
                    (mapcar (lambda (o) (remove-if (lambda (a) (member (first a) '(planned-request))) (getf o :simulated))) (plan-outcomes r state))))
    r))
(defun res (policy) `((resolve :l :target ,policy)))
(defparameter +fork+ '((page-unavailable :origin :target 404) (verified-copy :snap :a :target) (fork-permitted :origin :a :target)
                       (fork-source-policy verified-copy-suffices)))
(defparameter +prep+ '((prepare-local-target :target)))
;; Contract 2: imported modeled facts / markers
(show "I1" "imported modeled-local-page only, collaborative" (st '((modeled-local-page :origin :target)) :a) (res 'collaborative))
(show "I2" "imported modeled-local-page only, local-only" (st '((modeled-local-page :origin :target)) :a) (res 'local-only))
(show "I3" "imported modeled-local-page + 404 + NO permission, prepare" (st '((modeled-local-page :origin :target) (page-unavailable :origin :target 404))) +prep+)
(show "I4" "imported modeled-local-page at remote :a, origin 404" (st '((page-unavailable :origin :target 404) (modeled-local-page :a :target)) :a) (res 'collaborative))
(show "I5" "imported planned-fork only (no presence) + fork evidence, prepare" (st (cons '(planned-fork :origin :target :a verified-copy :snap) (copy-tree +fork+))) +prep+)
(show "I6" "imported planned-panel marker, origin unknown, local-only" (st '((planned-panel :l :origin :target origin))) (res 'local-only))
;; Fork semantics
(show "F1" "fork with HTTP 500 at origin" (st (cons '(page-unavailable :origin :target 500) (remove 'page-unavailable (copy-tree +fork+) :key #'first))) +prep+)
(show "F2" "fork with explicit fork-forbidden as well" (st (cons '(fork-forbidden :origin :a :target) (copy-tree +fork+))) +prep+)
(show "F3" "fork, strict policy, remote present, NO copy" (st '((page-unavailable :origin :target 404) (fork-permitted :origin :a :target) (fork-source-policy require-remote-confirmation) (page-available :a :target))) +prep+)
(show "F4" "fork, two verified copies" (st (cons '(verified-copy :snap2 :b :target) (append (copy-tree +fork+) '((fork-permitted :origin :b :target)))))  +prep+)
(show "F5" "fork, cached policy, copy from a remote observed 404" (st (cons '(page-unavailable :a :target 404) (copy-tree +fork+))) +prep+)
(show "F7" "fork with request-error at origin (no HTTP answer)" (st (cons '(request-error :origin :target) (remove 'page-unavailable (copy-tree +fork+) :key #'first))) +prep+)
(show "F8" "prepare twice" (st (copy-tree +fork+)) (append +prep+ +prep+))
(show "F9" "prepare, then resolve local-only" (st (copy-tree +fork+)) (append +prep+ (res 'local-only)))
;; Conflicts and scope
(show "C1" "conflict at an unrelated site/slug, local hit" (st '((page-available :origin :target) (page-available :zz :other) (page-unavailable :zz :other 404)) :a) (res 'collaborative))
(show "C2" "conflict at a later candidate after local hit" (st '((page-available :origin :target) (page-available :b :target) (page-unavailable :b :target 404)) :a :b) (res 'collaborative))
(show "C2b" "conflict at a candidate before the hit" (st '((page-unavailable :origin :target 404) (page-available :a :target) (page-unavailable :a :target 404) (page-available :b :target)) :a :b) (res 'collaborative))
(show "C4" "both fork policies, copy and remote evidence" (st (list* '(fork-source-policy require-remote-confirmation) '(page-available :a :target) (copy-tree +fork+))) +prep+)
(show "C5" "fork-permitted + fork-forbidden" (st (cons '(fork-forbidden :origin :a :target) (copy-tree +fork+))) +prep+)
(show "C6" "origin conflict, local-only" (st '((page-available :origin :target) (page-unavailable :origin :target 404))) (res 'local-only))
(show "C7" "origin conflict + imported modeled-local-page, local-only" (st '((page-available :origin :target) (page-unavailable :origin :target 404) (modeled-local-page :origin :target))) (res 'local-only))
;; Missing / failed evidence
(show "M1" "local-only, origin unknown" (st '()) (res 'local-only))
(show "M2" "local-only, origin 404" (st '((page-unavailable :origin :target 404))) (res 'local-only))
(show "M3" "collaborative, all 404" (st '((page-unavailable :origin :target 404) (page-unavailable :a :target 404)) :a) (res 'collaborative))
(show "M4" "collaborative, network failure at a" (st '((page-unavailable :origin :target 404) (request-error :a :target) (page-available :b :target)) :a :b) (res 'collaborative))
(show "M5" "local-only, remote available but origin 404" (st '((page-unavailable :origin :target 404) (page-available :a :target)) :a) (res 'local-only))
(show "M6" "collaborative, unknown a before hit b" (st '((page-unavailable :origin :target 404) (page-available :b :target)) :a :b) (res 'collaborative))
(format t "~&P32 M6 diagnosis ~S~%" (diagnose-no-plan (st '((page-unavailable :origin :target 404) (page-available :b :target)) :a :b) :l :target 'collaborative))
;; Contract 3: primitives through the public entry point (PLAN-LINK-RESOLUTION accepts any task list)
(show "X1" "!plan-fork twice directly" (st (copy-tree +fork+)) '((!plan-fork :origin :target :a verified-copy :snap) (!plan-fork :origin :target :a verified-copy :snap)))
(show "X2" "!conclude-unresolved directly, no evidence" (st '()) '((!conclude-unresolved :l :target local-only)))
(show "X3" "!request remote directly (no gate)" (st '()) '((!request :l :a :target :journal)))
(show "X4" "try-candidate at remote position directly under 'local-only' intent" (st '((page-available :a :target)) :a) '((try-candidate :l :target 1)))
(show "X5" "!open-panel at a conflicting site" (st '((page-available :origin :target) (page-unavailable :origin :target 404))) '((!open-panel :l :origin :target origin)))
(let ((n (length shop3::*all-problems*))) (dotimes (i 3) (plan-link-resolution (st '((page-available :origin :target))) (res 'local-only)))
  (format t "~&P32 R1 *all-problems* grew by ~D; shop3:*domain* ~S~%" (- (length shop3::*all-problems*) n) (and shop3:*domain* (shop3::domain-name shop3:*domain*))))
(format t "~&P32-DONE~%")
