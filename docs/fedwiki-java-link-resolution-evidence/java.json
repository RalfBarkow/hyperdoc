      "symbol": "Page.context",
      "file": "Main.java",
      "startLine": 289,
      "endLine": 295,
      "text": "    public List<String> context() {\n      List<String> sites = new ArrayList<String>();\n      for (int i=journal.size()-1; i>=0; i--)\n        if (journal.get(i).site != null && !sites.contains(journal.get(i).site))\n          sites.add(journal.get(i).site);\n      return sites;\n    }\n",
      "sha256": "80158a3807276b25d18c23895d621c2cbdc27d4e9252d82fc69a5519c2396517",
      "url": "https://github.com/RalfBarkow/fedwiki-java/blob/b58fb43e7ffbbbda66685363dcda1facbd2a46a1/Main.java#L289-L295"
    },
    {
      "symbol": "Panel.context",
      "file": "Main.java",
      "startLine": 266,
      "endLine": 273,
      "text": "    public List<String> context () {\n        var context = this.page.context();\n      if(!this.site.equals(origin)) {\n        context.remove(this.site);\n        context.add(0,this.site);\n      }\n      return context;\n    }\n",
      "sha256": "35e2b5281611155be9dc3c2dfc9b2b49c08005275a5d8509e1c6b0c45333aef7",
      "url": "https://github.com/RalfBarkow/fedwiki-java/blob/b58fb43e7ffbbbda66685363dcda1facbd2a46a1/Main.java#L266-L273"
    },
    {
      "symbol": "Panel.load(from,slug)",
      "file": "Main.java",
      "startLine": 225,
      "endLine": 255,
      "text": "    public static Panel load(Panel from, String slug) {\n      var context = from.context();\n      if(from.item().site != null) {\n        context.remove(from.item().site);\n        context.add(0,from.item().site);\n      }\n\n      var site = origin;\n      while(true) {\n        String url = String.format(\"http://%s/%s.json\", site, slug);\n        var page = Main.fetch(url);\n        if(page != null) {\n          var panel = new Panel(site,slug);\n          panel.page = page;\n          panel.itemno = 0;\n          panel.context().forEach((each) -> {\n            enlarge(each);\n          });\n          return panel;\n        }\n        else {\n          if(!context.isEmpty()) {\n            site = context.get(0);\n            debug(site);\n            context.remove(0);\n          } else {\n            trouble(\"can't find page in current context\");\n          }\n        }\n      }\n    }\n",
      "sha256": "151095456aa7156da1f5129d32c19ecd8f2de0c4700435fe416af8f65539ccb2",
      "url": "https://github.com/RalfBarkow/fedwiki-java/blob/b58fb43e7ffbbbda66685363dcda1facbd2a46a1/Main.java#L225-L255"
    },
    {
      "symbol": "Panel.load(site,slug)",
      "file": "Main.java",
      "startLine": 216,
      "endLine": 223,
      "text": "    public static Panel load(String site, String slug) {\n      var panel = new Panel(site,slug);\n      String url = String.format(\"http://%s/%s.json\", site, slug);\n      panel.page = Main.fetch(url);\n      if(panel.page == null) trouble(\"can't find page at expected site\");\n      panel.itemno = 0;\n      return panel;\n    }\n",
      "sha256": "33a940ca4fb874260d11204a8330a6feebaf94d511d60f10c4b701d40c627685",
      "url": "https://github.com/RalfBarkow/fedwiki-java/blob/b58fb43e7ffbbbda66685363dcda1facbd2a46a1/Main.java#L216-L223"
    },
    {
      "symbol": "Item.links",
      "file": "Main.java",
      "startLine": 307,
      "endLine": 319,
      "text": "    private static final Pattern linkPattern = Pattern.compile(\"\\\\[\\\\[(.*?)]]\");\n\n    public List<String> links() {\n      var matcher = linkPattern.matcher(text);\n      if (matcher.find()) {\n        var slug = matcher.group(1)\n          .replaceAll(\"\\\\s\", \"-\")\n          .replaceAll(\"[^A-Za-z0-9-]\", \"\")\n          .toLowerCase(Locale.getDefault());\n        return List.of(slug);\n      }\n      return List.of();\n    }\n",
      "sha256": "18643c65dabdf77cd4add03c2e1e22fcbb3351499328c61dd0a8ff327b196d7c",
      "url": "https://github.com/RalfBarkow/fedwiki-java/blob/b58fb43e7ffbbbda66685363dcda1facbd2a46a1/Main.java#L307-L319"
    },
    {
      "symbol": "Main.enlarge",
      "file": "Main.java",
      "startLine": 193,
      "endLine": 199,
      "text": "  public static void enlarge(String site) {\n    if(!neighborhood.containsKey(site)) {\n      System.out.println(String.format(\"Reading SiteMap %s\",site));\n      var sitemap = fetchSiteMap(String.format(\"http://%s/system/sitemap.json\",site));\n      neighborhood.put(site, sitemap);\n    }\n  }\n",
      "sha256": "ec5b0e765b1ec414b510861892387c16a7e09477e7a49993d6b03e7a4d0889e7",
      "url": "https://github.com/RalfBarkow/fedwiki-java/blob/b58fb43e7ffbbbda66685363dcda1facbd2a46a1/Main.java#L193-L199"
    },
    {
      "symbol": "Main.fetch",
      "file": "Main.java",
      "startLine": 143,
      "endLine": 165,
      "text": "  static Page fetch(String url) {\n    Page page = null;\n    try {\n      HttpRequest request = HttpRequest.newBuilder()\n        .uri(new URI(url))\n        .header(\"User-Agent\", \"fedwiki-java\")\n        .version(HttpClient.Version.HTTP_1_1)\n        .GET()\n        .build();\n      HttpResponse<String> response = HttpClient\n        .newBuilder()\n        .build()\n        .send(request, HttpResponse.BodyHandlers.ofString());\n      var code = response.statusCode();\n      if (code == 200) {\n        var mapper = new ObjectMapper();\n        page = mapper.readValue(response.body(), Page.class);\n      }\n    } catch (URISyntaxException | IOException | InterruptedException e) {\n      trouble(\"http error: \" + e.getMessage());\n    }\n    return page;\n  }\n",
      "sha256": "31c977d8d23f439ae427c87816dc9e56e2ce03a6bf609e52cc9fa65d629fc7b3",
      "url": "https://github.com/RalfBarkow/fedwiki-java/blob/b58fb43e7ffbbbda66685363dcda1facbd2a46a1/Main.java#L143-L165"
    },
    {
      "symbol": "Main.fetchSiteMap",
      "file": "Main.java",
      "startLine": 167,
      "endLine": 191,
      "text": "  static SiteMap fetchSiteMap(String url) {\n    SiteMap map = null;\n    try {\n      HttpRequest request = HttpRequest.newBuilder()\n        .uri(new URI(url))\n        .header(\"User-Agent\", \"fedwiki-java\")\n        .version(HttpClient.Version.HTTP_1_1)\n        .GET()\n        .build();\n      HttpResponse<String> response = HttpClient\n        .newBuilder()\n        .build()\n        .send(request, HttpResponse.BodyHandlers.ofString());\n      var code = response.statusCode();\n      if (code == 200) {\n        var mapper = new ObjectMapper();\n        var infos = mapper.readValue(response.body(), PageInfo[].class);\n        map = new SiteMap();\n        map.infos = Arrays.asList(infos);\n      }\n    } catch (URISyntaxException | IOException | InterruptedException e) {\n      trouble(\"http error: \" + e.getMessage());\n    }\n    return map;\n  }\n",
      "sha256": "cae167cb2e4e292c257325402b7340b6a7917191965d5577f3cf9d48ff4e85c2",
      "url": "https://github.com/RalfBarkow/fedwiki-java/blob/b58fb43e7ffbbbda66685363dcda1facbd2a46a1/Main.java#L167-L191"
    },
    {
      "symbol": "Main.link",
      "file": "Main.java",
      "startLine": 104,
      "endLine": 111,
      "text": "  static void link(Panel panel) {\n    lineup.add(Panel.load(panel,panel.link()));\n    System.out.println(\"\");\n    for(Panel each : lineup)\n      System.out.println(each.page.title + ANSI_GREEN + \" \" + each.site + ANSI_RESET);\n    System.out.println(\"==========================================\");\n    System.out.println(ANSI_PURPLE + location() + ANSI_RESET);\n   }\n",
      "sha256": "5aef688e34a09385bf2985501e290021e08310f76b3b83510f8634ab9d3d301b",
      "url": "https://github.com/RalfBarkow/fedwiki-java/blob/b58fb43e7ffbbbda66685363dcda1facbd2a46a1/Main.java#L104-L111"
    }
