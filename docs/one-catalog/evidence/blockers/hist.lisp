(require :asdf)
(asdf:load-system "dreyeck/topic-maps-public-views/tests")
(in-package :dreyeck/topic-maps-public-views/tests)
(let* ((ws1 (dreyeck/work/reading:work-workspace)) (ws2 (dreyeck/work/reading:work-workspace)))
  (format t "~&HIST singleton-workspace: ~S~%" (eq ws1 ws2))
  (served (lambda ()
    (let* ((history (find-symbol "TOPICMAP-WORKSPACE-HISTORY-OF" :dreyeck/topicmap))
           (point (find-symbol "TOPICMAP-WORKSPACE-POINT-OF" :dreyeck/topicmap))
           (moves (remove-if-not (lambda (c) (or (typep (cdr c) 'ap:reviewed-thunk) (ap::%reviewed-control-class-p (cdr c))))
                                 (%controls-of-view ws1 "Topicmap")))
           (before (length (funcall history ws1))) (p0 (funcall point ws1)))
      (format t "~&HIST controls offered: ~D; history before: ~D~%" (length moves) before)
      (loop repeat 2000 do (dolist (m moves) (click m)))
      (format t "~&HIST after ~D clicks through the click path: history ~D (point ~A -> ~A)~%" (* 2000 (length moves)) (length (funcall history ws1)) p0 (funcall point ws1))))))
