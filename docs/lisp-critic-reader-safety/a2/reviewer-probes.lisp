;;;; Verbatim counterexamples supplied by the owner from Claude's A1 review.
;;;; The reviewer's private files were not independently accessed.
(asdf:load-system "dreyeck/lisp-critic/text-criticism/tests")
(when (uiop:getenv "A2_BASELINE_SOURCE") (load (uiop:getenv "A2_BASELINE_SOURCE")))
(in-package #:dreyeck/lisp-critic/text-criticism/tests)
(let* ((baseline (uiop:getenv "A2_BASELINE_SOURCE"))
       (directory (merge-pathnames "docs/lisp-critic-reader-safety/a2/reviewer-cases/" (root)))
       (comment (uiop:read-file-string (merge-pathnames "line-comment.txt" directory) :external-format :utf-8))
       (string-source (uiop:read-file-string (merge-pathnames "string.txt" directory) :external-format :utf-8))
       (definition "(defun historical-claims () (copy-tree '((:subject :real))))")
       (before (file-octets +claims+))
       (checks 0))
  (labels ((verify (value label) (incf checks) (assert value () "A2 review case: ~A" label))
           (accepted (source)
             (multiple-value-bind (table why) (passage:read-claim-table source)
               (verify (and (null why) (equal table '((:subject :real)))) "real definition remains accepted"))))
    (loop for text in (list comment string-source)
          for subject in '(:in-line-comment :in-string)
          do (multiple-value-bind (table why) (passage:read-claim-table text)
               (format t "~&REVIEW-CASE ~S source=~S table=~S refusal=~S~%" subject text table why)
               (verify (if baseline
                           (and (null why) (equal table (list (list :subject subject))))
                           (and (null table) (equal why '(:definitions-found 0)))) subject)))
    ;; Standard reader used only as an oracle on these two fixed trusted cases.
    ;; It is never used by the production extractor or as a fallback.
    (loop for text in (list comment string-source) for count in '(1 3)
          do (let ((forms (with-standard-io-syntax
                            (let ((*read-eval* nil))
                              (with-input-from-string (stream text)
                                (loop for form = (read stream nil :end) until (eq form :end) collect form))))))
               (verify (= count (length forms)) "standard-reader form count")
               (verify (char= #\a (first forms)) "first form is character a")
               (when (= count 3)
                 (verify (and (stringp (second forms)) (null (third forms))) "remaining forms are a string and NIL"))))
    (unless baseline
      (dolist (token '("#\\;" "#\\\"" "#\\a"))
        (verify (equal '(:definitions-found 0) (nth-value 1 (passage:read-claim-table token)))
                "standalone character is allowed syntax but supplies no definition")
        (accepted (format nil "~A ~A" token definition)))
      (accepted (format nil "~A~%~A" comment definition))
      (accepted (format nil "~A~%~A" string-source definition))
      (multiple-value-bind (table why) (passage:read-claim-table (file-text +claims+))
        (verify (null why) "Fischer table accepted")
        (verify (= 10 (getf (getf (passage:observe-claim-evidence table) :result) :claims-citing-a-primary-paper))
                "Fischer primary-paper count preserved")))
    (verify (equalp before (file-octets +claims+)) "source file unchanged")
    (format t "~&A2-VERBATIM-~A-PASS: ~D checks.~%" (if baseline "BASELINE" "CORRECTED") checks)))
