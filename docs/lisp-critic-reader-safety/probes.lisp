(asdf:load-system "dreyeck/lisp-critic/text-criticism/tests")
(when (uiop:getenv "A1_BASELINE_SOURCE") (load (uiop:getenv "A1_BASELINE_SOURCE")))
(in-package #:dreyeck/lisp-critic/text-criticism/tests)
(defstruct constructor-probe (effect (setf *effect* t)))
(defun a1-probes ()
  (let* ((baseline (uiop:getenv "A1_BASELINE_SOURCE"))
         (attack (table-source "((:subject #S(dreyeck/lisp-critic/text-criticism/tests::constructor-probe)))"))
         (comment (format nil "#|~A~%|#" (table-source "((:subject :a))")))
         (features (table-source "((:subject #+a1-feature :a #-a1-feature :b))")))
    (setf *effect* nil)
    (passage:read-claim-table attack)
    (format t "~&CONSTRUCTOR effect=~S~%" *effect*)
    (assert (eq (not (null baseline)) (not (null *effect*))))
    (setf *effect* nil)
    (let ((result (criticism:observe-now :octets (list :claims-source (octets attack)))))
      (format t "~&CHANGED-SOURCE effect=~S discrepancy=~S claims=~S~%" *effect* (getf result :discrepancies) (getf (getf result :claims) :status))
      (assert (eq :not-determined (getf result :discrepancies)))
      (assert (eq (not (null baseline)) (not (null *effect*)))))
    (multiple-value-bind (table why) (passage:read-claim-table comment)
      (declare (ignore table))
      (format t "~&COMMENT refusal=~S~%" why)
      (assert (eq (null baseline) (not (null why)))))
    (let ((one (let ((*features* '(:a1-feature))) (multiple-value-list (passage:read-claim-table features))))
          (two (let ((*features* nil)) (multiple-value-list (passage:read-claim-table features)))))
      (format t "~&FEATURES same=~S results=~S / ~S~%" (equal one two) one two)
      (assert (eq (null baseline) (equal one two))))
    (unless baseline
      (let ((packages (list-all-packages)) (before (file-octets +claims+)))
        (dolist (text (list (format nil "#| outer #| nested |# ~A |#" comment)
                           (prin1-to-string (table-source "()"))
                           (concatenate 'string "'" (table-source "()"))
                           (concatenate 'string (table-source "()") "(")
                           (concatenate 'string "#|" (table-source "()"))
                           (table-source "((:a #.(error \"effect\")))")
                           (table-source "((:a #1=(x . #1#)))")
                           (table-source "((:a |escaped|))")
                           (table-source "((:a #+a1-feature :x))")
                           (concatenate 'string (table-source "()") (table-source "()"))))
          (assert (nth-value 1 (passage:read-claim-table text))))
        ;; Verify early source-state gating, even when the parser itself would signal.
        (let ((original (symbol-function 'passage:read-claim-table)))
          (unwind-protect
               (progn (setf (symbol-function 'passage:read-claim-table)
                            (lambda (text) (declare (ignore text)) (error "Parser reached for changed source")))
                      (assert (eq :not-determined (getf (criticism:observe-now :octets (list :claims-source (octets attack))) :discrepancies))))
            (setf (symbol-function 'passage:read-claim-table) original)))
        (assert (equalp before (file-octets +claims+)))
        (assert (equal packages (list-all-packages)))
        (assert (null *effect*))))
    (format t "~&A1-~A-PROBES-PASS~%" (if baseline "BASELINE-REPRODUCTION" "CORRECTED"))))
(a1-probes)
