#!/usr/bin/env python3
"""Test-only launcher: portable SBCL plus the same registry in each fresh child."""
import os
import pathlib
import sys

assert os.environ.get("DEFEDERATION_REPO"), "Select the test worktree explicitly"
root = pathlib.Path(__file__).resolve().parent
os.environ["A1_PORTABLE_LAUNCHER"] = str(root / "portable-sbcl")
# SBCL runtime options must precede Lisp --load/--eval options. Preserve all
# test expressions and exit statuses; only deduplicate these startup flags.
args = [arg for arg in sys.argv[1:] if arg not in ("--noinform", "--no-sysinit")]
command = ["/workspace/scratch/tmdm-mcp-portable/bin/sbcl", "--noinform", "--no-sysinit",
           "--load", str(root / "bootstrap.lisp"), "--eval",
           '(setf sb-ext:*runtime-pathname* (pathname (uiop:getenv "A1_PORTABLE_LAUNCHER")))', *args]
os.execv(command[0], command)
