(load (merge-pathnames "probes-prelude.lisp" (directory-namestring *load-truename*)))
(in-package #:a1-review)
(format t "~&=== revision ~A (second batch)~%" (uiop:getenv "A1_REVISION"))
(dolist (lit '("#\\(" "#\\)" "#\;" "#\\\"" "#\\Space" "#\\\\" "#\\a" "#\\'" "#\\`" "#\\," "#\\#" "#\\|"))
  (probe (format nil "char-literal ~A" lit) (src "((:a :b))" :before (format nil "(defvar *c* (list ~A 1))" lit)) :truth t))
(probe "char-then-string-2" (format nil "#\\a\" (defun historical-claims () (copy-tree '((:subject :in-string)))) #\\b\" nil~%") :truth t)
(probe "char-then-line-comment" (format nil "#\\a; (defun historical-claims () (copy-tree '((:subject :in-line-comment))))~%") :truth t)
(probe "char-then-comment+real" (format nil "(defvar *c* #\\a); x~%#\\a; (defun historical-claims () (copy-tree '((:subject :in-line-comment))))~%~A" (src "((:subject :real))")) :truth t)
(probe "char;hides-real-definition" (format nil "#\\a;~A" (subseq (src "((:subject :real))") 1)) :truth t)
;; the same through the ungated caller
(let* ((dir (uiop:ensure-directory-pathname (merge-pathnames (format nil "a1-review-~36R/" (random (expt 36 8))) (uiop:temporary-directory))))
       (file (merge-pathnames "dreyeck/src/lisp-critic-reading.lisp" dir)))
  (ensure-directories-exist file)
  (unwind-protect
       (progn (with-open-file (out file :direction :output :external-format :utf-8)
                (format out "#\\a; (defun historical-claims () (copy-tree '((:subject :in-line-comment))))~%"))
              (format t "~&CALLER image-agreement without the reading system: ~S~%" (c:image-agreement :root dir)))
    (uiop:delete-directory-tree dir :validate t)))
(format t "~&TOTAL effects: ~D~%" *effects*)
