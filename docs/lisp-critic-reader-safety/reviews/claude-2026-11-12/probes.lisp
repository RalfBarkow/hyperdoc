;;; Independent probes of READ-CLAIM-TABLE, written by the reviewer. Loaded
;;; into a fresh process after the system of the worktree under test.
(defpackage #:a1-review (:use #:cl) (:local-nicknames (#:p #:dreyeck/lisp-critic/text-passage) (#:c #:dreyeck/lisp-critic/text-criticism)))
(in-package #:a1-review)
(defvar *effects* 0)
(defstruct probe-struct (slot (incf *effects*)))
(defun src (table &key (before "") (after "") (body "(copy-tree '~A)"))
  (format nil "~A~%(defun historical-claims ()~%  \"Claims.\"~%  ~?)~%~A" before body (list table) after))
(defun ground-truth (text)
  "What the standard reader sees at top level: only for texts without #. or #S."
  (let ((scratch (make-package (format nil "GT-~D" (random 1000000)) :use '(:cl))))
    (unwind-protect
         (handler-case
             (with-standard-io-syntax
               (let ((*read-eval* nil) (*package* scratch) (eof (list nil)))
                 (with-input-from-string (in text)
                   (loop for form = (read in nil eof) until (eq form eof)
                         collect (cond ((and (consp form) (eq 'defun (first form))
                                             (symbolp (second form)) (string= "HISTORICAL-CLAIMS" (symbol-name (second form))))
                                        :active-definition)
                                       ((consp form) :other-list) ((stringp form) :string)
                                       ((characterp form) :character) (t :atom))))))
           (error (e) (list :reader-error (type-of e))))
      (delete-package scratch))))
(defun probe (name text &key truth)
  (let ((before *effects*))
    (multiple-value-bind (table why)
        (handler-case (p:read-claim-table text)
          (error (e) (values :signalled (type-of e)))
          (sb-sys:interactive-interrupt () (values :interrupt nil)))
      (format t "~&PROBE ~32A table=~S why=~S effects=~D~@[ cl-reader=~S~]~%"
              name table why (- *effects* before) (and truth (ground-truth text))))))
(defun nest (n inner) (format nil "~A~A~A" (make-string n :initial-element #\() inner (make-string n :initial-element #\))))

(format t "~&=== revision ~A~%" (uiop:getenv "A1_REVISION"))
;; the three reported failures
(probe "constructor-#S" (src "((:subject #S(a1-review::probe-struct)))"))
(probe "block-comment-definition" (format nil "#|~%~A~%|#" (src "((:subject :in-comment))")) :truth t)
(let ((text (src "((:subject #+a1-feat :a #-a1-feat :b))")))
  (let ((*features* (cons :a1-feat *features*))) (probe "feature-conditional/with" text))
  (let ((*features* (remove :a1-feat *features*))) (probe "feature-conditional/without" text)))
;; the gate: changed claims source carrying the constructor attack
(let* ((before *effects*)
       (attack (sb-ext:string-to-octets (src "((:subject #S(a1-review::probe-struct)))") :external-format :utf-8))
       (result (c:observe-now :octets (list :claims-source attack))))
  (format t "~&GATE  changed-source: claims=~S discrepancies=~S scope=~S effects=~D~%"
          (getf (getf result :claims) :status) (getf result :discrepancies) (getf result :scope) (- *effects* before)))
;; tripwire: is the parser called at all for a changed source?
(let ((original (symbol-function 'p:read-claim-table)) (called 0))
  (unwind-protect
       (progn (setf (symbol-function 'p:read-claim-table) (lambda (text) (incf called) (funcall original text)))
              (c:observe-now :octets (list :claims-source (sb-ext:string-to-octets (src "()") :external-format :utf-8)))
              (format t "~&GATE  parser calls for changed claims source: ~D~%" called)
              (setf called 0)
              (c:observe-now :octets (list :page (sb-ext:string-to-octets "<p>changed</p>" :external-format :utf-8)))
              (format t "~&GATE  parser calls for changed page only: ~D~%" called)
              (setf called 0)
              (c:observe-now)
              (format t "~&GATE  parser calls for the committed sources: ~D~%" called))
    (setf (symbol-function 'p:read-claim-table) original)))
;; the committed source
(let ((result (c:observe-now)))
  (format t "~&COMMITTED content=~S binding=~S scope=~S claims=~S discrepancies=~S~%"
          (getf (getf result :source-state) :content) (getf (getf result :source-state) :revision-binding) (getf result :scope)
          (let ((r (getf (getf result :claims) :result))) (list (getf r :claims-citing-a-primary-paper) (getf r :by-observed-evidence-kind)))
          (mapcar (lambda (d) (getf d :assertion)) (let ((d (getf result :discrepancies))) (if (listp d) d (list (list :assertion d)))))))
;; reviewer's counterexamples: token boundaries after a character literal
(probe "char-then-string" (format nil "#\\a\" (defun historical-claims () (copy-tree '((:subject :in-string)))) \" #\\\"~%") :truth t)
(probe "char-then-line-comment" (format nil "#\\a; (defun historical-claims () (copy-tree '((:subject :in-line-comment))))~%") :truth t)
(probe "char-then-quote" (format nil "(list #\\a'(defun historical-claims () (copy-tree '())))~%~A" (src "((:subject :real))")) :truth t)
;; other active definitions the grammar does not count
(probe "later-progn-redefinition" (src "((:subject :first))" :after "(progn (defun historical-claims () (copy-tree '((:subject :later)))))") :truth t)
(probe "later-cl:defun" (src "((:subject :first))" :after "(cl:defun historical-claims () (copy-tree '((:subject :later))))"))
(probe "later-qualified-name" (src "((:subject :first))" :after "(defun cl-user::historical-claims () (copy-tree '((:subject :later))))"))
(probe "only-nested-definition" "(progn (defun historical-claims () (copy-tree '((:subject :nested)))))" :truth t)
(probe "quoted-definition" (format nil "'~A" (src "((:subject :quoted))")) :truth t)
(probe "definition-in-string" (prin1-to-string (src "((:subject :in-string))")) :truth t)
(probe "two-definitions" (concatenate 'string (src "()") (src "()")))
;; reader state
(let ((text (src "((:subject :a :n 10 :m -7 :s \"x\"))")))
  (probe "state/default" text)
  (let ((*read-base* 16) (*package* (find-package :keyword)) (*read-default-float-format* 'double-float)
        (*readtable* (let ((rt (copy-readtable nil))) (setf (readtable-case rt) :preserve) rt)))
    (probe "state/base16+preserve+keyword" text)))
;; shape and literal edges
(probe "mixed-case" "(DeFuN Historical-Claims () (Copy-Tree '((:Subject :A))))" :truth t)
(probe "explicit-quote" "(defun historical-claims () (copy-tree (quote ((:subject :a)))))")
(probe "lambda-list-nil-token" "(defun historical-claims nil (copy-tree '((:subject :a))))")
(probe "declaration" "(defun historical-claims () (declare (optimize speed)) (copy-tree '((:subject :a))))")
(probe "backquote-table" "(defun historical-claims () (copy-tree `((:subject :a))))")
(probe "table-token-nil" "(defun historical-claims () (copy-tree 'nil))")
(probe "table-keyword" "(defun historical-claims () (copy-tree ':a))")
(probe "row-not-plist" (src "((:subject))"))
(probe "row-string" (src "(\"row\")"))
(probe "kw-dot" (src "((:a.b :c))")) (probe "kw-slash" (src "((:a/b :c))")) (probe "kw-double-colon" (src "((::a :c))"))
(probe "kw-bare-colon" (src "((: :c))")) (probe "kw-unicode" (src "((:über :c))"))
(probe "int-plus" (src "((:a +5))")) (probe "int-dot" (src "((:a 1.))")) (probe "int-ratio" (src "((:a 1/2))")) (probe "float" (src "((:a 1.5))"))
(probe "radix" (src "((:a #x10))")) (probe "vector" (src "((:a #(1 2)))")) (probe "read-eval" (src "((:a #.(incf a1-review::*effects*)))"))
(probe "graph-label" (src "((:a #1=(:b) #1#))")) (probe "escaped-symbol" (src "((:a |x|))")) (probe "backslash-symbol" (src "((:a x\\y))"))
(probe "dotted" (src "((:a . :b))")) (probe "symbol-value" (src "((:a foo))")) (probe "nested-quote" (src "((:a '(:b)))"))
(probe "string-escapes" (src "((:a \"q\\\"uote\\\\ and — dash\"))"))
(probe "unknown-package-in-table" (src "((:a no-such:x))"))
;; incomplete and malformed source
(probe "unclosed-list" (concatenate 'string (src "()") "(")) (probe "stray-close" (concatenate 'string (src "()") ")"))
(probe "unclosed-string" (concatenate 'string (src "()") "\"abc")) (probe "unclosed-block-comment" (concatenate 'string "#|" (src "()")))
(probe "hash-at-eof" (concatenate 'string (src "()") "#")) (probe "char-at-eof" (concatenate 'string (src "()") "#\\"))
(probe "quote-at-eof" (concatenate 'string (src "()") "'")) (probe "empty" "") (probe "only-comment" "; nothing")
(probe "nesting-127" (concatenate 'string (nest 127 "x") (src "((:a :b))")))
(probe "nesting-130" (concatenate 'string (nest 130 "x") (src "((:a :b))")))
(probe "literal-depth-9" (src (format nil "((:a ~A))" (nest 8 ":x"))))
(probe "literal-depth-12" (src (format nil "((:a ~A))" (nest 12 ":x"))))
(probe "cr-terminated-comment" (format nil "; comment~C(defun historical-claims () (copy-tree '((:subject :after-cr))))~%" #\Return) :truth t)
(probe "feature-outside-definition" (src "((:a :b))" :before "#+sbcl (defvar *x* 1)"))
(probe "char-literals-outside" (src "((:a :b))" :before "(defvar *c* (list #\\( #\\) #\; #\\\" #\\Space #\\\\))") :truth t)
;; interning before validation?
(probe "refused-table-with-new-keyword" (src "((:zz-a1-review-never-seen foo))"))
(format t "~&INTERN keyword from a refused table present: ~S~%" (and (find-symbol "ZZ-A1-REVIEW-NEVER-SEEN" :keyword) t))
(format t "~&PACKAGES left behind: ~S~%" (remove-if-not (lambda (n) (or (search "READ-" n) (search "GT-" n))) (mapcar #'package-name (list-all-packages))))
(format t "~&TOTAL effects: ~D~%" *effects*)
