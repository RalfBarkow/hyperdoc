          \"Work Breakdown\" :SIGNAL-ERROR? T))
 (ASSERT (NULL (FIND-PACKAGE :DREYECK/WORK/PLANNING)))
 (LET ((TEMPORAL
        (HYPERBOOK:FIND-HYPERBOOK \"dreyeck/upstream-intake/temporal\"
