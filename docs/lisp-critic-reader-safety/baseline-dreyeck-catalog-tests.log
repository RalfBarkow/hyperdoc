                  (thunks (count-if (lambda (ref) (typep (cdr ref) 'html-inspector-views:thunk))
                                    (html-inspector-views:view-references widget-view))))
             (unless (= 1 thunks)
               ;; The optional layout tool is absent in this fresh default
               ;; image. Its four source widgets remain, with explicit evidence
