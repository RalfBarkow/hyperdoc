               (assert (= 0 thunks))
               (assert (equal (first entry) \"dreyeck/topicmap/tala/reading\"))
               (assert (some (lambda (name) (search name html :test #'char-equal))
                             '(\"READING-LAYOUT-RESULT\" \"READING-GEOMETRY\"
                               \"READING-INVARIANT-REPORT\" \"READING-COMPARISON\")))
               (assert (search \"inspect capability\" html))
               (assert (find-if
                        (lambda (ref)
                          (let ((value (cdr ref)))
                            (and (listp value) (member (getf value :status) '(:unavailable :unsupported))
