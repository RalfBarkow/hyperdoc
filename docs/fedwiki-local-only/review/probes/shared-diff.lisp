;;;; Differential probe of the shared FedWiki code (pages.lisp / wiki-links.lisp): run unchanged on the base (PR #34) and on PR #35,
;;;; then diff the outputs. Offline FEDWIKI objects (sitemaps from data), every socket connect refused and recorded.
(require :asdf)
(defparameter cl-user::*review-tree*
  (uiop:ensure-directory-pathname
   (or (uiop:getenv "PR_TREE")
       (truename (merge-pathnames "../../../../" (uiop:pathname-directory-pathname *load-truename*))))))
(defparameter cl-user::*review-work*
  (uiop:ensure-directory-pathname
   (or (uiop:getenv "PROBE_DIR") (error "Set PROBE_DIR to an empty scratch directory (run-review.sh does this)."))))
(require :sb-introspect)
(asdf:load-asd (merge-pathnames "dreyeck.asd" cl-user::*review-tree*))
(asdf:load-system "hyperbook/fedwiki")
(asdf:load-system "dreyeck/local-fedwiki-page")
(defpackage #:shared-diff (:use #:cl) (:local-nicknames (#:fw #:hyperbook/fedwiki) (#:hb #:hyperbook)))
(in-package #:shared-diff)
(setf *print-pretty* nil)
(defvar *attempts* '())
(sb-ext:without-package-locks
  (setf (fdefinition 'usocket:socket-connect)
        (lambda (host &rest args) (declare (ignore args)) (push host *attempts*) (error 'usocket:ns-host-not-found-error :host-or-ip host))))
(defvar *trace* '()) (defvar *tracing* nil)
(defmethod hb:find-page :around ((wiki fw::fedwiki) id &key signal-error?)
  (declare (ignore signal-error?))
  (when *tracing* (push (list :find-page (fw::domain-name-of wiki) id) *trace*))
  (call-next-method))
(defun sitemap (slugs) (coerce (loop for s in slugs collect (let ((h (make-hash-table :test 'equal))) (setf (gethash "slug" h) s (gethash "title" h) s) h)) 'vector))
(defun offline (name slugs)
  (let ((w (fw::make-fedwiki name :protocol-probe (constantly "https")
                                  :sitemap-fetcher (lambda (w) (fw::fetch-sitemap w :json-fetcher (lambda (u) (declare (ignore u)) (sitemap slugs))))
                                  :plugin-data-fetcher (lambda (w) (declare (ignore w)) nil))))
    (fw::wait-for-sitemap w) (setf (gethash name fw::*neighborhood*) w)))
(defparameter *origin* (offline "origin" '("welcome-visitors" "here")))
(offline "s1" '("target" "deep")) (offline "s2" '("other")) (offline "s3" '("target"))
(defun json (journal-sites &optional attribution)
  (let ((h (make-hash-table :test 'equal)))
    (setf (gethash "title" h) "P" (gethash "story" h) (vector)
          (gethash "journal" h) (coerce (append (loop for s in journal-sites collect (let ((e (make-hash-table :test 'equal))) (setf (gethash "type" e) "fork" (gethash "site" e) s) e))
                                                (when attribution (list (let ((e (make-hash-table :test 'equal)) (a (make-hash-table :test 'equal)))
                                                                         (setf (gethash "site" a) attribution (gethash "type" e) "edit" (gethash "attribution" e) a) e))))
                                        'vector))
    h))
(defun page (wiki journal-sites &optional attribution)
  (let ((p (fw::make-fedwiki-page wiki "p" "P"))) (fw::set-page-data p (json journal-sites attribution)) p))
(defun describe-result (x) (cond ((null x) nil) ((typep x 'condition) (list :condition (type-of x)))
                                 (t (list (type-of x) (fw::domain-name-of (hb:hyperbook-of x)) (hb:id-of x)
                                          (and (typep x 'fw::remote-fedwiki-page) (fw::domain-name-of (fw::origin-of x)))
                                          (mapcar (lambda (w) (fw::domain-name-of w)) (fw::context-of x))))))
(defun lookup (label slug page)
  (setf *trace* '())
  (let* ((plugin '())
         (result (let ((*tracing* t))
                   (handler-case (fw::lookup-slug-in-page-context slug page :plugin-page-resolver (lambda (w s) (push (list :plugin (fw::domain-name-of w) s) plugin) nil))
                     (error (c) c)))))
    (format t "~&SD ~A slug=~A context=~S result=~S consulted=~S plugin=~S~%" label slug (mapcar #'fw::domain-name-of (fw::context-of page))
            (describe-result result) (reverse *trace*) (reverse plugin))
    result))
(let* ((p (page *origin* '("s3" "s2" "s1"))))
  (lookup "collaborative/remote-hit" "target" p)
  (lookup "collaborative/local-hit" "here" p)
  (lookup "collaborative/miss" "nowhere" p)
  (let ((remote (lookup "collaborative/remote-hit-again" "deep" p)))
    (when (typep remote 'fw::remote-fedwiki-page) (lookup "from-remote-page" "target" remote))))
(lookup "attribution-site" "target" (page *origin* '() "s1"))
(lookup "empty-journal" "target" (page *origin* '()))
;; the existing Local-FedWiki classes (not the PR's opt-in OWN-PAGE): still collaborative?
(let* ((root (uiop:ensure-directory-pathname (merge-pathnames "localsite/" cl-user::*review-work*))))
  (ensure-directories-exist (merge-pathnames "pages/" root))
  (with-open-file (o (merge-pathnames "pages/lp" root) :direction :output :if-exists :supersede)
    (write-string "{\"title\":\"LP\",\"story\":[],\"journal\":[{\"type\":\"fork\",\"site\":\"s1\"}]}" o))
  (let* ((lw (dreyeck/local-fedwiki-page:make-local-fedwiki root "fedwiki:localsite"))
         (lp (dreyeck/local-fedwiki-page:make-local-fedwiki-page root lw "lp")))
    (format t "~&SD local-fedwiki-page class=~S~%" (type-of lp))
    (lookup "local-fedwiki-page/remote-hit" "target" lp)))
(format t "~&SD find-target-by-slug miss: ~S~%" (handler-case (fw::find-target-by-slug "nowhere" (page *origin* '("s2"))) (error (c) (type-of c))))
(format t "~&SD non-fedwiki page object: ~S~%" (handler-case (fw::lookup-slug-in-page-context "x" (make-instance 'standard-object)) (error (c) (type-of c))))
(format t "~&SD nil page: ~S~%" (handler-case (fw::lookup-slug-in-page-context "x" nil) (error (c) (type-of c))))
(format t "~&SD set-page-data context for (s3 s2 s1): ~S~%" (mapcar #'fw::domain-name-of (fw::context-of (page *origin* '("s3" "s2" "s1")))))
(format t "~&SD set-page-data lambda-list: ~S~%" (sb-introspect:function-lambda-list #'fw::set-page-data))
(format t "~&SD socket attempts: ~S~%" *attempts*)
(format t "~&SD-DONE~%")
