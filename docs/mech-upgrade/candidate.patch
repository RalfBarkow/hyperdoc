diff --git a/test/code-solo-compat.test.js b/test/code-solo-compat.test.js
new file mode 100644
index 0000000..073ff56
--- /dev/null
+++ b/test/code-solo-compat.test.js
@@ -0,0 +1,35 @@
+import {describe, it, afterEach} from 'node:test'
+import assert from 'node:assert/strict'
+import {blocks} from '../src/client/blocks.js'
+const originalWindow = globalThis.window, originalDollar = globalThis.$
+afterEach(() => {globalThis.window = originalWindow; globalThis.$ = originalDollar})
+describe('CODE backport preserves existing event and Solo protocol', () => {
+  it('LISTEN retains publishSourceData topic/name counting without new nested-input semantics', () => {
+    let listener
+    globalThis.window = {addEventListener: (kind, callback) => {assert.equal(kind, 'message'); listener = callback}}
+    globalThis.$ = () => ({on() {}})
+    const elem = {id: 'listener', innerHTML: ''}
+    blocks.LISTEN.emit({elem, command: 'LISTEN node', args: ['node'], state: {}})
+    assert.match(elem.innerHTML, /ready/)
+    listener({data: {action: 'publishSourceData', topic: 'other', title: 'Other'}})
+    assert.match(elem.innerHTML, /ready/)
+    listener({data: {action: 'publishSourceData', topic: 'node', title: 'Reflective Practice'}})
+    assert.match(elem.innerHTML, /1 events/)
+    listener({data: {action: 'publishSourceData', name: 'node', title: 'John Dewey'}})
+    assert.match(elem.innerHTML, /2 events/)
+  })
+  it('SOLO retains batch/source/aspect/pageKey and opener-origin delivery', async () => {
+    let sent, added
+    const aspects = [{name: 'trail 1', graph: {nodes: [], rels: []}}, {name: 'trail 2', graph: {nodes: [], rels: []}}]
+    const popup = {location: {pathname: '/plugins/solo/dialog/'}, postMessage: (data, origin) => {sent = {data, origin}}}
+    globalThis.window = {origin: 'https://example.invalid', addEventListener: kind => {added = kind},
+      open: (url, name) => {assert.equal(url, '/plugins/solo/dialog/#'); assert.equal(name, 'solo'); return popup}}
+    const elem = {id: 'solo', innerHTML: '', previousElementSibling: {innerHTML: ''},
+      closest: () => ({dataset: {key: 'page-key'}})}
+    await blocks.SOLO.emit({elem, command: 'SOLO', state: {aspect: [{id: 'item', source: 'Trails Rendered', result: aspects}]}})
+    assert.equal(added, 'message'); assert.equal(sent.origin, window.origin)
+    assert.deepEqual(sent.data, {type: 'batch', sources: [{source: 'Trails Rendered', aspects}], pageKey: 'page-key'})
+    assert.equal(sent.data.sources[0].aspects, aspects)
+    assert.match(elem.innerHTML, /1 sources, 2 aspects/)
+  })
+})
diff --git a/test/code.test.js b/test/code.test.js
new file mode 100644
index 0000000..c039963
--- /dev/null
+++ b/test/code.test.js
@@ -0,0 +1,78 @@
+import {describe, it, afterEach} from 'node:test'
+import assert from 'node:assert/strict'
+import {api, blocks, run} from '../src/client/blocks.js'
+
+const originalWindow = globalThis.window
+const originalWiki = globalThis.wiki
+afterEach(() => {globalThis.window = originalWindow; globalThis.wiki = originalWiki; delete globalThis.__codeCalls})
+function fixture(texts, {owner = false, remote = false} = {}) {
+  globalThis.window = {isOwner: owner}
+  const page = {story: texts.map(text => ({type: 'code', text}))}
+  const pageObject = {getRawPage: () => page, isRemote: () => remote}
+  const state = {context: {value: 2}, api: {
+    thisLineupKey: () => 'page-key', lineupAtKey: key => {assert.equal(key, 'page-key'); return pageObject},
+    inspect() {}, element: key => ({id: key}),
+    trouble: (_elem, message) => log.push({kind: 'trouble', message}),
+    status: (_elem, command, text) => {log.push({kind: 'status', command, text}); finish?.()},
+    button: (_elem, _label, callback) => {click = callback},
+    ticker: callback => {tick = callback; return {api: {stop: () => {}}}}
+  }}
+  const log = []; let click, tick, finish
+  return {state, log, page, pageObject,
+    code: (args = ['trails'], initiator) => blocks.CODE.emit({elem: {id: 'code'}, command: 'CODE trails', args, state, initiator}),
+    clicked: () => click({shiftKey: false}), ticked: () => tick(),
+    completed: () => new Promise(resolve => {finish = resolve})}
+}
+const sources = [
+  'export function trails(suffix=" aspects") {this.aspect = helper(this.context.value); return this.aspect.count + suffix}',
+  'function helper(value) {return {count: value}}'
+]
+describe('CODE backport invocation and state contract', () => {
+  it('recognizes CODE, joins multiple Code items and invokes named export with state/arguments', async () => {
+    const f = fixture(sources); await f.code(['trails', ' aspects'], 'click')
+    assert.deepEqual(f.state.aspect, {count: 2}); assert.equal(f.log.at(-1).text, ' ⇒ 2 aspects')
+  })
+  it('CLICK propagates initiation to its CODE child', async () => {
+    const f = fixture(sources); await run([{command: 'CLICK', key: 'click'}, [{command: 'CODE trails', key: 'code'}]], f.state)
+    const completed = f.completed(); f.clicked(); await completed
+    assert.equal(f.log.at(-1).text, ' ⇒ 2 aspects')
+  })
+  it('TICK propagates initiation to its CODE child', async () => {
+    const f = fixture(sources); await run([{command: 'TICK 1', key: 'tick'}, [{command: 'CODE trails', key: 'code'}]], f.state)
+    f.clicked(); await f.ticked(); assert.equal(f.log.at(-1).text, ' ⇒ 2 aspects')
+  })
+  it('rejects non-initiated execution for anonymous and owner/remote pages before evaluating source', async () => {
+    for (const options of [{}, {owner: true, remote: true}]) {
+      const f = fixture(['globalThis.__codeCalls = 99; export function trails() {return 1}'], options)
+      await f.code(); assert.equal(globalThis.__codeCalls, undefined)
+      assert.match(f.log[0].message, /must be run by CLICK or TICK or owned/)
+    }
+  })
+  it('allows non-initiated execution only for an owned local page', async () => {
+    const f = fixture(sources, {owner: true}); await f.code(); assert.equal(f.log.at(-1).text, ' ⇒ 2 aspects')
+  })
+  it('CLICK permits explicit execution of a remote page like the upstream contract', async () => {
+    const f = fixture(sources, {remote: true}); await f.code(['trails'], 'click'); assert.equal(f.log.at(-1).text, ' ⇒ 2 aspects')
+  })
+  it('reports missing Code items, missing/non-function exports and syntax errors through the caller API', async () => {
+    const cases = [[[], /expects the Code plugin/], [['export const other=1'], /Expected export of function/],
+      [['export const trails=1'], /Expected export of function/], [['export function trails( {'], /Unexpected/]]
+    for (const [texts, expected] of cases) {const f = fixture(texts); await f.code(['trails'], 'click'); assert.match(f.log[0].message, expected)}
+  })
+  it('supports default export and hides the raw execution API in the narrow backport', async () => {
+    const f = fixture(['export default function () {this.answer = this.api; return this.context.value}'])
+    await f.code([], 'click'); assert.equal(f.state.answer, undefined); assert.equal(f.log.at(-1).text, ' ⇒ 2')
+  })
+  it('reports unsupported server execution before importing a page module', async () => {
+    const f = fixture(['globalThis.__codeCalls=99; export function trails() {}'])
+    delete globalThis.window
+    await f.code(['trails'], 'click')
+    assert.equal(globalThis.__codeCalls, undefined)
+    assert.match(f.log[0].message, /expects a browser Wiki page context/)
+  })
+  it('locates the current page by its actual lineup key', () => {
+    globalThis.wiki = {lineup: {atKey: key => ({key})}}
+    assert.equal(api.thisLineupKey({closest: selector => {assert.equal(selector, '.page'); return {dataset: {key: 'actual'}}}}), 'actual')
+    assert.deepEqual(api.lineupAtKey('actual'), {key: 'actual'})
+  })
+})
