+// CODE backport: named exports/state proxy (70b23b9), visibility policy (6782e4d).
+async function code_emit({ elem, command, args, state, initiator }) {
+  if (typeof window == 'undefined' || !state.api.lineupAtKey || !state.api.thisLineupKey)
+    return state.api.trouble(elem, 'CODE expects a browser Wiki page context.')
+  const pageObject = state.api.lineupAtKey(state.api.thisLineupKey(elem))
+  const codes = pageObject.getRawPage().story.filter(item => item.type == 'code')
+  if (!codes.length) return state.api.trouble(elem, 'CODE expects the Code plugin in use on this page.')
+  const owned = window.isOwner && !pageObject.isRemote()
+  if (!(initiator || owned))
+    return state.api.trouble(elem, 'This CODE must be run by CLICK or TICK or owned by the logged in user.')
+  const code = codes.map(item => item.text).join('\n')
+  const way = args.length ? args[0] : 'default'
+  const handler = {
+    get(target, prop) {
+      // This narrow backport does not introduce the later CODE convenience API.
+      if (prop == 'api') return undefined
+      state.api.inspect(elem, prop, target)
+      return target[prop]
+    },
+  }
+  try {
+    const module = await import(`data:text/javascript;base64,${btoa(code)}`)
+    if (typeof module[way] != 'function')
+      return state.api.trouble(elem, `Expected export of function "${way}".`)
+    const result = await module[way].apply(new Proxy(state, handler), args.slice(1))
+    if (typeof result != 'undefined') state.api.status(elem, command, ` ⇒ ${result}`)
+  } catch (err) {
+    return state.api.trouble(elem, err.message)
+  }
+}
+
