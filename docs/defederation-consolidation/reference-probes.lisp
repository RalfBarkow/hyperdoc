(require :asdf)
(asdf:load-system "dreyeck/work/defederation-planning")
(in-package #:dreyeck/work/defederation-planning)
(let* ((pr29 (fboundp 'plan-defederation))
       (domain (if pr29 'defederation-preparation 'prepare-wiki-defederation))
       (task (if pr29 '(prepare-defederation :local-wiki :target-page)
                 '(prepare-defederation local-wiki remote-wiki target-page)))
       (state (scenario-state :b)))
  (flet ((probe (label facts tasks)
           (shop3:make-problem (list 'reference-probe :domain domain :silently t) facts tasks)
           (multiple-value-bind (raw seconds trees states)
               (shop3:find-plans 'reference-probe :which :all :verbose 0 :plan-tree t :collect-state t)
             (declare (ignore seconds))
             (format t "~&REFERENCE ~A ~A: plans=~S trees=~D states=~S~%"
                     (if pr29 29 30) label (mapcar #'shop3:shorter-plan raw) (length trees)
                     (mapcar #'shop3:state-atoms states)))))
    (probe :repeat state (list task task))
    (probe :unrelated-conflict
           (append state (if pr29 '((local-page :local-wiki :other) (local-page-absent :local-wiki :other))
                             '((local-page local-wiki other) (local-page-absent local-wiki other)))) (list task))))
