(asdf:load-system "dreyeck/work/welcome-development")
(in-package #:dreyeck/work/welcome-development)
(defun baseline-extra-submission (scenario assignment-id)
  (let* ((records (fixture-records scenario))
         (assignment (find assignment-id records :key #'record-id :test #'equal))
         (commit (fixture-sha #\9))
         (claim (fixture-submission assignment commit))
         (verification (fixture-verification assignment commit))
         (review (fixture-review assignment commit)))
    (setf (slot-value claim 'id) (list :extra-claim assignment-id commit)
          (slot-value verification 'id) (list :extra-verification assignment-id commit))
    (append records (list claim verification review))))
(loop for (label scenario assignment-id) in '((:c1 :p4 :a1) (:c2 :p6 :a1)
                                             (:c3-first :p7 :a1) (:c3-second :p7 :retry))
      for records = (baseline-extra-submission scenario assignment-id)
      for prior = (fixture-records scenario)
      for prior-run = (development-workflow prior)
      for run = (development-workflow records)
      for state = (development-initial-state run)
      do (assert (member `((!assign s2 codex ,(fixture-sha #\9)))
                         (dreyeck/shop3:plans-of (development-plan-result run)) :test #'equal))
         (when (eq label :c1)
           (assert (member `((!assign s2 codex ,(fixture-sha #\1)))
                           (dreyeck/shop3:plans-of (development-plan-result run)) :test #'equal)))
         (when (eq scenario :p7)
           (assert (equal '(((!report-blocker s1 attempts-exhausted)))
                          (dreyeck/shop3:plans-of (development-plan-result prior-run)))))
         (format t "~&REVIEWED-COMMIT ~A ADMITTED: verified S1 commits ~S; native proposals ~S~%"
                 label
                 (loop for fact in state when (and (eq 'slice-verified (first fact))
                                                    (eq 's1 (second fact))) collect (third fact))
                 (mapcar (lambda (alternative) (getf alternative :step))
                         (development-next-action-view run))))
