<?xml version="1.0" encoding="UTF-8"?>
<scxml
    xmlns="http://www.w3.org/2005/07/scxml"
    version="1.0"
    name="dmx-action-auth-session"
    initial="no-auth-context">

  <state id="no-auth-context">
    <onentry>
      <log label="No action-time auth context present yet"/>
    </onentry>
    <transition event="AUTH.INPUT_CAPTURED" target="input-captured"/>
  </state>

  <state id="input-captured">
    <onentry>
      <log label="Captured action-time auth input (credentials are never persisted)"/>
    </onentry>
    <transition event="AUTH.MODE_NORMALIZED" target="mode-normalized"/>
  </state>

  <state id="mode-normalized">
    <onentry>
      <log label="Normalized auth mode for request-scoped transition"/>
    </onentry>
    <transition event="AUTH.MODE.ANONYMOUS" target="anonymous-blocked"/>
    <transition event="AUTH.MODE.USERPASS" target="bootstrap-prepared"/>
    <transition event="AUTH.MODE.AUTHORIZATION_HEADER" target="request-shaped"/>
    <transition event="AUTH.MODE.BEARER_TOKEN" target="request-shaped"/>
  </state>

  <state id="request-shaped">
    <onentry>
      <log label="Shaped request metadata using redacted auth/session evidence only"/>
    </onentry>
    <transition event="AUTH.REQUEST.GUARDED_SHAPED" target="guarded-request-shaped"/>
    <transition event="AUTH.REQUEST.DIRECT_HEADER_SHAPED" target="direct-header-request-shaped"/>
    <transition event="AUTH.REQUEST.BEARER_SHAPED" target="bearer-request-shaped"/>
  </state>

  <state id="bootstrap-prepared">
    <onentry>
      <log label="Username/password mode prepared a login bootstrap before guarded assignment"/>
    </onentry>
    <transition event="AUTH.BOOTSTRAP_PREPARED" target="bootstrap-response-received"/>
  </state>

  <state id="bootstrap-response-received">
    <onentry>
      <log label="Bootstrap response received with bounded redacted evidence"/>
    </onentry>
    <transition event="AUTH.BOOTSTRAP.SUCCEEDED" target="session-material-extracted"/>
    <transition event="AUTH.BOOTSTRAP.FAILED" target="auth-failed"/>
  </state>

  <state id="session-material-extracted">
    <onentry>
      <log label="Session material extracted in memory; only redacted shape is inspectable"/>
    </onentry>
    <transition event="AUTH.SESSION_MATERIAL_EXTRACTED" target="guarded-put-prepared"/>
  </state>

  <state id="guarded-put-prepared">
    <onentry>
      <log label="Guarded assignment PUT prepared with empty body, JSON accept header, and redacted session/workspace cookie shape"/>
    </onentry>
    <transition event="AUTH.CONTINUATION_READY" target="continuation-ready"/>
    <transition event="AUTH.GUARDED_PUT_401" target="guarded-put-401"/>
  </state>

  <state id="guarded-put-401">
    <onentry>
      <log label="Guarded assignment PUT returned 401; classify once as auth blocked and do not retry loops"/>
    </onentry>
    <transition event="AUTH.BLOCKED" target="auth-blocked-terminal"/>
  </state>

  <state id="auth-blocked-terminal">
    <onentry>
      <log label="Terminal auth-blocked state with bounded evidence only"/>
    </onentry>
    <transition event="AUTH.DONE" target="done"/>
  </state>

  <state id="guarded-request-shaped">
    <onentry>
      <log label="Guarded request shaped for continuation mutation boundary"/>
    </onentry>
    <transition event="AUTH.CONTINUATION_READY" target="continuation-ready"/>
  </state>

  <state id="direct-header-request-shaped">
    <onentry>
      <log label="Direct header-mode request shaped without revealing header value"/>
    </onentry>
    <transition event="AUTH.CONTINUATION_READY" target="continuation-ready"/>
  </state>

  <state id="bearer-request-shaped">
    <onentry>
      <log label="Bearer-token request shaped without revealing token value"/>
    </onentry>
    <transition event="AUTH.CONTINUATION_READY" target="continuation-ready"/>
  </state>

  <state id="anonymous-blocked">
    <onentry>
      <log label="Anonymous action-time mode blocked at local auth boundary"/>
    </onentry>
    <transition event="AUTH.BLOCKED" target="done"/>
  </state>

  <state id="continuation-ready">
    <onentry>
      <log label="Continuation request is ready with bounded redacted auth/session evidence"/>
    </onentry>
    <transition event="AUTH.DONE" target="done"/>
  </state>

  <state id="auth-failed">
    <onentry>
      <log label="Bootstrap/auth failed before continuation became ready"/>
    </onentry>
    <transition event="AUTH.FAILED" target="done"/>
  </state>

  <final id="done">
    <onentry>
      <log label="DMX action auth/session transition run completed"/>
    </onentry>
  </final>

</scxml>
