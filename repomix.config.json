{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 2000000
  },
  "output": {
    "filePath": "repomix-output-hyperdoc.core.md",
    "style": "markdown",
    "parsableStyle": false,
    "compress": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "topFilesLength": 20,
    "includeFullDirectoryStructure": false,
    "splitOutput": 500000,
    "tokenBudget": 140000,
    "git": {
      "sortByChanges": false,
      "sortByChangesMaxCommits": 200,
      "includeDiffs": false,
      "includeLogs": false,
      "includeLogsCount": 50
    }
  },
  "include": [
    "README.md",
    "AGENTS.md",
    "AUTHORS",
    "LICENSE",
    "*.asd",
    "package.json",
    "flake.nix",
    "flake.lock",
    "dev.sh",
    "start.sh",
    "repomix.config.json",
    "repomix.config.*.json",
    "tools/repomix-pack.sh",
    "tools/repomix-snapshot-manifest.sh",
    "hyperdoc/Codex handover for HyperDoc.html",
    "hyperdoc/Best handover to Codex for HyperDoc.html",
    "hyperbook/**/*.lisp",
    "hyperbook-explorer/**/*.lisp",
    "hyperbook-server/**/*.lisp",
    "hyperdoc/*.lisp",
    "hyperdoc-explorer/*.lisp",
    "hyperdoc-inspector/*.lisp",
    "hyperdoc-scxml/**/*.lisp",
    "tests/package.lisp",
    "tests/test-runner.lisp"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".direnv/**",
      ".cache/**",
      ".flake-deps/**",
      ".release-verifications/**",
      "node_modules/**",
      "test-results/**",
      "target/**",
      "result",
      "var/**",
      "repomix-output*.xml",
      "repomix-output*.md",
      ".DS_Store",
      "**/quicklisp.lisp",
      "**/*.fasl",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.ico",
      "deps/**/assets/**",
      "assets/dm6-elm/app.js",
      "hyperdoc/dmx-annotations.lisp",
      "tests/dmx-annotations-smoke.lisp",
      "hyperdoc-inspector/snippet-playground.lisp"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
