;;;; Reading Conversation Coordinates
(defpackage #:dreyeck/work/conversation-coordinates
  (:use #:cl)
  (:local-nicknames (#:work #:dreyeck/work/reading)
                    (#:p #:dreyeck/work/collaborative-planning)
                    (#:c #:dreyeck/work/ctm-page-authoring)
                    (#:tm #:dreyeck/topicmap) (#:v #:html-inspector-views)
                    (#:occ #:dreyeck/gesture/operation-request))
  (:export #:read-conversation #:conversation-session #:conversation-message
           #:conversation-span #:source-key #:conversation-workspace
           #:conversation #:message-number #:select-message #:verify-review-binding))
(in-package #:dreyeck/work/conversation-coordinates)
(hyperdoc:see (hyperdoc:page "Conversation Coordinates" :hyperbook "dreyeck/work/reading"))

;; This is a closed reading of four coordinates, not a transcript importer.
;; The private bodies never enter these objects, even when separately verified.
(defparameter +manifest-sha+ "9f273fb79de656f7cbb2a0866d3cdb2cfa99e98a6e45e6e4693fc044a28f3f7e")
(defparameter +session-id+ "262d6ca6-81c4-4cd2-b4da-1d4613821702")
(defparameter +bindings+
  '((2 "ad0fb435-b522-4d96-a3cb-5d632b348096" "assistant" "assistant-text" "agent-reported" "claude-review")
    (8 "30fc24fb-6c79-41b1-b043-34ee9895b4ea" "assistant" "tool-input:ExitPlanMode" "agent-reported" "original-report")
    (16 "a3503eb6-b352-4e39-8473-7fe547184ab9" "user" "unwrapped" "not-recorded" "ctm-pre-transfer")
    (20 "b3acd503-a1d9-4f44-803e-81dcf173019e" "user" "pasted-wrapper" "not-recorded" "ctm-plan-p1" "ctm-wp-1")))

(define-condition conversation-source-error (error)
  ((reason :initarg :reason :reader source-error-reason))
  (:report (lambda (condition stream) (write-string (source-error-reason condition) stream))))
(defun refuse (control &rest args)
  (error 'conversation-source-error :reason (apply #'format nil control args)))
(defun evidence-file (name)
  (asdf:system-relative-pathname "dreyeck/work/reading"
                                 (concatenate 'string "dreyeck/work/conversation-evidence/" name)))
(defun text-sha (text)
  (ironclad:byte-array-to-hex-string
   (ironclad:digest-sequence :sha256 (babel:string-to-octets text :encoding :utf-8))))

(defclass conversation-session ()
  ((id :initarg :id :reader session-id)
   (messages :accessor session-messages)
   (spans :accessor session-spans)
   (ctm :initarg :ctm :reader session-ctm)
   (subjects :initform (make-hash-table :test 'equal) :reader session-subjects)
   (cursor :initform 0 :accessor session-cursor)
   (bindings :initarg :bindings :reader session-bindings)
   (offline-check :initarg :offline-check :reader session-offline-check)
   (workspace :initform nil :accessor session-workspace)))
(defclass conversation-message ()
  ((session :initarg :session :reader message-session)
   (record :initarg :record :reader message-record)))
(defclass conversation-span (occ:source-occurrence)
  ((message :initarg :message :reader span-message)
   (targets :initarg :targets :reader span-targets)))
(defclass conversation-work-topic (work:work-topic)
  ((session :initarg :session :reader topic-session))
  (:documentation "An existing declared Work Topic in one coordinate reading.
Only its navigation context is added; its declaration and source key stay intact."))
(defclass conversation-item-observation (work:work-fedwiki-item-observation)
  ((session :initarg :session :reader observation-session)))
(defclass report-reference ()
  ((record :initarg :record :reader report-record)))
(defvar *conversation* nil)
(defun conversation () (or *conversation* (setf *conversation* (read-conversation))))
(defun message-number (message) (gethash "ordinal" (message-record message)))
(defgeneric source-key (object))
(defmethod source-key ((session conversation-session)) (list (session-id session)))
(defmethod source-key ((message conversation-message))
  (list (session-id (message-session message)) (gethash "uuid" (message-record message))))
(defmethod source-key ((span conversation-span))
  (append (source-key (span-message span))
          (list (car (occ:occurrence-range span)) (cdr (occ:occurrence-range span)))))
(defmethod source-key ((subject c::ctm-subject)) (source-key (c::subject-topic subject)))
(defmethod source-key ((topic work:work-topic))
  ;; Subject identity survives edits. Revision evidence is a separate property.
  (let ((occurrence (work:topic-source-occurrence topic)))
    (list "work-subject/v2" (hyperbook:id-of (hyperbook:hyperbook-of (work:topic-occurrence-page occurrence)))
          (hyperbook:title-of (work:topic-occurrence-page occurrence))
          (tm:topicmap-topic-id-of topic))))
(defun declaration-observation (subject)
  (let* ((occurrence (work:topic-source-occurrence (c::subject-topic subject)))
         (snapshot (work:topic-occurrence-snapshot occurrence))
         (range (work:topic-occurrence-element-range occurrence)))
    (list :range (copy-tree range) :page-sha (text-sha snapshot)
          :declaration-sha (text-sha (subseq snapshot (car range) (cdr range))))))
(defun resolve-ctm-source-key (session key)
  (let ((matches (remove key (c::reading-subjects (session-ctm session)) :key #'source-key :test-not #'equal)))
    (unless (= 1 (length matches)) (refuse "CTM subject key no longer resolves uniquely"))
    (first matches)))
(defun binding-status (session subject)
  "Historical evidence stays attached to its Subject, never to a namesake.
Range and page revisions are observations, not Subject identifiers."
  (let ((binding (gethash (c::subject-id subject) (session-bindings session))))
    (if (and binding
             (equal (source-key subject) (coerce (gethash "subjectKey" binding) 'list))
             (equal (gethash "declarationSha256" binding)
                    (getf (declaration-observation subject) :declaration-sha)))
        :current :stale)))
(defun message-range (message)
  (let ((range (gethash "evidenceRange" (message-record message))))
    (cons (aref range 0) (aref range 1))))
(defun check-status-text (session &optional (here "NOT-RUN: original-message and local-report checks are not executed in this served reading."))
  (let ((check (session-offline-check session)))
    (format nil "~A recorded offline PASS (~A; ~A). Offline evidence is not a check executed here."
            here (gethash "date" check) (gethash "source" check))))
(defun attribution (message)
  (let ((record (message-record message)))
    (format nil "session-~A envelope; ~A; author ~A"
            (gethash "role" record) (gethash "origin" record) (gethash "author" record))))
(defun message-at (session number)
  (or (find number (session-messages session) :key #'message-number)
      (refuse "Unselected message #~D" number)))
(defun span-at (session number)
  (find (message-at session number) (session-spans session) :key #'span-message :test #'eq))
(defun subject-at (session id)
  (or (gethash id (session-subjects session)) (refuse "Unresolved subject ~A" id)))
(defun selected-message (session) (nth (session-cursor session) (session-messages session)))
(defun select-message (session index)
  "Same bounded event-cursor pattern as SELECT-CONTEXT-EVENT; no Workspace motion.
Federated journal events themselves cannot represent Claude messages."
  (check-type index integer)
  (setf (session-cursor session) (max 0 (min index (1- (length (session-messages session)))))))

(defmethod v:text-representation ((session conversation-session)) "Claude-Code conversation coordinates")
(defmethod v:text-representation ((message conversation-message)) (format nil "Message #~D" (message-number message)))
(defmethod v:text-representation ((span conversation-span))
  (format nil "Source span #~D" (message-number (span-message span))))
(defmethod v:text-representation ((observation conversation-item-observation)) "E3 source evidence")
(defmethod v:text-representation ((report report-reference)) "CTM/TMDM original report (local source reference)")
;; Specialize the source-occurrence protocol: a withheld message isn't Lisp code,
;; isn't an available snapshot and must never resolve through the Lisp CST reader.
(defmethod occ:occurrence-status ((span conversation-span)) :body-not-published)
(defmethod occ:resolve-occurrence ((span conversation-span))
  (refuse "Message body not published; coordinates cannot resolve an unavailable original."))

(defun verify-review-binding (message-text &key (start 1386) (end 14103) (offset -1386))
  "Check the retained review and ALL existing findings, without creating F1–F11 anew."
  (let ((document (p::case-subject "claude-review")))
    (unless (and (= start 1386) (= end 14103) (= offset (- start))
                 (equal message-text (subseq (p::document-text document) start end)))
      (refuse "Review retained-as span or offset differs"))
    (loop for n from 1 to 11 for finding = (p::case-subject (format nil "F~D" n))
          for record = (p::subject-record finding)
          unless (equal (gethash "quote" record)
                        (subseq message-text (+ offset (gethash "start" record))
                                             (+ offset (gethash "end" record))))
            do (refuse "Finding offset differs: F~D" n))
    t))

(defun validate-records (records)
  ;; Compare all retained metadata, not just role labels. Never consult originals.
  (let ((file (evidence-file "coordinates.json")))
    (unless (equal +manifest-sha+ (p::file-digest file)) (refuse "Coordinate manifest changed"))
    (let* ((shasht:*read-default-false-value* :false)
           (expected (gethash "messages" (shasht:read-json (uiop:read-file-string file :external-format :utf-8)))))
      (unless (work::%json-equal records expected) (refuse "Message metadata differs from the retained observation"))))
  (unless (= (length records) (length +bindings+)) (refuse "Unexpected selected messages"))
  (loop for record across records for binding in +bindings+
        for (number uuid role origin author) = binding
        for index from 0
        for previous = (and (plusp index) (aref records (1- index))) do
    (unless (and (equal +session-id+ (gethash "sessionId" record))
                 (equal (list number uuid role origin author)
                        (mapcar (lambda (key) (gethash key record)) '("ordinal" "uuid" "role" "origin" "author")))
                 (eq :false (gethash "decision" record))
                 (equal "not-published" (gethash "body" record))
                 (plusp (gethash "characters" record))
                 (or (null previous) (string< (gethash "timestamp" previous) (gethash "timestamp" record))))
      (refuse "Message order, speaker, origin or decision attribution differs")))
  records)

(defun read-conversation (&key (ctm (c:read-ctm-authoring)))
  "Fresh coordinate objects; reuse the checked Planning Case and the CTM reader.
No private source lookup, network fetch, source writing or authority grant."
  (let* ((file (evidence-file "coordinates.json")))
    (unless (equal +manifest-sha+ (p::file-digest file)) (refuse "Coordinate manifest changed"))
    (let* ((data (let ((shasht:*read-default-false-value* :false))
                   (shasht:read-json (uiop:read-file-string file :external-format :utf-8))))
           (records (validate-records (gethash "messages" data)))
           (session (make-instance 'conversation-session :id +session-id+ :ctm ctm
                                   :bindings (gethash "ctmBindings" data) :offline-check (gethash "offlineCheck" data)))
           (work (work:work-projection)))
      (setf (session-messages session)
            (map 'list (lambda (record) (make-instance 'conversation-message :session session :record record)) records))
      (dolist (subject (c::reading-subjects (session-ctm session)))
        (setf (gethash (c::subject-id subject) (session-subjects session)) subject))
      ;; Resolve stable Subjects independently of historical declaration revisions.
      ;; A changed declaration is STALE evidence, not an unidentified Subject.
      (maphash (lambda (id binding)
                 (unless (equal (source-key (subject-at session id))
                                (coerce (gethash "subjectKey" binding) 'list))
                   (refuse "CTM binding addresses a different Subject")))
               (session-bindings session))
      ;; Explicit reading context for backward navigation, also for fresh readings.
      (setf (c::reading-conversation-context (session-ctm session)) session)
      (dolist (id '("planning" "dogfooding" "conversation-coordinates" "collaborative-planning-case" "ctm-plan-page-authoring"))
        (setf (gethash id (session-subjects session))
              (change-class (tm:topicmap-projection-topic-by-id work id)
                            'conversation-work-topic :session session)))
      (dolist (id (cons "claude-review" (loop for n from 1 to 11 collect (format nil "F~D" n))))
        (setf (gethash id (session-subjects session)) (p::case-subject id)))
      (setf (gethash "original-report" (session-subjects session))
            (make-instance 'report-reference :record (gethash "report" data)))
      (let* ((path (asdf:system-relative-pathname "dreyeck/work/reading" "dreyeck/work/ctm-page-evidence/ctm-and-tmdm-in-hyperdoc.json"))
             (json (shasht:read-json (uiop:read-file-string path :external-format :utf-8)))
             (item (find "ed37e9bac2fcd548" (gethash "story" json) :key (lambda (item) (gethash "id" item)) :test #'equal)))
        (unless (and (equal (gethash "sha256" (gethash "e3" data)) (p::file-digest path))
                     (= 1 (count "ed37e9bac2fcd548" (gethash "story" json) :key (lambda (item) (gethash "id" item)) :test #'equal)))
          (refuse "Retained E3 source differs"))
        (setf (gethash "e3-evidence" (session-subjects session))
              (change-class (work:observe-work-fedwiki-item "localhost:3000" "ctm-and-tmdm-in-hyperdoc" item)
                            'conversation-item-observation :session session)))
      (setf (session-spans session)
            (loop for message in (session-messages session) for binding in +bindings+
                  collect (make-instance 'conversation-span :message message :page message :source nil
                                         :form-key (source-key message)
                                         :range (message-range message)
                                         :targets (nthcdr 5 binding))))
      (let ((text (subseq (p::document-text (p::case-subject "claude-review")) 1386 14103)))
        (unless (equal (text-sha text) (gethash "textSha256" (message-record (message-at session 2))))
          (refuse "Retained review text digest differs"))
        (verify-review-binding text))
      session)))

(defun validate-span (session span)
  (let* ((message (span-message span))
         (binding (assoc (message-number message) +bindings+)))
    (unless (and binding (eq span (span-at session (message-number message))) (eq message (message-at session (first binding)))
                 (equal (span-targets span) (nthcdr 5 binding))
                 (equal (occ:occurrence-range span) (message-range message))
                 (null (occ:occurrence-source span)))
      (refuse "Mutated span, source range or target binding")))
  span)

(defun relation-warrant (session from type to)
  "Closed role, warrant and source-binding contracts for EVERY introduced edge.
Imported Work/CTM/Planning relations retain their own existing contracts."
  (validate-records (map 'vector #'message-record (session-messages session)))
  (when (typep from 'conversation-span) (validate-span session from))
  (labels ((rule (from-role to-role evidence warrant &optional message status)
             (list :epistemic "derived" :from-role from-role :to-role to-role
                   :source-key evidence :binding-status (or status :current)
                   :attribution (if message (attribution message) "record-metadata")
                   :check-status (check-status-text session) :warrant warrant)))
    (cond
      ((and (equal type "has-message") (eq from session)
            (typep to 'conversation-message) (member to (session-messages session) :test #'eq))
       (rule "session" "selected-message" (source-key to)
             "Recorded selected membership; original transcript NOT-RUN here." to))
      ((and (equal type "has-span") (typep from 'conversation-message)
            (member from (session-messages session) :test #'eq)
            (typep to 'conversation-span) (eq from (span-message to))
            (eq to (span-at session (message-number from))))
       (validate-span session to)
       (rule "message" "evidence-span" (source-key to)
             "Recorded Unicode evidence range; body withheld." from))
      ((equal type "follows")
       (unless (and (member from (session-messages session) :test #'eq)
                    (member to (session-messages session) :test #'eq)
                    (> (message-number from) (message-number to))
                    (eq to (nth (max 0 (1- (position from (session-messages session)))) (session-messages session))))
         (refuse "follows requires consecutive SELECTED records in the same session"))
       (rule "later-selected-message" "earlier-selected-message" (list (source-key from) (source-key to))
             "Selected message order, not immediate parent adjacency or a reply assertion."))
      ((and (typep from 'conversation-span) (eq session (message-session (span-message from)))
            (member to (span-targets from) :test #'equal)
            (equal type (if (member (message-number (span-message from)) '(2 8)) "retained-as" "reports-observation")))
       (let ((target (subject-at session to)))
         (rule "message-evidence-span" "represented-subject" (source-key from)
               (if (equal type "retained-as")
                   "Recorded text identity; #2 retained substring checked here, #8 original identity NOT-RUN here. Hashes do not authenticate authorship."
                   "Reported observation; NOT a production observation, decision or authorization. Stale declaration evidence remains historical.")
               (span-message from) (when (typep target 'c::ctm-subject) (binding-status session target)))))
      ((and (equal type "source-evidence") (eq from (subject-at session "ctm-wp-1"))
            (eq to (subject-at session "e3-evidence")))
       (let* ((path (asdf:system-relative-pathname "dreyeck/work/reading" "dreyeck/work/ctm-page-evidence/ctm-and-tmdm-in-hyperdoc.json"))
              (page (shasht:read-json (uiop:read-file-string path :external-format :utf-8)))
              (item (find "ed37e9bac2fcd548" (gethash "story" page) :key (lambda (i) (gethash "id" i)) :test #'equal)))
         (unless (and (equal "localhost:3000" (work:fedwiki-item-observation-site to))
                      (equal "ctm-and-tmdm-in-hyperdoc" (work:fedwiki-item-observation-slug to))
                      (equal "ed37e9bac2fcd548" (work:fedwiki-item-observation-item-id to))
                      (work::%json-equal item (work:fedwiki-item-observation-item to)))
           (refuse "E3 observation differs from the retained local source")))
       (rule "work-result" "retained-local-observation" (source-key (span-at session 20))
             "Retained localhost:3000 copy checked here; equal bytes on dreyeck.ch only reported in #20, author not recorded."
             (message-at session 20) (binding-status session from)))
      (t (refuse "Unsupported conversation relation, roles or source binding")))))

(defun object-id (object)
  (typecase object
    (conversation-session "session")
    (conversation-message (format nil "message-~D" (message-number object)))
    (conversation-span (format nil "span-~D" (message-number (span-message object))))))
(defun conversation-projection (session)
  (let ((topics nil) (edges nil))
    (labels ((topic (id object label kind)
               (let ((n (length topics)))
                 (push (tm:make-topicmap-topic :id id :object object :label label :type :conversation-coordinate
                         :view-properties (list :kind kind :visible t :x (* 275 (mod n 4)) :y (* 105 (floor n 4)))) topics)))
             (edge (from type to properties)
               (push (tm:make-topicmap-association :id (format nil "conversation:~A:~A:~A" from type to)
                                                  :from from :to to :type type :properties properties) edges)))
      (topic "session" session "Conversation Session" "conversation source")
      (loop for message in (session-messages session) for span in (session-spans session)
            for index from 0
            for previous = (and (plusp index) (nth (1- index) (session-messages session))) do
        (topic (object-id message) message (v:text-representation message) "message coordinate")
        (topic (object-id span) span (v:text-representation span) "source span")
        (edge "session" "has-message" (object-id message) (relation-warrant session session "has-message" message))
        (edge (object-id message) "has-span" (object-id span) (relation-warrant session message "has-span" span))
        (when previous (edge (object-id message) "follows" (object-id previous) (relation-warrant session message "follows" previous)))
        (dolist (id (span-targets span))
          (let ((type (if (member (message-number message) '(2 8)) "retained-as" "reports-observation")))
            (edge (object-id span) type id (append (list :conversation-span span) (relation-warrant session span type id))))))
      ;; Reuse the CTM projection's existing relations, including P1 -> WP1.
      (let ((ctm (c:ctm-authoring-projection (session-ctm session))))
        (dolist (tpc (tm:topicmap-projection-topics-of ctm))
          (push tpc topics))
        (setf edges (append (reverse (tm:topicmap-projection-associations-of ctm)) edges)))
      (dolist (id '("planning" "dogfooding" "conversation-coordinates" "collaborative-planning-case" "ctm-plan-page-authoring" "claude-review" "original-report" "e3-evidence"))
        (let ((object (subject-at session id)))
          (topic id object (if (typep object 'tm:topicmap-topic) (tm:topicmap-topic-label-of object) (v:text-representation object)) "existing subject or evidence")))
      (dolist (e (tm:topicmap-projection-associations-of (work:work-projection)))
        (when (and (find (tm:topicmap-association-from-of e) topics :key #'tm:topicmap-topic-id-of :test #'equal)
                   (find (tm:topicmap-association-to-of e) topics :key #'tm:topicmap-topic-id-of :test #'equal))
          (push e edges)))
      ;; Import the already checked review finding Topics/Associations verbatim.
      (let ((planning (p::collaborative-planning-projection)))
        (loop for n from 1 to 11 for id = (format nil "F~D" n) do
          (push (tm:topicmap-projection-topic-by-id planning id) topics))
        (dolist (e (tm:topicmap-projection-associations-of planning))
          (when (and (equal "claude-review" (tm:topicmap-association-from-of e))
                     (equal "contains" (tm:topicmap-association-type-of e))) (push e edges))))
      (edge "ctm-wp-1" "source-evidence" "e3-evidence"
            (relation-warrant session (subject-at session "ctm-wp-1") "source-evidence" (subject-at session "e3-evidence")))
      ;; Layout belongs to this projection, not to the reused source projections.
      ;; Keep identities and represented objects; copy only presentation carriers.
      (tm:make-topicmap-projection
       :source session
       :topics (loop for old in (nreverse topics) for n from 0
                     for properties = (copy-list (tm:topicmap-topic-view-properties-of old))
                     do (setf (getf properties :x) (* 275 (mod n 4))
                              (getf properties :y) (* 105 (floor n 4)))
                     collect (tm:make-topicmap-topic :id (tm:topicmap-topic-id-of old)
                              :object (tm:topicmap-topic-object-of old) :label (tm:topicmap-topic-label-of old)
                              :type (tm:topicmap-topic-type-of old) :view-properties properties))
       :associations (nreverse edges) :view-properties '(:width 1180 :height 760)))))
(defmethod tm:topicmap-projection-of ((session conversation-session)) (conversation-projection session))
(defun workspace-of (session)
  (or (session-workspace session)
      (setf (session-workspace session) (tm:make-topicmap-workspace (conversation-projection session) "session"))))
(hyperdoc:defexample conversation-workspace
  "Inspect selected source coordinates in a native Workspace; private bodies remain absent."
  (workspace-of (conversation)))

(defun ref (object &optional label select)
  (v:html (v:object-ref object :display (or label (v:text-representation object)) :select select)))
(defun session-links (session)
  (v:html (:p (ref session "Conversation Session" "Chronology") " / "
              (ref (workspace-of session) "Conversation Workspace" "Topicmap") " / "
              (ref (work:work-page "Conversation Coordinates") "Reading page" "Content"))))
(v:defview conversation-chronology (session conversation-session)
  (v:html-view :title "Chronology" :priority -1
    (v:html (:h2 "Conversation chronology")
      (:p "Four selected Claude-Code records; gaps are intentional. These UUIDs are not ChatGPT message IDs. Cursor and Workspace Point are independent.")
      (:p (v:esc (check-status-text session)))
      (:ol (dolist (message (session-messages session))
             (v:html (:li (ref message nil "Message coordinates") " — "
                          (v:esc (gethash "timestamp" (message-record message)))))))
      (:p "Cursor: " (ref (selected-message session) nil "Message coordinates"))
      (:p (v:action-button "Previous selected message" (dreyeck/authority-policy:reviewed-thunk "conversation/select-message" (select-message session (1- (session-cursor session)))))
          " " (v:action-button "Next selected message" (dreyeck/authority-policy:reviewed-thunk "conversation/select-message" (select-message session (1+ (session-cursor session))))))
      (session-links session))))
(v:defview message-coordinates (message conversation-message)
  (v:html-view :title "Message coordinates" :priority -1
    (v:html (:h2 (v:esc (v:text-representation message)))
      (:p "Original message body: not published. No summary is presented as its original text.")
      (:table :class "inspector-table"
        (dolist (key '("sessionId" "uuid" "parentUuid" "timestamp" "role" "origin" "author" "lineOrdinal" "lineSha256" "textSha256" "characters" "octets"))
          (v:html (:tr (:td (v:esc key)) (:td (v:esc (princ-to-string (gethash key (message-record message)))))))))
      (:p (v:esc (check-status-text (message-session message)
                      (if (= 2 (message-number message)) "checked here: retained #2 substring digest and F1-F11 offsets. Original transcript NOT-RUN." "NOT-RUN: original record and #8 local report identity here."))))
      (:p "Role is the transcript envelope. Pasted authorship is not recorded. No user decision or execution authority is asserted.")
      (:p (ref (span-at (message-session message) (message-number message)) nil "Source span"))
      (session-links (message-session message)))))
(v:defview conversation-source-span (span conversation-span)
  (v:html-view :title "Source span" :priority -1
    (let ((session (message-session (span-message span))))
      (v:html (:h2 (v:esc (v:text-representation span)))
        (:p (v:esc (format nil "Unicode characters [~D, ~D); stable source key ~S. Body not published; source-occurrence status :BODY-NOT-PUBLISHED."
                           (car (occ:occurrence-range span)) (cdr (occ:occurrence-range span)) (source-key span))))
        (:p (v:esc (check-status-text session)))
        (:p (ref (span-message span) nil "Message coordinates"))
        (:ul (dolist (id (span-targets span))
               (let* ((type (if (member (message-number (span-message span)) '(2 8)) "retained-as" "reports-observation"))
                      (rule (relation-warrant session span type id)))
                 (v:html (:li (ref (subject-at session id) id)
                              (v:esc (format nil " — ~A; ~A; ~A. ~A" type (getf rule :epistemic) (getf rule :attribution) (getf rule :warrant))))))))
        (session-links session)))))

(defun render-ctm-sources (subject)
  (let* ((session (or (c::reading-conversation-context (c::subject-reading subject)) (conversation)))
         (id (c::subject-id subject)))
    (v:html (:h2 (v:esc (format nil "Conversation sources: ~A" id)))
      (:p (v:esc (format nil "Evidence binding: ~(~A~). Subject key ~S. Current declaration ~S. Historical declaration range ~S, digest ~A; historical page revision ~A."
                          (binding-status session subject) (source-key subject) (declaration-observation subject)
                          (gethash "declarationRange" (gethash id (session-bindings session)))
                          (gethash "declarationSha256" (gethash id (session-bindings session)))
                          (gethash "pageSha256" (gethash id (session-bindings session))))))
      (:p (v:esc (check-status-text session)))
      (:p "Reports of observations, not user decisions or authorizations. A stale binding describes historical evidence; it does not verify the current declaration.")
      (dolist (span (session-spans session))
        (when (member id (span-targets span) :test #'equal)
          (v:html (:p (ref span nil "Source span") " / " (ref (span-message span) nil "Message coordinates")))))
      (when (equal id "ctm-wp-1")
        (v:html (:p (ref (subject-at session "e3-evidence") "E3 source evidence" "Conversation E3 evidence"))))
      (:p (ref (make-instance 'c::ctm-plan :reading (session-ctm session)) "CTM Plan" "Plan steps") " / "
          (ref (make-instance 'c::ctm-wbs :reading (session-ctm session)) "CTM WBS" "WBS"))
      (session-links session))))
(defun occurrence-snapshot (subject)
  (let ((occurrence (work:topic-source-occurrence (c::subject-topic subject))))
    (list (work:topic-occurrence-snapshot occurrence) (work:topic-occurrence-element-range occurrence))))
(v:defview ctm-conversation-sources (subject c::ctm-subject)
  (when (member (c::subject-id subject) '("ctm-plan-p1" "ctm-wp-1" "ctm-pre-transfer") :test #'equal)
    (v:html-view :title "Conversation sources" :priority 1 (render-ctm-sources subject))))
(v:defview conversation-e3-evidence (observation conversation-item-observation)
  (when (and (equal "localhost:3000" (work:fedwiki-item-observation-site observation))
             (equal "ctm-and-tmdm-in-hyperdoc" (work:fedwiki-item-observation-slug observation))
             (equal "ed37e9bac2fcd548" (work:fedwiki-item-observation-item-id observation)))
    (v:html-view :title "Conversation E3 evidence" :priority -1
      (v:html (:h2 "E3 source evidence")
        (:p "checked here: retained local localhost:3000 copy digest and E3 item identity. Equal bytes on dreyeck.ch were reported in Message #20 (session-user envelope; author not-recorded). Production check: NOT-RUN here.")
        (:p "Page SHA-256: d7215c50f4efa07b3e94749b060b7d7b828654f2a44caab7f1034415c6003dff")
        (:pre :style "white-space:pre-wrap;overflow-wrap:anywhere"
              (v:esc (gethash "text" (work:fedwiki-item-observation-item observation))))
        (:p (ref (work:fedwiki-item-observation-item observation) "Whole retained Story Item"))
        (:p (ref (span-at (observation-session observation) 20) "Source span #20" "Source span"))))))
(v:defview public-report-reference (report report-reference)
  (v:html-view :title "Report source" :priority -1
    (let ((record (report-record report)))
      (v:html (:h2 "CTM/TMDM original report")
        (:p "Local farm source at localhost:3000; text not copied into this slice. Identity with Message #8: NOT-RUN here; recorded offline PASS (2026-10-16; Codex local source verification). Public reachability: recorded offline FAIL, HTTP 404 (2026-10-16; Claude independent review 1a22c33a-59b8-4eec-bb15-dca10d671e82); NOT-RUN here. The recorded URL is a historical locator, not a verified public source.")
        (:p (v:esc (gethash "url" record)))
        (:p (v:esc (format nil "Item ~A; UTF-8 [0, ~D); text SHA-256 ~A."
                           (gethash "itemId" record) (gethash "octets" record) (gethash "sha256" record))))))))
(v:defview review-message-findings (document p::planning-document-version)
  (when (equal "claude-review" (p::subject-id document))
    (v:html-view :title "Conversation findings" :priority 1
      (v:html (:h2 "Review in Message #2")
        (:p "Retained document [1386,14103) equals Message #2; existing finding coordinates map by -1386 Unicode characters.")
        (:ul (loop for n from 1 to 11 do (v:html (:li (ref (p::case-subject (format nil "F~D" n)) (format nil "F~D" n) "Planning evidence")))))
        (:p (ref (p::planning-case) "collaborative-planning-case" "Planning case"))))))

(v:defview work-conversation-sources (topic work:work-topic)
  (when (member (tm:topicmap-topic-id-of topic)
                '("conversation-coordinates" "ctm-plan-page-authoring" "collaborative-planning-case") :test #'equal)
    (v:html-view :title "Conversation sources" :priority 1000
      (let* ((session (if (typep topic 'conversation-work-topic) (topic-session topic) (conversation)))
             (numbers (cond ((equal (tm:topicmap-topic-id-of topic) "collaborative-planning-case") '(2))
                            ((equal (tm:topicmap-topic-id-of topic) "ctm-plan-page-authoring") '(16 20))
                            (t '(2 8 16 20)))))
        (v:html (:h2 "Conversation sources")
          (dolist (number numbers)
            (v:html (:p (ref (message-at session number) nil "Message coordinates") " / "
                        (ref (span-at session number) nil "Source span"))))
          (session-links session))))))
