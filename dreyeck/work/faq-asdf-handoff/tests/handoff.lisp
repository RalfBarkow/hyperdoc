(in-package #:faq-asdf-handoff)

(defvar *checks* 0)

(defmacro check (form)
  `(progn (assert ,form) (incf *checks*)))

(defun tab-line (&rest fields)
  (format nil (concatenate 'string "~{~A~^" (string #\Tab) "~}~%") fields))

(defparameter +store-probe+ "/nix/store/00000000000000000000000000000000-faq-probe/package.fasl")
(defparameter +salza2+ "/nix/store/sl2w45plgmshgj1q7fb77bcpqqi4h6wv-sbcl-salza2-2.1/")

(defun sample-run (&key (c4 "1") (with-nil (concatenate 'string +salza2+ "package.fasl"))
                        (restore-exit "0") (c6 "2"))
  "Lines as run-checks.sh printed them on x86_64-linux for the unprivileged user."
  (let ((cache "/tmp/t/~A/.cache/common-lisp/sbcl-2.4.10-linux-x64")
        (fasl (concatenate 'string +salza2+ "package.fasl")))
    (concatenate
     'string
     (tab-line "PLATFORM" "Linux-x86_64") (tab-line "SBCL" "SBCL 2.4.10")
     (tab-line "CASE" "C1" "0" (format nil "~@?~A" cache "C1" +store-probe+) "PASS: destination is outside the store and can be created.")
     (tab-line "CASE" "C2" "0" fasl "PASS prebuilt: …")
     (tab-line "CASE" "C3" "0" fasl "PASS prebuilt: …")
     (tab-line "CASE" "C4" c4 +store-probe+ "FAIL store-destination: …")
     (tab-line "CASE" "C5" "1" (concatenate 'string +salza2+ "no-such-file.fasl") "FAIL store-destination: …")
     (if (equal c6 "skipped")
         (tab-line "CASE" "C6" "skipped" "-" "root could create /nonexistent")
         (tab-line "CASE" "C6" c6 (concatenate 'string "/nonexistent/.cache/common-lisp/sbcl-2.4.10-linux-x64" +store-probe+) "FAIL not-creatable: …"))
     (tab-line "CASE" "C7" "0" (format nil "~@?~A" cache "C7" +store-probe+) "PASS read-only: …")
     (tab-line "CREATED" "C7" "0")
     (tab-line "CASE" "C8" "3" "-" "FAIL not-found: system or component not found.")
     (tab-line "CASE" "C9" "0" "/tmp/t/C9/.cache/asdf-nix-store/00000000000000000000000000000000-faq-probe/package.fasl" "PASS: …")
     (tab-line "CASE" "C10" "0" fasl "PASS prebuilt: …")
     (tab-line "CASE" "C11" "0" (format nil "~@?~A" cache "C11" "/nix/store/r40b3p08hidpxcf6cvdhfazlvlig1dyn-source/shop3/package.fasl") "PASS: …")
     (tab-line "RESTORE" "wrapper" fasl)
     (tab-line "RESTORE" "override" (format nil "~@?~A" cache "restore" fasl))
     (tab-line "RESTORE" "without-argument" (format nil "~@?~A" cache "restore" fasl))
     (tab-line "RESTORE" "with-nil" with-nil)
     (if restore-exit (tab-line "RESTORE-EXIT" restore-exit) ""))))

(defun test-runner-lines ()
  (let ((parsed (parse-runner-output (sample-run))))
    (check (equal "Linux-x86_64" (getf parsed :platform)))
    (check (= 11 (length (getf parsed :cases))))
    (check (= 4 (length (getf parsed :restore))))
    (check (null (deviations parsed))))
  (check (null (deviations (parse-runner-output (sample-run :c6 "skipped")))))
  (check (equal '("C4") (mapcar #'first (deviations (parse-runner-output (sample-run :c4 "0"))))))
  (check (equal '("with-nil")
                (mapcar #'first (deviations (parse-runner-output
                                             (sample-run :with-nil "/tmp/t/restore/.cache/common-lisp/x.fasl"))))))
  (check (equal '("restore-probe") (mapcar #'first (deviations (parse-runner-output (sample-run :restore-exit nil))))))
  (check (eq :none (destination-kind "-")))
  (check (eq :fix-a (destination-kind "/Users/u/.cache/asdf-nix-store/x.fasl"))))

(defun test-plan ()
  (let ((handoff (make-handoff :repository (uiop:temporary-directory))))
    (dolist (step '(:bind-revision :check-asdf :mac-live :mac-fresh :hand-over))
      (check (eq step (offered-step (plan-next handoff))))
      (push (list step) (observations handoff)))
    (check (null (offered-step (plan-next handoff))))
    (check (eq :plan-only (dreyeck/shop3:execution-mode-of (plan-next handoff)))))
  (let ((handoff (make-handoff :repository (uiop:temporary-directory))))
    (play-step handoff :check-asdf)
    (check (null (observations handoff)))
    (check (search "veraltet" (message-of handoff)))))

(defun test-topics ()
  (check (= 4 (length (topic-paths))))
  (check (every #'probe-file (topic-paths)))
  (dolist (step '(:bind-revision :check-asdf :mac-live :mac-fresh :hand-over))
    (multiple-value-bind (path root node) (topic-of-step step)
      (check (and path node (equal "task" (plump:tag-name root))))
      (check (plusp (length (plump:get-elements-by-tag-name node "codeblock"))))))
  (let* ((book (make-instance 'handoff-book :id +book-id+))
         (page (attach-task-page book (make-handoff :repository (uiop:temporary-directory))))
         (view (find "DITA Task" (v:all-views page) :key #'v:view-title :test #'equal)))
    (check (eq page (hb:lookup-path book (list (hb:path-item-of page)))))
    (check (and view (search "Revision binden" (v:view-html view)) (search "Play" (v:view-html view))))))

(defun test-bind-revision ()
  (let ((fixture (uiop:ensure-directory-pathname
                  (uiop:run-program '("mktemp" "-d" "/tmp/faq-handoff-test.XXXXXXXX")
                                    :output '(:string :stripped t))))
        (source (default-repository)))
    (labels ((run (&rest arguments) (git:trim-git-output (apply #'git:git-run-string fixture arguments)))
             (copy (name) (let ((to (merge-pathnames name fixture)))
                            (ensure-directories-exist to)
                            (uiop:copy-file (merge-pathnames name source) to))))
      (unwind-protect
           (progn
             (run "init" "--quiet")
             (run "config" "user.email" "fixture@example.invalid")
             (run "config" "user.name" "FAQ handoff fixture")
             (copy "flake.lock")
             (dolist (file +handoff-files+)
               (copy (concatenate 'string +handoff-directory+ (first file))))
             (run "add" ".")
             (run "commit" "--quiet" "--no-gpg-sign" "-m" "fixture")
             (let* ((commit (run "rev-parse" "HEAD"))
                    (handoff (make-handoff :repository fixture)))
               (let ((+handoff-commit+ commit))
                 (let ((evidence (bind-revision handoff)))
                   (check (equal commit (getf evidence :revision)))
                   (check (eq t (getf evidence :clean)))
                   (check (equal +nixpkgs-revision+ (getf evidence :nixpkgs))))
                 (with-open-file (stream (merge-pathnames (concatenate 'string +handoff-directory+ "HANDOVER.md") fixture)
                                         :direction :output :if-exists :append)
                   (write-line "changed" stream))
                 (check (search "HANDOVER.md" (handler-case (progn (bind-revision handoff) "")
                                                (error (condition) (princ-to-string condition))))))
               (let ((+handoff-commit+ "0000000000000000000000000000000000000000"))
                 (check (search "fehlt" (handler-case (progn (bind-revision handoff) "")
                                          (error (condition) (princ-to-string condition))))))))
        (uiop:delete-directory-tree fixture :validate t)))))

(defun test-this-checkout ()
  "The checkout the system was loaded from binds, if it holds the handoff commit (not a shallow clone)."
  (let ((handoff (make-handoff)))
    (if (zerop (git-exit handoff "cat-file" "-e" (format nil "~A^{commit}" +handoff-commit+)))
        (check (equal (git-output handoff "rev-parse" "HEAD") (getf (bind-revision handoff) :revision)))
        (format t "~&faq-asdf-handoff: handoff commit absent in this checkout; its binding is not checked.~%"))))

(defun run-tests ()
  (let ((*checks* 0))
    (test-runner-lines)
    (test-plan)
    (test-topics)
    (test-bind-revision)
    (test-this-checkout)
    (format t "~&faq-asdf-handoff: ~D checks passed.~%" *checks*)
    *checks*))
