(in-package #:codepath-review)

(defvar *checks* 0)
(defmacro check (form) `(progn (assert ,form () "Failed: ~S" ',form) (incf *checks*)))

(defun fixture-analysis ()
  (let ((*excluded-package-prefixes* (remove "CPR-FIXTURE" *excluded-package-prefixes* :test #'string=))
        (*extra-source-files* (list (namestring (asdf:system-relative-pathname "codepath-review" "tests/fixture.lisp")))))
    (analyze)))

(defun fx (name) (find-symbol (string name) '#:cpr-fixture))
(defun fx-status (analysis name) (let ((n (find-node analysis (fx name)))) (and n (node-status n))))

(defun test-fixture-paths ()
  (let ((a (fixture-analysis)))
    (check (eq :open (fx-status a "FX-OPEN-SINK")))
    (check (eq :uncovered (fx-status a "FX-ENTRY")))
    (check (eq :guarded (fx-status a "FX-GUARDED-SINK")))
    (check (eq :xref (node-guard (find-node a (fx "FX-GUARDED-SINK")))))
    ;; A guard reached through SYMBOL-CALL is invisible to xref and must not be reported as missing.
    (check (eq :guarded (fx-status a "FX-TEXT-GUARDED-SINK")))
    (check (eq :text (node-guard (find-node a (fx "FX-TEXT-GUARDED-SINK")))))
    (check (eq :protected (fx-status a "FX-PROTECTED-SINK")))
    (check (eq :guarded (fx-status a "FX-GUARDED-CALLER")))
    (check (eq :no-caller (fx-status a "FX-LONELY-SINK")))
    ;; A docstring that names a function is a text edge; it shows in the map but does not decide the status.
    (check (find-if (lambda (e) (and (eq (edge-via e) :text) (equal (edge-from e) (fx "FX-DOC-MENTIONER"))
                                     (equal (edge-to e) (fx "FX-LONELY-SINK"))))
                    (analysis-edges a)))
    (check (eq :to-read (fx-status a "FX-DOC-MENTIONER")))
    ;; A command line for another process is found only in the text, and still becomes a sink.
    (check (eq :text-sink (node-role (find-node a (fx "FX-COMMAND-LINE")))))
    (check (find (list (fx "FX-ENTRY") (fx "FX-OPEN-SINK")) (analysis-edges a)
                 :test (lambda (pair e) (and (equal (first pair) (edge-from e)) (equal (second pair) (edge-to e))))))))

(defun test-default-exclusion ()
  (let ((a (analyze)))
    (check (notany (lambda (n) (let ((name (node-name n)))
                                 (and (symbolp name) (member (package-name (symbol-package name)) '("CPR-FIXTURE" "CODEPATH-REVIEW") :test #'string=))))
                   (analysis-nodes a)))
    a))

(defun test-this-image (a)
  "The three guarded places of the Lisp Critic, where this image has them."
  (flet ((status (package name)
           (let* ((p (find-package package)) (s (and p (find-symbol name p))) (n (and s (find-node a s))))
             (and n (node-status n)))))
    (if (find-package "DREYECK/LISP-CRITIC/READING")
        (progn (check (eq :guarded (status "DREYECK/LISP-CRITIC" "%LOAD-LISP-CRITIC-SOURCE-STATION")))
               (check (eq :guarded (status "DREYECK/LISP-CRITIC/READING" "%WRAPPER-SYSTEM-OBSERVATION")))
               (check (member (status "DREYECK/LISP-CRITIC/READING" "WITH-ENGINE-ASSETS-REGISTERED") '(:guarded :protected))))
        (format t "~&codepath-review: Lisp Critic not loaded, image checks skipped.~%"))))

(defun test-pages (a)
  (let* ((*analysis* a)
         (book (make-instance 'codepath-book :id +book-id+))
         (graph (make-instance 'call-graph :analysis a))
         (projection (dreyeck/topicmap:topicmap-projection-of graph)))
    (check (= (length (analysis-nodes a)) (length (dreyeck/topicmap:topicmap-projection-topics-of projection))))
    (check (= (length (analysis-edges a)) (length (dreyeck/topicmap:topicmap-projection-associations-of projection))))
    (dolist (entry +pages+)
      (let* ((page (hb:find-page book (first entry) :signal-error? t))
             (views (v:all-views page))
             (html (and views (v:view-html (first views)))))
        (check (and html (plusp (length html))))
        (check (not (search "dita-unsupported" html)))))
    (let ((code (v:view-html (first (v:all-views (hb:find-page book "sinks" :signal-error? t))))))
      (check (search "(defun" code)))
    (check (search "Play" (v:view-html (first (v:all-views (hb:find-page book "overview" :signal-error? t))))))
    (check (= (length +pages+) (length (page-paths book))))))

(defun test-configured-port ()
  "The port comes from the Catalog application's configuration: its variable, else its own default."
  (check (= 18999 (configured-port (lambda (name) (and (equal name "HYPERDOC_CATALOG_PORT") "18999")))))
  (let ((default (configured-port (constantly nil))))
    (check (and (integerp default) (<= 1 default 65535)))
    (check (= default (getf (uiop:symbol-call "DREYECK/CATALOG-APPLICATION" "%CONFIGURATION" nil (constantly nil)) :port)))))

(defun run-tests ()
  (let ((*checks* 0))
    (test-configured-port)
    (test-fixture-paths)
    (let ((a (test-default-exclusion)))
      (test-this-image a)
      (test-pages a))
    (format t "~&codepath-review: ~D checks passed.~%" *checks*)
    *checks*))
