# HyperDoc project work: a CTM Topic Map derived from the HyperDoc Work pages.
# Derived, not a source. The pages listed below stay authoritative for what they declare; a change belongs there.
# Do not edit by hand. Regenerate with (dreyeck/work/project:write-project-ctm); emitter version 2.
# Read it with the Document IRI tag:dreyeck.ch,2026:hyperdoc/project.ctm. Every Topic has a subject identifier, so no identity depends on it.
# Sources, by repository path and the SHA-256 of the octets read:
#   dreyeck/pages/work/Work Breakdown.html  a7dc3d53a1a7312e6feba2350bde7251c222b2acd321ef5a109116f5cf616e13
#   dreyeck/pages/work/Authoring the CTM Plan Page.html  fced413ad5e893e49973df1fa8fb5ca14dee87695c50100e72ddd12d4d2de75a
#   dreyeck/pages/work/CTM Plan Page WBS Dictionary.html  de3f372912e0a257a85990686fdcd354f79481af7aecb1ecc5d1ffb171e9d9b5
#   dreyeck/pages/project/Implementation Assignments.html  059d90d04472ae5bc0975491106aa896f12989af7bfa17cf1c0d32d192984ce6
# Other files read: the test files WBS Dictionary controls name, to derive test marker found:
#   dreyeck/tests/fedwiki-page-authoring.lisp  0fcd02078576bde7a0438620797ea30c805900201ac443b8bc20ac8b146671d1
#   dreyeck/tests/fedwiki-item-edit-execution.lisp  d215e10c48f94b401248d60e7c8fe95db5c693ea8a489f60b368c7f8102c755d
# No other file is read. A file an assignment names is written by its path only; this document holds no digest of itself.
# Identity: tag: IRIs under tag:dreyeck.ch,2026:hyperdoc/ that name and do not locate; see dreyeck/work/project/project-ctm.lisp.
# Provenance is in declared-on, proposed-on and stated-on; work status is the occurrence work-status; no scope is used.

%prefix s <tag:dreyeck.ch,2026:hyperdoc/schema/>
%prefix w <tag:dreyeck.ch,2026:hyperdoc/work/topic/>

# Schema: the types, Role types and Occurrence types of this document

s:hyperbook
    - "HyperBook" ;
    s:description: "A HyperBook of the HyperDoc Catalog." .

s:hyperdoc-page
    - "HyperDoc page" ;
    s:description: "A page of a HyperBook. Its id in the HyperBook is the occurrence page-id." .

s:repository-file
    - "Repository file" ;
    s:description: "A file of the HyperDoc repository, named by its repository path." .

s:authored-statement
    - "Authored statement" ;
    s:description: "One <li data-from data-relation data-to> on a Work page. It reifies the Association it states." .

s:proposed-statement
    - "Proposed statement" ;
    s:description: "One proposed relation on the page Implementation Assignments. It is not declared." .

s:planned-control
    - "Planned control" ;
    s:description: "A control a WBS Dictionary entry lists for its work package." .

s:implementation-assignment
    - "Implementation assignment" ;
    s:description: "An assignment given to Claude Code, as recorded on the page Implementation Assignments." .

s:plan-gap
    - "Plan gap" ;
    s:description: "Derived by the emitter from the sources by a stated rule: where the declarations do not say enough. A gap states no relation of the Work." .

s:relation-word
    - "Relation word" ;
    s:description: "A relation written as a plain word, which no Relation Contract defines." .

s:declared-on
    - "declared on" ;
    s:description: "The source page declares the Work Topic: a data-topic declaration. Provenance, not a Work relation." .

s:proposed-on
    - "proposed on" ;
    s:description: "The page Implementation Assignments proposes the Topic or statement. Nothing is declared." .

s:stated-on
    - "stated on" ;
    s:description: "The source page states the authored statement." .

s:carried-by
    - "carried by" ;
    s:description: "The declaration names this page as its carrier (the attribute page). Not a Work relation." .

s:contains-page
    - "contains page" ;
    s:description: "The HyperBook has the page." .

s:defined-in-dictionary
    - "defined in dictionary" ;
    s:description: "The WBS Dictionary has an entry for the work package." .

s:planned-control-of
    - "planned control of" ;
    s:description: "The WBS Dictionary entry of the work package lists the control." .

s:exercised-by
    - "exercised by" ;
    s:description: "The control names a test file that exercises it (coverage existing)." .

s:gap-concerns
    - "gap concerns" ;
    s:description: "The derived gap concerns the Topic." .

s:assignment-for
    - "assignment for" ;
    s:description: "The assignment names the Work Item it serves." .

s:assignment-delivers
    - "assignment delivers" ;
    s:description: "The assignment names the work package it delivers." .

s:reads-source
    - "reads source" ;
    s:description: "The assignment reads this source authority." .

s:changes-source
    - "changes source" ;
    s:description: "The assignment adds or changes this file." .

s:evidenced-by-test
    - "evidenced by test" ;
    s:description: "The assignment names this test as its evidence." .

