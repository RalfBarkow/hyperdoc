<tag:dreyeck.ch,2026:hyperdoc/control/ctm-wp-1/site-root-slug-item>
    isa s:planned-control ;
    - "site-root-slug-item" ;
    s:declaration-text: "Correct site root, slug and Item id: an invalid slug and an absent Item id are refused." ;
    s:control-coverage: "existing" ;
    s:test-marker: "(refused :absent-id" ;
    s:test-marker-found: "yes" .

<tag:dreyeck.ch,2026:hyperdoc/file/dreyeck/tests/fedwiki-page-authoring.lisp>
    isa s:repository-file ;
    - "dreyeck/tests/fedwiki-page-authoring.lisp" ;
    s:repository-path: "dreyeck/tests/fedwiki-page-authoring.lisp" ;
    s:source-sha256: "0fcd02078576bde7a0438620797ea30c805900201ac443b8bc20ac8b146671d1" .

<tag:dreyeck.ch,2026:hyperdoc/control/ctm-wp-2/exactly-one-item>
    isa s:planned-control ;
    - "exactly-one-item" ;
    s:declaration-text: "Change at exactly one Item: an Item id that occurs more than once is refused." ;
    s:control-coverage: "existing" ;
    s:test-marker: "(refused :duplicate-id" ;
    s:test-marker-found: "yes" .

<tag:dreyeck.ch,2026:hyperdoc/control/ctm-wp-3/no-execution-without-authority>
    isa s:planned-control ;
