(in-package #:site-observation)

(defvar *checks* 0)
(defmacro check (form) `(progn (assert ,form) (incf *checks*)))

(defun observation (&rest overrides)
  (let ((base (list :time (get-universal-time) :status "200" :http "2" :expires "Feb 11 22:10:11 2027 GMT"
                    :wiki "0.41.1" :dialog-fix t)))
    (loop for (k v) on overrides by #'cddr do (setf (getf base k) v))
    base))

(defun test-deviations ()
  (let ((wiki (find-site :wiki-ralfbarkow-ch)) (catalog (find-site :dreyeck-ch)))
    (check (null (deviations wiki (observation))))
    (check (null (deviations wiki (observation :wiki "0.42.0"))))
    (check (equal '(:wiki) (mapcar #'first (deviations wiki (observation :wiki "0.39.2")))))
    (check (equal '(:dialog-fix) (mapcar #'first (deviations wiki (observation :dialog-fix nil)))))
    (check (equal '(:status :http) (mapcar #'first (deviations wiki (observation :status "502" :http "1.1")))))
    (check (equal '(:certificate) (mapcar #'first (deviations wiki (observation :expires nil)))))
    (check (null (deviations catalog (list :status "200" :http "2" :expires "x" :catalog t))))
    (check (equal '(:catalog) (mapcar #'first (deviations catalog (list :status "200" :http "2" :expires "x")))))
    (check (null (deviations wiki (observation :wiki :unverified))))
    (check (version>= "0.41.10" "0.41.1"))
    (check (not (version>= "0.41.0-rc.3" "0.41.1")))
    (check (equal "0.41.1" (wiki-version "{\"wiki\":\"0.41.1\"}")))
    (check (null (wiki-version "Not Found")))))

(defun test-plan ()
  (let ((*sites* (list (make-site :a "a.example" "a.example" :fedwiki)
                       (make-site :b "b.example" "b.example" :fedwiki))))
    (check (equal '(:a :b) (sort (copy-list (offered-sites (plan-next))) #'string<)))
    (push (observation) (observations-of (first *sites*)))
    (check (equal '(:b) (offered-sites (plan-next))))
    (push (observation) (observations-of (second *sites*)))
    (check (null (offered-sites (plan-next))))
    (push (observation :time (- (get-universal-time) (* 2 *max-age-seconds*))) (observations-of (second *sites*)))
    (check (equal '(:b) (offered-sites (plan-next))))
    (push (observation :wiki "0.39.2" :deviations '((:wiki "0.39.2"))) (observations-of (first *sites*)))
    (check (equal '(:a :b) (sort (copy-list (offered-sites (plan-next))) #'string<)))
    (check (eq :plan-only (dreyeck/shop3:execution-mode-of (plan-next))))
    (let ((view (find "Read the Plan" (v:all-views (plan-next)) :key #'v:view-title :test #'equal)))
      (check (and view (search "Alternative 1" (v:view-html view)) (search "OFFER" (v:view-html view)))))))

(defun test-views ()
  (let* ((book (make-instance 'observation-book :id +book-id+))
         (overview (hb:find-page book "overview" :signal-error? t))
         (page (hb:find-page book "dreyeck-ch" :signal-error? t))
         (view (find "Beobachtung" (v:all-views page) :key #'v:view-title :test #'equal)))
    (check (typep overview 'overview-page))
    (check (equal "dreyeck.ch" (machine-of page)))
    (check (find "Übersicht" (v:all-views overview) :key #'v:view-title :test #'equal))
    (check (and view (search "hyperdoc.dreyeck.ch" (v:view-html view)) (search "Play" (v:view-html view))))
    (check (= 3 (count "dreyeck.ch" *sites* :key #'site-machine :test #'equal)))))

(defun test-page-copy ()
  "Attach the system with the script into a scratch site and check SOURCE and SHA256SUMS."
  (let* ((site (uiop:ensure-directory-pathname
                (uiop:run-program '("mktemp" "-d") :output '(:string :stripped t))))
         (top (uiop:ensure-directory-pathname
               (uiop:run-program (list "git" "-C" (namestring (system-directory)) "rev-parse" "--show-toplevel")
                                 :output '(:string :stripped t))))
         (commit (uiop:run-program (list "git" "-C" (namestring top) "rev-parse" "HEAD")
                                   :output '(:string :stripped t)))
         (copy (merge-pathnames "assets/pages/site-observation/" site)))
    (unwind-protect
         (progn
           (ensure-directories-exist (merge-pathnames "pages/" site))
           (uiop:run-program (list "bash" "scripts/attach-page-system.sh" "dreyeck/work/site-observation"
                                   "site-observation" (namestring site))
                             :directory top :output nil)
           (let ((state (source-state copy)))
             (check (eq :page-copy (getf state :origin)))
             (check (equal commit (getf state :commit)))
             (check (getf state :intact)))
           (with-open-file (s (merge-pathnames "observe-site.dita" copy) :direction :output :if-exists :append)
             (write-line "<!-- edited -->" s))
           (let ((state (source-state copy)))
             (check (not (getf state :intact)))
             (check (equal '("observe-site.dita") (getf state :changed))))
           (check (eq :repository-checkout (getf (source-state) :origin))))
      (uiop:delete-directory-tree site :validate t))))

(defun test-catalog-route ()
  "Without CLOG running, ENSURE-CATALOG-ROUTE refuses instead of starting a server."
  (unless (clog:is-running-p)
    (check (nth-value 1 (ignore-errors (ensure-catalog-route))))))

(defun lsof-available-p ()
  (zerop (nth-value 2 (uiop:run-program '("sh" "-c" "command -v lsof") :ignore-error-status t :output nil))))

(defun call-with-listener (host function)
  (let ((socket (usocket:socket-listen host 0 :reuse-address t)))
    (unwind-protect (funcall function (usocket:get-local-port socket))
      (usocket:socket-close socket))))

(defun test-playground-guard ()
  ;; Derivation from fixed lsof answers
  (check (equal '("127.0.0.1:18080") (lsof-listen-addresses (format nil "p42~%n127.0.0.1:18080~%"))))
  (check (eq :loopback (binding-status '("127.0.0.1:18080" "[::1]:18080"))))
  (check (eq :loopback (binding-status '("localhost:18080"))))
  (check (eq :exposed (binding-status '("127.0.0.1:18080" "*:18080"))))
  (check (eq :exposed (binding-status '("192.168.1.20:18080"))))
  (check (eq :exposed (binding-status '("[::]:18080"))))
  (check (eq :not-determined (binding-status nil)))
  (check (eq :not-determined (clog-binding nil)))
  ;; Observation of real sockets of this process
  (cond ((lsof-available-p)
         (call-with-listener "127.0.0.1" (lambda (port) (check (eq :loopback (clog-binding port)))
                                           (check (equal (list (format nil "127.0.0.1:~D" port))
                                                         (require-loopback-for-development port)))))
         (call-with-listener "0.0.0.0" (lambda (port)
                                         (check (eq :exposed (clog-binding port)))
                                         (check (eq :exposed (handler-case (progn (require-loopback-for-development port) nil)
                                                               (development-refused (c) (refused-status c))))))))
        (t (format t "~&site-observation: lsof missing, live binding checks skipped.~%")))
  ;; A port nobody listens on is not loopback
  (let ((port (call-with-listener "127.0.0.1" #'identity)))
    (check (eq :not-determined (handler-case (progn (require-loopback-for-development port) nil)
                                 (development-refused (c) (refused-status c))))))
  ;; The pages: code blocks are the definitions as they stand in the file
  (check (uiop:string-prefix-p "(defun clog-binding " (definition-source "clog-binding")))
  (check (uiop:string-prefix-p "(define-condition development-refused " (definition-source "development-refused")))
  (check (not (search "SOURCE:" (fill-sources (read-topic "playground-guard-code.dita")))))
  (let* ((book (make-instance 'observation-book :id +book-id+))
         (text (hb:find-page book "playground-guard" :signal-error? t))
         (code (hb:find-page book "playground-guard-code" :signal-error? t))
         (text-view (find "Text" (v:all-views text) :key #'v:view-title :test #'equal))
         (code-view (find "Code" (v:all-views code) :key #'v:view-title :test #'equal)))
    (check (and text-view (search "Was die Schranke nicht abdeckt" (v:view-html text-view))))
    (check (and code-view (search "(defun require-loopback-for-development" (v:view-html code-view))
                (search "Play" (v:view-html code-view)) (not (search "dita-unsupported" (v:view-html code-view)))))
    (check (not (search "dita-unsupported" (v:view-html text-view))))
    (check (assoc "playground-guard-code" (page-paths book) :test #'equal))))

(defun test-configured-port ()
  "The port comes from the Catalog application's configuration: its variable, else its own default."
  (check (= 18999 (configured-port (lambda (name) (and (equal name "HYPERDOC_CATALOG_PORT") "18999")))))
  (let ((default (configured-port (constantly nil))))
    (check (and (integerp default) (<= 1 default 65535)))
    (check (= default (getf (uiop:symbol-call "DREYECK/CATALOG-APPLICATION" "%CONFIGURATION" nil (constantly nil)) :port)))))

(defun run-tests ()
  (let ((*checks* 0))
    (test-configured-port)
    (test-deviations) (test-plan) (test-views) (test-page-copy) (test-catalog-route) (test-playground-guard)
    (format t "~&site-observation: ~D checks passed.~%" *checks*)
    *checks*))
