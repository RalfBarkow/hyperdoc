(in-package #:zettelkasten-kiosk)

(defvar *checks* 0)
(defmacro check (form) `(progn (assert ,form () "Failed: ~S" ',form) (incf *checks*)))

(defun offers-for (register &optional heads)
  (let ((*register* register) (*heads* heads)) (offers (plan-next register))))
(defun offered (offers step x) (find (list step x) offers :test #'equal))

(defun with-evidence (register id &rest evidence)
  "A copy of REGISTER with EVIDENCE added to item ID."
  (let* ((copy (copy-tree register))
         (i (find id copy :key (lambda (e) (and (eq (first e) :item) (getf (rest e) :id))))))
    (setf (getf (rest i) :evidence) (append evidence (getf (rest i) :evidence)))
    copy))

(defun decided (register id choice)
  (let* ((copy (copy-tree register))
         (d (find id copy :key (lambda (e) (and (eq (first e) :decision) (getf (rest e) :id))))))
    (setf (getf (rest d) :status) :decided (getf (rest d) :choice) choice)
    copy))

(defun test-register ()
  (let ((r (load-register)))
    (check (= 6 (length (items r))))
    (check (= 1 (length (decisions r))))
    ;; Every piece of evidence names kind, date, who, text and the commit it was made at.
    (dolist (i (items r))
      (dolist (e (getf (rest i) :evidence))
        (check (member (first e) '(:verified :failed :seen :pr-open :merged)))
        (check (member (third e) '(:claude :operator)))
        (check (stringp (getf (nthcdr 4 e) :at)))))))

(defun test-plan-now ()
  "The register as committed: the open decision comes first; finished branches are ready for a PR."
  (let* ((r (load-register)) (o (offers-for r)))
    (check (equal '(decide :rsa-aes-variant) (first o)))
    (check (offered o 'review :concept))
    (check (offered o 'pull-request :kiosk))
    (check (offered o 'pull-request :repomix))
    (dolist (id '(:remote-screen :acceptance-steps :hyperdoc-frame))
      (check (offered o 'wait-for-decision id))
      (check (not (offered o 'implement id))))
    (check (not (offered o 'fix :remote-screen)))
    (check (every (lambda (x) (assoc (first x) +steps+)) o))))

(defun test-progress ()
  (let* ((r (decided (load-register) :rsa-aes-variant :patch-neatvnc-ra2ne))
         (o (offers-for r)))
    ;; Decided: the failed remote screen is to be fixed; what depends on it waits for it.
    (check (equal '(fix :remote-screen) (first o)))
    (check (offered o 'wait-for-dependency :acceptance-steps))
    (check (not (offered o 'decide :rsa-aes-variant)))
    ;; A moved head makes the kiosk's evidence stale.
    (let ((o2 (offers-for r '((:kiosk . "0123456789abcdef0123456789abcdef01234567")))))
      (check (offered o2 'reverify :kiosk))
      (check (not (offered o2 'pull-request :kiosk))))
    ;; Fixed and verified at a new head: the dependants can be built.
    (let* ((r3 (copy-tree r))
           (i (find :remote-screen r3 :key (lambda (e) (getf (rest e) :id)))))
      (setf (getf (rest i) :head) "fedcba9")
      (setf (getf (rest i) :evidence) (list '(:verified "test" :claude "test" :at "fedcba9")))
      (let ((o3 (offers-for r3)))
        (check (offered o3 'implement :acceptance-steps))
        (check (offered o3 'implement :hyperdoc-frame))
        (check (offered o3 'pull-request :remote-screen))))
    ;; Everything merged: no step left.
    (let ((done (reduce (lambda (reg id) (with-evidence reg id '(:merged "test" :operator "test" :at "x")))
                        '(:kiosk :repomix :remote-screen :concept :acceptance-steps :hyperdoc-frame)
                        :initial-value r)))
      (check (null (offers-for done))))))

(defun test-reasons ()
  (let* ((plan (let ((*register* (load-register))) (plan-next)))
         (facts (dreyeck/shop3:initial-facts-of plan)))
    ;; Every step's method exists in the domain, and every offered step has reasons.
    (dolist (m +methods+)
      (check (assoc (first m) +steps+)))
    (let ((*register* (load-register)))
      (let ((r (reasons 'decide :rsa-aes-variant facts)))
        (check (string= "Methode decide" (first r)))
        (check (some (lambda (s) (search "Fernbildschirm" s)) (rest r))))
      (let ((r (reasons 'pull-request :kiosk facts)))
        (check (some (lambda (s) (search "Build accb7d6" s)) r))))))

(defun test-play ()
  (let ((*register* (load-register)) (*heads* nil) (*observations* nil) (*message* nil)
        (*head-reader* (lambda (repo branch)
                         (declare (ignore repo))
                         (if (string= branch "nix/package-kiosk")
                             "9999999999999999999999999999999999999999"
                             (let ((i (find branch (items) :key (lambda (i) (prop i :branch)) :test #'equal)))
                               (concatenate 'string (prop i :head) "0000000000000000000000000000000"))))))
    (let ((o (play-read-heads)))
      (check (typep o 'head-observation))
      (check (= 4 (length (observation-entries o))))
      (check (getf (find :kiosk (observation-entries o) :key (lambda (e) (getf e :item))) :moved))
      (check (not (getf (find :repomix (observation-entries o) :key (lambda (e) (getf e :item))) :moved)))
      (check (offered (offers-after o) 'reverify :kiosk))
      (check (offered (offers-before o) 'pull-request :kiosk))
      (check (search "nix/package-kiosk bewegt" *message*))))
  (check (member "zettelkasten-kiosk/read-heads" (policy:reviewed-control-identities) :test #'string=)))

(defun test-views ()
  (let ((*register* (load-register)) (*heads* nil))
    (let ((html (loop for view in (v:all-views (project))
                     when (compute-applicable-methods #'v:view-html (list view))
                       collect (plump:decode-entities (v:view-html view)))))
      (check (>= (length html) 3))
      (check (some (lambda (h) (search "Empfehlung" h)) html))
      (check (some (lambda (h) (search "Play" h)) html))
      (check (some (lambda (h) (search "Build accb7d6" h)) html))
      (check (some (lambda (h) (search "neatvnc um RA2ne (6) erweitern" h)) html)))
    (check (search "Den Zettelkasten-Kiosk fertigstellen" (plump:decode-entities (v:view-html (find-if (lambda (view) (compute-applicable-methods #'v:view-html (list view)))
                                                (v:all-views (task-topic)))))))))

(defun test-pages ()
  "Every page link names a page of this HyperDoc; every expr link evaluates; the carrier page links the right slug."
  (let* ((dir (system-file "pages/"))
         (files (directory (merge-pathnames "*.html" dir)))
         (titles (mapcar (lambda (f) (let ((s (uiop:read-file-string f :external-format :utf-8)))
                                       (subseq s (+ 7 (search "<title>" s)) (search "</title>" s))))
                         files))
         (*package* (find-package '#:zettelkasten-kiosk))
         (*register* (load-register)))
    (check (= 5 (length files)))
    (check (member "Zettelkasten-Kiosk" titles :test #'string=))
    (dolist (f files)
      (let ((s (uiop:read-file-string f :external-format :utf-8)))
        (loop for at = (search "page=\"" s) then (search "page=\"" s :start2 (1+ at))
              while at
              do (check (member (subseq s (+ at 6) (position #\" s :start (+ at 6))) titles :test #'string=)))
        (loop for at = (search "expr=\"" s) then (search "expr=\"" s :start2 (1+ at))
              while at
              do (check (eval (read-from-string (plump:decode-entities (subseq s (+ at 6) (position #\" s :start (+ at 6))))))))))
    (let ((json (uiop:read-file-string (system-file "fedwiki/zettelkasten-kiosk.json") :external-format :utf-8)))
      (check (search (format nil "localhost:8080/~A" (hyperbook/server::slug *hyperdoc*)) json))
      (check (search "pages/zettelkasten-kiosk" json))
      ;; The carrier page carries its own bootstrap as a code item.
      (check (search "\"type\": \"code\"" json))
      (check (search "nix run github:RalfBarkow/hyperdoc/work/zettelkasten-kiosk#zettelkasten-kiosk" json)))))

(defun test-check-image ()
  (flet ((status (revision head)
           (let ((*revision-reader* (constantly revision))
                 (*head-reader* (lambda (repo branch)
                                  (check (string= repo "RalfBarkow/hyperdoc"))
                                  (check (string= branch "work/zettelkasten-kiosk"))
                                  (or head (error "no network")))))
             (image-status (check-image)))))
    (check (eq :current (status "abcdef1234567890" "abcdef1234567890ffff")))
    (check (eq :behind (status "abcdef1234567890" "1111111111111111")))
    (check (eq :dirty (status "abcdef1234567890-dirty" "abcdef1234567890")))
    (check (eq :unknown (status nil "abcdef1234567890")))
    (check (eq :error (status "abcdef1234567890" nil))))
  (check (member "zettelkasten-kiosk/check-image" (policy:reviewed-control-identities) :test #'string=))
  (let ((html (loop for view in (v:all-views (open-locally))
                    when (compute-applicable-methods #'v:view-html (list view))
                      collect (plump:decode-entities (v:view-html view)))))
    (check (some (lambda (h) (search "nix run github:RalfBarkow/hyperdoc/work/zettelkasten-kiosk#zettelkasten-kiosk" h)) html))
    (check (some (lambda (h) (search "localhost:8080/6F061-zettelkasten-kiosk" h)) html))
    (check (some (lambda (h) (search "Play" h)) html))))

(defun run-tests ()
  (let ((*checks* 0))
    (test-register) (test-plan-now) (test-progress) (test-reasons) (test-play) (test-views) (test-check-image) (test-pages)
    (format t "~&zettelkasten-kiosk: ~D checks passed.~%" *checks*)
    *checks*))
