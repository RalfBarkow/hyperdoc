(defpackage #:topic-maps-integration-review/tests
  (:use #:cl)
  (:local-nicknames (#:r #:topic-maps-integration-review) (#:v #:html-inspector-views) (#:tm #:dreyeck/topicmap)
                    (#:snap #:dreyeck/source-snapshot) (#:c #:dreyeck/catalog-topic-maps) (#:p #:dreyeck/work/project)
                    (#:ex #:dreyeck/work/topic-maps-project-example))
  (:export #:run-tests))
(in-package #:topic-maps-integration-review/tests)

(defvar *checks* nil)
(defmacro check (label form)
  `(progn (unless ,form (error "Integration review check failed: ~A" ,label)) (push ,label *checks*)))

(defun html-views (object) (remove-if-not (lambda (view) (typep view 'v::html-view)) (v:all-views object)))
(defun view (object title)
  (or (find title (html-views object) :key #'v:view-title :test #'equal) (error "No view ~S on ~S" title object)))
(defun html (object title) (v:view-html (view object title)))
(defun render-all (object) (dolist (view (html-views object)) (v:view-html view)))
(defun any-view-p (object title) (find title (v:all-views object) :key #'v:view-title :test #'equal))

(defun page-titles ()
  (mapcar (lambda (c) (pathname-name (asdf:component-pathname c)))
          (asdf:component-children (asdf:find-component "topic-maps-integration-review" "pages"))))
(defun page-links (title)
  "Every expr link of a page as (expression view-title) and every page link's title."
  (let ((text (uiop:read-file-string (asdf:system-relative-pathname "topic-maps-integration-review" (format nil "pages/~A.html" title))))
        (exprs nil) (pages nil))
    (loop for start = (search "expr=\"" text) then (search "expr=\"" text :start2 (1+ start)) while start
          do (let* ((from (+ start 6)) (to (position #\" text :start from)) (tag-end (position #\> text :start to))
                    (view-at (search "view=\"" text :start2 to :end2 tag-end)))
               (push (list (plump:decode-entities (subseq text from to))
                           (and view-at (subseq text (+ view-at 6) (position #\" text :start (+ view-at 6)))))
                     exprs)))
    (loop for start = (search "page=\"" text) then (search "page=\"" text :start2 (1+ start)) while start
          do (push (subseq text (+ start 6) (position #\" text :start (+ start 6))) pages))
    (values (reverse exprs) (reverse pages))))
(defun evaluate (expression) (let ((*package* (find-package :topic-maps-integration-review))) (eval (read-from-string expression))))

(defun counts-of-runs ()
  (list (length (r:runs (r:the-topic-maps-source))) (length r::*guard-runs*) (length r::*read-runs*)))

(defun page-tests ()
  (let ((titles (page-titles)) (claim-ids (mapcar #'r:claim-id (r:claims))) (used nil))
    (check "pages:eleven-declared" (= 11 (length titles)))
    (check "pages:main-page-is-declared" (member "Integrating Topic Maps 6162ed68" titles :test #'string=))
    (dolist (title titles)
      (let ((page (r:review-page title)))
        (check (format nil "page:~A:found" title) page))
      (multiple-value-bind (exprs pages) (page-links title)
        (dolist (target pages) (check (format nil "page:~A:links-page:~A" title target) (member target titles :test #'string=)))
        (dolist (entry exprs)
          (destructuring-bind (expression view-title) entry
            (let ((object (evaluate expression)))
              (when (typep object 'r:review-claim) (push (r:claim-id object) used))
              (check (format nil "page:~A:~A:has-view-~A" title (subseq expression 0 (min 40 (length expression))) view-title)
                     (or (null view-title) (any-view-p object view-title))))))))
    (check "pages:every-claim-is-reached-from-a-page" (null (set-difference claim-ids used :test #'string=)))
    (check "pages:main-page-reaches-every-other-page"
           (null (set-difference (remove "Integrating Topic Maps 6162ed68" titles :test #'string=) (nth-value 1 (page-links "Integrating Topic Maps 6162ed68")) :test #'string=)))))

(defun evidence-tests ()
  (let* ((records (r:records)) (directory (merge-pathnames "evidence/" (asdf:system-source-directory "topic-maps-integration-review")))
         (files (mapcar #'file-namestring (remove-if (lambda (path) (string= "SHA256SUMS" (file-namestring path))) (uiop:directory-files directory)))))
    (check "evidence:every-record-has-a-file" (every (lambda (rec) (probe-file (r::evidence-pathname (r:record-file rec)))) records))
    (check "evidence:every-file-is-a-record" (null (set-difference files (mapcar #'r:record-file records) :test #'string=)))
    (check "evidence:every-record-is-a-file-that-exists" (null (set-difference (mapcar #'r:record-file records) files :test #'string=)))
    (check "evidence:every-record-matches-SHA256SUMS" (every #'r:record-intact-p records))
    ;; The check can fail: other bytes have another digest.
    (check "evidence:negative:altered-bytes-do-not-match"
           (let* ((rec (first records)) (octets (copy-seq (alexandria:read-file-into-byte-vector (r::evidence-pathname (r:record-file rec))))))
             (setf (aref octets 0) (logxor 1 (aref octets 0)))
             (not (equal (ironclad:byte-array-to-hex-string (ironclad:digest-sequence :sha256 octets)) (r:recorded-sha256 (r:record-file rec))))))
    (check "evidence:no-fasl-or-cache-among-the-files" (notany (lambda (name) (search ".fasl" name)) files))
    (dolist (rec records) (check (format nil "evidence:~A:outcome-lines-or-whole-record" (r:record-file rec)) (plusp (length (r:record-text rec)))))
    (check "evidence:the-experimental-record-is-marked" (search "EXPERIMENTAL" (v:text-representation (r:record "independent-bench-experimental.json"))))))

(defun claim-tests ()
  (check "claims:classes-are-known" (every (lambda (c) (member (r:claim-class c) '(:observed :derived :inferred :open))) (r:claims)))
  (check "claims:unique-ids" (= (length (r:claims)) (length (remove-duplicates (mapcar #'r:claim-id (r:claims)) :test #'string=))))
  (check "claims:observed-ones-have-evidence" (every (lambda (c) (or (not (eq :observed (r:claim-class c))) (r:claim-evidence c))) (r:claims)))
  (check "claims:open-ones-say-what-is-not-done" (every (lambda (c) (or (not (eq :open (r:claim-class c))) (plusp (length (r:claim-statement c))))) (r:claims)))
  (check "claims:three-are-open" (= 3 (count :open (r:claims) :key #'r:claim-class)))
  (check "claims:the-linux-claim-is-open-and-names-no-evidence" (let ((c (r:claim "linux-nix-unbuilt"))) (and (eq :open (r:claim-class c)) (null (r:claim-evidence c)))))
  (check "claims:target-unmet-is-stated" (search "not met" (r:claim-statement (r:claim "target-20s-unmet"))))
  (check "claims:load-sensitivity-is-stated" (search "161 s" (r:claim-limit (r:claim "within-90-seconds")))))

(defun performance-tests ()
  (let* ((rows (r:performance-rows)) (review (r:record-text (r:record "independent-review.md"))))
    (destructuring-bind (baseline candidate nix integrated reference experimental) rows
      (check "performance:baseline-has-no-read-and-timed-out" (and (null (second baseline)) (member 124 (third baseline))))
      (check "performance:candidate-under-90-and-equal" (and (second candidate) (< (r::median (second candidate)) 90) (fourth candidate)))
      (check "performance:packaged-runtime-under-90-and-equal" (and (< (r::median (second nix)) 90) (fourth nix)))
      (check "performance:integrated-primary-checkout-under-90-and-equal" (and (= 3 (length (second integrated))) (< (r::median (second integrated)) 90) (fourth integrated)))
      (check "performance:reference-faster-than-candidate" (< (r::median (second reference)) (r::median (second candidate))))
      (check "performance:experimental-is-marked-and-not-counted-as-task-1c" (and (fifth experimental) (null (fifth candidate)) (null (fifth integrated)) (null (fifth baseline)) (null (fifth reference)))))
    (dolist (row (append r::+slice-rows+ r::+micro-rows+))
      (dolist (cell (rest row)) (check (format nil "performance:~A:~A-is-in-the-review" (first row) cell) (search cell review))))
    (check "performance:rendering-reads-files-only" (search "Reading the unchanged project CTM" (html (r:the-performance) "Performance")))))

(defun pin-tests ()
  (let ((manifest (snap:find-snapshot-manifest r:+reviewed-commit+)))
    (check "pins:catalog-and-22u-reading-and-workspace-and-reading-name-one-commit"
           (and (string= c:+topic-maps-commit+ r:+reviewed-commit+) (string= ex:+source-revision+ r:+reviewed-commit+)
                (string= p::+topic-maps-revision+ r:+reviewed-commit+) (string= (snap:manifest-commit manifest) r:+reviewed-commit+)))
    (check "pins:the-previous-manifest-stays-as-history" (string= r:+baseline-commit+ (snap:manifest-commit (snap:find-snapshot-manifest r:+baseline-commit+))))
    (check "pins:the-sibling-lineage-is-not-the-pin" (and (string/= r:+sibling-commit+ p::+topic-maps-revision+)))
    (check "pins:manifest-names-reports-as-excluded" (equal '("reports") (snap:manifest-excluded manifest)))
    (check "pins:archive-verification-says-2354-files" (search "\"files\": 2354" (r:record-text (r:record "snapshot-archive-verification.json"))))
    (let ((identity (p::topic-maps-source-identity)))
      (check "pins:this-image-has-a-known-source-kind" (member (getf identity :kind) '(:git-checkout :verified-nix-store-snapshot :unverified-nix-store-snapshot :unverifiable)))
      (check "pins:negative:an-unidentified-directory-is-not-pinned"
             (let ((identity (p::topic-maps-source-identity (uiop:temporary-directory))))
               (and (eq :unverifiable (getf identity :kind)) (null (getf identity :commit)) (null (getf identity :clean)) (null (getf identity :pinned))))))))

(defun workspace-tests ()
  (let* ((workspace (r:the-workspace)) (projection (tm:topicmap-workspace-projection-of workspace))
         (topics (tm:topicmap-projection-topics-of projection)) (associations (tm:topicmap-projection-associations-of projection))
         (ids (mapcar #'tm:topicmap-topic-id-of topics)))
    (check "workspace:topic-ids-are-unique" (= (length ids) (length (remove-duplicates ids :test #'string=))))
    (check "workspace:every-association-joins-two-topics"
           (every (lambda (a) (and (member (tm:topicmap-association-from-of a) ids :test #'string=) (member (tm:topicmap-association-to-of a) ids :test #'string=))) associations))
    (check "workspace:every-association-says-how-it-is-known" (every (lambda (a) (member (r:association-class a) '(:observed :derived :open :proposed))) associations))
    ;; Proposed is not declared: the proposed relations all start at the one proposed object, name the claim that says so, and there are four.
    (let ((proposed (remove :proposed associations :key #'r:association-class :test-not #'eq)))
      (check "workspace:proposed-relations-are-four" (= 4 (length proposed)))
      (check "workspace:proposed-relations-all-start-at-the-proposed-work-item" (every (lambda (a) (equal "p-work-item" (tm:topicmap-association-from-of a))) proposed))
      (check "workspace:proposed-relations-name-the-claim-that-they-are-proposed"
             (every (lambda (a) (member (r:claim "zettel-navigation-is-proposed") (r:association-provenance a))) proposed))
      (check "workspace:the-proposed-work-item-is-marked-proposed" (search "Proposed, not declared" (html (r:subject-object "p-work-item") "Proposed")))
      (check "workspace:nothing-else-is-a-proposed-object" (= 1 (count-if (lambda (topic) (typep (tm:topicmap-topic-object-of topic) 'r:proposed-object)) topics))))
    (check "workspace:observed-relations-have-evidence-or-provenance" (every (lambda (a) (or (not (eq :observed (r:association-class a))) (r:association-evidence a) (r:association-provenance a))) associations))
    (check "workspace:derived-relations-name-no-run" (every (lambda (a) (or (not (eq :derived (r:association-class a))) (null (r:association-evidence a)))) associations))
    (check "workspace:point-is-the-reviewed-revision" (equal "6162ed68" (tm:topicmap-workspace-point-of workspace)))
    (dolist (id ids)
      (tm:topicmap-workspace-go-to workspace id)
      (check (format nil "workspace:go-to:~A" id) (equal id (tm:topicmap-workspace-point-of workspace))))
    (tm:topicmap-workspace-go-to workspace "6162ed68")
    (check "workspace:point-editor-explains-the-relations" (search "Why these relations hold" (tmi-point-html workspace)))
    (check "workspace:the-experimental-association-index-is-not-a-subject" (notany (lambda (id) (search "association-index" id)) ids))
    (check "workspace:the-guard-subject-is-the-refusing-function" (eq (r:subject-object "guard") (symbol-function 'c:refuse-project-workspace)))))

(defun tmi-point-html (workspace)
  "The Workspace view of the Inspector, which renders the Point editor for the Topic at Point."
  (html workspace "Topicmap"))

(defun boundary-tests ()
  (let* ((boundaries (remove-if-not #'r:boundary-present-p (r:boundaries))) (split (mapcar #'car (r::boundary-hunks (r:boundary "1")))) (git (topic-maps-deployment-review::git-available-p))
         (all (mapcar #'r:boundary-all-files boundaries)))
    (check "boundaries:four-are-declared" (= 4 (length (r:boundaries))))
    (check "boundaries:1-to-3-are-always-present" (every #'r:boundary-present-p (list (r:boundary "1") (r:boundary "2") (r:boundary "3"))))
    (check "boundaries:dependencies-point-backwards" (every (lambda (b) (every (lambda (id) (< (parse-integer id) (parse-integer (r:boundary-id b)))) (r:boundary-depends-on b))) boundaries))
    (check "boundaries:every-file-exists" (every (lambda (paths) (every (lambda (path) (r:boundary-file-identity path)) paths)) all))
    (check "boundaries:the-two-split-files-are-split-between-boundaries-1-and-2"
           (and (equal (sort (copy-list split) #'string<) (sort (mapcar #'car (r::boundary-hunks (r:boundary "2"))) #'string<))
                (equal '("dreyeck.asd" "dreyeck/src/catalog-topic-maps.lisp") (sort (copy-list split) #'string<))))
    (let ((flat (apply #'append all)))
      (check "boundaries:a-file-is-in-one-boundary-unless-it-is-split"
             (every (lambda (path) (= (count path flat :test #'string=) (if (member path split :test #'string=) 2 1))) (remove-duplicates flat :test #'string=)))
      (when git
        ;; Together the boundaries are exactly the paths the working tree changes against the base: tracked changes (intent-to-add included) and untracked files.
        (let ((changed (remove-duplicates (append (topic-maps-deployment-review::git-lines "diff" "--name-only" "8e64e7189daf1c5615cbc8bbe40cff3bf2bcd1aa")
                                                  (topic-maps-deployment-review::git-lines "ls-files" "--others" "--exclude-standard"))
                                          :test #'string=)))
          (check "boundaries:no-changed-path-lacks-a-boundary" (null (set-difference changed flat :test #'string=)))
          (check "boundaries:no-boundary-names-an-unchanged-path" (null (set-difference flat changed :test #'string=))))))
    ;; The control: a boundary table that dropped a file would be found.
    (check "boundaries:negative:a-dropped-file-would-be-found"
           (let ((flat (rest (apply #'append all))))
             (or (not git) (not (null (set-difference (topic-maps-deployment-review::git-lines "diff" "--name-only" "8e64e7189daf1c5615cbc8bbe40cff3bf2bcd1aa") flat :test #'string=))))))))

(defun rendering-tests ()
  (let ((before (counts-of-runs)) (guard-before (length r::*guard-runs*)))
    (dolist (object (append (r:records) (r:claims) (list (r:the-workspace) (r:the-performance) (r:the-topic-maps-source) (r:boundary "1") (r:boundary "2") (r:boundary "3") (r:boundary "4") (r:subject-object "p-work-item")
                                                         (snap:find-snapshot-manifest r:+reviewed-commit+) (getf r::*subjects* :reviewed) (getf r::*subjects* :ancestry))))
      (render-all object))
    (dolist (a (tm:topicmap-projection-associations-of (tm:topicmap-workspace-projection-of (r:the-workspace)))) (render-all a))
    (check "rendering:every-view-of-every-object-renders" t)
    (check "rendering:runs-nothing" (and (equal before (counts-of-runs)) (= guard-before (length r::*guard-runs*))))
    (check "rendering:no-page-authoring-writer-loaded" (null (find-package "DREYECK/FEDWIKI-PAGE-AUTHORING")))))

(defun experiment-tests ()
  (let* ((run (r:identify-topic-maps-source-now)) (identity (r::run-identity run)))
    (check "experiment:source-identity-run-is-recorded" (member run (r:runs (r:the-topic-maps-source))))
    (check "experiment:source-identity-names-its-kind" (getf identity :kind))
    (check "experiment:source-identity-view-renders" (search "Pinned revision" (html run "Source identity"))))
  (let ((guard (r:ask-whether-project-workspace-is-refused)))
    (check "experiment:guard-still-refuses-the-workspace-although-it-is-loaded-here" (and (r::run-condition guard) (r::run-loaded guard)))
    (check "experiment:guard-message-is-truthful" (let ((text (princ-to-string (r::run-condition guard))))
                                                    (and (search "does not admit" text) (search "6162ed68" text))))
    (check "experiment:guard-view-renders" (search "refuses the Project Workspace" (html guard "Guard result"))))
  (when (equal "1" (uiop:getenv "HYPERDOC_REVIEW_READ_CTM"))
    (let ((run (r:read-project-ctm-now)))
      (check "experiment:ctm-read-equals-retained-bytes" (r::run-equal-retained run))
      (check "experiment:ctm-read-within-90-seconds" (< (r::run-seconds run) 90))
      (check "experiment:ctm-read-counts" (and (= 327 (r::run-topics run)) (= 572 (r::run-associations run)))))))

(defun run-tests ()
  (let ((*checks* nil))
    (page-tests) (evidence-tests) (claim-tests) (performance-tests) (pin-tests) (workspace-tests) (boundary-tests) (rendering-tests) (experiment-tests)
    (format t "~&TOPIC-MAPS-INTEGRATION-REVIEW-PASS: ~D checks; ~D pages, ~D records, ~D claims, ~D subjects; rendering runs nothing, the guard still refuses the Project Workspace, the evidence matches SHA256SUMS.~%"
            (length *checks*) (length (page-titles)) (length (r:records)) (length (r:claims))
            (length (tm:topicmap-projection-topics-of (tm:topicmap-workspace-projection-of (r:the-workspace)))))
    (length *checks*)))
