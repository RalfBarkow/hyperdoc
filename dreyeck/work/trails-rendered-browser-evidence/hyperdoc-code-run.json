        "id": "17a5b123160ef0d9",
        "type": "item code",
        "text": "import {Graph} from 'https://wardcunningham.github.io/graph/graph.js'"
      },
      {
        "page": "trails-rendered",
        "id": "cc6a77771de7edbd",
        "type": "item code",
        "text": "export function trails () {\n let context = this.context\n let page = context.page\n let result = page.story\n  .filter(item => item.type == \"paragraph\")\n  .map(item => item.text)\n  .filter(text => text.s"
      },
      {
        "page": "trails-rendered",
        "id": "c2706793c45f5631",
        "type": "item paragraph",
        "text": "See Increment of Progress, Eigenmode Patterns"
      },
