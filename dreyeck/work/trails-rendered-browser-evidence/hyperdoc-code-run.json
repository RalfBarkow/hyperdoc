    "items": [
      {
        "page": "welcome-visitors",
        "id": "7b56f22a4b9ee974",
        "type": "item paragraph",
        "text": "Welcome to this Federated Wiki site. From this page you can find who we are and what we do. New sites provide this information and then claim the site as their own. You will need your own site to part"
      },
      {
        "page": "welcome-visitors",
        "id": "821827c99b90cfd1",
        "type": "item paragraph",
        "text": "Pages about us."
      },
      {
        "page": "welcome-visitors",
        "id": "63ad2e58eecdd9e5",
        "type": "item reference",
        "text": " Ralf Barkow — See How I Use My Wiki"
      },
      {
        "page": "welcome-visitors",
        "id": "2bbd646ff3f44b51",
        "type": "item paragraph",
        "text": "Pages where we do and share."
      },
      {
        "page": "welcome-visitors",
        "id": "93e830ff69f68cc4",
        "type": "item markdown",
        "text": "⚠ WARNING: Chrome is introducing/rolling out Local Network Access permission behavior for pages that attempt connections to local network targets. blog , docs , draft "
      },
      {
        "page": "welcome-visitors",
        "id": "8c6539698b040279",
        "type": "item markdown",
        "text": "The following reference is to a local network target."
      },
      {
        "page": "welcome-visitors",
        "id": "05e2fa92643677ca",
        "type": "item reference",
        "text": " Getting Started with HyperDoc on macOS (Nix, direnv, SBCL) — HyperDoc is a Common Lisp system for serving hypertext documents with interactive CLOG-based inspectors."
      },
      {
        "page": "welcome-visitors",
        "id": "6de0cf7d14de4f54",
        "type": "item reference",
        "text": " Running a private Wiki on your computer — explains that if private pages with localhost in fork history get published, other users’ browsers may attempt local connections and show security warnings; "
      },
      {
        "page": "welcome-visitors",
        "id": "5bb4d706496fa020",
        "type": "item reference",
        "text": " HyperDoc Tutorial — HyperDoc Navigation Basics"
      },
      {
        "page": "welcome-visitors",
        "id": "305c2d536ffae417",
        "type": "item reference",
        "text": " Focused Semantic Source Stations — Focused semantic source stations is a reusable view type for rendering semantically meaningful stations inside source so users can lay durable routes from source to"
      },
      {
        "page": "welcome-visitors",
        "id": "ee416d431ebf4fb4",
        "type": "item paragraph",
        "text": "You can edit your copy of these pages. Press [+] to add more writing spaces. Read How to Wiki for more ideas. Follow Recent Changes here and nearby."
      },
      {
        "page": "trails-rendered",
        "id": "16917360196332109824",
        "type": "item paragraph",
        "text": "Here we work out an example to use as a test case. This page saved from Pattern Machinery."
      },
      {
        "page": "trails-rendered",
        "id": "49488010256113991680",
        "type": "item graphviz aspect-source",
        "text": "Howard\nBecker\nEveryday\nDonald\nSchön\nJohn\nDewey\nSusan\nLeigh\nStar\nReflective\nPractice\nInteraction\nDesign\nHenrik\nGedenryd\nSusan\nKare\nAlan\nCooper\nInteresting\nPeople\nAndrew\nAbbott\nClose\nAt\nHand\nDorothy\nSmi"
      },
      {
        "page": "trails-rendered",
        "id": "29487849520185925632",
        "type": "item solo aspect-source",
        "text": "INCLUDED\n  3 aspects\n\nview in solo"
      },
      {
        "page": "trails-rendered",
        "id": "02a6f8340521e129",
        "type": "item paragraph",
        "text": "We will add two trails by hand then explore how they interact while browsing aspects."
      },
      {
        "page": "trails-rendered",
        "id": "93cd119d6286888a",
        "type": "item paragraph",
        "text": "Susan Kare ⇒ John Dewey ⇒ Reflective Practice"
      },
      {
        "page": "trails-rendered",
        "id": "fc6c7d06e5bce7d3",
        "type": "item paragraph",
        "text": "Jean Lave ⇒ Dorothy Smith ⇒ Reflective Practice"
      },
      {
        "page": "trails-rendered",
        "id": "6405b752d1739af0",
        "type": "item mech",
        "text": "CLICK▶\nCODE trails\nCLICK\nSOLO\nCLICK\nPREVIEW synopsis items"
