;;;; Bounded local readings. No model changes and no persistent subject registry.
(defpackage #:dreyeck/work/tmdm-reading
  (:use #:cl)
  (:local-nicknames (#:m #:topic-maps.tmdm) (#:ctm #:topic-maps.ctm) (#:cx #:topic-maps.cxtm)
                    (#:tf #:topic-maps.test-foundation) (#:nav #:dreyeck/inspector/tmdm)
                    (#:v #:html-inspector-views) (#:git #:dreyeck/git)
                    (#:ev #:dreyeck/evaluation-record) (#:work #:dreyeck/work/reading)
                    (#:tm #:dreyeck/topicmap))
  (:export #:read-case #:default-name-example #:explicit-name-example #:reading-run
           #:run-map #:run-case #:run-source #:run-baseline #:run-actual #:run-expected
           #:run-observed-state #:run-context #:model-state-current-p))
(in-package #:dreyeck/work/tmdm-reading)

(defparameter +topic-maps-commit+ "788899aea1a20b9cd8237c6106e6613e180d7362")
(defparameter +hyperdoc-base+ "aabbb983cbaaf713e7406856d853694c5166d5ef")
(defvar *image-identity* (gensym "TMDM-IMAGE-"))
(defclass reading-run ()
  ((case :initarg :case :reader run-case)
   (source :initarg :source :reader run-source)
   (baseline :initarg :baseline :reader run-baseline)
   (recorded-evidence :initarg :recorded-evidence :reader run-recorded-evidence)
   (interpretation :initarg :interpretation :reader run-interpretation)
   (map :initform nil :accessor run-map)
   (actual :initform nil :accessor run-actual)
   (expected :initarg :expected :reader run-expected)
   (actual-octets :initform nil :accessor run-actual-octets)
   (expected-octets :initarg :expected-octets :reader run-expected-octets)
   (state :initform nil :accessor run-observed-state)
   (status :initform :not-run :accessor run-status)
   (failure :initform nil :accessor run-failure)
   (trace :initform nil :accessor run-trace)
   (started :initform (get-universal-time) :reader run-started)
   (finished :initform nil :accessor run-finished)
   (identity :initform (gensym "TMDM-RUN-") :reader run-identity)
   (context :initarg :context :reader run-context))
  (:documentation "One actual local execution, adapted to the existing evaluation-record protocol.
Its time-bound outcome and output are retained even if the live model later changes."))

(defun utc (time)
  (if (null time) "NOT-RUN"
      (multiple-value-bind (s mi h d mo y) (decode-universal-time time 0)
        (format nil "~4,'0D-~2,'0D-~2,'0DT~2,'0D:~2,'0D:~2,'0DZ" y mo d h mi s))))
(defun binary-file (path)
  (with-open-file (in path :element-type '(unsigned-byte 8))
    (let ((bytes (make-array (file-length in) :element-type '(unsigned-byte 8))))
      (unless (= (length bytes) (read-sequence bytes in)) (error "Source changed while reading.")) bytes)))
(defun %descendant-of-pin-p (root hash)
  "Whether HASH is the pinned commit or a commit that has it as an ancestor."
  (or (string= +topic-maps-commit+ hash)
      (handler-case (progn (git:git-run-string root "merge-base" "--is-ancestor" +topic-maps-commit+ hash) t)
        (error () nil))))
(defun %blob-at (root revision path)
  (git:trim-git-output (git:git-run-string root "rev-parse" (format nil "~A:~A" revision path))))
(defun %check-pinned-inputs (commit paths)
  "The reading's inputs, read at COMMIT, are the blobs of the pinned commit: a newer checkout is accepted only if nothing
the reading starts from has changed since. What the newer code then does with them is what the run observes."
  (let ((root (asdf:system-source-directory "topic-maps")) (hash (git:git-commit-hash-of commit)))
    (dolist (path paths)
      (unless (string= (%blob-at root +topic-maps-commit+ path) (%blob-at root hash path))
        (error "~A differs between Topic Maps commit ~A and the checkout at ~A; the reading's inputs are no longer the pinned ones."
               path +topic-maps-commit+ hash)))))
(defun checked-repository ()
  "Refuse an unpinned/dirty source checkout before assigning any execution outcome. The checkout is the pinned commit
or a clean descendant of it; for a descendant the inputs of each reading are checked against the pinned blobs."
  (let* ((root (asdf:system-source-directory "topic-maps"))
         (repo (make-instance 'git:git-repository-checkout :root root :root-source :asdf-system-source))
         (commit (git:make-git-commit :repository repo :commit-ish "HEAD")))
    (unless (%descendant-of-pin-p root (git:git-commit-hash-of commit))
      (error "The CTM reading requires Topic Maps commit ~A or a clean descendant of it." +topic-maps-commit+))
    (unless (zerop (length (git:git-run-string root "status" "--porcelain")))
      (error "The pinned Topic Maps checkout has local changes."))
    (dolist (system '("topic-maps/ctm" "topic-maps/tmdm" "topic-maps/cxtm"))
      (unless (equal (truename root) (truename (asdf:system-source-directory system)))
        (error "ASDF source checkout disagrees for ~A." system)))
    commit))
(defun revision-file (commit path)
  (git:make-git-file-at-commit :commit commit :path path))
(defun execution-context (commit)
  (let* ((root (asdf:system-source-directory "dreyeck"))
         (head (git:trim-git-output (git:git-run-string root "rev-parse" "HEAD")))
         (dirty (git:git-run-string root "status" "--porcelain")))
    (git:git-run-string root "merge-base" "--is-ancestor" +hyperdoc-base+ head)
    (list :image *image-identity* :implementation (lisp-implementation-type) :version (lisp-implementation-version)
          :hyperdoc-head head :hyperdoc-integration-base +hyperdoc-base+ :hyperdoc-working-tree (if (zerop (length dirty)) :clean :modified)
          :adapter-source-sha256
          (loop for path in '("dreyeck/src/tmdm-model-navigation.lisp" "dreyeck/work/tmdm-model-reading.lisp")
                collect (cons path (ironclad:byte-array-to-hex-string
                                   (ironclad:digest-file :sha256 (merge-pathnames path root)))))
          :topic-maps-commit commit :topic-maps-pinned-commit +topic-maps-commit+
          :loaded-definition-to-revision :inferred-from-matching-asdf-checkout
          :fresh-process :not-established-by-library
          :loaded-functions (list #'ctm:deserialize-string #'cx:canonicalize-octets #'m:add-name)
          :classification :observed)))
(defun model-state-current-p (run)
  (and (run-map run) (equal (run-observed-state run) (nav:model-state (run-map run)))))

(defun read-case (id)
  "Execute an existing positive corpus contract. Never write a source or report.
The actual model is returned through RUN-MAP; its provenance is runtime-local.
No source span is inferred, and normative interpretation is not a comparison outcome."
  (let* ((commit (checked-repository)) (corpus (tf:discover-corpus))
         (case (first (tf:select-cases corpus :id id))))
    (unless (and case (eq :cxtm-equal (tf:test-case-expected-outcome case)))
      (error "Select an existing positive CXTM contract, not an arbitrary path: ~S." id))
    (let* ((source (revision-file commit (concatenate 'string "vendor/cxtm/" id)))
           (relative (enough-namestring (tf:test-case-expected-baseline case) (tf:default-corpus-root)))
           (baseline (revision-file commit (concatenate 'string "vendor/cxtm/" relative)))
           (text (git:git-file-contents source))
           (expected (git:git-file-contents baseline))
           (expected-bytes (binary-file (tf:test-case-expected-baseline case))))
      (%check-pinned-inputs commit (list (concatenate 'string "vendor/cxtm/" id) (concatenate 'string "vendor/cxtm/" relative)
                                         "reports/slice-12a/execution.json" "docs/reading-typed-topic-names.md"))
      (unless (and (string= text (uiop:read-file-string (tf:test-case-source-pathname case) :external-format :utf-8))
                   (equalp expected-bytes (babel:string-to-octets expected :encoding :utf-8)))
        (error "Pinned Git blobs and corpus files disagree; no comparison was executed."))
      (let ((run (make-instance 'reading-run :case case :source source :baseline baseline
                               :expected expected :expected-octets expected-bytes :context (execution-context commit)
                               :recorded-evidence (revision-file commit "reports/slice-12a/execution.json")
                               :interpretation (revision-file commit "docs/reading-typed-topic-names.md"))))
        (handler-case
            (progn
              (setf (run-map run) (ctm:deserialize-string text :document-iri (tf:test-case-document-iri case) :source-name id))
              (push :deserialized (run-trace run))
              (setf (run-actual-octets run) (cx:canonicalize-octets (run-map run) :base-locator (tf:test-case-document-iri case))
                    (run-actual run) (babel:octets-to-string (run-actual-octets run) :encoding :utf-8))
              (push :canonicalized (run-trace run))
              (let ((difference (mismatch (run-actual-octets run) expected-bytes)))
                (when difference (setf (run-failure run) (list :first-different-byte difference)))
                (tf:record-result case (if difference :cxtm-mismatch :cxtm-match)
                                  :diagnostics (when difference (list (format nil "First different byte: ~D." difference)))))
              (push :compared-original-bytes (run-trace run)))
          ((or ctm:ctm-unsupported cx:cxtm-unsupported) (condition)
            (setf (run-failure run) condition)
            (tf:record-result case :unsupported :diagnostics (list (princ-to-string condition))))
          (ctm:ctm-rejection (condition)
            (setf (run-failure run) condition)
            (tf:record-result case :ctm-rejection :diagnostics (list (princ-to-string condition))))
          (error (condition)
            (setf (run-failure run) condition)
            (tf:record-result case :execution-error :diagnostics (list (princ-to-string condition)))))
        (setf (run-status run) (tf:test-case-status case) (run-finished run) (get-universal-time)
              (run-trace run) (nreverse (run-trace run)))
        (when (run-map run)
          (setf (run-observed-state run) (nav:model-state (run-map run)))
          (nav:register-execution (run-map run) run))
        run))))

(hyperdoc:defexample default-name-example
  "Read the pinned default-name example; inspect its actual model and execution evidence."
  (let ((run (read-case "ctm/in/name.ctm"))) (or (run-map run) run)))
(hyperdoc:defexample explicit-name-example
  "Read the pinned explicitly typed example; no default Name Type is synthesized."
  (let ((run (read-case "ctm/in/name-type.ctm"))) (or (run-map run) run)))

(defmethod ev:evaluation-specification-of ((run reading-run)) (run-case run))
(defmethod ev:evaluation-input-of ((run reading-run)) (run-source run))
(defmethod ev:evaluation-result-of ((run reading-run)) (run-map run))
(defmethod ev:evaluation-status-of ((run reading-run)) (run-status run))
(defmethod ev:evaluation-trace-of ((run reading-run)) (copy-list (run-trace run)))
(defmethod ev:evaluation-evidence-of ((run reading-run))
  (list :source (run-source run) :baseline (run-baseline run) :actual-output (run-actual run)
        :stored-evidence (run-recorded-evidence run) :normative-interpretation (run-interpretation run)))
(defmethod ev:evaluation-failure-of ((run reading-run)) (run-failure run))
(defmethod ev:evaluation-started-at-of ((run reading-run)) (run-started run))
(defmethod ev:evaluation-finished-at-of ((run reading-run)) (run-finished run))
(defmethod ev:evaluation-identity-of ((run reading-run)) (run-identity run))
(defmethod ev:evaluation-annotation-of ((run reading-run))
  (list :comparison :observed :normative-interpretation :derived :context (run-context run)))
(defmethod v:text-representation ((run reading-run))
  (format nil "~A — checked here ~A (~A)" (tf:test-case-id (run-case run)) (utc (run-finished run)) (run-status run)))
(v:defview tmdm-execution (run reading-run)
  (v:html-view :title "Execution" :priority -10
    (v:html (:h2 "CTM → TMDM → CXTM execution")
      (:p (v:esc (format nil "Observed: checked here ~A; outcome ~A. This is a dated execution, not a timeless model property."
                             (utc (run-finished run)) (run-status run))))
      (:p (v:esc (cond ((null (run-map run)) "No model was produced; inspect the diagnostic below.")
                            ((model-state-current-p run) "Live public model state matches this observation.")
                            (t "Live model changed since this observation; output and outcome describe the earlier execution."))))
      (:table :class "inspector-table"
        (:tr (:td "Contract") (:td (v:object-ref (run-case run) :display "Original Test Case")))
        (:tr (:td "Document IRI / CXTM Base Locator") (:td (v:esc (tf:test-case-document-iri (run-case run)))))
        (:tr (:td "Model") (:td (if (run-map run) (v:object-ref (run-map run) :display "Actual Topic Map" :select "Topics") (v:html "No model produced"))))
        (:tr (:td "Pinned CTM source") (:td (v:object-ref (run-source run) :display "CTM source at commit" :select "Contents")))
        (:tr (:td "Actual CXTM") (:td (v:object-ref (run-actual run) :display "Executed CXTM result")))
        (:tr (:td "Original CXTM baseline") (:td (v:object-ref (run-baseline run) :display "Baseline at commit" :select "Contents")))
        (:tr (:td "Expected bytes") (:td (v:object-ref (run-expected run) :display "Original baseline text")))
        (:tr (:td "Observed state at execution") (:td (v:object-ref (run-observed-state run) :display "Dated public-property observation")))
        (:tr (:td "Failure / mismatch") (:td (v:object-ref (run-failure run))))
        (:tr (:td "Loaded reader / canonicalizer")
             (:td (v:object-ref #'ctm:deserialize-string :display "CTM reader definition" :select "Source code")
                  " / " (v:object-ref #'cx:canonicalize-octets :display "CXTM canonicalizer definition" :select "Source code")))
        (:tr (:td "Execution context") (:td (v:object-ref (run-context run) :display "Runtime and revisions")))
        (:tr (:td "Stored evidence") (:td (v:object-ref (run-recorded-evidence run) :display "Stored Slice 12A evidence — not executed here" :select "Contents")))
        (:tr (:td "Normative interpretation") (:td (v:object-ref (run-interpretation run) :display "Derived interpretation and clauses" :select "Contents"))))
      (:p "Normative sources: " (:a :href "https://www.isotopicmaps.org/ctm/ctm.html" "CTM §3.11")
          " / " (:a :href "https://www.isotopicmaps.org/sam/sam-model/2006-06-18/" "TMDM §5.4")
          " / " (:a :href "https://www.isotopicmaps.org/cxtm/cxtm.html" "CXTM §§3.6, 4.7")))))

(defun ctm-work-topic ()
  (or (find "ctm-plan-page-authoring" (tm:topicmap-projection-topics-of (work:work-projection))
            :key #'tm:topicmap-topic-id-of :test #'equal)
      (error "The existing CTM page-authoring Work Topic is missing.")))
(v:defview tmdm-work-entry (page hyperbook:page)
  (when (and (equal "dreyeck/work/reading" (hyperbook:id-of (hyperbook:hyperbook-of page)))
             (member (hyperbook:id-of page) '("Work Breakdown" "Authoring the CTM Plan Page") :test #'equal))
    (v:html-view :title "TMDM model" :priority 140
      (v:html (:h2 "TMDM model reading")
        (:p "A local model reading linked to the existing authoring Work Topic; no work status or authority is changed.")
        (:p (v:object-ref (ctm-work-topic) :display "ctm-plan-page-authoring" :select "TMDM model"))))))
(v:defview tmdm-work-entry (topic work:work-topic)
  (when (equal "ctm-plan-page-authoring" (tm:topicmap-topic-id-of topic))
    (v:html-view :title "TMDM model" :priority 140
      (v:html (:h2 "Topic → Name → Type Topic")
        (:p "Execute a reading explicitly. Rendering views never reruns a comparison. Each reading keeps actual model references in its own image context.")
        (:p (dreyeck/authority-policy:run-button "Read default-type example" (v:thunk (default-name-example)) "Run DEFEXAMPLE")
            " / " (v:object-ref #'default-name-example :display "Default DEFEXAMPLE definition" :select "Source code"))
        (:p (dreyeck/authority-policy:run-button "Read explicit-type example" (v:thunk (explicit-name-example)) "Run DEFEXAMPLE")
            " / " (v:object-ref #'explicit-name-example :display "Explicit DEFEXAMPLE definition" :select "Source code"))
        ;; The shared Workspace is not linked from a served Catalog's view; it stays reachable where it already was, and here locally.
        (unless (dreyeck/authority-policy:policy-enforced-p)
          (v:html (:p (v:object-ref (work:work-workspace) :display "Existing Work Workspace" :select "Topicmap"))))))))
