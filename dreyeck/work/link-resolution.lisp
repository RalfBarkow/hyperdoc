;;;; Source-derived ordered SHOP3 search. No HTTP, real forks or Wiki writes.
(defpackage #:dreyeck/work/link-resolution
  (:use #:cl)
  (:export #:candidate-context #:plan-resolution #:resolution-experiment
           #:fixture-cases #:fixture-state #:fixture-candidates #:fixture-by-id
           #:fixture-outcomes #:*reference-commit*))
(in-package #:dreyeck/work/link-resolution)
(defparameter *reference-commit* "b58fb43e7ffbbbda66685363dcda1facbd2a46a1")
(defun promote (site sites) (cons site (remove site sites :test #'equal)))
(defun candidate-context (origin panel-site item-site journal)
  "Main L225–273,289–295. Journal direct sites, oldest first. Preserve origin retries."
  (let ((context nil))
    (dolist (site journal) (when site (setf context (promote site context))))
    (unless (equal panel-site origin) (setf context (promote panel-site context)))
    (when item-site (setf context (promote item-site context)))
    (cons origin context)))
(shop3:defdomain fedwiki-ordered-resolution
  ((:- (input-conflict)
    page-conflict ((page-present ?site ?slug) (page-absent ?site ?slug))
    response-conflict ((page-present ?site ?slug) (http-miss ?site ?slug ?code))
    transport-conflict ((network-failed ?site ?slug) (page-present ?site ?slug))
    policy-conflict ((fork-source-policy :cached-copy-sufficient)
                     (fork-source-policy :require-remote-evidence)))
   (:- (allowed :collaborative ?origin ?site) ())
   (:- (allowed :local-only ?origin ?origin) ())
   (:- (known-miss ?site ?slug)
    confirmed-absence ((page-absent ?site ?slug))
    http-non-200 ((http-miss ?site ?slug ?code) (shop3:call /= ?code 200)))
   (:- (evidence ?site ?slug :observed) ((page-present ?site ?slug)))
   (:- (evidence ?site ?slug :modeled) ((modeled-local-page ?site ?slug)))
   (:- (fork-source ?remote ?slug ?snapshot)
    verified-local-copy ((fork-source-policy :cached-copy-sufficient)
                         (verified-copy ?remote ?slug ?snapshot))
    remote-evidence-required ((fork-source-policy :require-remote-evidence)
                              (verified-copy ?remote ?slug ?snapshot)
                              (page-present ?remote ?slug)))
   (:operator (!record-resolution ?slug ?site ?basis)
    ((evidence ?site ?slug ?basis)) () ((resolution-prepared ?slug ?site ?basis)))
   (:operator (!record-miss ?site ?slug)
    ((known-miss ?site ?slug)) () ((modeled-miss ?site ?slug)))
   (:operator (!prepare-fork ?origin ?remote ?slug ?snapshot)
    ((page-absent ?origin ?slug) (fork-permitted ?origin ?slug)
     (fork-source ?remote ?slug ?snapshot))
    () ((modeled-local-page ?origin ?slug) (modeled-fork ?origin ?remote ?slug ?snapshot)))
   (:method (resolve-link ?policy ?origin ?slug ?sites)
    consistent-request ((not (input-conflict)))
    ((search-sites ?policy ?origin ?slug ?sites)))
   (:method (search-sites ?policy ?origin ?slug (?site . ?rest))
    observed-hit ((allowed ?policy ?origin ?site) (page-present ?site ?slug))
    ((!record-resolution ?slug ?site :observed)))
   (:method (search-sites ?policy ?origin ?slug (?origin . ?rest))
    hypothetical-local-hit
    ((allowed ?policy ?origin ?origin) (modeled-local-page ?origin ?slug)
     (not (page-present ?origin ?slug)))
    ((!record-resolution ?slug ?origin :modeled)))
   (:method (search-sites ?policy ?origin ?slug (?site . ?rest))
    next-after-proven-miss
    ((allowed ?policy ?origin ?site) (known-miss ?site ?slug)
     (not (modeled-local-page ?site ?slug)) (not (network-failed ?site ?slug)))
    ((!record-miss ?site ?slug) (search-sites ?policy ?origin ?slug ?rest)))
   (:method (prepare-local-target ?origin ?slug)
    observed-local ((page-present ?origin ?slug)) ())
   (:method (prepare-local-target ?origin ?slug)
    already-modeled ((modeled-local-page ?origin ?slug) (not (page-present ?origin ?slug))) ())
   (:method (prepare-local-target ?origin ?slug)
    prepare-one-fork
    ((page-absent ?origin ?slug) (not (modeled-local-page ?origin ?slug))
     (fork-permitted ?origin ?slug) (fork-source ?remote ?slug ?snapshot))
    ((!prepare-fork ?origin ?remote ?slug ?snapshot)))
   (:method (prepare-and-resolve ?policy ?origin ?slug ?sites)
    preparation-only ((not (input-conflict)))
    ((prepare-local-target ?origin ?slug) (resolve-link ?policy ?origin ?slug ?sites)))))
(defun plan-resolution (state candidates &key (policy :collaborative) prepare
                                              (repeat 1) (domain 'fedwiki-ordered-resolution))
  "Real SHOP3. Repeated tasks share simulated state inside one plan, not between searches."
  (unless (member policy '(:collaborative :local-only)) (error "Unknown policy."))
  (unless (and (integerp repeat) (plusp repeat)) (error "REPEAT must be positive."))
  (let* ((name (gensym "LINK-RESOLUTION-"))
         (tasks (loop repeat repeat collect
                       (if prepare `(prepare-and-resolve ,policy :origin :target ,candidates)
                           `(resolve-link ,policy :origin :target ,candidates)))))
    (unwind-protect
         (progn
           (shop3:make-problem (list name :domain domain :silently t) (copy-tree state) tasks)
           (multiple-value-bind (raw seconds trees states)
               (shop3:find-plans name :which :all :verbose 0 :plan-tree t :collect-state t)
             (make-instance 'dreyeck/shop3:hyperdoc-htn-plan-result
               :problem-name name :raw-plans raw :plans (mapcar #'shop3:shorter-plan raw)
               :time seconds :plan-trees trees :final-states states :execution-mode :plan-only)))
      (shop3:delete-problem name))))
(defun fixture-cases ()
  (with-open-file (in (asdf:system-relative-pathname "dreyeck/work/link-resolution"
                       "dreyeck/tests/fixtures/link-resolution/cases.json") :external-format :utf-8)
    (coerce (gethash "cases" (shasht:read-json in)) 'list)))
(defun fixture-by-id (id)
  (or (find id (fixture-cases) :test #'equal :key (lambda (case) (gethash "id" case)))
      (error "Unknown fixture ~S." id)))
(defun site-key (site)
  (and site (not (eq :null site)) (or (find (string-upcase site) '(:origin :panel :item :a :b :c)
                     :test #'equal :key #'symbol-name) (error "Unsupported fixture site."))))
(defun fixture-candidates (case)
  (candidate-context :origin (site-key (gethash "panel" case)) (site-key (gethash "itemSite" case))
                     (map 'list #'site-key (gethash "journal" case))))
(defun fixture-state (case)
  (loop for response across (gethash "responses" case)
        for site = (site-key (gethash "site" response))
        collect (let ((kind (gethash "kind" response)))
                  (cond ((equal kind "page") `(page-present ,site :target))
                        ((equal kind "absent") `(page-absent ,site :target))
                        ((equal kind "http-error") `(http-miss ,site :target ,(gethash "status" response)))
                        ((equal kind "network-error") `(network-failed ,site :target))
                        (t (error "Unknown response kind."))))))
(defun fixture-outcomes (result)
  (loop for plan in (dreyeck/shop3:plans-of result)
        collect (loop for step in plan when (eq '!record-resolution (car step)) collect (cddr step))))
(defun resolution-experiment (&optional (id "context-order") (policy :collaborative))
  (let* ((case (fixture-by-id id)) (state (fixture-state case)) (candidates (fixture-candidates case))
         (result (plan-resolution state candidates :policy policy :repeat (or (gethash "repeat" case) 1))))
    (list :fixture case :policy policy :candidates candidates :initial-state state
          :reference (list :repository "RalfBarkow/fedwiki-java" :commit *reference-commit*
                           :file "Main.java" :lines '(225 273))
          :result result :outcome (if (dreyeck/shop3:raw-plans-of result) :planned :no-plan)
          :availability (loop for site in candidates collect
                              (list site (cond ((member `(page-present ,site :target) state :test #'equal) :observed-present)
                                               ((member `(page-absent ,site :target) state :test #'equal) :observed-absent)
                                               (t :not-proven-present-or-absent))))
          :execution :not-executed :scope :resolution-preparation-only)))
