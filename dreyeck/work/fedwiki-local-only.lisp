;;;; Opt-in local runtime and protected planning boundary. No Wiki writes.
(defpackage #:dreyeck/work/fedwiki-local-only
  (:use #:cl)
  (:local-nicknames (#:fw #:hyperbook/fedwiki) (#:hb #:hyperbook)
                    (#:local #:dreyeck/local-fedwiki-page) (#:v #:html-inspector-views)
                    (#:d #:dreyeck/work/defederation-planning)
                    (#:r #:dreyeck/work/local-only-resolution) (#:h #:dreyeck/shop3))
  (:export #:make-own-site #:observe-link #:prepare-link #:continue-preparation
           #:resolve-link #:invalid-observation #:invalid-continuation #:observation
           #:observed-page #:observed-item #:target-link #:target-page #:finding
           #:preparation-result #:resolution-result #:demo))
(in-package #:dreyeck/work/fedwiki-local-only)
(define-condition invalid-observation (error)
  ((detail :initarg :detail :reader detail))
  (:report (lambda (c s) (format s "Invalid observation: ~A" (detail c)))))
(define-condition invalid-continuation (error) ()
  (:report (lambda (c s) (declare (ignore c)) (write-string "Unknown or changed planning result/observation." s))))
(defun refuse (detail) (error 'invalid-observation :detail detail))

(defun json-array-p (x) (and (vectorp x) (not (stringp x))))
(defun name-string-p (x) (and (stringp x) (plusp (length x))))
(defun checked-page-json (json &key (require-arrays t))
  (unless (and (hash-table-p json) (name-string-p (gethash "title" json)))
    (refuse :page-needs-title))
  (dolist (field '("story" "journal"))
    (multiple-value-bind (items present) (gethash field json)
      (when (or present require-arrays)
        (unless (json-array-p items) (refuse (list :page-needs-array field)))
        (loop for item across items do
          (unless (hash-table-p item) (refuse (list :page-entry-needs-object field)))
          (when (equal field "story")
            (unless (name-string-p (gethash "type" item)) (refuse :story-item-needs-type)))
          (dolist (key '("id" "text" "site" "type"))
            (multiple-value-bind (value present) (gethash key item)
              (when (and present (not (stringp value)))
                (refuse (list :page-field-needs-string key)))))))))
  json)
(defun input-bytes (path)
  (handler-case (local::%read-octets path)
    ((or file-error stream-error) (c) (refuse (list :cannot-read path (princ-to-string c))))))
(defun input-json (bytes path)
  (handler-case
      (shasht:read-json (sb-ext:octets-to-string bytes :external-format :utf-8) t nil t)
    ((or parse-error end-of-file sb-int:character-decoding-error) (c)
      (refuse (list :invalid-json path (princ-to-string c))))))
(defun snapshot-path (root relative)
  ;; Deliberately a direct child: no absolute paths, separators, '..', wildcards.
  (unless (and (stringp relative)
               (cl-ppcre:scan "\\Asnapshots/[A-Za-z0-9_-]+[.]json\\z" relative))
    (refuse (list :snapshot-path-outside-area relative)))
  (let* ((expected (merge-pathnames relative root))
         (actual (handler-case (truename expected)
                   (file-error (c) (refuse (list :snapshot-missing relative (princ-to-string c)))))))
    ;; Reject symlinked directories and symlinked files, even if the target is inside.
    (unless (equal expected actual) (refuse (list :snapshot-symlink relative)))
    actual))

(defclass own-site (local:local-fedwiki) ())
(defclass own-page (local:local-fedwiki-page)
  ((source :initarg :source :reader source-of)
   (own-site :initarg :own-site :reader page-own-site-of)))
(defun make-own-site (root id)
  (make-instance 'own-site :id id :site-root (truename (uiop:ensure-directory-pathname root))))
(defmethod hb:find-page ((wiki own-site) slug &key signal-error?)
  ;; Fresh read: a simulated result never populates this real page store.
  (let* ((root (local:local-fedwiki-site-root-of wiki))
         (path (dreyeck/fedwiki-assets:local-fedwiki-page-pathname root slug)))
    (cond ((probe-file path)
           (let* ((source (local:observe-local-fedwiki-page-source root slug))
                  (page (make-instance 'own-page :source source :own-site wiki :site-root root :hyperbook wiki :id slug)))
             (fw::set-page-data page (checked-page-json (local:page-source-json source) :require-arrays nil) :context-resolver (constantly nil))
             page))
          (signal-error? (error 'hb:page-lookup-failure :hyperbook wiki :page-id slug)))))
(defmethod fw::lookup-page-link ((page own-page) slug plugin-page-resolver)
  (declare (ignore plugin-page-resolver))
  ;; OWN-PAGE can only be constructed by this local-site path; no context iteration.
  (hb:find-page (page-own-site-of page) slug))
(defmethod v:title-bar-action-buttons ((page own-page)) (declare (ignore page)) nil)
(v:defview fw::👀story (page own-page)
  (v:html-view :title "Story" :priority 2
    (v:html (:p "Local read-only source. No remote assets or renderer activation.")
      (loop for item across (fw::story-of page) do
        (v:html (:p (v:object-ref item) (v:esc (fw::text-of item))))))))

(defclass observation ()
  ((own-site :initarg :own-site :reader own-site-of)
   (page :initarg :page :reader observed-page)
   (item :initarg :item :reader observed-item)
   (link :initarg :link :reader target-link)
   (target :initarg :target :reader target-page)
   (finding :initarg :finding :reader finding)
   (failure :initarg :failure :reader failure-of)
   (local-evidence :initarg :local-evidence :reader local-evidence-of)
   (evidence :initarg :evidence :reader evidence-of)
   (facts :initarg :facts :reader facts-of)
   (candidates :initarg :candidates :reader candidates-of)
   (preparation :initform nil :accessor preparation-result)
   (resolution :initform nil :accessor resolution-result)
   (history :initform nil :accessor history-of)))
;; Internal registries bind identity to frozen observations and original state atoms.
;; These are a cooperative in-image boundary, not a sandbox against arbitrary Lisp.
(defvar *observations* (make-hash-table :test #'eq))
(defvar *results* (make-hash-table :test #'eq))
(defun copy-data (value)
  (typecase value (string (copy-seq value))
    (cons (cons (copy-data (car value)) (copy-data (cdr value)))) (t value)))
(defun observation-seal (obs)
  (list (own-site-of obs) (hb:id-of (own-site-of obs))
        (fw::target-slug-of (target-link obs)) (observed-page obs) (observed-item obs)
        (target-link obs) (target-page obs) (finding obs) (facts-of obs)
        (candidates-of obs) (evidence-of obs) (local-evidence-of obs)))
(defparameter *schemas*
  '((d::local-page . 2) (d::local-page-absent . 2) (d::remote-snapshot . 4)
    (d::snapshot-unavailable . 2) (d::remote-page . 2) (d::remote-page-absent . 2)
    (d::fork-permitted . 2) (d::fork-forbidden . 2) (d::fork-source-policy . 3)
    (r::page-available . 2) (r::page-unavailable . 3) (r::request-error . 2)))
(defun checked-facts (facts)
  (unless (alexandria:proper-list-p facts) (refuse :facts-not-a-list))
  (dolist (fact facts)
    (let ((schema (and (consp fact) (alexandria:proper-list-p fact) (assoc (car fact) *schemas*))))
      (unless (and schema (= (length (cdr fact)) (cdr schema))
                   (name-string-p (second fact)) (name-string-p (third fact))
                   (case (car fact)
                     (d::remote-snapshot (and (name-string-p (fourth fact)) (name-string-p (fifth fact))))
                     (d::fork-source-policy (member (fourth fact) '(:cached-copy-sufficient :require-remote-evidence)))
                     (r::page-unavailable (and (integerp (fourth fact)) (<= 100 (fourth fact) 599) (/= 200 (fourth fact))))
                     (otherwise t)))
        (refuse (list :unapproved-fact fact)))))
  (copy-tree facts))
(defun read-evidence (path)
  (when path
    (let* ((bytes (input-bytes path)) (json (input-json bytes path))
           (root (uiop:pathname-directory-pathname (truename path))))
      (unless (and (hash-table-p json) (json-array-p (gethash "facts" json)))
        (refuse :evidence-needs-facts-array))
      (let ((facts
              (loop for row across (gethash "facts" json) collect
                (progn
                  (unless (and (json-array-p row) (plusp (length row)) (stringp (aref row 0)))
                    (refuse (list :invalid-fact-row row)))
                  (let* ((schema (find (aref row 0) *schemas* :test #'string-equal
                                       :key (lambda (s) (symbol-name (car s))))))
                    (unless schema (refuse (list :unapproved-predicate (aref row 0))))
                    (unless (= (length row) (1+ (cdr schema))) (refuse (list :wrong-fact-arity row)))
                    (let ((fact (cons (car schema) (coerce (subseq row 1) 'list))))
                      (when (eq (car schema) 'd::fork-source-policy)
                        (setf (fourth fact)
                              (cond ((equal (fourth fact) "cached-copy-sufficient") :cached-copy-sufficient)
                                    ((equal (fourth fact) "require-remote-evidence") :require-remote-evidence)
                                    (t (refuse (list :unknown-policy (fourth fact)))))))
                      (first (checked-facts (list fact))))))))
            (copies (gethash "copies" json #())) (verified nil))
        (unless (json-array-p copies) (refuse :copies-needs-array))
        (loop for copy across copies do
          (unless (and (hash-table-p copy)
                       (every (lambda (key) (name-string-p (gethash key copy))) '("site" "slug" "path" "sha256")))
            (refuse :incomplete-copy-entry))
          (let* ((file (snapshot-path root (gethash "path" copy))) (octets (input-bytes file))
                 (digest (ironclad:byte-array-to-hex-string (ironclad:digest-sequence :sha256 octets))))
            (unless (equal digest (gethash "sha256" copy)) (refuse :snapshot-digest-mismatch))
            (checked-page-json (input-json octets file))
            (push (list :site (gethash "site" copy) :slug (gethash "slug" copy)
                        :pathname file :sha256 digest) verified)))
        (dolist (fact facts)
          (when (eq (car fact) 'd::remote-snapshot)
            (unless (find-if (lambda (copy) (and (equal (fourth fact) (getf copy :site))
                                                 (equal (third fact) (getf copy :slug))
                                                 (equal (fifth fact) (getf copy :sha256)))) verified)
              (refuse :snapshot-copy-not-verified))))
        (list :pathname (truename path)
              :sha256 (ironclad:byte-array-to-hex-string (ironclad:digest-sequence :sha256 bytes))
              :copies (nreverse verified) :facts facts)))))
(defun source-page-for-observation (site slug)
  (unless (name-string-p slug) (refuse :source-slug-needs-string))
  (handler-case (hb:find-page site slug :signal-error? t)
    ((or file-error stream-error parse-error hb:page-lookup-failure
         dreyeck/fedwiki-assets:invalid-fedwiki-page-slug sb-int:character-decoding-error) (c)
      (refuse (list :invalid-source-page slug (princ-to-string c))))))
(defun observation-item (page index)
  (checked-page-json (fw::raw-json-of page))
  (unless (and (integerp index) (<= 0 index) (< index (length (fw::story-of page))))
    (refuse (list :invalid-story-item-index index)))
  (elt (fw::story-of page) index))
(defun observe-link (own-site source-slug item-index &key evidence-file facts reader-origin panel-site)
  "OWN-SITE is explicit. External facts must match the inert evidence file exactly.
Local presence/absence comes only from the actual local page lookup. No HTTP status implies absence."
  (unless (typep own-site 'own-site) (refuse :own-site-required))
  (let* ((evidence (read-evidence evidence-file))
         (external (getf evidence :facts))
         (own (hb:id-of own-site))
         (page (source-page-for-observation own-site source-slug))
         (item (observation-item page item-index))
         (link (find-if (lambda (l) (typep l 'fw::wiki-link))
                       (fw::extract-links-from-story-item (fw::item-type-of item) item page))))
    (when (some (lambda (f) (and (member (car f) '(r::page-available r::page-unavailable r::request-error))
                                 (equal own (second f)))) external)
      (refuse :own-site-availability-must-come-from-store))
    (when facts
      (checked-facts facts)
      (unless (equal facts external) (refuse :facts-without-matching-source)))
    (unless link (refuse :item-has-no-wiki-link))
    (when (some (lambda (f) (member (car f) '(d::local-page d::local-page-absent))) external)
      (refuse :local-observations-must-come-from-store))
    (unless (name-string-p (fw::target-slug-of link)) (refuse :invalid-link-target))
    (handler-case (dreyeck/fedwiki-assets:local-fedwiki-page-pathname
                   (local:local-fedwiki-site-root-of own-site) (fw::target-slug-of link))
      (dreyeck/fedwiki-assets:invalid-fedwiki-page-slug (c) (refuse (princ-to-string c))))
    (let* ((slug (fw::target-slug-of link)) (failure nil)
           (target (handler-case (hb:find-page own-site slug)
                     ((or file-error stream-error parse-error invalid-observation sb-int:character-decoding-error) (c) (setf failure c) nil)))
           (finding (cond (failure :unknown) (target :observed-local) (t :confirmed-local-absence)))
           (facts (append external
                          (unless failure (list (list (if target 'd::local-page 'd::local-page-absent) own slug)))))
           (candidates (when (and reader-origin panel-site)
                         (r::java-link-candidates
                          :origin reader-origin :panel-site panel-site
                          :item-site (and (fw::data-of item) (gethash "site" (fw::data-of item)))
                          :journal-sites (map 'list (lambda (a) (gethash "site" a))
                                              (gethash "journal" (fw::raw-json-of page))))))
           (obs (make-instance 'observation :own-site own-site :page page :item item :link link
                               :target target :finding finding :failure failure
                               :local-evidence (list :pathname (dreyeck/fedwiki-assets:local-fedwiki-page-pathname
                                                                 (local:local-fedwiki-site-root-of own-site) slug)
                                                     :observed-at (get-universal-time) :finding finding
                                                     :source (and target (source-of target)))
                               :evidence evidence
                               :facts facts :candidates candidates)))
      (setf (gethash obs *observations*) (copy-data (observation-seal obs))) obs)))
(defun trusted-facts (obs)
  (multiple-value-bind (facts registered) (gethash obs *observations*)
    (unless (and registered (equal facts (observation-seal obs))) (error 'invalid-continuation))
    (copy-data (facts-of obs))))
(defun remember-result (obs result)
  (setf (gethash result *results*)
        (list obs (mapcar (lambda (s) (copy-data (shop3:state-atoms s))) (h:final-states-of result))))
  (pushnew result (history-of obs) :test #'eq)
  result)
(defun result-state (obs result index)
  (let ((entry (gethash result *results*)))
    (unless (and entry (eq (first entry) obs) (integerp index) (<= 0 index)
                 (< index (length (second entry)))
                 (equal (second entry) (mapcar #'shop3:state-atoms (h:final-states-of result))))
      (error 'invalid-continuation))
    (trusted-facts obs)
    (copy-data (nth index (second entry)))))
(defun prepare-link (obs &key (repeat 1))
  (let ((result (d:plan-defederation (trusted-facts obs) :site (hb:id-of (own-site-of obs))
                                     :slug (fw::target-slug-of (target-link obs)) :repeat repeat)))
    (remember-result obs result) (setf (preparation-result obs) result)))
(defun continue-preparation (obs result &key (index 0) (repeat 1))
  (let ((next (d:plan-defederation (result-state obs result index)
                                  :site (hb:id-of (own-site-of obs))
                                  :slug (fw::target-slug-of (target-link obs)) :repeat repeat)))
    (remember-result obs next) (setf (preparation-result obs) next)))
(defun resolution-state (obs prepared index)
  (let* ((facts (trusted-facts obs)) (own (hb:id-of (own-site-of obs)))
         (slug (fw::target-slug-of (target-link obs)))
         (state (append `((r::own-site ,own)) (r::candidate-facts :link (candidates-of obs))
                        (remove-if-not (lambda (f) (member (car f) '(r::page-available r::page-unavailable r::request-error))) facts))))
    (case (finding obs)
      (:observed-local (push `(r::page-available ,own ,slug) state))
      (:confirmed-local-absence (push `(r::page-unavailable ,own ,slug :local-store-absent) state)))
    (when prepared
      (let ((final (result-state obs prepared index)))
        (when (and (member `(d::modeled-local-page ,own ,slug) final :test #'equal)
                   (some (lambda (f) (and (eq 'd::modeled-fork (car f))
                                         (equal own (second f)) (equal slug (third f)))) final))
          (push `(r::modeled-local-page ,own ,slug) state))))
    (remove-duplicates state :test #'equal)))
(defun resolve-link (obs &key (policy :local-only) prepared (index 0))
  "Only generated compound tasks. Resolution never performs the planned requests."
  (unless (member policy '(:local-only :collaborative)) (refuse :unknown-policy))
  (when (and (eq policy :collaborative) (null (candidates-of obs)))
    (refuse :explicit-reader-origin-and-panel-site-required))
  (let* ((name (gensym "LOCAL-RESOLUTION-"))
         (state (resolution-state obs prepared index))
         (problem (shop3:make-problem (list name :domain 'r::fedwiki-link-resolution :silently t) state
                                    `((r::resolve :link ,(fw::target-slug-of (target-link obs))
                                                  ,(if (eq policy :local-only) 'r::local-only 'r::collaborative))))))
    (multiple-value-bind (raw seconds trees states)
        (shop3:find-plans problem :which :all :verbose 0 :plan-tree t :collect-state t)
      (setf (resolution-result obs)
            (make-instance 'h:hyperdoc-htn-plan-result :problem-name name :raw-plans raw
              :plans (mapcar #'shop3:shorter-plan raw) :time seconds :plan-trees trees :final-states states
              :execution-mode :plan-only))
      (push (resolution-result obs) (history-of obs))
      (resolution-result obs))))

(defun resolution-outcomes (obs)
  (let ((result (resolution-result obs)))
    (if (and result (h:raw-plans-of result))
        (loop for plan in (h:plans-of result) collect
          (cond ((find 'r::!use-modeled-page plan :key #'car) :hypothetical-local)
                ((find 'r::!abort-resolution plan :key #'car) :aborted-network-error)
                ((find 'r::!conclude-unresolved plan :key #'car) :not-found)
                (t :observed-availability)))
        (if result :no-plan :not-planned))))

(v:defview local-link-view (obs observation)
  (v:html-view :title "Local-only evidence" :priority 0
    (v:html
      (:p (v:esc (format nil "Observed finding: ~S. Plans are hypothetical; no fork executed." (finding obs))))
      (:p (v:esc (format nil "Resolution outcome: ~S" (resolution-outcomes obs))))
      (:table
        (loop for (label object) on
          (list "Explicit own-site" (own-site-of obs) "Source page" (observed-page obs)
                "Source revision" (source-of (observed-page obs)) "Story item" (observed-item obs)
                "Link target" (target-link obs) "Observed target page" (target-page obs)
                "Local observation provenance" (local-evidence-of obs)
                "External evidence revision" (evidence-of obs) "Observation facts" (facts-of obs)
                "Candidate provenance" (candidates-of obs) "Read failure (unknown)" (failure-of obs)
                "Preparation result" (preparation-result obs) "Resolution result" (resolution-result obs)) by #'cddr
          do (v:html (:tr (:td (v:esc label)) (:td (v:object-ref object))))))
      (dolist (result (history-of obs))
        (v:html (:p "Planning result " (v:object-ref result))
                (:p "SHOP3 problem " (v:object-ref (shop3:find-problem (h:problem-name-of result))))
                (:p "Simulated final states " (v:object-ref (h:final-states-of result)))
                (:p "Planned operations (not executed) " (v:object-ref (h:plans-of result))))))))
(defun demo ()
  (let* ((root (asdf:system-relative-pathname "dreyeck/work/fedwiki-local-only"
                  "dreyeck/tests/fixtures/fedwiki-local-only/"))
         (site (make-own-site root "fedwiki:local"))
         (obs (observe-link site "source" 1 :evidence-file (merge-pathnames "evidence.json" root)
                            :reader-origin "fedwiki:local" :panel-site "fedwiki:local"))
         (plan (prepare-link obs :repeat 2)))
    (resolve-link obs :prepared plan) obs))
