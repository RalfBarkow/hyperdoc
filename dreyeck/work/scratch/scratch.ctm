q:m01 isa s:matrix-beitrag ;
    - "Ein Trail durch Marcs Solo-Beispiel" ;
    s:beschreibung: "Beim Zeichnen eines Trails im Call scheiterte die Zuordnung bei verschieden typisierten Knoten. In Marcs Beispiel unterscheiden sich die Platzhalter durch ihre Typen. Ward beschreibt den Graphen als Schema, das sich im Gebrauch weiter ausarbeiten lässt." ;
    s:zeit: "2026-11-16 · 23:50" ;
    s:autor: "Ward" .

q:m02 isa s:matrix-beitrag ;
    - "Solo 0.1.32-4" ;
    s:beschreibung: "Ward meldet, dass typisierte Knoten im Trail und das stabilere Layout gemeinsam ausgeliefert wurden und der Quellcode auf GitHub steht." ;
    s:zeit: "2026-11-16 · 23:56" ;
    s:autor: "Ward" .

q:m03 isa s:matrix-beitrag ;
    - "KAPOW und Pageviews" ;
    s:beschreibung: "Ward verweist auf Wikimedias Bot-Erkennung. Die Einordnung von Zugriffen als automatisiert oder menschlich wirkt sich auf die Seitenaufrufstatistik aus." ;
    s:zeit: "2026-11-17 · 17:09" ;
    s:autor: "Ward" ;
    s:url: "https://wikitech.wikimedia.org/wiki/KAPOW_(bot_detection_system)" .

q:m04 isa s:matrix-beitrag ;
    - "Öffentliche Beschreibung, interne Details" ;
    s:beschreibung: "Ward hebt hervor, dass Wikimedia aus Gründen des Infrastrukturschutzes Code, Detaildokumentation und Ausgabedaten von KAPOW intern hält. Für Phabricator-Tickets gilt eine fallweise Sichtbarkeit." ;
    s:zeit: "2026-11-17 · 17:11" ;
    s:autor: "Ward" .

q:m05 isa s:matrix-beitrag ;
    - "Codegenerierung für CPUs und Beschleuniger" ;
    s:beschreibung: "Ward kündigt Lattners Vortrag als Blick auf das Programmieren für verschiedene Prozessoren und Beschleuniger an. Ein Bild zur Ankündigung ist im Auszug erwähnt." ;
    s:zeit: "2026-11-17 · 22:10" ;
    s:autor: "Ward" .

q:m06 isa s:matrix-beitrag ;
    - "SPLASH’26: Mojo" ;
    s:beschreibung: "Ward nennt die Keynote „Mojo: Towards One Systems Language for All Hardware“ und berichtet, dass sich der Videolink über SPLASH schwer teilen liess." ;
    s:zeit: "2026-11-17 · 22:13" ;
    s:autor: "Ward" .

q:m07 isa s:matrix-beitrag ;
    - "Lisp und die verpasste Gelegenheit" ;
    s:beschreibung: "Ward vermutet, dass Lisp-Programmierer Ähnliches früher hätten tun können. Er nennt die damalige Hardware und die wirtschaftlichen Anreize als mögliche Bedingungen und beschreibt seine eigene Abkehr." ;
    s:zeit: "2026-11-17 · 22:31" ;
    s:autor: "Ward" .

q:m08 isa s:matrix-beitrag ;
    - "Link zur SPLASH-Keynote" ;
    s:beschreibung: "Robert reicht den YouTube-Link nach." ;
    s:zeit: "2026-11-17 · 22:35" ;
    s:autor: "Robert Sterbal" ;
    s:url: "https://youtu.be/9-97SB5XJh4?is=LUyoGU09tUPBvmn1" .

q:m09 isa s:matrix-beitrag ;
    - "Keynote-Q&A und Swift" ;
    s:beschreibung: "Ward bestätigt das Video und hebt den Q&A-Teil hervor, insbesondere Lattners Rückblick auf Swift bei Apple." ;
    s:zeit: "2026-11-17 · 23:02" ;
    s:autor: "Ward" .

q:m10 isa s:matrix-beitrag ;
    - "Die Zukunft des Programmierens" ;
    s:beschreibung: "Ward beschreibt Vortragsdichte und Fachjargon und sieht darin einen Bezugsrahmen für künftige Programmiersprachen." ;
    s:zeit: "2026-11-17 · 23:04" ;
    s:autor: "Ward" .

q:m11 isa s:matrix-beitrag ;
    - "Application Accelerators" ;
    s:beschreibung: "Ward stellt den Link zur FedWiki-Seite in die Diskussion." ;
    s:zeit: "2026-11-17 · 23:16" ;
    s:autor: "Ward" ;
    s:url: "http://code.fed.wiki.org/application-accelerators.html" .

q:m12 isa s:matrix-beitrag ;
    - "Lattner-Interview über KI, Mojo und Softwarearbeit" ;
    s:beschreibung: "Ward teilt ein Interview zu KI-Agenten und Vibe Coding, Entscheidungen darüber, was sich zu bauen lohnt, Mojo, Erfahrungen mit dem Swift-Start und dem Druck auf Open-Source-Maintainer." ;
    s:zeit: "2026-11-18 · 03:03" ;
    s:autor: "Ward" ;
    s:url: "https://www.youtube.com/watch?v=VHZUeM1BduQ" .

q:m13 isa s:matrix-beitrag ;
    - "Sprachinnovation bei Minute 55" ;
    s:beschreibung: "Ward markiert ungefähr Minute 55 im Interview. Dort geht es laut Ward darum, wie Sprachinnovation verändert, wie wir über das Verhalten von Programmen sprechen." ;
    s:zeit: "2026-11-18 · 03:35" ;
    s:autor: "Ward" ;
    s:url: "https://www.youtube.com/watch?v=VHZUeM1BduQ&t=3300s" .

q:m14 isa s:matrix-beitrag ;
    - "Die richtige Person zur richtigen Zeit" ;
    s:beschreibung: "Ward nennt Chris Lattner und Mike Bostock als zwei Personen, die für die Zukunft der Software zur richtigen Zeit an den richtigen Fragen arbeiten könnten." ;
    s:zeit: "2026-11-18 · 03:47" ;
    s:autor: "Ward" .

q:image isa s:kontextquelle ;
    - "Angehängte Graphviz-Abbildung" ;
    s:beschreibung: "Die rote Kurve beginnt bei Ecology, biegt bei Role ab und endet mit einer Pfeilspitze bei Result. Die meisten Knoten tragen ein Fragezeichen unter ihrem Typnamen. Kreuzen und Überdecken von Knoten oder Kanten verrät keine zusätzlichen Trail-Stationen. Unter den sichtbaren Legenden stehen EIP Graphviz Decorations und Spring Layout." ;
    s:datei: "evidence/typed-trail.png" ;
    s:sha256: "7b6deaea6533c64c581f6dc9113b588a84962604b9daca3860a2839729e83dbe" .

q:release isa s:kontextquelle ;
    - "Solo-Commit 0.1.32-4" ;
    s:beschreibung: "Im Quellrepo nachgesehener Versionscommit." ;
    s:url: "https://github.com/WardCunningham/wiki-plugin-solo/commit/cd2c43356e4ce2ba6092bda991bd73158d076aa0" .

q:solo isa s:kontextquelle ;
    - "Solo-Quelltext von 0.1.32-4" ;
    s:beschreibung: "Der Quelltext verwendet dotlabel für die Zuordnung von Trail-Knoten zu SVG-Text und übernimmt Hervorhebungen in die reguläre Knotendeklaration. Er importiert D3 und verwendet curveNatural für die rote Kurve." ;
    s:url: "https://github.com/WardCunningham/wiki-plugin-solo/blob/cd2c43356e4ce2ba6092bda991bd73158d076aa0/client/dialog/index.html" .

q:trails isa s:kontextquelle ;
