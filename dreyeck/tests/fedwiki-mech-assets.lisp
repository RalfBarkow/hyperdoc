(in-package #:dreyeck/fedwiki-mech/tests)

(defun check-page-attached-browser-assets ()
  (let* ((root (merge-pathnames (format nil "mech-assets-~A/" (gensym))
                               (uiop:temporary-directory)))
         (dir (merge-pathnames "assets/pages/mech-of-mastodon/" root))
         (page (merge-pathnames "pages/mech-of-mastodon" root))
         (asd (merge-pathnames "mech-of-mastodon-reading.asd" dir))
         (html (merge-pathnames "host/page-attached.html" dir))
         (archive (merge-pathnames "mech-of-mastodon.zip" dir))
         (application (dreyeck/fedwiki-story-assets:wrap-mastodon-assets
                       (constantly :catalog) root))
         (prefix "/assets/pages/mech-of-mastodon/host/"))
    (flet ((put (path text)
             (ensure-directories-exist path)
             (with-open-file (out path :direction :output :if-exists :supersede)
               (write-string text out)))
           (request (suffix &optional (method :get))
             (funcall application (list :request-method method
                                        :path-info (concatenate 'string prefix suffix)))))
      (unwind-protect
           (progn
             (put page "{\"story\":[{\"type\":\"assets\",\"text\":\"pages/mech-of-mastodon\"}]}")
             ;; Discovery may inspect this filename. Any attempt to load the ASD fails.
             (put asd "(error \"This ASD must never be loaded by the browser route.\")")
             (put html "<title>Page host</title>")
             (assert (eq :catalog (funcall application '(:path-info "/view/mech-of-mastodon"))))
             (let ((get (request "page-attached.html"))
                   (head (request "page-attached.html" :head)))
               (assert (= 200 (first get) (first head)))
               (assert (equal (second get) (second head)))
               (assert (equalp (alexandria:read-file-into-byte-vector html) (third get)))
               (assert (= (length (third get)) (getf (second get) :content-length)))
               (assert (search "sandbox allow-scripts" (getf (second get) :content-security-policy)))
               (assert (equal "*" (getf (second get) :access-control-allow-origin)))
               (assert (equal '("") (third head)))
               (zip:with-output-to-zipfile (zip archive)
                 (zip:write-zipentry zip "mech-of-mastodon/mech-of-mastodon-reading.asd" asd)
                 (zip:write-zipentry zip "mech-of-mastodon/host/page-attached.html" html))
               (delete-file asd)
               (delete-file html)
               (assert (equalp get (request "page-attached.html"))))
             (dolist (name '("../mech-of-mastodon-reading.asd" "host.js" "index.html"))
               (assert (= 404 (first (request name)))))
             (assert (= 404 (first (request "page-attached.html" :post))))
             (put page "{\"story\":[]}")
             (assert (= 404 (first (request "page-attached.html")))))
        (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore)))))
