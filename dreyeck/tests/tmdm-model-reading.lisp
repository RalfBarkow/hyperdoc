(defpackage #:dreyeck/work/tmdm-reading/tests
  (:use #:cl)
  (:local-nicknames (#:m #:topic-maps.tmdm) (#:n #:dreyeck/inspector/tmdm)
                    (#:r #:dreyeck/work/tmdm-reading) (#:v #:html-inspector-views)
                    (#:ev #:dreyeck/evaluation-record) (#:git #:dreyeck/git)
                    (#:tf #:topic-maps.test-foundation))
  (:export #:run-tests))
(in-package #:dreyeck/work/tmdm-reading/tests)
(defvar *checks* nil)
(defmacro check (name form)
  `(progn (unless ,form (error "TMDM navigation check failed: ~A" ,name)) (push ,name *checks*)))
(defun view (object title)
  (let ((view (find title (v:all-views object) :key #'v:view-title :test #'equal)))
    (assert view) (v:view-html view) view))
(defun refs (object title) (mapcar #'cdr (v:view-references (view object title))))
(defun selected-references-exist (object title)
  (loop for (id . target) in (v:view-references (view object title)) always
    (let ((parts (uiop:split-string id :separator "-")))
      (or (/= (length parts) 3)
          (not (string-equal "inspect" (first parts)))
          (find (v:decode-base32 (third parts)) (v:all-views target) :key #'v:view-title :test #'equal)
          (error "Missing selected view ~S on ~S" (v:decode-base32 (third parts)) target)))))
(defun text (object title) (v:view-html (view object title)))
(defun topic (map id)
  (m:intern-topic map :item-identifier (concatenate 'string "urn:independent:" id)))
(defun snapshot-files ()
  (loop for path in '("dreyeck/pages/work/Work Breakdown.html" "dreyeck/pages/work/Authoring the CTM Plan Page.html"
                     "dreyeck/pages/work/CTM Plan Page WBS Dictionary.html")
        collect (ironclad:digest-file :sha256 (asdf:system-relative-pathname "dreyeck" path))))
(defun refuses (thunk) (handler-case (progn (funcall thunk) nil) (error () t)))

(defun example-checks ()
  (dolist (id '("ctm/in/name.ctm" "ctm/in/name-type.ctm"))
    (let* ((run (r:read-case id)) (map (r:run-map run)) (topics (m:topic-map-topics map))
           (owner (find-if #'m:topic-names topics)) (name (first (m:topic-names owner)))
           (type (m:topic-name-type name)) (before (n:model-state map)))
      (check (list id :model) (and (typep map 'm:topic-map) (= 2 (length topics))))
      (check (list id :map-reference) (every (lambda (topic) (member topic (refs map "Topics") :test #'eq)) topics))
      (check (list id :owner-to-name) (member name (refs owner "Topic") :test #'eq))
      (check (list id :name-to-parent) (member owner (refs name "Name") :test #'eq))
      (check (list id :name-to-type) (member type (refs name "Name") :test #'eq))
      (check (list id :topic-to-map) (member map (refs type "Topic") :test #'eq))
      (check (list id :type-meaning)
             (if (search "name-type" id)
                 (and (equal (list (concatenate 'string (tf:test-case-document-iri (r:run-case run)) "#nametype"))
                             (m:topic-item-identifiers type)) (null (m:topic-subject-identifiers type)))
                 (equal (list (m:default-name-type-identifier)) (m:topic-subject-identifiers type))))
      (loop for object in (list map owner name type) for role in '(:map :owner :name :type) do
        (check (list id role :same-run) (member run (refs object "Evidence") :test #'eq))
        (check (list id role :class-reference) (member (class-of object) (refs object "Definitions") :test #'eq)))
      (check (list id :definition-function) (member #'m:add-name (refs name "Definitions") :test #'eq))
      (check (list id :class-source) (plusp (length (text (class-of name) "Source code"))))
      (check (list id :definition-source) (plusp (length (text #'m:add-name "Source code"))))
      (check (list id :actual-pass) (and (eq :pass (ev:evaluation-status-of run))
                                      (eq :cxtm-match (tf:test-case-actual-outcome (r:run-case run)))
                                      (string= (r:run-actual run) (r:run-expected run))))
      (check (list id :source-reference) (member (r:run-source run) (refs run "Execution") :test #'eq))
      (check (list id :baseline-reference) (member (r:run-baseline run) (refs run "Execution") :test #'eq))
      (check (list id :output-reference) (member (r:run-actual run) (refs run "Execution") :test #'eq))
      (check (list id :source-bytes) (string= (git:git-file-contents (r:run-source run))
                                           (uiop:read-file-string (tf:test-case-source-pathname (r:run-case run)) :external-format :utf-8)))
      ;; The source is read from the loaded checkout: the pinned commit, or a clean descendant whose pinned inputs are unchanged.
      (check (list id :source-commit) (let ((hash (git:git-commit-hash-of (git:git-file-commit-of (r:run-source run)))))
                                        (and (r::%descendant-of-pin-p (asdf:system-source-directory "topic-maps") hash)
                                             (equal hash (git:git-commit-hash-of (getf (r:run-context run) :topic-maps-commit)))
                                             (equal r::+topic-maps-commit+ (getf (r:run-context run) :topic-maps-pinned-commit)))))
      (check (list id :case-protocol) (and (eq (r:run-case run) (ev:evaluation-specification-of run))
                                          (eq map (ev:evaluation-result-of run))))
      (check (list id :time-context) (and (ev:evaluation-started-at-of run) (ev:evaluation-finished-at-of run)
                                         (getf (r:run-context run) :image)))
      (check (list id :classification-separation) (and (eq :observed (getf (ev:evaluation-annotation-of run) :comparison))
                                                      (eq :derived (getf (ev:evaluation-annotation-of run) :normative-interpretation))))
      (check (list id :stored-not-current) (search "not executed here" (text run "Execution")))
      (check (list id :selected-target-views-exist)
             (and (selected-references-exist run "Execution")
                  (selected-references-exist map "Topics") (selected-references-exist name "Name")))
      (check (list id :no-invented-span) (not (search "Source span" (text run "Execution"))))
      (check (list id :rendering-does-not-execute) (and (equal before (n:model-state map))
                                                       (= 1 (length (n:executions-of map))) (r:model-state-current-p run)))
      (m:add-name owner "changed after observation" :type type)
      (check (list id :dated-evidence-not-current-claim) (and (not (r:model-state-current-p run))
                                                            (search "changed since" (text run "Execution"))
                                                            (eq :pass (ev:evaluation-status-of run)))))))

(defun pinned-input-checks ()
  ;; A checkout newer than the pin is accepted only where the reading's inputs are the pinned blobs. Control: a path that
  ;; did change since the pin is refused, and one that did not change passes.
  (let* ((root (asdf:system-source-directory "topic-maps"))
         (head (git:trim-git-output (git:git-run-string root "rev-parse" "HEAD")))
         (changed (remove "" (uiop:split-string (git:git-run-string root "diff" "--name-only" r::+topic-maps-commit+ head)
                                               :separator '(#\Newline))
                          :test #'string=))
         (commit (git:make-git-commit :repository (make-instance 'git:git-repository-checkout :root root :root-source :asdf-system-source)
                                      :commit-ish "HEAD")))
    (check :unchanged-input-passes (null (r::%check-pinned-inputs commit (list "reports/slice-12a/execution.json"))))
    (when changed
      (check :changed-input-refused
             (handler-case (progn (r::%check-pinned-inputs commit (list (first changed))) nil)
               (error (condition) (search "no longer the pinned ones" (princ-to-string condition))))))))

(defun generic-and-merge-checks ()
  (let* ((map (m:make-topic-map)) (a (topic map "a")) (b (topic map "b"))
         (x (topic map "x")) (y (topic map "y"))
         (na (m:add-name a "unrelated <Name>" :type x)) (nb (m:add-name b "unrelated <Name>" :type y)))
    (check :arbitrary-map-topics (every (lambda (tpc) (member tpc (refs map "Topics") :test #'eq)) (list a b x y)))
    (check :arbitrary-name-parent (member a (refs na "Name") :test #'eq))
    (check :arbitrary-name-type (member x (refs na "Name") :test #'eq))
    (check :no-fabricated-provenance (and (null (n:executions-of na)) (search "No CTM source" (text na "Evidence"))))
    (check :escaped-values (not (search "<Name>" (text na "Name"))))
    (m:merge-topics a b) (m:merge-topics x y)
    (let ((owner (m:canonical-topic a)) (type (m:canonical-topic x)) (name (m:canonical-topic-name na)))
      (check :name-handles-merged (and (not (eq na name)) (eq name (m:canonical-topic-name nb))))
      (check :retained-topic-links (member owner (refs a "Topic") :test #'eq))
      (check :retained-name-links (member name (refs na "Name") :test #'eq))
      (check :retained-name-parent (member owner (refs nb "Name") :test #'eq))
      (check :retained-name-type (member type (refs nb "Name") :test #'eq))
      (let ((before (n:model-state map)))
        (dolist (object (list a b x y na nb))
          (text object (if (typep object 'm:topic) "Topic" "Name")))
        (check :retained-handles-render-without-mutation (equal before (n:model-state map))))))
  (let ((a (r:read-case "ctm/in/name-type.ctm")) (b (r:read-case "ctm/in/name-type.ctm")))
    (check :separate-executions-not-eq (and (not (eq (r:run-map a) (r:run-map b)))
                                         (not (eq (ev:evaluation-identity-of a) (ev:evaluation-identity-of b)))))
    (check :wrong-run-binding-refused (refuses (lambda () (n:register-execution (r:run-map b) a))))
    (check :no-cross-run-evidence (not (member a (n:executions-of (r:run-map b)) :test #'eq))))
  (let* ((run (r:read-case "ctm/in/name-type.ctm")) (map (r:run-map run))
         (owner (find-if #'m:topic-names (m:topic-map-topics map)))
         (name (first (m:topic-names owner))) (type (m:topic-name-type name))
         (other-owner (topic map "second-owner")) (other-type (topic map "second-type")))
    (m:add-name other-owner "Name" :type other-type)
    (m:merge-topics owner other-owner) (m:merge-topics type other-type)
    (check :retained-name-keeps-original-execution
           (and (not (eq name (m:canonical-topic-name name))) (member run (refs name "Evidence") :test #'eq)))
    (check :retained-topic-keeps-original-execution (member run (refs owner "Evidence") :test #'eq))
    (check :merged-model-is-dated-not-rerun (and (not (r:model-state-current-p run))
                                              (= 1 (length (n:executions-of name)))
                                              (search "changed since" (text run "Execution")))))
  (let ((run (r:read-case "ctm/in/occurrence-datetime-timezone2.ctm")))
    (check :known-mismatch-remains-fail (and (eq :fail (ev:evaluation-status-of run))
                                           (eq :cxtm-mismatch (tf:test-case-actual-outcome (r:run-case run)))
                                           (not (string= (r:run-actual run) (r:run-expected run))))))
  (let* ((run (r:read-case "ctm/in/name.ctm")) (map (r:run-map run))
         (owner (find-if #'m:topic-names (m:topic-map-topics map)))
         (name (first (m:topic-names owner))))
    (setf (char (m:topic-name-value name) 0) #\n)
    (check :snapshot-does-not-alias-mutable-values (not (r:model-state-current-p run)))
    (let ((added (m:add-name owner "Later" :type (m:topic-name-type name))))
      (check :later-items-not-attributed-to-original-source (search "Items added later" (text added "Evidence")))))
  ;; Reader evolution: the former Unsupported fixture is now an original PASS.
  ;; Preserve that support and exercise an actual Unsupported outcome by reading
  ;; the Include original without a resolver. The complete corpus executor has
  ;; a resolver; this bounded reading intentionally does not. No corpus status changes.
  (let ((run (r:read-case "ctm/in/template-topic-nested.ctm")))
    (check :former-unsupported-original-now-pass (eq :pass (ev:evaluation-status-of run))))
  (let ((run (r:read-case "ctm/in/include.ctm")))
    (check :unsupported-not-pass (and (eq :unsupported (ev:evaluation-status-of run))
                                     (null (r:run-map run))
                                     (typep (ev:evaluation-failure-of run) 'topic-maps.ctm:ctm-unsupported)
                                     (eq :resource-resolver-required
                                         (topic-maps.ctm:error-code (ev:evaluation-failure-of run)))))
    (format t "~&LEGACY-UNSUPPORTED-CONTROL: former template-topic-nested=PASS; include without resolver=~A; condition=~A code=~A line=~S column=~S~%"
      (ev:evaluation-status-of run) (type-of (ev:evaluation-failure-of run))
      (topic-maps.ctm:error-code (ev:evaluation-failure-of run))
      (topic-maps.ctm:error-line (ev:evaluation-failure-of run))
      (topic-maps.ctm:error-column (ev:evaluation-failure-of run)))
    (check :unsupported-diagnostic-and-navigation
           (and (search "No model was produced" (text run "Execution"))
                (ev:evaluation-failure-of run) (selected-references-exist run "Execution"))))
  (check :unknown-case-refused (refuses (lambda () (r:read-case "../secret"))))
  (check :invalid-case-not-mislabeled-pass (refuses (lambda () (r:read-case "ctm/invalid/prefix-undefined.ctm")))))

(defun work-checks ()
  (let* ((page (dreyeck/work/reading:work-page "Work Breakdown"))
         (work (r::ctm-work-topic)) (refs (refs work "TMDM model")))
    (check :work-entry-refers-to-existing-topic
           (find "ctm-plan-page-authoring" (refs page "TMDM model")
                 :key (lambda (o) (when (typep o 'dreyeck/work/reading:work-topic)
                                   (dreyeck/topicmap:topicmap-topic-id-of o))) :test #'equal))
    (check :work-default-view-preserved
           (equal (v:view-title (first (v:all-views work)))
                  (v:view-title (first (v:all-views (dreyeck/topicmap:make-topicmap-topic :id "plain" :label "Plain"))))))
    (check :work-uses-defexample-functions (and (member #'r:default-name-example refs :test #'eq)
                                             (member #'r:explicit-name-example refs :test #'eq)))
    (check :example-source-play-button (search "Run example" (text #'r:explicit-name-example "Source code")))))

(defun run-tests ()
  (let ((*checks* nil) (before (snapshot-files)))
    (example-checks) (pinned-input-checks) (generic-and-merge-checks) (work-checks)
    (check :work-sources-unchanged (equalp before (snapshot-files)))
    (check :no-writer-loaded (not (find-package "DREYECK/FEDWIKI-PAGE-AUTHORING")))
    ;; The diagnosis of the missing Edit view is part of DREYECK/WORK/READING since the integration with the
    ;; Item edit path, so it is no longer a foreign module here. The writer must still be absent.
    (check :topic-maps-remains-clean (zerop (length (git:git-run-string (asdf:system-source-directory "topic-maps") "status" "--porcelain"))))
    (format t "~&TMDM-MODEL-NAVIGATION-PASS: ~D assertions, actual references, dated evidence and unchanged sources.~%" (length *checks*))
    t))
