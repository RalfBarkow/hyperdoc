(defpackage #:dreyeck/work/hub-investigation/tests
  (:use #:cl)
  (:local-nicknames (#:h #:dreyeck/work/hubs) (#:work #:dreyeck/work/reading)
                    (#:tm #:dreyeck/topicmap) (#:v #:html-inspector-views)
                    (#:r #:dreyeck/work/trails-rendered-reading/tests))
  (:export #:run-tests))
(in-package #:dreyeck/work/hub-investigation/tests)

(defun refs (object view)
  (let ((references (mapcar #'cdr (v:view-references (r::following-view object view)))))
    (assert (notany (lambda (x) (typep x 'condition)) references))
    references))

(defun run-tests ()
  ;; A preceding Hub reading test already seeded these native objects. Replacing
  ;; them here would create competing test subjects behind a cached Workspace.
  (unless (gethash '("ward.voices.ustawi.wiki" "dewey-alexander-trail") h::*hub-wiki-pages*)
    (dreyeck/work/hubs/tests:seed-hub-wiki-pages))
  (let* ((projection (work:work-projection))
         (topic (find "ward-hub-trail-selection" (tm:topicmap-projection-topics-of projection)
                      :key #'tm:topicmap-topic-id-of :test #'equal))
         (page (work:work-page "From Two Hubs to One Trail")))
    (assert topic)
    (assert (eq page (tm:topicmap-topic-object-of topic)))
    (assert (equal "work item" (getf (tm:topicmap-topic-view-properties-of topic) :kind)))
    (assert (equal "open" (getf (tm:topicmap-topic-view-properties-of topic) :status)))
    (assert (typep (work:topic-source-occurrence topic) 'work:work-topic-source-occurrence))
    (assert (eq (work:work-page "Work Breakdown") (work:topic-occurrence-page (work:topic-source-occurrence topic))))
    (assert (find "work:dogfooding:current-work:ward-hub-trail-selection"
                  (tm:topicmap-projection-associations-of projection) :key #'tm:topicmap-association-id-of :test #'equal))
    (assert (member h::*hub-investigation-plan* (refs page "Content") :test #'eq))
    (assert (typep (work:work-page "Investigating Ward's Hub Selection and Trail") 'hyperdoc::code-page)))
  (let* ((capture (h::hub-page-capture))
         (before (hyperbook/fedwiki::copy-page-json capture))
         (ward-plan (h::hub-wiki-page "next.ward.dojo.fed.wiki" "how-trails-travel" "How Trails Travel"))
         (plan-before (hyperbook/fedwiki::copy-page-json (hyperbook/fedwiki::raw-json-of ward-plan)))
         (plan-view (r::following-view ward-plan "Plan"))
         (plan-text (plump:text (plump:parse (v:view-html plan-view))))
         (plan-refs (mapcar #'cdr (v:view-references plan-view))))
    (dolist (id '("P1" "P2" "P3"))
      (let* ((step (h::hub-investigation-step id))
             (finding (h::hub-investigation-finding id))
             (record (h::finding-record finding)))
        (assert (member step (refs h::*hub-investigation-plan* "Investigation Plan") :test #'eq))
        (assert (member finding (refs step "Investigation step") :test #'eq))
        (assert (member step (refs finding "Investigation evidence") :test #'eq))
        (assert (member capture (refs finding "Investigation evidence") :test #'eq))
        (assert (equal "ward.voices.ustawi.wiki" (gethash "site" record)))
        (assert (equal "dewey-alexander-trail" (gethash "slug" record)))
        (assert (equal h::*hub-capture-digest* (gethash "capture-sha256" record)))
        (dolist (key '("observed" "unsupported" "needed")) (assert (plusp (length (gethash key record)))))
        (assert (null (gethash "confirmed-historical-selection" record)))
        (assert (equal "unknown" (gethash "click-order" record)))
        (assert (equal "unknown" (gethash "executed-mech-revision" record)))
        (assert (equal "unknown" (gethash "executed-solo-revision" record)))))
    (assert (= 3 (length (h::hub-saved-aspects))))
    (assert (equal '("hub 21 john-dewey" "hub 4 christopher-alexander" "New Trail")
                   (map 'list (lambda (a) (gethash "name" a)) (h::hub-saved-aspects))))
    (let* ((graphviz (h::hub-capture-item "94623848847186231296"))
           (dot (gethash "dot" graphviz)))
      (assert (equal dot (gethash "text" graphviz)))
      (assert (gethash "svg" graphviz))
      (assert (search (format nil "3~%6~%10~%14~%") dot))
      (assert (not (search "label=\"Trail\"" dot))))
    (dolist (i '(0 1))
      (let ((props (gethash "props" (gethash "node" (h::hub-node-coordinate i 0)))))
        (assert (gethash "site" props))
        (assert (gethash "title" props))
        (assert (null (gethash "slug" props)))))
    (loop for node across (gethash "nodes" (gethash "graph" (aref (h::hub-saved-aspects) 2))) do
      (assert (= 1 (hash-table-count (gethash "props" node)))))
    (assert (equal '((0 1) (1 2) (2 3))
       (map 'list (lambda (rel) (list (gethash "from" rel) (gethash "to" rel)))
            (gethash "saved-path-relations" (h::finding-record (h::hub-investigation-finding "P2"))))))
    ;; Same array index in two aspects does not identify one node.
    (assert (not (equal (gethash "identity" (h::hub-node-coordinate 0 0))
                        (gethash "identity" (h::hub-node-coordinate 1 0)))))
    ;; A name copied into the New Trail does not carry its former site's identity.
    (let* ((candidate (first (h::hub-trail-name-candidates)))
           (trail (first candidate)) (hub (first (second candidate))))
      (assert (equal (gethash "name" (gethash "props" (gethash "node" trail)))
                     (gethash "name" (gethash "props" (gethash "node" hub)))))
      (assert (not (equal (gethash "identity" trail) (gethash "identity" hub))))
      (assert (null (gethash "site" (gethash "props" (gethash "node" trail)))))
      (assert (gethash "site" (gethash "props" (gethash "node" hub)))))
    ;; Synthetic negative control: two same-name input nodes stay two candidates.
    (let* ((h::*hub-page-capture* (hyperbook/fedwiki::copy-page-json capture))
           (a (h::hub-saved-aspects))
           (name (gethash "name" (gethash "props" (aref (gethash "nodes" (gethash "graph" (aref a 2))) 0)))))
      (setf (gethash "name" (gethash "props" (aref (gethash "nodes" (gethash "graph" (aref a 1))) 0))) name)
      (let ((matches (second (first (h::hub-trail-name-candidates)))))
        (assert (= 2 (length matches)))
        (assert (not (equal (gethash "identity" (first matches)) (gethash "identity" (second matches)))))))
    ;; Present/retained source identities never fill the historical runtime fields.
    (assert (find h::*hub-revision* (h::finding-sources (h::hub-investigation-finding "P3")) :key #'cdr :test #'eq))
    (assert (equal "unknown" (gethash "executed-mech-revision" (h::finding-record (h::hub-investigation-finding "P3")))))
    (assert (equalp before capture))
    (assert (equalp capture (hyperbook/fedwiki::raw-json-of
                            (h::hub-wiki-page "ward.voices.ustawi.wiki" "dewey-alexander-trail" "Dewey Alexander Trail"))))
    (assert (equalp plan-before (hyperbook/fedwiki::raw-json-of ward-plan)))
    ;; Native reference element ids are fresh on each rendering; compare content
    ;; and referents rather than those generated browser identifiers.
    (let ((after (r::following-view ward-plan "Plan")))
      (assert (equal plan-text (plump:text (plump:parse (v:view-html after)))))
      (assert (every #'eq plan-refs (mapcar #'cdr (v:view-references after)))))
    (h::checked-hub-json "dreyeck/work/trails-rendered-evidence/next.ward.dojo.fed.wiki--how-trails-travel.json"
                        "2a98c388653c40c02dd44eb51b55067483dc1e6539e8b5b4074bfc8e8a613b79"))
  (let* ((base (h::hub-learning-projection))
         (workspace (h::hub-and-trail-workspace))
         (projection (tm:topicmap-workspace-projection-of workspace))
         (topics (tm:topicmap-projection-topics-of projection))
         (edges (tm:topicmap-projection-associations-of projection))
         (point (tm:topicmap-workspace-point-of workspace))
         (history (copy-list (tm:topicmap-workspace-history-of workspace))))
    (assert (= 18 (length (tm:topicmap-projection-topics-of base))))
    (assert (= 15 (length (tm:topicmap-projection-associations-of base))))
    (assert (= 26 (length topics))) (assert (= 28 (length edges)))
    (dolist (old (tm:topicmap-projection-topics-of base))
      (let ((new (find (tm:topicmap-topic-id-of old) topics :key #'tm:topicmap-topic-id-of :test #'equal)))
        (assert (eq (tm:topicmap-topic-object-of old) (tm:topicmap-topic-object-of new)))
        (assert (equal (tm:topicmap-topic-label-of old) (tm:topicmap-topic-label-of new)))
        (assert (equalp (tm:topicmap-topic-view-properties-of old) (tm:topicmap-topic-view-properties-of new)))))
    (dolist (old (tm:topicmap-projection-associations-of base))
      (let ((new (find (tm:topicmap-association-id-of old) edges :key #'tm:topicmap-association-id-of :test #'equal)))
        (assert (equalp (tm:topicmap-association-properties-of old) (tm:topicmap-association-properties-of new)))))
    (dolist (id '("investigation-plan" "P1" "P1-evidence" "P2" "P2-evidence" "P3" "P3-evidence"))
      (let ((old-point (tm:topicmap-workspace-point-of workspace)))
        (tm:topicmap-workspace-go-to workspace id)
        (assert (equal old-point (first (tm:topicmap-workspace-history-of workspace))))
        (assert (member (tm:topicmap-workspace-current-object workspace) (refs workspace "Topicmap") :test #'eq))))
    (tm:topicmap-workspace-go-to workspace point)
    (setf (tm:topicmap-workspace-history-of workspace) history))
  (format t "~&HUB-INVESTIGATION-PASS: Work declaration, P1/P2/P3 findings and sources; negative identity/order/runtime controls; preserved original Plan/JSON and 18/15 subjects, extended native Point/History.~%"))
