;;;; Federated Search Without a Central Index Acceptance

(defpackage #:dreyeck/traverse/item-search-tests
  (:use #:cl)
  (:local-nicknames (#:c #:dreyeck/traverse)
                    (#:ct #:dreyeck/traverse/tests)
                    (#:n #:dreyeck/nested-actions)
                    (#:tm #:dreyeck/topicmap)
                    (#:v #:html-inspector-views)
                    (#:git #:dreyeck/git))
  (:export #:run-tests))

(in-package #:dreyeck/traverse/item-search-tests)

(defvar *checks* 0)

(defun check (value &optional (description "item search contract"))
  (incf *checks*)
  (unless value (error "Failed: ~A" description))
  value)

(defparameter +revisions+
  '(("wiki-client" "https://github.com/fedwiki/wiki-client" "d59dbd68c2a539d32add72e06d2fd74e9d6d60c2")
    ("wiki-server" "https://github.com/fedwiki/wiki-server" "251c2881dc91bd11944fe8da4d3817602b60a333")
    ("wiki-plugin-search" "https://github.com/fedwiki/wiki-plugin-search" "62fb3a5068dd1ba7be0e3781fd7c8faddc5a8a55")
    ("search" "https://github.com/WardCunningham/search" "ecb09effc4f1b095abcb8917302d566589cf2c32")))

(defparameter +source-lines+
  '(("plugin:provider" "const defaultSearchProvider = 'query.search.federatedwiki.org'")
    ("plugin:search" "const url = `//${item.site || defaultSearchProvider}/match`")
    ("plugin:search" "$.post(url, request")
    ("plugin:handle" ".on('click', () => search(request))")
    ("crawler:items" "id = item['alias'] || item['id']")
    ("crawler:found" "make.each {|site, count| Dir.mkdir \"sites/#{site}\"}")
    ("crawler:named-sites" "if item['type'] == 'roster'")
    ("crawler:schedule" "0 */6 * * *")
    ("service:match" "post '/match'")
    ("server:site-index" "fields: ['title', 'content'],")
    ("client:search" "fields: ['title', 'content'],"))
  "Lines the text page relies on, in the excerpt that must hold them.")

(defun render (object title)
  (let ((view (find title (v:all-views object) :key #'v:view-title :test #'equal)))
    (check view (format nil "~A view of ~A" title object))
    (v:view-html view)
    (check (notany (lambda (ref) (typep (cdr ref) 'condition)) (v:view-references view))
           (format nil "native references of the ~A view resolve" title))
    view))

(defun ids (occurrences)
  (mapcar (lambda (occurrence) (let ((item (car occurrence))) (list (c::page-site (c::item-page item)) (c::page-slug (c::item-page item)))))
          occurrences))

(defun check-sources ()
  (let ((reading (c::search-sources-reading)))
    (check (eq reading (c::search-sources-reading)) "read once")
    (dolist (expected +revisions+)
      (destructuring-bind (repo authority oid) expected
        (let ((revision (cdr (assoc repo (c::search-revisions reading) :test #'equal))))
          (check (equal authority (git:git-revision-authority-of revision)) (format nil "~A authority" repo))
          (check (equal oid (git:git-commit-hash-of revision)) (format nil "~A full OID" repo)))))
    (check (= 17 (length (c::search-sources reading))))
    (dolist (source (c::search-sources reading))
      (let ((metadata (n:source-metadata source)))
        (check (member (gethash "revision" metadata) (mapcar #'third +revisions+) :test #'equal))
        (check (equal (gethash "path" metadata) (git:git-file-path-of (n:source-revision-file source))))
        (check (member source (git:git-evidence-file-locations-of (n:source-revision-file source)) :test #'eq))
        (render source "Source definition")))
    (dolist (line +source-lines+)
      (check (search (second line) (n:source-text (c::search-source (first line))))
             (format nil "~A holds ~A" (first line) (second line))))
    (check (not (search ".id" (n:source-text (c::search-source "client:extractPageText"))))
           "the client's page text reads item text, never an item's id")))

(defun check-space ()
  (let ((space (c::retained-search-space)))
    (check (equal '("ward.dojo.fed.wiki" "discourse.dreyeck.ch" "found.ward.fed.wiki") (mapcar #'c::site-domain space)))
    (check (equal '(1 110 1) (mapcar (lambda (site) (length (c::site-pages site))) space)))
    (check (equal '(nil t nil) (mapcar #'c::site-complete-p space)) "only discourse.dreyeck.ch is whole, as of its sitemap")
    (dolist (site space) (render site "Searched site"))))

(defun check-searches ()
  (let ((token (c::curiosity-token-search))
        (forked (c::forked-item-search))
        (template (c::template-item-search)))
    (check (eq token (c::recorded-search "cf80b0444c62866e")) "the same execution for the same id")
    (check (equal '(("found.ward.fed.wiki" "curiosity-token")) (ids (c::execution-occurrences token))))
    (check (eq (c::curiosity-item "cf80b0444c62866e") (car (first (c::execution-occurrences token))))
           "the occurrence is the retained item itself")
    (check (equal '(("ward.dojo.fed.wiki" "discourse-graphs") ("discourse.dreyeck.ch" "discourse-graphs"))
                  (ids (c::execution-occurrences forked)))
           "Ward's sentence on two sites")
    (check (not (eq (car (first (c::execution-occurrences forked))) (car (second (c::execution-occurrences forked)))))
           "two occurrences stay two items")
    (check (= 42 (length (c::execution-occurrences template))))
    (check (equal '("discourse.dreyeck.ch") (c::occurrence-sites template)))
    (dolist (execution (list token forked template))
      (check (equal '(1 110 1) (mapcar #'second (c::execution-examined execution))) "every retained page was read")
      (check (every (lambda (occurrence) (eq :id (cdr occurrence))) (c::execution-occurrences execution)))
      (render execution "Search")
      (render (c::index-answer execution) "Open statement")
      (check (eq :not-recorded (c::statement-status (c::index-answer execution))) "the central answer is not recorded"))
    ;; The crawler's rule: an alias stands in for the id.
    (let* ((aliased (c::recorded-search "aa7b131a18ee1583"))
           (by-alias (remove :id (c::execution-occurrences aliased) :key #'cdr)))
      (check (equal '(("discourse.dreyeck.ch" "zachs-lineup")) (ids by-alias)) "the item with that alias matches by alias")
      (check (equal "e48e6c31e9c2d85f" (c::item-id (car (first by-alias)))))
      (check (null (c::execution-occurrences (c::search-item-id "e48e6c31e9c2d85f")))
             "an aliased item is not found by its own id, as the crawler indexes it"))))

(defun check-discovery ()
  (let ((candidates (c::discovery-candidates))
        (space (mapcar #'c::site-domain (c::retained-search-space))))
    (check (= 160 (length candidates)))
    (check (equal "wiki.ralfbarkow.ch" (c::candidate-domain (first candidates))))
    (check (= 44 (length (c::candidate-named-by (first candidates)))))
    (dolist (candidate candidates)
      (check (not (member (c::candidate-domain candidate) space :test #'equal)) "outside the search space")
      (check (not (c::excluded-by-found-p (c::candidate-domain candidate))) "what found.rb would add")
      (check (every (lambda (page) (member (c::candidate-domain candidate) (c::named-sites page) :test #'equal))
                    (c::candidate-named-by candidate))
             "each naming page names it"))
    (check (member "wow.dreyeck.ch" (c::named-sites (c::wiki-page-of "discourse.dreyeck.ch" "discourse-graphs")) :test #'equal)
           "a roster domain is a named site")
    (check (member "ward.dojo.fed.wiki" (c::named-sites (c::wiki-page-of "discourse.dreyeck.ch" "discourse-graphs")) :test #'equal)
           "a fork's site is a named site")
    (check (c::excluded-by-found-p "localhost:3000"))
    (render (first candidates) "Discovery candidate")))

(defun check-projection ()
  (let* ((execution (c::forked-item-search))
         (workspace (c::item-search-topicmap))
         (projection (tm:topicmap-workspace-projection-of workspace))
         (topic-ids (mapcar #'tm:topicmap-topic-id-of (tm:topicmap-projection-topics-of projection)))
         (ward "ward.dojo.fed.wiki/discourse-graphs#31bd93ad173f651c")
         (dreyeck "discourse.dreyeck.ch/discourse-graphs#31bd93ad173f651c"))
    (check (equal ward (tm:topicmap-workspace-point-of workspace)) "Point on the first occurrence")
    (check (member dreyeck topic-ids :test #'equal))
    (check (= (length topic-ids) (length (remove-duplicates topic-ids :test #'equal))))
    (dolist (topic (tm:topicmap-projection-topics-of projection))
      (check (tm:topicmap-topic-object-of topic))
      (check (not (find #\' (tm:topicmap-topic-label-of topic))) "labels survive the view's attribute quoting"))
    (dolist (association (tm:topicmap-projection-associations-of projection))
      (let ((warrant (getf (tm:topicmap-association-properties-of association) :warrant)))
        (check (member (tm:topicmap-association-from-of association) topic-ids :test #'equal))
        (check (member (tm:topicmap-association-to-of association) topic-ids :test #'equal))
        (check (member (getf warrant :status) c::+search-origins+))
        (check (getf warrant :basis))
        (check (getf warrant :source))))
    (flet ((origin (from type to)
             (let ((a (find-if (lambda (a) (and (equal from (tm:topicmap-association-from-of a)) (equal type (tm:topicmap-association-type-of a))
                                                (equal to (tm:topicmap-association-to-of a))))
                               (tm:topicmap-projection-associations-of projection))))
               (and a (getf (getf (tm:topicmap-association-properties-of a) :warrant) :status)))))
      (check (eq :derived (origin ward "same item id on another site" dreyeck)))
      (check (eq :execution (origin "execution:items/31bd93ad173f651c" "observed" ward)))
      (check (eq :execution (origin "execution:items/31bd93ad173f651c" "observed" dreyeck)))
      (check (eq :not-recorded (origin "query:items/31bd93ad173f651c" "would be answered by" "index-answer:items/31bd93ad173f651c")))
      (check (eq :story (origin "discourse.dreyeck.ch/discourse-graphs" "contains" dreyeck))))
    (let ((visited nil))
      (dolist (topic (tm:topicmap-projection-topics-of projection))
        (tm:topicmap-workspace-go-to workspace (tm:topicmap-topic-id-of topic))
        (push (tm:topicmap-topic-id-of topic) visited)
        (check (eq (tm:topicmap-topic-object-of topic) (tm:topicmap-workspace-current-object workspace))))
      (check (equal (subseq (reverse visited) 0 (1- (length visited)))
                    (subseq (reverse (tm:topicmap-workspace-history-of workspace))
                            (- (length (tm:topicmap-workspace-history-of workspace)) (1- (length visited)))))
             "history records the path"))
    ;; From an occurrence to the projection of its page, Point kept on the same item.
    (tm:topicmap-workspace-go-to workspace dreyeck)
    (let ((item (tm:topicmap-workspace-current-object workspace)))
      (c::reproject-on-page workspace (c::item-page item))
      (check (equal dreyeck (tm:topicmap-workspace-point-of workspace)))
      (check (eq item (tm:topicmap-workspace-current-object workspace)) "the page projection holds the same item"))
    (render workspace "Topicmap")
    (check (< 40 (length (tm:topicmap-projection-topics-of (c::item-search-projection (c::template-item-search))))))
    (check execution)))

(defun check-text-page ()
  (let* ((book (hyperbook:find-hyperbook c:+book-id+ :signal-error? t))
         (page (c:companion-page "Federated Search Without a Central Index"))
         (dom (plump-parser:parse (hyperdoc:file-of page)))
         (view (render page "Content")))
    (dolist (tag '("title" "h1"))
      (check (equal "Federated Search Without a Central Index"
                    (plump-dom:text (first (plump-dom:get-elements-by-tag-name dom tag))))))
    (dolist (anchor (plump-dom:get-elements-by-tag-name dom "a"))
      (let ((target (plump-dom:attribute anchor "page"))
            (expression (plump-dom:attribute anchor "expr"))
            (view-title (plump-dom:attribute anchor "view"))
            (href (plump-dom:attribute anchor "href")))
        (when href (check (equal "https://github.com/WardCunningham/search" href)))
        (when target (check (hyperbook:find-page book target :signal-error? nil) (format nil "page link ~A" target)))
        (when expression
          (let* ((*package* (find-package :dreyeck/traverse))
                 (value (eval (read-from-string (plump-dom:decode-entities expression)))))
            (check value (format nil "expression ~A" expression))
            (when view-title (render value view-title))))))
    (let ((code (c:companion-page "Searching Retained Pages for an Item Id")))
      (check (member code (mapcar #'cdr (v:view-references view)) :test #'eq))
      (render code "Source")
      (hyperdoc:load-page code)
      (check (find "Federated Search Without a Central Index" (hyperbook:page-links-of (hyperbook:links-of code))
                   :test #'equal :key #'hyperbook:target-page-of)
             "the code page links back"))
    (check (member page (mapcar #'cdr (v:view-references (render (c:companion-page "Curiosity Token as Topic Map") "Content")))
                   :test #'eq)
           "Curiosity Token as Topic Map leads here")))

(defun run-tests ()
  (setf *checks* 0)
  (let ((actions (ct::call-with-action-guard
                  (lambda ()
                    (check-sources)
                    (check-space)
                    (check-searches)
                    (check-discovery)
                    (check-projection)
                    (check-text-page)))))
    (check (zerop actions) "rendering and searching started no process and opened no connection"))
  (format t "~&ITEM-SEARCH-PASS: ~D checks; 17 sources at 4 revisions, 112 pages on 3 sites searched, 160 sites named.~%"
          *checks*)
  t)
