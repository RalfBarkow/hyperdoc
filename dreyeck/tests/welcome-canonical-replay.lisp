;;;; R1: content equality must survive string storage and persistence boundaries.
(in-package #:dreyeck/work/welcome-development)

(defun r1-string (text element-type)
  (make-array (length text) :element-type element-type :initial-contents text))
(defun r1-copy-strings (value &optional (element-type 'character))
  (typecase value
    (cons (cons (r1-copy-strings (car value) element-type) (r1-copy-strings (cdr value) element-type)))
    (string (r1-string value element-type))
    (t value)))
(defun r1-round-trip (records)
  "Persistence-style new records with EQUAL data; never mutate the originals."
  (mapcar (lambda (record)
            (make-instance (type-of record) :id (r1-copy-strings (record-id record))
                           :source (record-source record) :data (r1-copy-strings (record-data record)))) records))
(defun r1-journal-data (records)
  (mapcar (lambda (r) (list (type-of r) (record-id r) (record-source r) (record-data r))) records))
(defun r1-reviewed-printer (value)
  "Independent oracle only for already-character-string permitted test inputs."
  (with-standard-io-syntax
    (let ((*package* (find-package "KEYWORD"))) (prin1-to-string value))))

(defun r1-round-trip-check (scenario &optional baseline)
  (let* ((records (fixture-records scenario))
         (id-objects (mapcar #'record-id records)) (data-objects (mapcar #'record-data records))
         (before-values (copy-record-data (r1-journal-data records)))
         (before (development-workflow records)) (persisted (r1-round-trip records)))
    (assert (equal (r1-journal-data records) (r1-journal-data persisted)))
    (handler-case
        (let ((after (development-workflow persisted)))
          (assert (equal (development-initial-state before) (development-initial-state after)))
          (assert (eq (development-outcome before) (development-outcome after)))
          (assert (equal (dreyeck/shop3:plans-of (development-plan-result before))
                         (dreyeck/shop3:plans-of (development-plan-result after))))
          (dolist (run (list before after))
            (let ((source (development-records run))
                  (result (development-plan-result run))
                  (objects (mapcar #'dreyeck/topicmap:topicmap-topic-object-of
                                   (dreyeck/topicmap:topicmap-projection-topics-of (development-topicmap run))))
                  (view (development-next-actions run)))
              (html-inspector-views:view-html view)
              (assert (eq :plan-only (dreyeck/shop3:execution-mode-of result)))
              (assert (= (length (dreyeck/shop3:plans-of result)) (length (dreyeck/shop3:raw-plans-of result))
                         (length (dreyeck/shop3:plan-trees-of result)) (length (dreyeck/shop3:final-states-of result))))
              (dolist (r source)
                (assert (member r objects :test #'eq))
                (assert (member r (mapcar #'cdr (html-inspector-views:view-references view)) :test #'eq)))
              (let ((assignments (remove-if-not (lambda (r) (typep r 'dev-assignment)) source)))
                (dolist (r source)
                  (when (member (type-of r) '(dev-submission dev-verification dev-review))
                    (assert (eq (assignment-for r assignments)
                                (find (data r :assignment) source :key #'record-id :test #'equal))))))))
          (format t "~&R1 ~A ~A: EQUAL journal/state/plans, ~D alternatives, record/reference EQ identity, :PLAN-ONLY.~%"
                  (if baseline "BASELINE" "PASS") scenario
                  (length (dreyeck/shop3:plans-of (development-plan-result after)))))
      (invalid-development-record (condition)
        (unless baseline (error condition))
        (assert (eq :assignment-plan-binding-mismatch (first (refusal-reason condition))))
        (format t "~&R1 BASELINE ~A: EQUAL journal refused: ~S~%" scenario (refusal-reason condition))))
    (assert (equal before-values (r1-journal-data records)))
    (loop for r in records for id in id-objects for data in data-objects do
      (assert (eq id (record-id r))) (assert (eq data (record-data r))))
    (assert (every (lambda (r) (member r (development-records before) :test #'eq)) records)))
  t)

(defun run-canonical-replay-baseline ()
  (let* ((base (r1-string "same" 'base-char)) (characters (r1-string "same" 'character)))
    (assert (equal base characters))
    (assert (not (equal (development-canonical-string base) (development-canonical-string characters))))
    (assert (not (equal (development-data-digest base) (development-data-digest characters))))
    (format t "~&R1 BASELINE STRINGS: EQUAL=T; ~S => ~S / ~A; ~S => ~S / ~A.~%"
            (type-of base) (development-canonical-string base) (development-data-digest base)
            (type-of characters) (development-canonical-string characters) (development-data-digest characters)))
  (let* ((prefix (fixture-records :p0))
         (binding (assignment-proposal-binding prefix `(!assign s1 codex ,+fixture-base+)
                                               :domain-version (fixture-version-id prefix)))
         (inputs (getf binding :inputs)) (characters (r1-copy-strings inputs)))
    (assert (equal inputs characters))
    (format t "~&R1 BASELINE P0: stored=~A; same EQUAL inputs all-character=~A; original text=~S; character text=~S.~%"
            (getf binding :digest) (development-data-digest characters)
            (development-canonical-string inputs) (development-canonical-string characters)))
  (dolist (scenario '(:p1 :p4 :p11 :complete)) (r1-round-trip-check scenario t))
  t)

(defun r1-canonical-identity ()
  (let* ((base (fixture-record-key :r1 (r1-string "identity" 'base-char)
                                  (list :nested (r1-string "value" 'base-char))))
         (characters (fixture-record-key :r1 (r1-string "identity" 'character)
                                        (list :nested (r1-string "value" 'character)))))
    (assert (equal base characters))
    (assert (equal 'character (array-element-type base)))
    (assert (equal 'character (array-element-type characters)))
    (format t "~&R1-IDENTITY ~A ~A ~S~%" (development-data-digest base) (text-sha256 base) base)))

(defun run-canonical-replay-tests ()
  (let* ((base (r1-string "same" 'base-char)) (characters (r1-string "same" 'character))
         (adjustable (make-array 9 :element-type 'base-char :adjustable t :fill-pointer 4 :initial-element #\x))
         (displaced (make-array 4 :element-type 'character :displaced-to (r1-string "xsamex" 'character) :displaced-index-offset 1)))
    (replace adjustable base)
    (dolist (text (list base characters adjustable displaced))
      (assert (equal base text))
      (assert (equal (development-canonical-string text) (development-canonical-string characters)))
      (assert (equal (development-data-digest text) (development-data-digest characters)))
      (assert (equal 'character (array-element-type (development-canonical-string text)))))
    (format t "~&R1 STRINGS PASS: EQUAL base/character/adjustable/displaced values share ~S / ~A.~%"
            (development-canonical-string base) (development-data-digest base)))
  (let* ((character-values (list (r1-string "" 'character)
                                 (r1-string "quote\"slash\\" 'character)
                                 (list :nested (r1-string "inner" 'character) (list nil 3 (r1-string "tail" 'character)))
                                 (cons (r1-string "car" 'character) (r1-string "cdr" 'character))))
         (plan-inputs (getf (assignment-proposal-binding (fixture-records :p0)
                              `(!assign s1 codex ,+fixture-base+) :domain-version (fixture-version-id (fixture-records :p0))) :inputs)))
    (dolist (value (append character-values (list (r1-copy-strings plan-inputs))))
      (let* ((all-base (r1-copy-strings value 'base-char))
             (all-characters (r1-copy-strings value))
             (original (copy-record-data value))
             (old-text (r1-reviewed-printer all-characters))
             (expected (development-canonical-string all-characters))
             (digest (development-data-digest all-characters)))
        (assert (equal all-base all-characters))
        (assert (equal expected old-text))
        (assert (equal digest (text-sha256 old-text)))
        (assert (equal expected (development-canonical-string all-base)))
        (assert (equal digest (development-data-digest all-base)))
        (let ((*package* (find-package "CL-USER")) (*print-case* :downcase) (*print-base* 16)
              (*print-readably* nil) (*print-escape* nil) (*print-pretty* t)
              (*print-circle* t) (*print-length* 1) (*print-level* 1) (*print-right-margin* 12))
          (assert (equal expected (development-canonical-string all-base)))
          (assert (equal digest (development-data-digest all-base))))
        (assert (equal original value)))))
  (let* ((unicode (list :unicode (r1-string "Grüsse λ" 'character)))
         (old-text (r1-reviewed-printer unicode)))
    (assert (equal old-text (development-canonical-string unicode)))
    (assert (equal (text-sha256 old-text) (development-data-digest unicode))))
  (format t "~&R1 NESTED/INPUTS PASS: nested strings, actual v2 inputs and Unicode; character-only legacy bytes/digests unchanged; hostile printer settings ignored.~%")
  (dolist (pair (list (list (make-symbol "TRANSIENT") :uninterned-planning-input)
                     (list #\x :nonliteral-planning-input) (list 1.5 :nonliteral-planning-input)
                     (list #() :nonliteral-planning-input) (list #P"/tmp/r1" :nonliteral-planning-input)
                     (list #'identity :nonliteral-planning-input) (list (make-hash-table) :nonliteral-planning-input)))
    (let ((payload (list :nested (first pair))))
      (handler-case (progn (development-canonical-string payload) (error "Expected literal refusal"))
        (invalid-development-record (c) (assert (eq (second pair) (refusal-reason c)))))
      (handler-case (progn (development-data-digest payload) (error "Expected digest refusal"))
        (invalid-development-record (c) (assert (eq (second pair) (refusal-reason c)))))))
  (format t "~&R1 RESTRICTIONS PASS: nested unsupported values and uninterned symbols remain refused.~%")
  (let* ((items (shop3::domain-items (shop3:find-domain 'welcome-development)))
         (prefix (fixture-records :p0))
         (binding (assignment-proposal-binding prefix `(!assign s1 codex ,+fixture-base+)
                                               :domain-version (fixture-version-id prefix))))
    (assert (equal "f342bb4ad3455fac873a56d9a7d817ff35e7ace253527ef7db1068e3759ad315" (domain-version-id items)))
    (assert (equal (text-sha256 (r1-reviewed-printer (r1-copy-strings (getf binding :inputs))))
                   (getf binding :digest)))
    (assert (equal "ba9bbb10531faffdc221f1580360382bec2d39ec2fa6a64b83eb9a771ad48ba5"
                   (getf binding :digest)))
    (assert (equal "welcome-development-plan-v2" (getf binding :format)))
    (format t "~&R1 PINS PASS: domain ~A unchanged; approved character-stable P0 ~A; v2 unchanged.~%"
            (domain-version-id items) (getf binding :digest)))
  ;; The historical mixed-representation digest remains evidence, not an alias.
  ;; Replay must visibly refuse it and leave the retained binding untouched.
  (let* ((records (fixture-records :p1))
         (current (fixture-first-assignment records))
         (old (w2-copy-record current))
         (binding (data old :source-plan))
         (historical "1ebd24a84517314b1087526c13e27518f08f85e0b7e9e67f9185a3e7db3adc61"))
    (setf (getf binding :digest) historical)
    (let ((before (copy-record-data binding)))
      (test-refusal :r1-legacy-binding (substitute old current records :test #'eq)
                    :assignment-plan-binding-mismatch)
      (assert (eq binding (data old :source-plan)))
      (assert (equal before binding))
      (assert (equal historical (getf binding :digest))))
    (format t "~&R1 LEGACY BINDING PASS: historical P0 ~A visibly refused; stored binding unchanged, no digest substitution.~%"
            historical))
  (dolist (scenario '(:p1 :p4 :p11 :complete)) (r1-round-trip-check scenario))
  (r1-canonical-identity)
  t)
