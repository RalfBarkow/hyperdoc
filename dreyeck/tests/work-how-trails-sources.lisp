(in-package #:dreyeck/work/trails-rendered-reading/tests)

(defun seed-how-trails-page ()
  "Fresh-runtime navigation fixture: exact retained original JSON, not a live fetch."
  (let* ((wiki (make-instance 'hyperbook/fedwiki::fedwiki :id "fedwiki:next.ward.dojo.fed.wiki"))
         (page (hyperbook/fedwiki::make-fedwiki-page wiki "how-trails-travel" "How Trails Travel")))
    (setf (hyperbook/fedwiki::status-of wiki) t
          (gethash "next.ward.dojo.fed.wiki" hyperbook/fedwiki::*neighborhood*) wiki
          (gethash "how-trails-travel" (hyperbook/fedwiki::pages-of wiki)) page)
    (setf (hyperbook::hyperbooks-of hyperbook::*catalog*)
          (remove "fedwiki:next.ward.dojo.fed.wiki"
                  (hyperbook::hyperbooks-of hyperbook::*catalog*)
                  :key #'hyperbook:id-of :test #'equal))
    ;; Only a navigation skeleton for the separate, uninspected Wiki-link target.
    ;; No claim about that page's content; original How Trails Travel stays exact.
    (setf (gethash "graceful-polyline" (hyperbook/fedwiki::pages-of wiki))
          (hyperbook/fedwiki::make-fedwiki-page wiki "graceful-polyline" "Graceful Polyline"))
    (hyperbook/fedwiki::set-page-data page
      (reading::read-observation "dreyeck/work/trails-rendered-evidence/next.ward.dojo.fed.wiki--how-trails-travel.json"))
    page))

(defun check-how-trails-sources ()
  (let* ((original-catalog hyperbook::*catalog*)
         (hyperbook::*catalog* (make-instance 'hyperbook::catalog))
         (hyperbook/fedwiki::*neighborhood* (make-hash-table :test #'equal)))
    (setf (hyperbook::factories-of hyperbook::*catalog*)
          (hyperbook::factories-of original-catalog)
          (hyperbook::hyperbooks-of hyperbook::*catalog*)
          (copy-list (hyperbook::hyperbooks-of original-catalog)))
  (let* ((page (seed-how-trails-page))
         (before (hyperbook/fedwiki::copy-page-json (hyperbook/fedwiki::raw-json-of page)))
         (sources (reading::how-trails-sources page))
         (book (hyperbook:find-hyperbook "dreyeck/work/reading")))
    (assert (eq sources (reading::how-trails-sources page)))
    (assert (= 4 (length sources)))
    (multiple-value-bind (text view) (render-page book "How Trails Travel")
      (declare (ignore text))
      (assert (member page (mapcar #'cdr (views:view-references view)) :test #'eq))
      (assert (find-if (lambda (o) (and (hash-table-p o) (gethash "cases" o)))
                      (mapcar #'cdr (views:view-references view)))))
    (let ((story (views:view-html (following-view page "Story")))
          (links (views:view-html (hyperbook::👀links (hyperbook:links-of page)))))
      (dolist (source sources)
        (assert (search (reading::how-source-url source) story))
        (assert (search (reading::how-source-url source) links))))
    (following-view page "Links")
    (following-view page "Source references")
    (loop for source in sources
          for (id name start end anchor) in
          '(("f6ed717454f29690" "window.dochoose" 107 107 "#L107")
            ("d1b0aa5e1a47349e" "display" 182 227 "#L182-L227")
            ("fcbf4b3a2dcbe81b" "composite" 318 378 "#L318-L378")
            ("d41b9ef67e45521e" "dotify" 382 446 "#L382-L446")) do
      (assert (equal name (reading::how-source-name source)))
      (assert (equal anchor (subseq (reading::how-source-url source)
                                   (- (length (reading::how-source-url source)) (length anchor)))))
      (assert (typep source 'reading::trail-source-fragment))
      (assert (equal id (hyperbook/fedwiki::id-of (reading::how-source-item source))))
      (assert (= start (gethash :start-line (reading::fragment-metadata source))))
      (assert (= end (gethash :end-line (reading::fragment-metadata source))))
      (assert (equal (reading::fragment-text source)
                     (format nil "~{~A~%~}"
                             (subseq (uiop:read-file-lines
                                      (reading::following-path "assets/hyperbook/fedwiki/mech-host/plugins/solo/dialog/index.html"))
                                     (1- start) end))))
      (let ((refs (mapcar #'cdr (views:view-references
                                (following-view (reading::how-source-item source) "Source reference")))))
        (assert (member source refs :test #'eq)))
      (let ((refs (mapcar #'cdr (views:view-references (following-view source "Source reference")))))
        (assert (member reading::*how-trails-revision* refs :test #'eq))
        (assert (member reading::*how-trails-file* refs :test #'eq))
        (assert (member (hyperbook:find-page book "How Trails Travel") refs :test #'eq))))
    (assert (equal (dreyeck/git:git-revision-identity reading::*how-trails-revision*)
                   '("https://github.com/WardCunningham/wiki-plugin-solo"
                     "17915844349bada64c901bd5ea73472702c446f9")))
    (assert (equal "client/dialog/index.html" (dreyeck/git:git-file-path-of reading::*how-trails-file*)))
    (following-view reading::*how-trails-file* "Evidence locations")
    (following-view reading::*how-trails-revision* "Evidence revision")
    ;; A same-slug page on another site and an unrelated item get no added views.
    (let* ((wiki (make-instance 'hyperbook/fedwiki::fedwiki :id "fedwiki:example.invalid"))
           (other (hyperbook/fedwiki::make-fedwiki-page wiki "how-trails-travel" "Other")))
      (assert (null (reading::how-trails-page-sources other)))
      (assert (null (reading::how-trails-page-sources
                     (hyperbook/fedwiki::make-fedwiki-page (hyperbook:hyperbook-of page)
                                                         "another-page" "Another page"))))
      (assert (null (reading::how-trails-item-source
                     (hyperbook/fedwiki::make-story-item
                      (alexandria:plist-hash-table '("type" "paragraph" "id" "f6ed717454f29690" "text" "Other") :test 'equal))))))
    (assert (equalp before (hyperbook/fedwiki::raw-json-of page)))
    (dolist (entry '(("dreyeck/work/trails-rendered-evidence/next.ward.dojo.fed.wiki--how-trails-travel.json" "2a98c388653c40c02dd44eb51b55067483dc1e6539e8b5b4074bfc8e8a613b79")
                     ("dreyeck/work/solo-trail-identity.json" "912d7ab4c1b7ed062107a18890eff36f625c154fa9e46969f2fd5f1206d2ce84")))
      (assert (equal (second entry) (ironclad:byte-array-to-hex-string
                    (ironclad:digest-file :sha256 (reading::following-path (first entry))))))))
  (format t "~&HOW-TRAILS-SOURCES-PASS: original Story/Links, four exact ranges, Git/source/reading navigation, page-local scope, unchanged evidence.~%")))

(defun check-direct-how-trails-sources ()
  (let* ((original-catalog hyperbook::*catalog*)
         (hyperbook::*catalog* (make-instance 'hyperbook::catalog))
         (hyperbook/fedwiki::*neighborhood* (make-hash-table :test #'equal))
         (reading::*how-trails-sources* (make-hash-table :test #'eq))
         (locations (copy-list (dreyeck/git:git-evidence-file-locations-of reading::*how-trails-file*))))
    (setf (hyperbook::factories-of hyperbook::*catalog*) (hyperbook::factories-of original-catalog)
          (hyperbook::hyperbooks-of hyperbook::*catalog*) (copy-list (hyperbook::hyperbooks-of original-catalog)))
    (unwind-protect
        (let* ((page (seed-how-trails-page))
               (raw (hyperbook/fedwiki::copy-page-json (hyperbook/fedwiki::raw-json-of page))))
          ;; No how-trails-sources or page-wide Source references call prepares this.
          (assert (zerop (hash-table-count reading::*how-trails-sources*)))
          (dolist (coordinates reading::*how-trails-coordinates*)
            (assert (null (reading::how-trails-item-source
                           (find (first coordinates) (hyperbook/fedwiki::story-of page)
                                 :key #'hyperbook/fedwiki::id-of :test #'equal)))))
          (let* ((view (hyperbook/fedwiki::👀story page))
                 (html (views:view-html view))
                 (refs (mapcar #'cdr (views:view-references view)))
                 (sources (cdr (gethash page reading::*how-trails-sources*))))
            (assert (= 4 (length sources)))
            (dolist (source sources)
              (let ((item (reading::how-source-item source)))
                (assert (member item refs :test #'eq))
                (assert (search (format nil "Inspect story item ~A" (hyperbook/fedwiki::id-of item)) html))
                (assert (member source (mapcar #'cdr (views:view-references
                                       (following-view item "Source reference"))) :test #'eq))))
            (views:view-html (hyperbook/fedwiki::👀story page))
            (assert (eq sources (cdr (gethash page reading::*how-trails-sources*)))))
          ;; Three reloads replace references for this page; old item identities
          ;; cannot inherit the new item's reference, despite matching IDs.
          (dotimes (i 3)
            (let ((old-items (mapcar #'reading::how-source-item
                                    (cdr (gethash page reading::*how-trails-sources*)))))
              (hyperbook/fedwiki::set-page-data page raw)
              (views:view-html (hyperbook/fedwiki::👀story page))
              (assert (= 1 (hash-table-count reading::*how-trails-sources*)))
              (assert (= (+ 4 (length locations))
                         (length (dreyeck/git:git-evidence-file-locations-of reading::*how-trails-file*))))
              (dolist (old old-items) (assert (null (reading::how-trails-item-source old))))))
          (assert (equalp raw (hyperbook/fedwiki::raw-json-of page)))
          (let* ((wiki (make-instance 'hyperbook/fedwiki::fedwiki :id "fedwiki:other.invalid"))
                 (other (hyperbook/fedwiki::make-fedwiki-page wiki "how-trails-travel" "Other"))
                 (json (alexandria:plist-hash-table
                        (list "title" "Other" "story" (vector (aref (gethash "story" raw) 2))
                              "journal" #()) :test 'equal)))
            (hyperbook/fedwiki::set-page-data other json)
            (let ((html (views:view-html (hyperbook/fedwiki::👀story other))))
              (assert (not (search "Inspect story item" html))))
            (assert (null (reading::how-trails-item-source (aref (hyperbook/fedwiki::story-of other) 0))))))
      (setf (dreyeck/git:git-evidence-file-locations-of reading::*how-trails-file*) locations)))
  (format t "~&HOW-TRAILS-DIRECT-PASS: cold load, Story establishes exact-item refs, no page-wide view, repeat/reload bounded, foreign items untouched.~%"))

(defun check-how-trails-plan ()
  (let* ((page (seed-how-trails-page))
         (before (hyperbook/fedwiki::copy-page-json (hyperbook/fedwiki::raw-json-of page)))
         (plan (following-view page "Plan"))
         (html (views:view-html plan))
         (items (reading::how-trails-section page "plan"))
         (refs (mapcar #'cdr (views:view-references plan)))
         (ids '("f6ed717454f29690" "d60bd1c1d8fdd32b" "fc195fe5fbc3592f"
                "d1b0aa5e1a47349e" "fcbf4b3a2dcbe81b" "d41b9ef67e45521e"
                "db592e6139141964" "93dc48d83a96cd61" "8771026b69762044" "aac36e1826b25199")))
    (assert (equal ids (mapcar #'hyperbook/fedwiki::id-of items)))
    (assert (apply #'< (mapcar (lambda (id) (search (format nil "Plan step ~A" id) html)) ids)))
    (dolist (item items)
      (assert (member item refs :test #'eq))
      (let* ((view (following-view item "Plan step"))
             (text (views:view-html view))
             (links (mapcar #'cdr (views:view-references view))))
        (dolist (label '("Existing implementation" "Executed observation" "Ward's announced change" "Open question"))
          (assert (search (cl-who:escape-string label) text)))
        (assert (member page links :test #'eq))
        (assert (member item links :test #'eq))))
    (dolist (source (reading::how-trails-sources page))
      (let ((view (following-view (reading::how-source-item source) "Plan step")))
        (assert (member source (mapcar #'cdr (views:view-references view)) :test #'eq))))
    (let* ((item (third items)) (view (following-view item "Plan step"))
           (links (mapcar #'cdr (views:view-references view))))
      (assert (search "proposed, not implemented" (views:view-html view)))
      (assert (member (reading::how-trails-execution) links :test #'eq))
      (loop for case across (gethash "cases" (reading::how-trails-execution)) do
        (assert (member (gethash "complex" case) links :test #'eq))
        (assert (not (gethash "trails" (gethash "complex" case))))))
    (let* ((view (following-view page "Refactor"))
           (text (views:view-html view))
           (links (mapcar #'cdr (views:view-references view))))
      (assert (search "Graphviz is called by display, not by dotify" text))
      (assert (search "interpretive proposal, not implemented architecture" text))
      (assert (member (first (reading::how-trails-section page "refactor")) links :test #'eq))
      (assert (member reading::*how-trails-file* links :test #'eq))
      (dolist (source (reading::how-trails-sources page)) (assert (member source links :test #'eq))))
    (dolist (other (list (hyperbook/fedwiki::make-fedwiki-page
                          (make-instance 'hyperbook/fedwiki::fedwiki :id "fedwiki:other.invalid")
                          "how-trails-travel" "Foreign page")
                        (hyperbook/fedwiki::make-fedwiki-page (hyperbook:hyperbook-of page) "other" "Other")))
      (assert (null (reading::how-trails-plan other)))
      (assert (null (reading::how-trails-refactor other))))
    ;; Replaced items cannot inherit context by ID alone.
    (let ((old (first items)))
      (hyperbook/fedwiki::set-page-data page before)
      (assert (null (reading::how-trails-step old))))
    (assert (equalp before (hyperbook/fedwiki::raw-json-of page))))
  (format t "~&HOW-TRAILS-PLAN-PASS: ten ordered original items, four source refs, retained evidence, scoped views, return links, no JSON mutation.~%"))

(defun check-javascript-definitions ()
  (let* ((page (seed-how-trails-page))
         (source (third (reading::how-trails-sources page)))
         (composite (reading::how-trails-composite-definition))
         (merge (first (reading::javascript-definition-children composite)))
         (mergeprops (first (reading::javascript-definition-children merge)))
         (bytes (alexandria:read-file-into-byte-vector
                 (reading::following-path "assets/hyperbook/fedwiki/mech-host/plugins/solo/dialog/index.html"))))
    (assert (eq composite (reading::how-trails-composite-definition)))
    (assert (member composite (mapcar #'cdr (views:view-references
                                           (following-view (reading::how-source-item source) "Source reference"))) :test #'eq))
    (assert (eq (reading::javascript-definition-parent merge) composite))
    (assert (eq (reading::javascript-definition-parent mergeprops) merge))
    (assert (null (reading::javascript-definition-children mergeprops)))
    (assert (member composite (mapcar #'cdr (views:view-references
                                           (following-view source "Source reference"))) :test #'eq))
    (loop for def in (list composite merge mergeprops)
          for lines in '((318 378) (328 377) (330 349)) do
      (let* ((metadata (reading::fragment-metadata def))
             (data (gethash "definition" metadata))
             (view (following-view def "Function definition"))
             (html (views:view-html view))
             (refs (mapcar #'cdr (views:view-references view))))
        (assert (equal lines (list (gethash "startLine" data) (gethash "endLine" data))))
        (assert (equal (reading::fragment-text def)
                       (babel:octets-to-string (subseq bytes (gethash "fileStartByte" data)
                                                      (gethash "fileEndByte" data)) :encoding :utf-8)))
        (assert (search (cl-who:escape-string (reading::fragment-text def)) html))
        (assert (equal (subseq (reading::javascript-definition-identity def) 0 3)
                       '("https://github.com/WardCunningham/wiki-plugin-solo"
                         "17915844349bada64c901bd5ea73472702c446f9" "client/dialog/index.html")))
        (assert (eq reading::*how-trails-file* (reading::fragment-revision-file def)))
        (assert (member reading::*how-trails-revision* refs :test #'eq))
        (assert (member page refs :test #'eq))
        (assert (member (reading::how-source-item source) refs :test #'eq))
        (if (eq def composite)
            (assert (member (reading::how-trails-execution) refs :test #'eq))
            (progn (assert (not (member (reading::how-trails-execution) refs :test #'eq)))
                   (assert (search "not an isolated test" html))))))
    ;; Exercise the real runtime validator with independently corrupted evidence.
    (flet ((reject (mutator &optional (source-bytes bytes))
             (let ((record (reading::read-observation "dreyeck/work/how-trails-definitions.json")))
               (funcall mutator record)
               (assert (handler-case
                           (progn (reading::validate-how-trails-definitions record source-bytes) nil)
                         (error () t))))))
      (reject (lambda (r) (setf (gethash "path" (gethash "source" r)) "wrong.html")))
      (reject (lambda (r) (setf (gethash "oid" (gethash "source" r)) (make-string 40 :initial-element #\0))))
      (dolist (field '("fileStartByte" "fileEndByte" "astStart" "fileStartUtf16" "startLine" "startColumn"))
        (reject (lambda (r) (setf (gethash field (aref (gethash "definitions" r) 0)) -1))))
      (reject (lambda (r) (setf (gethash "parent" (aref (gethash "definitions" r) 1)) "wrong")))
      (reject (lambda (r) (setf (gethash "text" (aref (gethash "definitions" r) 0)) "wrong")))
      (let ((changed (copy-seq bytes)))
        (setf (aref changed 1500) (logxor 1 (aref changed 1500)))
        (reject #'identity changed))))
  (format t "~&JAVASCRIPT-DEFINITIONS-PASS: stable identities, complete spans, lexical containment, native source/Git/Story/evidence links; wrong identities, bytes, spans and parents rejected.~%"))
