(defpackage #:dreyeck/work/fedwiki-local-only/tests
  (:use #:cl)
  (:local-nicknames (#:i #:dreyeck/work/fedwiki-local-only) (#:h #:dreyeck/shop3)
                    (#:d #:dreyeck/work/defederation-planning)
                    (#:r #:dreyeck/work/local-only-resolution)
                    (#:fw #:hyperbook/fedwiki) (#:hb #:hyperbook) (#:v #:html-inspector-views))
  (:export #:run-tests))
(in-package #:dreyeck/work/fedwiki-local-only/tests)
(defun assert-condition (type thunk)
  (let ((caught nil))
    (handler-case (funcall thunk) (error (c) (unless (typep c type) (error c)) (setf caught c)))
    (assert caught) caught))
(defun has-step (result symbol)
  (find symbol (first (h:plans-of result)) :key #'first))
(defun check-plan (result)
  (assert (typep result 'h:hyperdoc-htn-plan-result))
  (assert (eq :plan-only (h:execution-mode-of result)))
  (assert (= 1 (length (h:plans-of result)) (length (h:plan-trees-of result))
             (length (h:final-states-of result)))) result)
(defun refs (object title)
  (let ((view (if (equal title "Slots") (html-inspector-views/standard:👀slots object)
                  (find title (v:all-views object) :key #'v:view-title :test #'equal))))
    (assert view) (v:view-html view) (mapcar #'cdr (v:view-references view))))
(defun check-evidence-view (obs expected absent)
  (let* ((view (find "Local-only evidence" (v:all-views obs) :key #'v:view-title :test #'equal))
         (html (v:view-html view))
         (references (mapcar #'cdr (v:view-references view)))
         (results (remove-duplicates
                   (remove nil (append (list (i:preparation-result obs) (i:resolution-result obs))
                                       (i::history-of obs))) :test #'eq)))
    (dolist (text (append '(">Observation</h3>" ">External evidence</h3>"
                           ">Planning — not executed</h3>" "max-width: 72ch" "flex-wrap: wrap" "<dl") expected))
      (assert (search text html) () "Missing view text: ~A" text))
    (dolist (text absent) (assert (not (search text html)) () "Unexpected view text: ~A" text))
    (assert (not (search "table-layout: fixed" html)))
    (assert (not (search "overflow-wrap: anywhere" html)))
    (dolist (object (list (i::own-site-of obs) (i:observed-page obs) (i:observed-item obs)
                          (i:target-link obs) (i:target-page obs) (i::failure-of obs)
                          (i::source-of (i:observed-page obs)) (i::local-evidence-of obs)
                          (i::evidence-of obs) (getf (i::evidence-of obs) :copies)
                          (i::facts-of obs) (i::candidates-of obs)))
      (assert (member object references :test #'eq)))
    (assert (= (length results) (length (cl-ppcre:all-matches-as-strings "<details" html))))
    (dolist (result results)
      ;; No duplicate overview/history links for the same planning result.
      (assert (= 1 (count result references :test #'eq)))
      (dolist (object (list (shop3:find-problem (h:problem-name-of result))
                            (h:plans-of result) (h:final-states-of result)))
        (assert (member object references :test #'eq))))
    ;; Keep long representations behind links, including the complete verified digest.
    (dolist (copy (getf (i::evidence-of obs) :copies))
      (assert (not (search (getf copy :sha256) html))))
    (assert (not (search "!SIMULATE-FORK" html)))
    html))
(defun run-tests ()
  (let* ((root (asdf:system-relative-pathname "dreyeck/work/fedwiki-local-only"
                  "dreyeck/tests/fixtures/fedwiki-local-only/"))
         (files (append (uiop:directory-files root)
                        (uiop:directory-files (merge-pathnames "pages/" root))
                        (uiop:directory-files (merge-pathnames "snapshots/" root))))
         (before (mapcar #'dreyeck/local-fedwiki-page::%read-octets files))
         (socket-count 0) (fallback-count 0)
         (symbols '(usocket:socket-connect sb-bsd-sockets:socket-connect
                    fw::get-plugin-page fw::get-fedwiki))
         (originals (mapcar #'symbol-function symbols)))
    (unwind-protect
         (progn
           (loop for symbol in symbols for index from 0 do
             (let ((socketp (< index 2)))
               (setf (symbol-function symbol)
                     (lambda (&rest args)
                       (declare (ignore args))
                       (if socketp (incf socket-count) (incf fallback-count))
                       (error "Forbidden network or fallback call.")))))
           ;; Prove the transport hook catches a call before evaluating fixtures.
           (assert-condition 'simple-error (lambda () (usocket:socket-connect "invalid.test" 443)))
           (assert (= 1 socket-count)) (setf socket-count 0)
           ;; The Catalog's fixture object is stable and already planned once at load.
           (let ((catalog (i:catalog-observation)))
             (assert (eq catalog (i:catalog-observation)))
             (assert (eq :confirmed-local-absence (i:finding catalog)))
             (assert (null (i:target-page catalog)))
             (assert (eq :plan-only (h:execution-mode-of (i:preparation-result catalog))))
             (assert (eq :plan-only (h:execution-mode-of (i:resolution-result catalog))))
             (check-evidence-view catalog
               '(":CONFIRMED-LOCAL-ABSENCE" ":HYPOTHETICAL-LOCAL" ":PLAN-ONLY")
               '("No external evidence supplied" "No planning results")))
           (let* ((site (i:make-own-site root "fedwiki:local"))
                  (evidence (merge-pathnames "evidence.json" root))
                  (local (i:observe-link site "source" 0))
                  (missing (i:observe-link site "source" 1 :evidence-file evidence))
                  (remote (i:observe-link site "source" 2 :evidence-file evidence
                                          :reader-origin "fedwiki:local" :panel-site "fedwiki:local")))
             (check-evidence-view local
               '(":OBSERVED-LOCAL" "found a real page" "Observed local page" "No external evidence supplied" "Not planned" "No planning results")
               '(":CONFIRMED-LOCAL-ABSENCE" ":HYPOTHETICAL-LOCAL" ":PLAN-ONLY" "Externally claimed:"))
             (check-evidence-view missing
               '(":CONFIRMED-LOCAL-ABSENCE" "NIL" "Externally claimed:" "1 verified cached" "Digest integrity does not prove historical remote origin" ":NOT-PLANNED")
               '(":HYPOTHETICAL-LOCAL" ":PLAN-ONLY"))
             (check-evidence-view (i:observe-link site "source" 3)
               '(":UNKNOWN" "availability remains unknown" "Inspect read failure" "No external evidence supplied" "No planning results")
               '(":CONFIRMED-LOCAL-ABSENCE" "confirmed absence" ":HYPOTHETICAL-LOCAL" ":PLAN-ONLY"))
             (assert (eq :observed-local (i:finding local)))
             (assert (typep (i:observed-page local) 'dreyeck/local-fedwiki-page:local-fedwiki-page))
             (assert (typep (i:observed-item local) 'fw::story-item))
             (assert (null (fw::context-of (i:observed-page local))))
             (assert (= 2 (length (gethash "journal" (fw::raw-json-of (i:observed-page local))))))
             (assert (equal "remote-item" (gethash "site" (fw::data-of (i:observed-item local)))))
             (assert (has-step (check-plan (i:resolve-link local)) 'r::!open-panel))
             (assert (not (has-step (check-plan (i:prepare-link local)) 'd::!simulate-fork)))
             (check-evidence-view local
               '(":OBSERVED-LOCAL" ":OBSERVED-AVAILABILITY" ":PLAN-ONLY" "Observed local page")
               '(":HYPOTHETICAL-LOCAL" ":CONFIRMED-LOCAL-ABSENCE" "NIL — no target page object"))
             (assert (eq :confirmed-local-absence (i:finding missing)))
             (assert (has-step (check-plan (i:resolve-link missing)) 'r::!conclude-unresolved))
             ;; Exercise the real HyperBook wiki-link thunk, not just the planner.
             (assert (typep (v:eval-thunk (hb:thunk-of (i:target-link local))) 'i::own-page))
             (assert (typep (v:eval-thunk (hb:thunk-of (i:target-link remote))) 'condition))
             (assert (null (fw::lookup-slug-in-page-context "remote-only" (i:observed-page remote))))
             (let ((local-plan (check-plan (i:resolve-link remote)))
                   (collaborative (check-plan (i:resolve-link remote :policy :collaborative))))
               (assert (has-step local-plan 'r::!conclude-unresolved))
               (assert (equal '("fedwiki:local")
                              (loop for step in (first (h:plans-of local-plan))
                                    when (eq (car step) 'r::!request) collect (third step))))
               (assert (equal '("fedwiki:local" "remote-item" "remote-new" "remote-old")
                              (mapcar #'car (i::candidates-of remote))))
               (assert (equal '("fedwiki:local" "remote-item")
                              (loop for step in (first (h:plans-of collaborative))
                                    when (eq (car step) 'r::!request) collect (third step))))
               (format t "~&LOCAL-ONLY NO-FALLBACK / COLLABORATIVE ORDER PASS ~S~%" (h:plans-of collaborative)))
             ;; Explicit own-site remains independent of the reader's Java origin.
             (let ((different (i:observe-link site "source" 0 :reader-origin "reader" :panel-site "panel")))
               (assert (equal "reader" (caar (i::candidates-of different))))
               (assert (has-step (check-plan (i:resolve-link different)) 'r::!open-panel))
               (assert (null (h:plans-of (i:resolve-link different :policy :collaborative)))))
             (let* ((prepared (check-plan (i:prepare-link missing :repeat 2)))
                    (continued (check-plan (i:continue-preparation missing prepared)))
                    (resolution (check-plan (i:resolve-link missing :prepared prepared)))
                    (atoms (shop3:state-atoms (first (h:final-states-of prepared)))))
               (check-evidence-view missing
                 '(":CONFIRMED-LOCAL-ABSENCE" "NIL" "Externally claimed:" ":HYPOTHETICAL-LOCAL" ":PLAN-ONLY"
                   "no Wiki page was materialized by these plans" "SHOP3 problem" "Planned operations" "Simulated final states")
                 '("No external evidence supplied" "No planning results"))
               (assert (= 1 (count 'd::!simulate-fork (first (h:plans-of prepared)) :key #'first)))
               (assert (not (has-step continued 'd::!simulate-fork)))
               (assert (has-step resolution 'r::!use-modeled-page))
               (assert (subsetp (i::facts-of missing) atoms :test #'equal))
               (assert (not (find 'd::local-page atoms :key #'car)))
               (assert (null (hb:find-page site "missing")))
               (assert (eq :confirmed-local-absence (i:finding (i:observe-link site "source" 1))))
               (assert (has-step (check-plan (i:resolve-link missing)) 'r::!conclude-unresolved))
               (format t "~&LOCAL-ONLY FORK ONCE / CONTINUATION PASS~%Plans ~S~%Trees ~S~%Final ~S~%"
                       (h:plans-of prepared) (h:plan-trees-of prepared) atoms)
               (assert-condition 'i:invalid-continuation (lambda () (i:continue-preparation local prepared)))
               (assert-condition 'i:invalid-continuation (lambda () (i:continue-preparation missing atoms)))
               (assert-condition 'i:invalid-continuation
                 (lambda () (i:continue-preparation missing (d:plan-defederation (d:scenario-state :b)))))
               (let ((states (h:final-states-of prepared)))
                 (unwind-protect
                      (progn (setf (slot-value prepared 'h::final-states) nil)
                             (assert-condition 'i:invalid-continuation
                               (lambda () (i:continue-preparation missing prepared))))
                   (setf (slot-value prepared 'h::final-states) states)))
               (let ((references (refs missing "Local-only evidence")))
                 (dolist (object (list (i:observed-page missing) (i:observed-item missing) (i:target-link missing)
                                       (i::source-of (i:observed-page missing)) (i::evidence-of missing)
                                       (i::local-evidence-of missing) continued resolution
                                       (h:final-states-of continued) (h:plans-of continued)
                                       (shop3:find-problem (h:problem-name-of continued))))
                   (assert (member object references :test #'eq))))
               (refs (i:observed-page missing) "Story")
               (dolist (result (list prepared continued resolution))
                 (let ((references (refs result "Slots")))
                   (assert (member (h:plan-trees-of result) references :test #'eq))
                   (assert (member (h:final-states-of result) references :test #'eq)))))
             (dolist (predicate '(d::modeled-local-page d::modeled-fork d::local-links-prepared
                                  d::paragraph-rendering-prepared r::planned-fork r::candidate r::!request))
               (assert-condition 'i:invalid-observation
                 (lambda () (i:observe-link site "source" 1 :facts (list (list predicate "fedwiki:local" "missing"))))))
             (assert-condition 'i:invalid-observation
               (lambda () (i:observe-link site "source" 1 :facts '((d::fork-permitted "fedwiki:local" "missing")))))
             (dolist (file '("bad-digest.json" "injected.json"))
               (assert-condition 'i:invalid-observation
                 (lambda () (i:observe-link site "source" 1 :evidence-file (merge-pathnames file root)))))
             (assert-condition 'program-error
               (lambda () (funcall (symbol-function 'i:prepare-link) missing :tasks '((d::!simulate-fork)))))
             (dolist (status '(500 302 "transport"))
               (let ((unknown (i:observe-link site "source" 3
                                :evidence-file (merge-pathnames (format nil "evidence-~A.json" status) root))))
                 (assert (eq :unknown (i:finding unknown)))
                 (assert (i::failure-of unknown))
                 (assert (not (find 'd::local-page-absent (i::facts-of unknown) :key #'car)))
                 (assert (null (h:plans-of (i:prepare-link unknown))))
                 (assert (null (h:plans-of (i:resolve-link unknown))))
                 (check-evidence-view unknown '(":UNKNOWN" ":NO-PLAN" "0 complete plan(s)" ":PLAN-ONLY")
                                      '(":CONFIRMED-LOCAL-ABSENCE" ":HYPOTHETICAL-LOCAL"))))
             (let ((facts (i::facts-of local)))
               (unwind-protect
                    (progn (push '(d::modeled-local-page "fedwiki:local" "target") (slot-value local 'i::facts))
                           (assert-condition 'i:invalid-continuation (lambda () (i:prepare-link local))))
                 (setf (slot-value local 'i::facts) facts)))
             (format t "~&LOCAL-ONLY VIEW-SECTIONS / STATUS-VARIANTS / UNIQUE-RESULTS / REFERENCE-EQ PASS~%")
             (format t "~&LOCAL-ONLY INPUT-GUARD / PROVENANCE / UNKNOWN / INSPECTOR-EQ PASS~%"))
           (assert (zerop socket-count)) (assert (zerop fallback-count))
           (assert (every #'equalp before (mapcar #'dreyeck/local-fedwiki-page::%read-octets files)))
           (format t "~&LOCAL-ONLY-NETWORK-PASS: ~D socket attempts, ~D plugin/context attempts; source loading included; fixture bytes unchanged.~%"
                   socket-count fallback-count))
      (loop for symbol in symbols for original in originals do (setf (symbol-function symbol) original))))
  (format t "~&LOCAL-ONLY-INTEGRATION-PASS~%") t)
