;;;; Run only in a disposable HyperDoc image. Read pinned Git objects, not Topic Maps code.
(in-package #:dreyeck/work/topic-maps-conformance-planning)
(defvar *checks* 0)
(defmacro check (form) `(progn (incf *checks*) (assert ,form () "Investigation check failed: ~S" ',form)))
(defun without (predicate state)
  (remove predicate state :key #'first))
(defun check-result (label result state expected-count methods)
  (check (typep result 'h:hyperdoc-htn-plan-result))
  (check (eq :plan-only (h:execution-mode-of result)))
  (check (= expected-count (length (h:plans-of result)) (length (h:raw-plans-of result))
            (length (h:plan-trees-of result)) (length (h:final-states-of result))))
  (let ((actual (mapcan (lambda (tree) (copy-list (method-names tree))) (h:plan-trees-of result))))
    (check (equal (sort (copy-list methods) #'string< :key #'symbol-name)
                  (sort actual #'string< :key #'symbol-name))))
  (dolist (final (h:final-states-of result))
    (let ((facts (shop3:state-atoms final)))
      ;; All input observations remain; every new fact is a planned effect.
      (check (subsetp state facts :test #'equal))
      (dolist (fact facts)
        (unless (member fact state :test #'equal)
          (check (uiop:string-prefix-p "PLANNED-" (symbol-name (first fact))))))
      (let ((before (remove-if-not (lambda (f) (eq 'registered-status (car f))) state))
            (after (remove-if-not (lambda (f) (eq 'registered-status (car f))) facts)))
        ;; SHOP3 may enumerate state atoms in a different order.
        (check (= (length before) (length after)))
        (check (subsetp before after :test #'equal))
        (check (subsetp after before :test #'equal)))))
  (check (null (shop3:find-problem (h:problem-name-of result))))
  (format t "~&CONFORMANCE ~A PASS: ~D native plans/trees/states, :PLAN-ONLY; methods ~S~%  ~S~%"
          label expected-count methods (h:plans-of result)) result)
(defun check-inspector (run)
  (let* ((view (find "Investigation alternatives" (v:all-views run) :key #'v:view-title :test #'equal))
         (text (v:view-html view)) (references (mapcar #'cdr (v:view-references view)))
         (evidence (run-evidence run)) (result (run-result run)))
    (check (search "plan only" text))
    (check (not (search "<button" text)))
    (dolist (object (append (list result (run-state run) (evidence-record evidence) (evidence-row evidence)
                                   (evidence-execution evidence) (evidence-controls-execution evidence))
                            (evidence-sources evidence) (h:plans-of result)
                            (h:plan-trees-of result) (h:final-states-of result)))
      (check (member object references :test #'eq)))))
(defun method-mutant ()
  "Use SHOP3 itself for one private precondition mutation; no second planner."
  (let* ((*package* (find-package '#:dreyeck/work/topic-maps-conformance-planning))
         (*read-eval* nil)
         (form (with-open-file (in (asdf:system-relative-pathname
                                    "dreyeck/work/topic-maps-conformance-planning"
                                    "dreyeck/work/topic-maps-conformance-planning.lisp"))
                 (loop for value = (read in nil :eof) until (eq :eof value)
                       when (and (consp value) (eq 'shop3:defdomain (car value))) return value)))
         (name (make-symbol "CONFORMANCE-PRECONDITION-MUTANT")) (domain nil))
    (push '(investigation-approved ?c)
          (fourth (find 'review-observed-mismatch (third form) :key #'third)))
    (setf (second form) `(,name :noset t :silently t))
    (handler-case (setf domain (eval form))
      (error (c) (when (get name :domain) (shop3:delete-domain (get name :domain))) (error c)))
    domain))
(defun run-tests ()
  (setf *checks* 0)
  (let* ((root (or (uiop:getenv "TOPIC_MAPS_EVIDENCE_REPOSITORY")
                   (error "Supply TOPIC_MAPS_EVIDENCE_REPOSITORY for read-only Git-object evidence.")))
         (repository (make-instance 'git:git-repository-checkout
                                    :root (truename (uiop:ensure-directory-pathname root))
                                    :root-source :explicit-pinned-investigation-test))
         (packages (mapcar #'find-package '("TOPIC-MAPS.TMDM" "TOPIC-MAPS.CTM")))
         (a (read-case-evidence repository :include-template))
         (b (read-case-evidence repository :template-subject-identifier2))
         (a-state (investigation-state a)) (b-state (investigation-state b))
         (blocked (investigation-state a :goal :edition-qualified-disposition))
         (a-record-before (shasht:write-json (evidence-record a) nil))
         (b-record-before (shasht:write-json (evidence-record b) nil))
         (sources-before (mapcar #'git:git-file-contents (append (evidence-sources a) (evidence-sources b))))
         (problems-before (copy-list shop3::*all-problems*))
         (public (shop3:find-domain 'conformance-investigation)))
    (check (equal "fail" (gethash "status" (evidence-record a))))
    (check (equal "not-run" (gethash "status" (evidence-record b))))
    (check (eq :null (gethash "actualOutcome" (evidence-record b))))
    (check (eq t (json-at (evidence-row b) "expandedControl" "byteExact")))
    (check-result :case-a (qualify-test-case a) a-state 2
                  '(review-observed-mismatch prepare-normative-question))
    (check-result :case-b (qualify-test-case b) b-state 1 '(investigate-registered-not-run))
    (check-result :explicit-missing-prerequisite
                  (qualify-test-case a :goal :edition-qualified-disposition) blocked 1
                  '(report-explicit-prerequisite-gap))
    (check-result :unknown-prerequisite (plan-state (without 'recorded-prerequisite blocked) (evidence-id a))
                  (without 'recorded-prerequisite blocked) 0 nil)
    ;; Missing comparison evidence disables only the byte route, not a justified alternative.
    (let ((state (without 'comparison-evidence a-state)))
      (check-result :missing-comparison (plan-state state (evidence-id a)) state 1 '(prepare-normative-question)))
    (let ((state (without 'normative-references a-state)))
      (check-result :missing-normative-references (plan-state state (evidence-id a)) state 1 '(review-observed-mismatch)))
    (let ((state (without 'normative-references (without 'comparison-evidence a-state))))
      (check-result :both-routes-unjustified (plan-state state (evidence-id a)) state 0 nil))
    (dolist (predicate '(known-case evidence-verified registered-status expanded-control reader-rejection))
      (let ((state (without predicate b-state)))
        (check-result (list :missing predicate) (plan-state state (evidence-id b)) state 0 nil)))
    ;; Extra unrelated corpus statuses also cannot become PASS through an operator.
    (let ((state (cons '(registered-status "hypothetical-other-case" :unsupported) b-state)))
      (check-result :unrelated-status-preserved (plan-state state (evidence-id b)) state 1
                    '(investigate-registered-not-run)))
    (let ((mutant (method-mutant)))
      (unwind-protect
           (progn
             (check-result :changed-method-precondition (plan-state a-state (evidence-id a) mutant)
                           a-state 1 '(prepare-normative-question))
             (let ((state (without 'normative-references a-state)))
               (check-result :no-unexpected-fallback (plan-state state (evidence-id a) mutant) state 0 nil)))
        (shop3:delete-domain mutant)))
    (dolist (pair (list (list a :preparation) (list b :preparation) (list a :edition-qualified-disposition)))
      (multiple-value-bind (result state) (qualify-test-case (first pair) :goal (second pair))
        (check-inspector (make-instance 'investigation-run :evidence (first pair)
                         :goal (second pair) :state state :result result))))
    ;; These are the exact retained serialized records and source bytes, not new registrations.
    (check (equal a-record-before (shasht:write-json (evidence-record a) nil)))
    (check (equal b-record-before (shasht:write-json (evidence-record b) nil)))
    (check (equal sources-before (mapcar #'git:git-file-contents (append (evidence-sources a) (evidence-sources b)))))
    (check (eq public (shop3:find-domain 'conformance-investigation)))
    (check (equal problems-before shop3::*all-problems*))
    (check (equal packages (mapcar #'find-package '("TOPIC-MAPS.TMDM" "TOPIC-MAPS.CTM"))))
    (format t "~&CONFORMANCE-INVESTIGATION-PASS: ~D assertions; pinned sources unchanged; no corpus PASS, test execution, Topic Maps code load or implementation edit.~%" *checks*)
    t))
