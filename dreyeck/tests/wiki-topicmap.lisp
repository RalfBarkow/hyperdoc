;;;; Curiosity Token as Topic Map Acceptance

(defpackage #:dreyeck/traverse/wiki-topicmap-tests
  (:use #:cl)
  (:local-nicknames (#:c #:dreyeck/traverse)
                    (#:ct #:dreyeck/traverse/tests)
                    (#:tm #:dreyeck/topicmap)
                    (#:v #:html-inspector-views))
  (:export #:run-tests))

(in-package #:dreyeck/traverse/wiki-topicmap-tests)

(defvar *checks* 0)

(defun check (value &optional (description "Curiosity Token Topicmap contract"))
  (incf *checks*)
  (unless value (error "Failed: ~A" description))
  value)

(defparameter +items+
  '(("433d402ef7f73541" "paragraph") ("ec56107747e359d6" "paragraph") ("cf80b0444c62866e" "markdown")
    ("85fdb82d3aa3b7db" "paragraph") ("fe4189c7c5f6d902" "paragraph") ("b241aba9ea8cb289" "search")
    ("7cea93d9a701bd70" "paragraph") ("e1708c9ae711cfa0" "markdown") ("8c19d21cff076dc0" "paragraph")
    ("8173173792fb1840" "paragraph") ("1943a99a6eecb530" "search"))
  "The story of the retained page, in order: item id and type.")

(defparameter +token+ "cf80b0444c62866e")
(defparameter +page-id+ "found.ward.fed.wiki/curiosity-token")

(defun render (object title)
  (let ((view (find title (v:all-views object) :key #'v:view-title :test #'equal)))
    (check view (format nil "~A view of ~A" title object))
    (v:view-html view)
    (check (notany (lambda (ref) (typep (cdr ref) 'condition)) (v:view-references view))
           (format nil "native references of the ~A view resolve" title))
    view))

(defun topic (projection id)
  (find id (tm:topicmap-projection-topics-of projection) :key #'tm:topicmap-topic-id-of :test #'equal))

(defun association (projection from type to)
  (find-if (lambda (a) (and (equal from (tm:topicmap-association-from-of a))
                            (equal type (tm:topicmap-association-type-of a))
                            (equal to (tm:topicmap-association-to-of a))))
           (tm:topicmap-projection-associations-of projection)))

(defun origin (association) (getf (getf (tm:topicmap-association-properties-of association) :warrant) :status))

(defun check-page ()
  (let ((page (c::curiosity-token-page))
        (record (c::curiosity-token-record)))
    (check (eq page (c::curiosity-token-page)) "the page is read once")
    (check (equal "found.ward.fed.wiki" (c::page-site page)))
    (check (equal "curiosity-token" (c::page-slug page)))
    (check (equal "Curiosity Token" (c::page-title page)))
    (check (equal "http://found.ward.fed.wiki/view/curiosity-token" (c::live-url page)))
    (check (equal (gethash "sha256" record) (c::page-sha256 page)))
    (check (equal (gethash "sha256" record)
                  (c::file-digest (c::evidence-path "curiosity/curiosity-token.json")))
           "the retained JSON matches its record")
    (check (equal (mapcar #'first +items+) (mapcar #'c::item-id (c::page-items page))) "all eleven items, in order")
    (check (equal (mapcar #'second +items+) (mapcar #'c::item-type (c::page-items page))))
    (check (= 33 (length (c::page-steps page))) "all journal entries")
    (let ((token (c::curiosity-item +token+)))
      (check (equal "# Curiosity" (c::item-text token)))
      (check (equal "markdown" (c::item-type token)) "a markdown item, not a pagefold")
      (check (= 2 (c::item-index token)) "the third item")
      (check (null (c::item-fold token)) "no pagefold precedes it")
      (check (eq page (c::item-page token))))
    (let ((variations (c::curiosity-item "e1708c9ae711cfa0")))
      (check (equal '("paragraph" "markdown")
                    (remove-duplicates (remove nil (mapcar (lambda (entry) (let ((item (gethash "item" (c::step-json entry))))
                                                                              (and item (gethash "type" item))))
                                                           (c::item-steps variations)))
                                       :test #'equal :from-end t))
             "the journal shows the item's type changing while its id stays"))
    (render page "Wiki page")
    (render page "Journal")))

(defun check-attribution ()
  (let* ((attribution (c::curiosity-attribution))
         (entry (c::attribution-entry attribution)))
    (check (equal "Photo Rotator" (c::attribution-page-title attribution)))
    (check (equal "photos.ward.dojo.fed.wiki" (c::attribution-site attribution)))
    (check (equal "add" (c::step-action entry)))
    (check (equal +token+ (c::step-id entry)))
    (check (equal "2023-01-16T16:02:" (subseq (c::iso-date (c::step-date entry)) 0 17)))
    (check (eq (c::curiosity-item +token+) (c::attributed-item attribution)))
    (check (= 1 (length (c::page-attributions (c::curiosity-token-page)))) "the only attribution the journal records")
    (check (eq attribution (c::curiosity-attribution)) "the same attribution object every time")
    (render attribution "Attribution")
    (render (c::remote-page-of (c::curiosity-token-page) attribution) "Remote page")))

(defun check-searches ()
  (let ((items (c::curiosity-search))
        (words (c::curiosity-word-search)))
    (check (equal '("ITEMS" "cf80b0444c62866e") (list (c::expression-verb items) (c::expression-argument items))))
    (check (equal (list (c::curiosity-item +token+)) (c::expression-matches items)) "SEARCH ITEMS names exactly the token")
    (check (equal '("WORDS" "curiosity") (list (c::expression-verb words) (c::expression-argument words))))
    (check (equal '("ec56107747e359d6" "cf80b0444c62866e" "fe4189c7c5f6d902")
                  (mapcar #'c::item-id (c::expression-matches words)))
           "the whole word curiosity, ignoring case, outside the search item itself")
    (check (equal (list (c::curiosity-item +token+)) (c::named-items (c::curiosity-item "85fdb82d3aa3b7db")))
           "the paragraph that writes the id out names the token")
    (check (= 2 (length (c::page-searches (c::curiosity-token-page)))))
    (render items "Search expression")
    (render words "Search expression")))

(defun check-projection ()
  (let* ((page (c::curiosity-token-page))
         (workspace (c::curiosity-token-topicmap))
         (projection (tm:topicmap-workspace-projection-of workspace))
         (token-id (format nil "~A#~A" +page-id+ +token+))
         (ids (mapcar #'tm:topicmap-topic-id-of (tm:topicmap-projection-topics-of projection))))
    (check (equal token-id (tm:topicmap-workspace-point-of workspace)) "Point is the Curiosity item")
    (check (eq (c::curiosity-item +token+) (tm:topicmap-workspace-current-object workspace)))
    (check (= (+ 1 11 33 1 1 2) (length ids)) "page, items, journal entries, attribution, its page and two searches")
    (check (= (length ids) (length (remove-duplicates ids :test #'equal))) "topic ids are unique")
    (check (eq page (tm:topicmap-topic-object-of (topic projection +page-id+))))
    (loop for (id) in +items+ for position from 1
          for topic = (topic projection (format nil "~A#~A" +page-id+ id))
          do (check topic (format nil "item ~A has a topic" id))
             (check (eq (c::curiosity-item id) (tm:topicmap-topic-object-of topic)) "the topic is the retained item")
             (check (eql 0 (search (format nil "~D/11 " position) (tm:topicmap-topic-label-of topic))) "the label gives the position")
             (check (not (find #\' (tm:topicmap-topic-label-of topic))) "labels survive the view's attribute quoting")
             (let ((contains (association projection +page-id+ "contains" (tm:topicmap-topic-id-of topic))))
               (check (and contains (eq :story (origin contains))))))
    (loop for ((id) (next)) on +items+ while next
          do (check (eq :story (origin (association projection (format nil "~A#~A" +page-id+ id) "precedes"
                                                    (format nil "~A#~A" +page-id+ next))))
                    "story order"))
    (dolist (association (tm:topicmap-projection-associations-of projection))
      (let ((warrant (getf (tm:topicmap-association-properties-of association) :warrant)))
        (check (member (tm:topicmap-association-from-of association) ids :test #'equal) "association start is a topic")
        (check (member (tm:topicmap-association-to-of association) ids :test #'equal) "association end is a topic")
        (check (member (getf warrant :status) c::+wiki-origins+) "story, journal or derived")
        (check (getf warrant :basis))
        (check (getf warrant :source))
        (when (eq :journal (getf warrant :status))
          (check (typep (getf warrant :source) 'c::journal-step) "a journal association cites its entry"))))
    ;; What the acceptance asks to see from the token's topic.
    (let* ((attribution (c::curiosity-attribution))
           (entry-id (format nil "~A@journal/~D" +page-id+ (c::step-index (c::attribution-entry attribution))))
           (attribution-id (format nil "~A@attribution/~D" +page-id+ (c::step-index (c::attribution-entry attribution))))
           (search-id (format nil "~A#b241aba9ea8cb289@search" +page-id+)))
      (check (eq :journal (origin (association projection entry-id "add entry for" token-id))))
      (check (eq :journal (origin (association projection entry-id "records" attribution-id))))
      (check (eq :journal (origin (association projection attribution-id "attributes" token-id))))
      (check (eq :journal (origin (association projection attribution-id "names the source page"
                                               "photos.ward.dojo.fed.wiki/photo-rotator"))))
      (check (eq :derived (origin (association projection search-id "names the item id of" token-id))))
      (check (eq :derived (origin (association projection (format nil "~A#b241aba9ea8cb289" +page-id+) "states" search-id))))
      (check (eq :derived (origin (association projection (format nil "~A#85fdb82d3aa3b7db" +page-id+)
                                               "names the item id of" token-id)))))
    ;; Point and history over every topic.
    (let ((visited nil))
      (dolist (topic (tm:topicmap-projection-topics-of projection))
        (tm:topicmap-workspace-go-to workspace (tm:topicmap-topic-id-of topic))
        (push (tm:topicmap-topic-id-of topic) visited)
        (check (eq (tm:topicmap-topic-object-of topic) (tm:topicmap-workspace-current-object workspace))
               "Point navigates to the represented object"))
      (check (equal (subseq (reverse visited) 0 (1- (length visited)))
                    (subseq (reverse (tm:topicmap-workspace-history-of workspace))
                            (- (length (tm:topicmap-workspace-history-of workspace)) (1- (length visited)))))
             "history records the path"))
    (render workspace "Topicmap")))

(defun check-text-page ()
  (let* ((book (hyperbook:find-hyperbook c:+book-id+ :signal-error? t))
         (page (c:companion-page "Curiosity Token as Topic Map"))
         (dom (plump-parser:parse (hyperdoc:file-of page)))
         (view (render page "Content"))
         (hrefs nil))
    (dolist (anchor (plump-dom:get-elements-by-tag-name dom "a"))
      (let ((target (plump-dom:attribute anchor "page"))
            (expression (plump-dom:attribute anchor "expr"))
            (view-title (plump-dom:attribute anchor "view")))
        (when (plump-dom:attribute anchor "href") (push (plump-dom:attribute anchor "href") hrefs))
        (when target (check (hyperbook:find-page book target :signal-error? nil) (format nil "page link ~A" target)))
        (when expression
          (let* ((*package* (find-package :dreyeck/traverse))
                 (value (eval (read-from-string (plump-dom:decode-entities expression)))))
            (check value (format nil "expression ~A" expression))
            (when view-title (render value view-title))))))
    (check (equal '("http://found.ward.fed.wiki/view/curiosity-token") hrefs) "one link to the original page")
    (check (member (c:companion-page "A Wiki Page as Topic Map") (mapcar #'cdr (v:view-references view)) :test #'eq))
    (let ((code (c:companion-page "A Wiki Page as Topic Map")))
      (render code "Source")
      (hyperdoc:load-page code)
      (check (find "Curiosity Token as Topic Map" (hyperbook:page-links-of (hyperbook:links-of code))
                   :test #'equal :key #'hyperbook:target-page-of)
             "the code page links back"))))

(defun run-tests ()
  (setf *checks* 0)
  (let ((actions (ct::call-with-action-guard
                  (lambda ()
                    (check-page)
                    (check-attribution)
                    (check-searches)
                    (check-projection)
                    (check-text-page)))))
    (check (zerop actions) "rendering started no process and opened no connection"))
  (format t "~&CURIOSITY-TOKEN-TOPICMAP-PASS: ~D checks; 11 items, 33 journal entries, one attribution, two searches.~%"
          *checks*)
  t)
