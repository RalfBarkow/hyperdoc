(defpackage #:dreyeck/topicmap-presentation/tests
  (:use #:cl)
  (:local-nicknames (#:tm #:dreyeck/topicmap) (#:v #:html-inspector-views)
                    (#:native #:dreyeck/inspector/topicmap)
                    (#:pr #:dreyeck/pull-request-review))
  (:export #:run-tests))
(in-package #:dreyeck/topicmap-presentation/tests)
(defvar *checks* 0)
(defun check (condition label)
  (unless condition (error "Topicmap presentation: ~A" label)) (incf *checks*))
(defun html-text (node) (plump:decode-entities (plump:text node)))
(defun legend (projection)
  (v:html-and-references (native::render-topicmap-legend projection)))
(defun table-data (html)
  (let* ((dom (plump:parse html)) (table (first (plump:get-elements-by-tag-name dom "table"))))
    (values (mapcar #'html-text (plump:get-elements-by-tag-name table "th"))
            (loop for row in (rest (plump:get-elements-by-tag-name table "tr"))
                  collect (mapcar #'html-text (plump:get-elements-by-tag-name row "td"))))))
(defun column (headers rows title)
  (let ((index (position title headers :test #'equal)))
    (when index (mapcar (lambda (row) (nth index row)) rows))))
(defun sha (text)
  (ironclad:byte-array-to-hex-string
   (ironclad:digest-sequence :sha256 (babel:string-to-octets text :encoding :utf-8))))
(defun svg (projection) (native:render-topicmap-html :native-svg projection))
(defun fixture (kind status &optional (scope :historical))
  (let* ((object (list :native-object-handle))
         (topic (tm:make-topicmap-topic :id "distinct-id" :type :projection-type-z
                  :label "Subject label" :object object :temporal-scope scope
                  :view-properties (list :x 20 :y 20 :visible t :kind kind :status status))))
    (values (tm:make-topicmap-projection :source object :topics (list topic)) topic object)))
(defun assert-projection-preserved (projection)
  (let* ((topics (copy-list (tm:topicmap-projection-topics-of projection)))
         (objects (mapcar #'tm:topicmap-topic-object-of topics))
         (types (mapcar #'tm:topicmap-topic-type-of topics))
         (scopes (mapcar #'tm:topicmap-topic-temporal-scope-of topics))
         (associations (copy-list (tm:topicmap-projection-associations-of projection)))
         (before (svg projection)))
    (multiple-value-bind (html references) (legend projection)
      (declare (ignore html))
      (check (equal topics (tm:topicmap-projection-topics-of projection)) "same Topic handles")
      (check (equal objects (mapcar #'tm:topicmap-topic-object-of topics)) "same represented-object handles")
      (check (equal types (mapcar #'tm:topicmap-topic-type-of topics)) "projection types unchanged")
      (check (equal scopes (mapcar #'tm:topicmap-topic-temporal-scope-of topics)) "temporal scope unchanged")
      (check (equal associations (tm:topicmap-projection-associations-of projection)) "same association handles")
      (check (string= before (svg projection)) "legend rendering cannot change SVG captions")
      (dolist (topic topics)
        (let ((object (tm:topicmap-topic-object-of topic))
              (workspace (tm:make-topicmap-workspace projection (tm:topicmap-topic-id-of topic))))
          (when object
            (check (member object (mapcar #'cdr references) :test #'eq) "legend retains native inspect references"))
          (tm:topicmap-workspace-go-to workspace (tm:topicmap-topic-id-of topic))
          (check (eq object (tm:topicmap-workspace-current-object workspace)) "existing workspace navigation unchanged"))))))

(defun run-tests ()
  (let ((*checks* 0))
    (dolist (case '(("classification-q" "status-u" :historical)
                    ("classification-q" nil :unspecified)
                    (nil "status-u" :current)
                    (nil nil :unspecified)
                    (:classification-keyword :status-keyword :historical)))
      (destructuring-bind (kind status scope) case
        (multiple-value-bind (projection topic object) (fixture kind status scope)
          (declare (ignore object))
          (multiple-value-bind (headers rows) (table-data (legend projection))
            (check (not (member "Kind" headers :test #'equal)) "no composite Kind heading")
            (check (equal '(":PROJECTION-TYPE-Z") (column headers rows "Topic type")) "actual projection type has its own column")
            (check (equal (not (null kind)) (not (null (member "Display classification" headers :test #'equal)))) "classification column only when supplied")
            (check (equal (not (null status)) (not (null (member "Status" headers :test #'equal)))) "status column only when supplied")
            (when kind (check (equal (list (princ-to-string kind)) (column headers rows "Display classification")) "classification contains no status/scope"))
            (when status (check (equal (list (princ-to-string status)) (column headers rows "Status")) "status contains no type/classification/scope"))
            (when (not (eq scope :unspecified))
              (check (equal (list (prin1-to-string scope)) (column headers rows "Temporal scope")) "scope stays separate")))
          ;; Literal pre-change captions from the old rendering contract, not a replacement implementation.
          (when (equal case '("classification-q" "status-u" :historical))
            (check (equal "classification-q · status-u · HISTORICAL" (native::topicmap-topic-caption topic)) "existing SVG caption retained"))
          (when (equal case '(nil nil :unspecified))
            (check (equal "PROJECTION-TYPE-Z" (native::topicmap-topic-caption topic)) "SVG raw-type fallback retained"))
          (assert-projection-preserved projection))))
    (multiple-value-bind (projection topic object) (fixture "<b>label</b>" "<img src=x>" :unspecified)
      (declare (ignore topic object))
      (let ((html (legend projection)))
        (check (not (search "<b>label" html)) "classification escaped")
        (check (not (search "<img src=x>" html)) "status escaped")))
    (format t "~&TYPE-STATUS independent columns, optional values, identity and SVG captions PASS~%")

    (let* ((reading (pr:example-reading)) (snapshot (pr:reading-snapshot reading))
           (projection (tm:topicmap-projection-of reading))
           (root (tm:topicmap-projection-topic-by-id projection "snapshot"))
           (headers nil) (rows nil))
      (multiple-value-setq (headers rows) (table-data (legend projection)))
      (check (eq snapshot (tm:topicmap-topic-object-of root)) "snapshot provenance object identity retained")
      (check (null (getf (tm:topicmap-topic-view-properties-of root) :status)) "observation time removed from status")
      (check (equal "snapshot" (native::topicmap-topic-caption root)) "only erroneous timestamp-bearing snapshot caption is shortened")
      (check (equal ":GITHUB-OBSERVATION" (first (column headers rows "Topic type"))) "snapshot's real projection type visible")
      (check (equal "" (first (column headers rows "Status"))) "snapshot has no invented status")
      (let ((view (find "Snapshot provenance" (v:all-views snapshot) :key #'v:view-title :test #'equal)))
        (check (search (pr:snapshot-observed-at snapshot) (v:view-html view)) "observation time remains in provenance"))
      (check (every (lambda (s) (not (search (pr:snapshot-observed-at snapshot) s))) (column headers rows "Status")) "no observation time in any status cell")
      (dolist (topic (rest (tm:topicmap-projection-topics-of projection)))
        (when (eq :pull-request (tm:topicmap-topic-type-of topic))
          (check (equal "pull request · draft" (native::topicmap-topic-caption topic)) "PR SVG captions unchanged")))
      (assert-projection-preserved projection)
      (format t "~&TYPE-STATUS PR Review provenance and native navigation PASS~%"))

    (let ((reference (nth-value 0 (pr::%json-file
                     (asdf:system-relative-pathname "dreyeck" "reports/topicmap-type-status/baseline-svg.json")))))
      (dolist (pair (list (cons "work" (dreyeck/work/reading:work-projection))
                         (cons "critic" (dreyeck/lisp-critic/reading:lisp-critic-genealogy-projection))))
        (let ((projection (cdr pair)))
          (check (string= (gethash (car pair) reference) (sha (svg projection))) "actual Reading SVG is byte-identical to unmodified PR8 baseline")
          (multiple-value-bind (headers rows) (table-data (legend projection))
            (check (member "Topic type" headers :test #'equal) "other Reading exposes true projection type")
            (check (member "Display classification" headers :test #'equal) "other Reading retains producer classification")
            (check (member "Status" headers :test #'equal) "other Reading retains separate status")
            (loop for topic in (tm:topicmap-projection-topics-of projection) for row in rows do
              (check (string= (prin1-to-string (tm:topicmap-topic-type-of topic)) (nth (position "Topic type" headers :test #'equal) row)) "Reading topic type not inferred from classification")
              (check (string= (or (getf (tm:topicmap-topic-view-properties-of topic) :status) "") (nth (position "Status" headers :test #'equal) row)) "Reading status not conflated with type")))
          (assert-projection-preserved projection)))
      (let* ((reading (pr:example-reading)) (projection (tm:topicmap-projection-of reading)))
        (check (string= (gethash "pr8WithoutObservationCaption" reference) (sha (svg projection)))
               "PR Review SVG differs from PR8 only by removing the misclassified timestamp caption")))
    (format t "~&TYPE-STATUS Work/Lisp Critic baseline SVG equivalence PASS~%")
    (format t "~&TYPE-STATUS-PASS ~D checks~%" *checks*)
    t))
