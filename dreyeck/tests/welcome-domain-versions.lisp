;;;; W2 acceptance probes. Git writers below are disposable fixture setup only.
(in-package #:dreyeck/work/welcome-development)

(defun w2-refuses (reason thunk)
  (handler-case (progn (funcall thunk) (error "Expected ~S refusal" reason))
    (invalid-development-record (c)
      (let ((actual (refusal-reason c)))
        (assert (eq reason (if (consp actual) (first actual) actual)))
        (format t "~&W2 refusal PASS: ~S~%" (refusal-reason c))))))
(defun w2-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil) (error () t))))
(defmacro w2-wrapped ((name wrapper) &body body)
  `(unwind-protect
       (progn (sb-int:encapsulate ',name 'w2-test ,wrapper) ,@body)
     (sb-int:unencapsulate ',name 'w2-test)))
(defun w2-copy-record (r &rest fields)
  (let ((data (copy-record-data (record-data r))))
    (loop for (key value) on fields by #'cddr do (setf (getf data key) value))
    (apply #'make-development-record (type-of r) (record-id r) (record-source r) data)))
(defun w2-observed (r)
  (apply #'make-development-record (type-of r) (record-id r) :observed (record-data r)))
(defun w2-public-snapshot ()
  (list (get 'welcome-development :domain) (copy-list (symbol-plist 'welcome-development)) shop3:*domain*))
(defun w2-public-unchanged (before)
  (assert (eq (first before) (get 'welcome-development :domain)))
  (assert (equal (second before) (symbol-plist 'welcome-development)))
  (assert (eq (third before) shop3:*domain*)))
(defun w2-source-form (items &optional (options '(:noset t)))
  (with-standard-io-syntax
    (let ((*package* (find-package "DREYECK/WORK/WELCOME-DEVELOPMENT")))
      (format nil "(shop3:defdomain (welcome-development ~{~S~^ ~}) ~S)" options items))))
(defun w2-write (path text)
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :if-exists :supersede) (write-string text out)))
(defun w2-fixture-git (root &rest args)
  (string-trim '(#\Newline #\Return)
               (uiop:run-program (append (list "git" "-C" (namestring root)) args) :output :string)))
(defun w2-git-fixture (root)
  "Only test setup writes Git. Production replay uses VERSION-GIT (read-only)."
  (let* ((path "dreyeck/work/welcome-development.lisp")
         (source (uiop:read-file-string (asdf:system-relative-pathname "dreyeck/work/welcome-development" path)))
         (form (development-domain-form-text source))
         (b-source (concatenate 'string (subseq form 0 (- (length form) 2))
                                " (:- (w2-unused-axiom) ())" "))")))
    (ensure-directories-exist (merge-pathnames "placeholder" root))
    (w2-fixture-git root "init" "-q")
    (w2-fixture-git root "config" "user.email" "fixture@example.invalid")
    (w2-fixture-git root "config" "user.name" "W2 disposable fixture")
    (w2-write (merge-pathnames path root) source)
    (w2-write (merge-pathnames +validator-path+ root) ";; Synthetic validator provenance, never loaded.")
    (w2-fixture-git root "add" ".") (w2-fixture-git root "commit" "-qm" "A")
    (let ((a (w2-fixture-git root "rev-parse" "HEAD")))
      (w2-fixture-git root "commit" "--allow-empty" "-qm" "Same domain at another commit")
      (let ((same (w2-fixture-git root "rev-parse" "HEAD")))
        (w2-write (merge-pathnames path root) b-source)
        (w2-fixture-git root "add" ".") (w2-fixture-git root "commit" "-qm" "B unused axiom")
        (values (make-instance 'dreyeck/git:git-repository-checkout :root root :root-source :w2-disposable-test)
                a same (w2-fixture-git root "rev-parse" "HEAD"))))))
(defun w2-observed-journal (repository commit)
  (let* ((version (git-domain-version-record :version-a repository commit))
         (prefix (list (w2-observed (fixture-policy)) version))
         (step `(!assign s1 codex ,+fixture-base+))
         (assignment (w2-observed
                      (w2-copy-record (fixture-first-assignment (fixture-records :p1))
                       :source-plan (assignment-proposal-binding prefix step :domain-version (data version :version-id))))))
    (append prefix (list assignment (w2-observed (fixture-submission assignment (fixture-sha #\1)))))))

(defun w2-identity ()
  (let* ((prefix (fixture-records :p0))
         (id (fixture-version-id prefix))
         (binding (assignment-proposal-binding prefix `(!assign s1 codex ,+fixture-base+) :domain-version id)))
    (format t "~&W2-IDENTITY ~A ~A~%" id (getf binding :digest))
    (values id (getf binding :digest))))

(defun w2-test-reader ()
  (let* ((source (development-domain-form-text
                  (uiop:read-file-string (asdf:system-relative-pathname
                                         "dreyeck/work/welcome-development" "dreyeck/work/welcome-development.lisp"))))
         (items (read-development-domain-form source))
         (builds 0) (foreign (or (find-package "W2-FOREIGN") (make-package "W2-FOREIGN" :use nil)))
         (before (loop for s being the symbols of foreign count s)))
    (assert (equal items (rest (shop3::domain-items (shop3:find-domain 'welcome-development)))))
    (let ((*read-base* 16))
      (assert (= 10 (sixth (first (read-development-domain-form
                                 "(shop3:defdomain (welcome-development :noset t) ((:operator (!x) () () () 10)))"))))))
    (assert (equal +domain-cl-symbols+ '(< <= > >= = /= not and or nil t)))
    (w2-wrapped (shop3::make-domain (lambda (original &rest args) (incf builds) (apply original args)))
      (dolist (text '("(:include \"evil\")" "#.(< 1 2)" "#+w2-feature-never-in-own (:- (x) ())"
                      "#-w2-feature-never-in-own (:- (x) ())" "#S(x)" "#P\"/tmp/no-write\"" "#:x"
                      "w2-foreign:missing" "w2-foreign::missing" "(:- (x) ((shop3:call cl:delete-file \"x\")))"
                      "(:- (x) ((eval x)))" "(:- (x) ((assign x)))" "(:- (x) ((assign* x)))"
                      "(:- (x) ((enforce x)))" "(:- (x) ((setof x)))" "(:- (x) ((bagof x)))"
                      "(:- (x) ((:external x)))" "(:operator (!x) () () () (< 1 2))"
                      "#'cl:car" "#(1 2)" "#=x" "#\\a" "1.5"))
        (dolist (caller '(nil t))
          (let ((*read-eval* caller))
            (w2-refuses :domain-version-untrusted
                        (lambda () (read-development-domain-form
                                    (format nil "(shop3:defdomain (welcome-development :noset t) (~A))" text)))))))
      (dolist (options '((:noset t :type x) (:noset t :redefine-ok t)))
        (w2-refuses :domain-version-untrusted (lambda () (read-development-domain-form (w2-source-form items options)))))
      (w2-refuses :domain-version-untrusted
                  (lambda () (development-domain-form-text (concatenate 'string source source))))
      (w2-refuses :domain-version-untrusted
                  (lambda () (read-development-domain-form (concatenate 'string source " trailing"))))
      (assert (zerop builds)))
    (assert (= before (loop for s being the symbols of foreign count s)))
    (assert (null (find-symbol "W2-FEATURE-NEVER-IN-OWN" "DREYECK/WORK/WELCOME-DEVELOPMENT")))
    ;; Real Eclector wrapping/restart probe. Observe RECOVER but never invoke it.
    (let ((client (make-instance 'development-domain-reader)) (observed nil))
      (catch 'reader-probe
        (handler-bind ((eclector.reader:read-time-evaluation-error
                         (lambda (c)
                           (setf observed (not (null (find-restart 'eclector.base:recover c))))
                           (throw 'reader-probe nil))))
          (eclector.reader:call-with-state-value
           client (lambda ()
                    (let ((eclector.reader:*client* client)
                          (*package* (find-package "DREYECK/WORK/WELCOME-DEVELOPMENT")))
                      (eclector.reader:read-from-string "#.(< 1 2)"))) '*read-eval* t)))
      (assert observed))
    ;; :CURRENT must obey Eclector's dynamic package state, not a fixed package.
    (let ((client (make-instance 'development-domain-reader)))
      (assert (eq :w2-package-probe
                  (eclector.reader:call-with-state-value
                   client (lambda () (eclector.reader:interpret-symbol client nil :current "W2-PACKAGE-PROBE" t))
                   '*package* (find-package "KEYWORD")))))
    ;; Reader/extractor ignores markers in strings, line/block comments and characters.
    (assert (equal source (development-domain-form-text
                           (format nil "~S~%; (shop3:defdomain fake)~%#| (shop3:defdomain fake) |#~%~A"
                                   "(shop3:defdomain fake)" source))))
    (format t "~&A7 PASS: actual W1 source; strict Eclector 0.11.0; recover restart observed, never invoked; no foreign interning/builds.~%")))

(defun w2-test-lifecycle ()
  (clear-development-domain-cache)
  (let* ((before (w2-public-snapshot))
         (items (copy-tree (shop3::domain-items (first before))))
         (id (domain-version-id items)) (installed nil)
         (symbol-properties (let ((symbols nil))
                              (labels ((walk (x) (cond ((symbolp x) (pushnew x symbols))
                                                      ((consp x) (walk (car x)) (walk (cdr x))))))
                                (walk items))
                              (mapcar (lambda (s) (cons s (copy-list (symbol-plist s)))) symbols))))
    (flet ((clean () (assert (zerop (hash-table-count *development-domain-cache*)))
                    (when installed (assert (null (get (shop3::domain-name installed) :domain))))
                    (w2-public-unchanged before)))
      (w2-error (lambda () (read-development-domain-form "(bad"))) (clean)
      (w2-wrapped (eclector.reader:interpret-symbol
                    (lambda (&rest args) (declare (ignore args)) (error "Injected reader failure")))
        (w2-error (lambda () (read-development-domain-form
                             "(shop3:defdomain (welcome-development :noset t) ())")))) (clean)
      (w2-wrapped (screen-development-domain-items
                    (lambda (&rest args) (declare (ignore args)) (error "Injected screen failure")))
        (w2-error (lambda () (development-domain-object id items)))) (clean)
      (w2-error (lambda () (development-domain-object id '((:include "bad"))))) (clean)
      (w2-wrapped (shop3::install-domain
                   (lambda (original &rest args)
                     (setf installed (first args)) (apply original args) (error "Injected after install")))
        (w2-error (lambda () (development-domain-object id items)))) (clean)
      (w2-wrapped (shop3::install-domain
                   (lambda (original &rest args) (setf installed (first args)) (apply original args)))
        (w2-refuses :domain-version-mismatch
                    (lambda () (development-domain-object (make-string 64 :initial-element #\0) items)))) (clean)
      (w2-wrapped (shop3::install-domain
                   (lambda (original &rest args) (setf installed (first args)) (apply original args)))
        (w2-wrapped (domain-version-id
                      (lambda (&rest args) (declare (ignore args)) (error "Injected ID failure")))
          (w2-error (lambda () (development-domain-object id items))))) (clean)
      (let* ((domain (development-domain-object id items)) (name (shop3::domain-name domain)))
        (assert (null (symbol-package name))) (w2-public-unchanged before)
        (do-all-symbols (s)
          (assert (not (uiop:string-prefix-p "WELCOME-DEVELOPMENT@" (symbol-name s)))))
        (assert (= 1 (clear-development-domain-cache)))
        (assert (null (get name :domain))) (clean)))
    (dolist (entry symbol-properties) (assert (equal (cdr entry) (symbol-plist (car entry)))))
    (let* ((journal (fixture-records :p2)) (problems (copy-list shop3::*all-problems*)) (current shop3::*problem*))
      (flet ((clean () (assert (equal problems shop3::*all-problems*))
                      (assert (eq current shop3::*problem*)) (w2-public-unchanged before)))
        (development-state journal) (clean)
        (w2-wrapped (shop3:find-plans (lambda (&rest args) (declare (ignore args)) (error "Injected planning failure")))
          (w2-error (lambda () (development-state journal)))) (clean)
        (w2-wrapped (shop3::initialize-problem
                     (lambda (original &rest args) (apply original args) (error "Injected partial problem")))
          (w2-error (lambda () (development-state journal)))) (clean)
        (unwind-protect
             (progn (shop3:delete-domain 'welcome-development) (development-state journal))
          (setf (symbol-plist 'welcome-development) (copy-list (second before)))) (clean)))
    (format t "~&A3/A4 PASS: public registration/properties/dynamic domain preserved, private construction and problem failure cleanup, replay with deleted public domain.~%")))

(defun w2-test-history ()
  (let* ((before (w2-public-snapshot)) (journal (fixture-records :p4))
         (claim-journal (fixture-records :p2))
         (a-items (copy-tree (shop3::domain-items (first before))))
         (b-items (append a-items '((:- (w2-unused-axiom) ())))))
    (unwind-protect
         (progn
           (eval `(shop3:defdomain (welcome-development :noset t :silently t) ,(copy-tree b-items)))
           (assert (not (equal (domain-version-id a-items) (domain-version-id b-items))))
           (clear-development-domain-cache)
           (development-state journal)
           (let* ((step `(!assign s2 codex ,(fixture-sha #\1)))
                  (version (fixture-domain-version-record)) (id (data version :version-id)))
             (w2-refuses :domain-version-unavailable
                         (lambda () (assignment-proposal-binding journal step :domain-version id)))
             (assert (equal id (getf (getf (assignment-proposal-binding
                                            (append journal (list version)) step :domain-version id) :inputs)
                                    :domain-version))))
           ;; Make B unable to await any claim. A's first claim must still replay.
           (let ((no-await (remove-if (lambda (x) (and (eq :method (first x)) (eq 'await-submission (third x)))) b-items)))
             (eval `(shop3:defdomain (welcome-development :noset t :silently t) ,(copy-tree no-await)))
             (let ((state (development-state (butlast claim-journal))))
               (assert (not (member '((!await-submission s1 :a1 codex))
                                    (dreyeck/shop3:plans-of (plan-development-state state)) :test #'equal))))
             (multiple-value-bind (state audit versions checks) (development-state claim-journal)
               (declare (ignore state audit versions))
               (assert (= 1 (length checks)))
               (assert (equal (domain-version-id a-items)
                              (domain-version-identity (getf (first checks) :domain-version)))))))
      (setf (symbol-plist 'welcome-development) (copy-list (second before))))
    (w2-public-unchanged before)
    (format t "~&A2/A8 PASS: old journal survives B and cache clear; new binding requires B record; submission uses assignment's A even when B has no await method.~%")))

(defun w2-test-bindings ()
  (let* ((records (fixture-records :p1)) (version (second records))
         (a (fixture-first-assignment records)) (binding (data a :source-plan)))
    (assert (equal "welcome-development-plan-v2" (getf binding :format)))
    (assert (null (getf (getf binding :inputs) :domain-items)))
    (test-refusal :v1-binding (append (butlast records) (list (w2-copy-record a :source-plan
                          (let ((copy (copy-record-data binding))) (setf (getf copy :format) "welcome-development-plan-v1") copy))))
                  :unsupported-binding-format)
    (test-refusal :unknown-version (append (butlast records) (list (w2-copy-record a :source-plan
                          (let ((copy (copy-record-data binding)))
                            (setf (getf (getf copy :inputs) :domain-version) (make-string 64 :initial-element #\0)) copy))))
                  :domain-version-unavailable)
    (test-refusal :late-version (list (first records) a version) :domain-version-unavailable)
    (test-refusal :duplicate-version (list (first records) version
                                         (make-instance 'dev-domain-version :id :duplicate :source :fixture :data (record-data version)))
                  :duplicate-domain-version)
    (test-refusal :record-items (list (first records) (w2-copy-record version :items '((:- (evil) ())))) :domain-version-untrusted)
    (test-refusal :planner-pin (list (first records) (w2-copy-record version :planner '(:wrong t))) :planner-version-mismatch)
    (test-refusal :mixed-versions (list (first records) (w2-observed version)) :mixed-fixture-and-observed-records)
    (let ((before (w2-public-snapshot)))
      (unwind-protect
           (progn
             (eval `(shop3:defdomain (welcome-development :noset t :silently t)
                       ,(append (copy-tree (shop3::domain-items (first before))) '((:- (w2-unused-axiom) ())))))
             (let* ((b (fixture-domain-version-record)) (copy (copy-record-data binding)))
               (setf (getf (getf copy :inputs) :domain-version) (data b :version-id))
               (test-refusal :swapped-valid-version
                             (list (first records) version b (w2-copy-record a :source-plan copy))
                             :assignment-plan-binding-mismatch)))
        (setf (symbol-plist 'welcome-development) (copy-list (second before)))))
    (format t "~&A6 fixture/v2 PASS.~%")))

(defun w2-test-provenance (run &optional observed)
  (let* ((projection (development-topicmap run))
         (topics (dreyeck/topicmap:topicmap-projection-topics-of projection))
         (objects (mapcar #'dreyeck/topicmap:topicmap-topic-object-of topics))
         (view (development-next-actions run)) (html (html-inspector-views:view-html view))
         (refs (mapcar #'cdr (html-inspector-views:view-references view))))
    (assert (search "Planning domain replayed by version; record validation uses the current validator." html))
    (assert (sha-p (getf (development-validator-source run) :sha256) 64))
    (assert (eq (not (null observed)) (development-current-version-tagged run)))
    (assert (sha-p (development-current-domain-version run) 64))
    (maphash (lambda (id version)
               (declare (ignore id))
               (assert (member version objects :test #'eq)) (assert (member version refs :test #'eq))
               (assert (member (domain-version-record version) refs :test #'eq))
               (assert (data (domain-version-record version) :validator))
               (let* ((detail (development-domain-provenance version))
                      (body (html-inspector-views:view-html detail))
                      (references (mapcar #'cdr (html-inspector-views:view-references detail))))
                 (assert (search "Tag signatures are not verified" body))
                 (assert (member (domain-version-record version) references :test #'eq))
                 (assert (member (domain-version-domain version) references :test #'eq)))
               (when observed
                 (assert (member (domain-version-commit version) objects :test #'eq))
                 (assert (member (domain-version-commit version) refs :test #'eq)))
               (let* ((topic (find version topics :key #'dreyeck/topicmap:topicmap-topic-object-of :test #'eq))
                      (id (dreyeck/topicmap:topicmap-topic-id-of topic)))
                 (assert (find-if
                          (lambda (edge)
                            (and (equal id (dreyeck/topicmap:topicmap-association-to-of edge))
                                 (eq (if observed :observed :hypothesized)
                                     (getf (dreyeck/topicmap:topicmap-association-properties-of edge) :epistemic-status))))
                          (dreyeck/topicmap:topicmap-projection-associations-of projection)))))
             (development-domain-versions run))
    (dolist (check (append (development-assignment-validations run) (development-submission-checks run)))
      (let ((version (getf check :domain-version)))
        (assert (eq version (gethash (domain-version-identity version) (development-domain-versions run))))
        (assert (member check objects :test #'eq))
        (let* ((topic (find check topics :key #'dreyeck/topicmap:topicmap-topic-object-of :test #'eq))
               (target (find version topics :key #'dreyeck/topicmap:topicmap-topic-object-of :test #'eq)))
          (assert (find-if (lambda (edge)
                            (and (eq :uses-domain-version (dreyeck/topicmap:topicmap-association-type-of edge))
                                 (equal (dreyeck/topicmap:topicmap-topic-id-of topic) (dreyeck/topicmap:topicmap-association-from-of edge))
                                 (equal (dreyeck/topicmap:topicmap-topic-id-of target) (dreyeck/topicmap:topicmap-association-to-of edge))
                                 (eq :derived (getf (dreyeck/topicmap:topicmap-association-properties-of edge) :epistemic-status))))
                          (dreyeck/topicmap:topicmap-projection-associations-of projection))))))
    (format t "~&A11/A12 PASS: ~S provenance, EQ version/record/commit references and derived links; current validator non-claim displayed.~%"
            (if observed :observed :hypothesized))))

(defun w2-test-tags (root)
  (multiple-value-bind (repository a same b) (w2-git-fixture root)
    (let* ((description (describe-development-domain-version repository a))
           (id (getf description :version-id)) (tag (subseq (domain-version-tag id) 10))
           (v (git-domain-version-record :a repository a)))
      (assert (equal id (domain-version-id (shop3::domain-items (shop3:find-domain 'welcome-development)))))
      (assert (equal id (getf (describe-development-domain-version repository same) :version-id)))
      (assert (not (equal id (getf (describe-development-domain-version repository b) :version-id))))
      (format t "~&A1 PASS: loaded/git identities equal; two distinct commits same ID; changed axiom different ID.~%")
      (w2-refuses :domain-version-unavailable (lambda () (admit-development-domain-version v)))
      (w2-fixture-git root "branch" "only-branch" a)
      (w2-refuses :domain-version-unavailable (lambda () (admit-development-domain-version v)))
      (w2-fixture-git root "tag" tag b)
      (w2-refuses :domain-version-mismatch (lambda () (admit-development-domain-version v)))
      (w2-fixture-git root "tag" "-d" tag)
      (w2-fixture-git root "tag" "-a" tag a "-m" "Disposable annotated approval fixture")
      (assert (equal "tag" (getf (domain-version-tag-provenance (admit-development-domain-version v)) :kind)))
      (w2-fixture-git root "tag" "-d" tag) (w2-fixture-git root "tag" tag a)
      (assert (equal "commit" (getf (domain-version-tag-provenance (admit-development-domain-version v)) :kind)))
      (dolist (key '(:blob :form-sha256))
        (w2-refuses :domain-version-mismatch
                    (lambda () (admit-development-domain-version (w2-copy-record v key (make-string (if (eq key :blob) 40 64) :initial-element #\0))))))
      ;; A valid cached version must not hide different source in a forged tag.
      (let ((forged (w2-copy-record (git-domain-version-record :b repository b)
                                   :version-id id :tag (domain-version-tag id))))
        (w2-fixture-git root "tag" "-f" tag b)
        (w2-refuses :domain-version-mismatch (lambda () (admit-development-domain-version forged)))
        (w2-fixture-git root "tag" "-f" tag a))
      ;; Exercise durable Git replay too: no fixture snapshot or cached domain may
      ;; rescue this journal after the public domain is replaced/deleted.
      (let* ((journal (w2-observed-journal repository a)) (before (w2-public-snapshot))
             (b-items (read-development-domain-form
                       (development-domain-form-text
                        (version-git repository "show" (format nil "~A:dreyeck/work/welcome-development.lisp" b))))))
        (unwind-protect
             (progn
               (eval `(shop3:defdomain (welcome-development :noset t :silently t) ,(copy-tree b-items)))
               (clear-development-domain-cache)
               (assert (not (development-current-version-tagged (development-workflow journal))))
               (shop3:delete-domain 'welcome-development)
               (clear-development-domain-cache)
               (development-state journal))
          (setf (symbol-plist 'welcome-development) (copy-list (second before))))
        (w2-public-unchanged before)
        (format t "~&A2/A3 durable Git PASS: tagged A re-read after public B replacement/deletion and cache clear.~%"))
      (let ((refs (w2-fixture-git root "for-each-ref" "refs/tags")))
        (w2-test-provenance (development-workflow (w2-observed-journal repository a)) t)
        (assert (equal refs (w2-fixture-git root "for-each-ref" "refs/tags"))))
      (format t "~&A5/A6 Git PASS: missing/branch-only/wrong-target refused; both tag kinds accepted; metadata and cached-source forgery refused; refs unchanged.~%")
      (values a id))))

(defun w2-test-transient ()
  (clear-development-domain-cache)
  (let* ((problems (copy-list shop3::*all-problems*)) (current shop3::*problem*)
         (records (fixture-records :complete)))
    (dotimes (i 100)
      (let ((run (development-workflow records)))
        (assert (eq :complete (development-outcome run)))
        (assert (eq :plan-only (dreyeck/shop3:execution-mode-of (development-plan-result run))))))
    (dotimes (i 20) (fixture-records :complete))
    (assert (equal problems shop3::*all-problems*)) (assert (eq current shop3::*problem*))
    (assert (= 1 (hash-table-count *development-domain-cache*)))
    (format t "~&A10 PASS: 100 complete runs + 20 journal builds; unchanged problem registry/current pointer; exactly one distinct cached version.~%")))

(defun run-domain-version-tests ()
  (let ((*development-domain-debug* t))
    (run-record-value-tests)
    (run-domain-trust-probes)
    (run-domain-reader-refusal-tests)
    (w2-test-reader) (w2-test-lifecycle) (w2-test-history) (w2-test-bindings)
    (w2-test-provenance (welcome-development-demo :p2))
    (let ((root (uiop:ensure-directory-pathname
                 (string-trim '(#\Newline #\Return)
                              (uiop:run-program '("mktemp" "-d" "-t" "hyperdoc-w2-XXXXXXXX") :output :string))))
          (passed nil))
      (unwind-protect
           (multiple-value-bind (commit id) (w2-test-tags root)
             (setf passed t)
             (when (uiop:getenv "W2_KEEP_REPO")
               (format t "~&W2-REPLAY-FIXTURE ~A ~A ~A~%" (namestring root) commit id)))
        (unless (and passed (uiop:getenv "W2_KEEP_REPO"))
          (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))
    (w2-test-transient)
    (w2-identity)
    (format t "~&W2-ALL-PASS: A1–A13 in-image checks; cross-process identity and syscall audit are separate runner modes. No action executed.~%")
    t))
