                                       (COMMON-LISP:NOT
                                                        (ASDF/OPERATE:COMPONENT-LOADED-P
                                                                                         (ASDF/SYSTEM:FIND-SYSTEM
                                                                                                                  "dreyeck/workflow/authoring"))))
