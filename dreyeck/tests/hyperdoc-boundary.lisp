                                                                                                  (FUNCTION
                                                                                                            HYPERDOC:LOAD-PAGE)
                                                                                                  NIL
                                                                                                  (COMMON-LISP:LIST
                                                                                                                    (COMMON-LISP:FIND-CLASS
