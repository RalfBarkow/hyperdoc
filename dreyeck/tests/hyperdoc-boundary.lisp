                                                                                                        "Boundary"
                                                                                                        :DIRECTORY
                                                                                                        #P"/tmp/"))
                                      (DREYECK/HYPERDOC/BOUNDARY-TESTS::LOADER
                                                                               (COMMON-LISP:FIND-METHOD
                                                                                                        (FUNCTION
                                                                                                                  HYPERDOC:LOAD-PAGE)
                                                                                                        NIL
