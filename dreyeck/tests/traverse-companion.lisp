;;;; TRAVERSE Reading Companion Acceptance

(defpackage #:dreyeck/traverse/tests
  (:use #:cl)
  (:local-nicknames (#:c #:dreyeck/traverse)
                    (#:n #:dreyeck/nested-actions)
                    (#:tm #:dreyeck/topicmap)
                    (#:v #:html-inspector-views)
                    (#:git #:dreyeck/git))
  (:export #:run-tests))

(in-package #:dreyeck/traverse/tests)

(defvar *checks* 0)

(defun check (value &optional (description "TRAVERSE companion contract"))
  (incf *checks*)
  (unless value (error "Failed: ~A" description))
  value)

(defparameter +texts+
  '("From Git Revision to Nix Package" "How TRAVERSE Enters Mech"
    "From PageFold to Discourse Graph" "What the Deployment Proves"))

(defparameter +codes+
  '("Revisions, Sources and the Nix Package" "Installing TRAVERSE in the Discourse Entry"
    "The Two-Page Example, Stage by Stage" "Records Before and After Deployment"
    "Two Projections of the Companion"))

(defparameter +revisions+
  '(("composition" "https://github.com/RalfBarkow/wiki" "a83c3e0d6662a10af000696fc3f1401524cef818")
    ("dreyeck" "https://github.com/RalfBarkow/wiki" "916ea5bf61bd81de961c26c57016556e10d57eba")
    ("module" "https://github.com/RalfBarkow/wiki" "1dbedae7b776ca38c36dc04302796be7a07b9371")
    ("upstream" "https://github.com/WardCunningham/wiki-plugin-mech" "a028b4bba04e539dcaa090423d38a00a0050489d")))

(defparameter +bundle+ "19b14c31c62f0ce92c4ecaacf78477b230d83f0fdefea48033128cb575190efd")

(defun render (object title)
  (let ((view (find title (v:all-views object) :key #'v:view-title :test #'equal)))
    (check view (format nil "~A view of ~A" title object))
    (v:view-html view)
    (check (notany (lambda (ref) (typep (cdr ref) 'condition)) (v:view-references view))
           "native references resolve")
    view))

(defun references (view) (mapcar #'cdr (v:view-references view)))

(defun check-catalog ()
  (let ((book (hyperbook:find-hyperbook c:+book-id+ :signal-error? t)))
    (check (= 1 (count c:+book-id+ (hyperbook:hyperbooks-of hyperbook:*catalog*)
                       :key #'hyperbook:id-of :test #'equal))
           "the Catalog contains the companion once")
    (check (equal "TRAVERSE Reading Companion" (hyperbook:title-of book)))
    (check (equal (first +texts+) (hyperbook:main-page-id-of book)))
    (check (eq (c:companion-page (first +texts+)) (hyperbook:lookup-path book (list (first +texts+)))))))

(defun check-pages ()
  (let ((book (hyperbook:find-hyperbook c:+book-id+ :signal-error? t)))
    (dolist (title +texts+)
      (let* ((page (c:companion-page title))
             (dom (plump-parser:parse (hyperdoc:file-of page)))
             (view (render page "Content")))
        (dolist (tag '("title" "h1"))
          (check (equal title (plump-dom:text (first (plump-dom:get-elements-by-tag-name dom tag))))
                 (format nil "~A in ~A" tag title)))
        (dolist (anchor (plump-dom:get-elements-by-tag-name dom "a"))
          (let ((target (plump-dom:attribute anchor "page"))
                (expression (plump-dom:attribute anchor "expr"))
                (view-title (plump-dom:attribute anchor "view")))
            (when target
              (check (hyperbook:find-page book target :signal-error? nil) (format nil "page link ~A" target)))
            (when expression
              (let* ((*package* (find-package :dreyeck/traverse))
                     (value (eval (read-from-string (plump-dom:decode-entities expression)))))
                (check (and value (not (typep value 'condition))) (format nil "expression ~A" expression))
                (when view-title (render value view-title))
                (when (typep value 'tm:topicmap-workspace)
                  (check (tm:topicmap-workspace-current-object value)))))))
        (dolist (code +codes+)
          (check (member (c:companion-page code) (references view) :test #'eq)
                 (format nil "~A links ~A" title code)))))
    (dolist (code +codes+)
      (let ((page (c:companion-page code)))
        (render page "Source")
        (hyperdoc:load-page page)
        (dolist (title +texts+)
          (let ((link (find title (hyperbook:page-links-of (hyperbook:links-of page))
                            :test #'equal :key #'hyperbook:target-page-of)))
            (check link (format nil "~A links back to ~A" code title))
            (check (eq (c:companion-page title) (v:eval-thunk (hyperbook:thunk-of link))))))))))

(defun check-revisions ()
  (let ((reading (c:retained-reading)))
    (dolist (expected +revisions+)
      (destructuring-bind (role authority oid) expected
        (let ((revision (c:revision-of reading role)))
          (check (equal authority (git:git-revision-authority-of revision)) (format nil "~A authority" role))
          (check (equal oid (git:git-commit-hash-of revision)) (format nil "~A full OID" role)))))
    (check (= 4 (length (c:reading-revisions reading))) "exactly the four fixed revisions")
    (dolist (source (c:reading-sources reading))
      (let ((metadata (n:source-metadata source)))
        (check (member (gethash "revision" metadata) (mapcar #'third +revisions+) :test #'equal)
               (format nil "~A at a fixed revision" (c:source-key source)))
        (check (eq (n:source-revision source) (git:git-file-commit-of (n:source-revision-file source))))
        (check (equal (gethash "path" metadata) (git:git-file-path-of (n:source-revision-file source))))
        (check (member source (git:git-evidence-file-locations-of (n:source-revision-file source)) :test #'eq))
        (render source "Source definition")))
    (dolist (key '("composition:traverse_emit" "composition:resolveEdges" "composition:traverse"
                   "composition:presentGraph" "composition:installDiscourseTraverse"))
      (check (equal "a83c3e0d6662a10af000696fc3f1401524cef818"
                    (gethash "revision" (n:source-metadata (c:source-by-key reading key))))
             (format nil "~A from the composition revision" key)))
    (check (search "a83c3e0d6662a10af000696fc3f1401524cef818"
                   (n:source-text (c:source-by-key reading "dreyeck:mech-composition-input"))))
    (check (search "1dbedae7b776ca38c36dc04302796be7a07b9371"
                   (n:source-text (c:source-by-key reading "composition:pins-module"))))
    (check (search "installDiscourseTraverse(blocks)"
                   (n:source-text (c:source-by-key reading "composition:discourse-entry"))))
    (check (not (search "Traverse" (n:source-text (c:source-by-key reading "composition:upstream-entry"))))
           "the upstream entry does not install TRAVERSE")
    (let ((chain (c:package-chain)))
      (check (equal "/nix/store/ka7nw9n09d1iqqk2in7v9pdbskdf1qb7-wiki-dreyeck-discourse-0.39.2"
                    (getf chain :evaluated-wiki-discourse)))
      (check (eq t (getf chain :evaluated-not-built)) "recorded as evaluated, not built")
      (check (equal +bundle+ (getf chain :bundle))))
    (let ((entry (c:traverse-entry)))
      (check (eq t (getf entry :discourse-entry-installs-traverse)))
      (check (null (getf entry :upstream-entry-installs-traverse))))
    (render reading "Companion")))

(defun check-example ()
  (let* ((run (c:two-page-example))
         (value (lambda (name) (c:stage-value (c:stage-of run name)))))
    (check (equal '("observed link" "EXTRACT" "resolveEdges" "traverse" "presentGraph" "SOLO" "asserted relation")
                  (mapcar #'c:stage-name (c:run-stages run))))
    (check (equal '(:observed :derived :derived :derived :derived :handed-over :not-established)
                  (mapcar #'c:stage-status (c:run-stages run))))
    (let ((link (gethash "item" (funcall value "observed link"))))
      (check (equal "[[Claim A]]" (gethash "text" link)) "the observed link is the story item text")
      (check (equal "Claims" (gethash "text" (gethash "fold" (funcall value "observed link"))))))
    (let ((edge (aref (gethash "edges" (funcall value "EXTRACT")) 0)))
      (check (= 1 (length (gethash "edges" (funcall value "EXTRACT")))))
      (check (equal "companion.example+question" (gethash "fromId" edge)))
      (check (equal "companion.example+claim-a" (gethash "toId" edge)))
      (check (equal "claim" (gethash "role" edge)) "the role is derived from the Claims fold")
      (check (null (nth-value 1 (gethash "item" (gethash "source" edge))))
             "EXTRACT records no story item for the relation"))
    (let ((resolved (aref (funcall value "resolveEdges") 0)))
      (check (equal "resolved" (gethash "status" (gethash "target" resolved))))
      (check (equal "Claim A" (gethash "title" (gethash "target" resolved)))))
    (check (= 1 (length (funcall value "traverse"))))
    (let* ((graph (funcall value "presentGraph"))
           (nodes (gethash "nodes" graph)))
      (check (equal '("companion.example/question" "companion.example/claim-a")
                    (map 'list (lambda (node) (gethash "name" (gethash "props" node))) nodes)))
      (check (every (lambda (node) (equal "WikiPage" (gethash "type" node))) nodes))
      (check (equal "claim" (gethash "type" (aref (gethash "rels" graph) 0)))))
    (let ((batch (aref (funcall value "SOLO") 0)))
      (check (equal "/plugins/solo/dialog/#" (gethash "url" batch)))
      (check (equal "batch" (gethash "type" (gethash "data" batch))))
      (check (c::json-equal (funcall value "presentGraph")
                            (gethash "graph" (aref (gethash "aspects" (aref (gethash "sources" (gethash "data" batch)) 0)) 0)))
             "SOLO hands over exactly the presented graph"))
    (check (eq :not-established (getf (funcall value "asserted relation") :status)))
    (check (zerop (gethash "networkAttempts" (c:record-value (c:run-record run)))))
    (render run "Example")
    (dolist (stage (c:run-stages run)) (render stage "Stage"))))

(defun check-workspace (mode point)
  (let* ((workspace (c:companion-workspace mode))
         (projection (tm:topicmap-workspace-projection-of workspace)))
    (check (equal point (tm:topicmap-workspace-point-of workspace)))
    (dolist (topic (tm:topicmap-projection-topics-of projection))
      (check (tm:topicmap-topic-object-of topic) (format nil "~A represents an object" (tm:topicmap-topic-id-of topic))))
    (dolist (association (tm:topicmap-projection-associations-of projection))
      (let ((warrant (getf (tm:topicmap-association-properties-of association) :warrant)))
        (check (member (getf warrant :status) c::+statuses+))
        (check (getf warrant :source) "every association names its warrant source")
        (check (getf warrant :basis))
        (when (equal "assertion" (tm:topicmap-association-to-of association))
          (check (eq :not-established (getf warrant :status)) "the asserted relation is never observed or derived"))))
    (let ((visited nil))
      (dolist (topic (tm:topicmap-projection-topics-of projection))
        (tm:topicmap-workspace-go-to workspace (tm:topicmap-topic-id-of topic))
        (push (tm:topicmap-topic-id-of topic) visited)
        (check (eq (tm:topicmap-topic-object-of topic) (tm:topicmap-workspace-current-object workspace))
               "Point navigates to the represented object"))
      (check (equal (first visited) (tm:topicmap-workspace-point-of workspace)))
      (check (equal (subseq (reverse visited) 0 (1- (length visited)))
                    (subseq (reverse (tm:topicmap-workspace-history-of workspace))
                            (- (length (tm:topicmap-workspace-history-of workspace)) (1- (length visited)))))
             "history records the path"))
    (render workspace "Topicmap")
    workspace))

(defun check-workspaces ()
  (check-workspace :source "rev:dreyeck")
  (check-workspace :dataflow "item:link")
  (let ((workspace (c:companion-workspace :source)))
    (tm:topicmap-workspace-go-to workspace "src:install-traverse")
    (let ((history (copy-list (tm:topicmap-workspace-history-of workspace))))
      (c:switch-projection workspace :dataflow)
      (check (equal "src:install-traverse" (tm:topicmap-workspace-point-of workspace))
             "switching keeps a Point absent from the other projection")
      (check (equal history (tm:topicmap-workspace-history-of workspace)))
      (tm:topicmap-workspace-go-to workspace "stage:traverse")
      (check (typep (tm:topicmap-workspace-current-object workspace) 'c:example-stage))
      (c:switch-projection workspace :source)
      (tm:topicmap-workspace-go-to workspace "rec:served")
      (check (typep (tm:topicmap-workspace-current-object workspace) 'c:companion-record)))))

(defun check-deployment ()
  (let ((evidence (c:deployment-evidence)))
    (check (eq t (getf evidence :same-bundle-throughout)) "one bundle hash before, in the run and served")
    (check (null (getf evidence :linux-package-built-before-deployment)))
    (check (null (getf evidence :operator-activation-observation)) "the operator observation is recorded as missing")
    (check (every (lambda (record) (eq :before-deployment (c:record-phase record))) (getf evidence :before-deployment)))
    (check (= 1 (length (getf evidence :after-deployment))))
    (dolist (record (c:reading-records (c:retained-reading))) (render record "Record"))))

(defun call-with-action-guard (thunk)
  "Every process start or socket connection during THUNK is counted and refused."
  (let* ((calls 0)
         (names (remove-if-not #'fboundp
                               (list 'uiop:run-program 'uiop:launch-program 'sb-ext:run-program
                                     (find-symbol "SOCKET-CONNECT" "SB-BSD-SOCKETS"))))
         (saved (mapcar #'fdefinition names)))
    (sb-ext:without-package-locks
      (unwind-protect
           (progn
             (dolist (name names)
               (setf (fdefinition name)
                     (let ((name name))
                       (lambda (&rest args) (declare (ignore args)) (incf calls)
                         (error "~A called during rendering" name)))))
             (funcall thunk))
        (loop for name in names for function in saved do (setf (fdefinition name) function))))
    calls))

(defun run-tests ()
  (let ((*checks* 0))
    (check-catalog)
    (let ((calls (call-with-action-guard
                  (lambda ()
                    (setf c::*reading* nil)
                    (check-revisions)
                    (check-example)
                    (check-workspaces)
                    (check-deployment)
                    (check-pages)))))
      (check (zerop calls) "no process or network action is triggered by reading or rendering"))
    (dolist (name '(c:retained-reading c:package-chain c:traverse-entry c:two-page-example
                    c:deployment-evidence c::source-workspace c::dataflow-workspace))
      (check (dreyeck/authority-policy:find-example-contract name) (format nil "contract ~A" name)))
    (format t "~&TRAVERSE-COMPANION-PASS: ~D checks; ~D text pages, ~D code pages, ~D sources, ~D records.~%"
            *checks* (length +texts+) (length +codes+)
            (length (c:reading-sources (c:retained-reading)))
            (length (c:reading-records (c:retained-reading))))
    t))
