(defpackage #:dreyeck/work/hubs/tests
  (:use #:cl)
  (:local-nicknames (#:h #:dreyeck/work/hubs)
                    (#:r #:dreyeck/work/trails-rendered-reading/tests)
                    (#:views #:html-inspector-views)
                    (#:tm #:dreyeck/topicmap))
  (:export #:run-tests #:seed-hub-wiki-pages))
(in-package #:dreyeck/work/hubs/tests)

(defun seed-hub-wiki-pages ()
  "Fresh runtime: exact retained JSON, site-qualified objects; no live-page claim."
  (r::seed-how-trails-page)
  (let* ((site "ward.voices.ustawi.wiki")
         (wiki (make-instance 'hyperbook/fedwiki::fedwiki :id (concatenate 'string "fedwiki:" site))))
    (setf (hyperbook/fedwiki::status-of wiki) t
          (gethash site hyperbook/fedwiki::*neighborhood*) wiki
          (hyperbook::hyperbooks-of hyperbook::*catalog*)
          (remove (concatenate 'string "fedwiki:" site) (hyperbook::hyperbooks-of hyperbook::*catalog*)
                  :key #'hyperbook:id-of :test #'equal))
    (dolist (entry '(("dewey-alexander-trail" "Dewey Alexander Trail" "dreyeck/work/hubs-evidence/ward.voices.ustawi.wiki--dewey-alexander-trail.json")
                     ("trails-rendered" "Trails Rendered" "dreyeck/work/trails-rendered-evidence/ward.voices.ustawi.wiki--trails-rendered.json")))
      (let ((page (hyperbook/fedwiki::make-fedwiki-page wiki (first entry) (second entry))))
        (setf (gethash (first entry) (hyperbook/fedwiki::pages-of wiki)) page)
        (hyperbook/fedwiki::set-page-data page (dreyeck/work/trails-rendered-reading::read-observation (third entry))))))
  (clrhash h::*hub-wiki-pages*))

(defun run-tests ()
  (seed-hub-wiki-pages)
  (let ((book (hyperbook:find-hyperbook "dreyeck/work/reading")))
    (dolist (title '("What Counts as a Hub?" "From Two Hubs to One Trail"))
      (multiple-value-bind (page view) (r::render-page book title)
        (assert (typep page 'hyperdoc:html-page))
        (assert (not (search "<in-package>" (views:view-html view))))))
    (let* ((expected "Here, while browsing \"hubs\" I selected two that I though would connect. They didn't. So clicked four nodes to make a \"trail\" which will render as its own kind of symbol. This is my first end-to-end run through the new code in Mech and Solo plugins.")
           (report (h::ward-hub-report))
           (page (hyperbook:find-page book "From Two Hubs to One Trail" :signal-error? t))
           (view (r::following-view page "Content"))
           (html (views:view-html view)))
      (assert (equal expected (gethash "verbatim" report)))
      (assert (equal "2026-10-14" (gethash "transmitted-date" report)))
      (assert (equal "not established" (gethash "publication-date" report)))
      (assert (not (gethash "date" report)))
      (let ((quotes (plump:get-elements-by-tag-name (plump:parse html) "blockquote")))
        (assert (= 1 (length quotes)))
        (assert (equal expected (plump:decode-entities (plump:text (first quotes))))))
      (assert (search "not independently reconstructed from the Wiki JSON" html))
      (assert (search "does not establish the message's publication date" html))
      (assert (not (search "not yet been supplied" html)))
      (assert (not (eq report (h::hub-page-capture))))
      (assert (member report (mapcar #'cdr (views:view-references view)) :test #'eq))
      (assert (member (h::hub-page-capture) (mapcar #'cdr (views:view-references view)) :test #'eq)))
    (dolist (title '("Reading Mech Hubs" "Inspecting a Hub Selection"))
      (let* ((page (hyperbook:find-page book title :signal-error? t))
             (view (r::following-view page "Hub evidence")))
        (assert (typep page 'hyperdoc::code-page))
        (assert (member (h::hub-function "hubs") (mapcar #'cdr (views:view-references view)) :test #'eq))))
    (assert (null (h::hub-code-evidence (hyperbook:find-page book "Tracing One Recorded Trail")))))
  (let* ((functions (h::hub-sources))
         (selected (h::hub-selection))
         (record (h::selection-record selected))
         (first (aref (gethash "cases" record) 0)))
    (assert (eq functions (h::hub-sources)))
    (assert (eq selected (h::hub-selection)))
    (assert (= 3 (length functions)))
    (assert (= 7 (length (gethash "cases" record))))
    (assert (= 4 (gethash "hub" (gethash "hits" (gethash "ranking" first)))))
    (assert (= 1 (length (gethash "in" (aref (gethash "nodes" (gethash "graph" (aref (gethash "aspects" first) 0))) 0)))))
    (dolist (source functions)
      (let* ((view (r::following-view source "Hub source"))
             (refs (mapcar #'cdr (views:view-references view))))
        (assert (member h::*hub-revision* refs :test #'eq))
        (assert (member h::*hub-file* refs :test #'eq))
        (assert (member selected refs :test #'eq))
        (assert (member (h::hub-function "blanket") refs :test #'eq))))
    (let ((view (r::following-view selected "Hub selection")))
      (assert (member record (mapcar #'cdr (views:view-references view)) :test #'eq))))
  (let* ((workspace (h::hub-and-trail-workspace))
         (projection (tm:topicmap-workspace-projection-of workspace))
         (topics (tm:topicmap-projection-topics-of projection))
         (edges (tm:topicmap-projection-associations-of projection))
         (point (tm:topicmap-workspace-point-of workspace))
         (history (copy-list (tm:topicmap-workspace-history-of workspace))))
    (assert (eq workspace (h::hub-and-trail-workspace)))
    (assert (= 26 (length topics)))
    (assert (= 28 (length edges)))
    (assert (every #'tm:topicmap-topic-object-of topics))
    (let ((view (r::following-view workspace "Topicmap")))
      (assert (search "Point" (views:view-html view))))
    (assert (equal point (tm:topicmap-workspace-point-of workspace)))
    (assert (equal history (tm:topicmap-workspace-history-of workspace)))
    (dolist (edge edges)
      (let ((properties (tm:topicmap-association-properties-of edge)))
        (assert (getf properties :source))
        (assert (member (getf properties :warrant) '(:derived :source-observed :author-reported)))))
    (assert (every (lambda (a) (eq :author-reported (getf (tm:topicmap-association-properties-of a) :warrant)))
                   (remove-if-not (lambda (a) (eq :reports (tm:topicmap-association-type-of a))) edges)))
    (tm:topicmap-workspace-go-to workspace "hubs")
    (assert (eq (h::hub-function "hubs") (tm:topicmap-workspace-current-object workspace)))
    (assert (equal point (first (tm:topicmap-workspace-history-of workspace))))
    (let ((refs (mapcar #'cdr (views:view-references (r::following-view workspace "Topicmap")))))
      (assert (member (h::hub-function "hubs") refs :test #'eq)))
    (tm:topicmap-workspace-go-to workspace point)
    (setf (tm:topicmap-workspace-history-of workspace) history))
  (let ((ward (h::hub-wiki-page "ward.voices.ustawi.wiki" "dewey-alexander-trail" "Dewey Alexander Trail"))
        (plan (h::hub-wiki-page "next.ward.dojo.fed.wiki" "how-trails-travel" "How Trails Travel")))
    (assert (equal "dewey-alexander-trail" (hyperbook/fedwiki::origin-id-of ward)))
    (assert (equal "ward.voices.ustawi.wiki" (hyperbook/fedwiki::domain-name-of (hyperbook/fedwiki::origin-of ward))))
    (assert (= 3 (length (hyperbook/fedwiki::story-of ward))))
    (let* ((before (hyperbook/fedwiki::copy-page-json (hyperbook/fedwiki::raw-json-of ward)))
           (view (r::following-view ward "Hub and trail reading")))
      (assert (member plan (mapcar #'cdr (views:view-references view)) :test #'eq))
      (assert (equalp before (hyperbook/fedwiki::raw-json-of ward))))
    (assert (null (h::dewey-trail-reading-view plan)))
    (assert (equal "61210638970208641024" (hyperbook/fedwiki::id-of (aref (hyperbook/fedwiki::story-of ward) 2))))
    (assert (= 4 (length (dreyeck/work/trails-rendered-reading::how-trails-sources plan))))
    (r::following-view plan "Plan")
    (assert (typep (dreyeck/work/trails-rendered-reading::how-trails-composite-definition)
                   'dreyeck/work/trails-rendered-reading::javascript-source-definition)))
  (format t "~&HUB-READING-PASS: checked functions and seven cases, extended 26-topic/28-association warranted Workspace, pure display, Point/History and site-qualified Wiki/Plan/definition navigation.~%"))
