;;;; Isolated-image tests. The retained Project map is read, not regenerated or written.
(defpackage #:dreyeck/work/topic-maps-instance-of-export/tests
  (:use #:cl)
  (:local-nicknames (#:e #:dreyeck/work/topic-maps-instance-of-export) (#:p #:dreyeck/work/project)
                    (#:tmdm #:topic-maps.tmdm) (#:cxtm #:topic-maps.cxtm) (#:v #:html-inspector-views))
  (:export #:run-tests))
(in-package #:dreyeck/work/topic-maps-instance-of-export/tests)
(defvar *checks* 0)
(defmacro check (form) `(progn (incf *checks*) (assert ,form () "Export check failed: ~S" ',form)))
(defun sha (bytes) (ironclad:byte-array-to-hex-string (ironclad:digest-sequence :sha256 bytes)))
(defun refused (reason thunk)
  (check (handler-case (progn (funcall thunk) nil)
           (e:export-refused (condition) (eq reason (e:refusal-reason condition))))))
(defun fixture (text)
  (let ((revision (p:ctm-revision-from-octets (sb-ext:string-to-octets text :external-format :utf-8)
                                               :label "synthetic export test")))
    (check (null (p:revision-refusal revision))) revision))
(defun export-fixture (revision)
  (e:export-instance-of revision "urn:test:a" "urn:test:b"))

(defun run-tests ()
  (let* ((*checks* 0)
         (registry-before (find-package "TOPIC-MAPS.TEST-FOUNDATION"))
         (shop-before (find-package "SHOP3"))
         (revision (p:project-ctm-document)) (map (p:revision-map revision))
         (source (copy-seq (p:revision-octets revision)))
         (before (cxtm:canonicalize-octets map :base-locator p:+document-iri+))
         (native-before (dreyeck/inspector/tmdm:model-state map))
         (topics (tmdm:topic-map-topics map)) (associations (tmdm:topic-map-associations map))
         (instance-si "tag:dreyeck.ch,2026:hyperdoc/page/dreyeck/work/reading/work-breakdown")
         (type-si "tag:dreyeck.ch,2026:hyperdoc/schema/hyperdoc-page")
         (statement (e:export-instance-of revision instance-si type-si))
         (association (e:statement-association statement)))
    (check (equal (list 'e::instance-of instance-si type-si) (e:statement-atom statement)))
    (check (eq revision (e:statement-revision statement)))
    (check (eq map (e:statement-map statement)))
    (check (eq map (tmdm:association-parent association)))
    (check (member association associations :test #'eq))
    (multiple-value-bind (type instance) (tmdm:type-instance-relationship association)
      (check (eq type (e:statement-type statement)))
      (check (eq instance (e:statement-instance statement)))
      (check (member type topics :test #'eq)) (check (member instance topics :test #'eq)))
    (check (equal (sha source) (p:revision-sha256 revision) ))
    (check (equal (sha source) (e:statement-source-sha256 statement)))
    (check (equal (sha before) (e:statement-cxtm-sha256 statement)))
    (check (null (e:statement-scope statement)))
    (check (eq :observed-in-map (getf (e:statement-provenance statement) :warrant)))
    (check (eq :none (getf (e:statement-provenance statement) :inference)))
    (check (eq :none (getf (e:statement-provenance statement) :conformance-claim)))
    (let* ((view (find "Instance-of provenance" (v:all-views statement) :key #'v:view-title :test #'equal))
           (html (v:view-html view)) (references (mapcar #'cdr (v:view-references view))))
      (check (not (search "<button" html)))
      (dolist (object (list association (e:statement-instance statement) (e:statement-type statement)
                            map revision (e:statement-atom statement) (e:statement-provenance statement)))
        (check (member object references :test #'eq))))
    (check (equalp before (cxtm:canonicalize-octets map :base-locator p:+document-iri+)))
    (check (equalp source (p:revision-octets revision)))
    (check (equal topics (tmdm:topic-map-topics map)))
    (check (equal associations (tmdm:topic-map-associations map)))
    (check (equal native-before (dreyeck/inspector/tmdm:model-state map)))
    (let ((again (e:export-instance-of revision instance-si type-si)))
      (check (eq association (e:statement-association again)))
      (check (eq revision (e:statement-revision again)))
      (check (equal (e:statement-cxtm-sha256 statement) (e:statement-cxtm-sha256 again))))
    (refused :no-stated-relationship (lambda () (e:export-instance-of revision "urn:absent" type-si)))
    ;; A superclass relationship does not authorize an unstated instance-of-supertype fact.
    (let ((r (fixture "a <urn:test:a>; isa b. b <urn:test:b>; ako c. c <urn:test:c>.")))
      (check (typep (export-fixture r) 'e:instance-of-statement))
      (refused :no-stated-relationship (lambda () (e:export-instance-of r "urn:test:a" "urn:test:c"))))
    (let ((r (fixture "a <urn:test:a>; <urn:test:alias>; isa b. b <urn:test:b>.")))
      (refused :non-single-subject-identifier (lambda () (export-fixture r))))
    (let ((r (fixture "a <urn:test:a>; isa b. b <urn:test:b>; <urn:test:alias>.")))
      (refused :non-single-subject-identifier (lambda () (export-fixture r))))
    (let ((r (fixture "%prefix m <http://psi.topicmaps.org/iso13250/model/>
a <urn:test:a>. b <urn:test:b>. theme <urn:test:theme>.
m:type-instance(m:instance: a, m:type: b) @theme")))
      (refused :scoped-relationship (lambda () (export-fixture r))))
    (let ((r (fixture "%prefix m <http://psi.topicmaps.org/iso13250/model/>
a <urn:test:a>; isa b. b <urn:test:b>. theme <urn:test:theme>.
m:type-instance(m:instance: a, m:type: b) @theme")))
      (refused :ambiguous-relationship (lambda () (export-fixture r))))
    (let ((r (fixture "a <urn:test:a>; isa b. b <urn:test:b>.")))
      (incf (aref (p:revision-octets r) 0))
      (refused :source-octets-changed (lambda () (export-fixture r))))
    (let ((r (fixture "a <urn:test:a>; isa b. b <urn:test:b>.")))
      (tmdm:intern-topic (p:revision-map r) :subject-identifier "urn:test:later")
      (refused :map-snapshot-changed (lambda () (export-fixture r))))
    (refused :invalid-identifiers (lambda () (e:export-instance-of revision '(not-a-term) type-si)))
    (check (eq registry-before (find-package "TOPIC-MAPS.TEST-FOUNDATION")))
    (check (eq shop-before (find-package "SHOP3")))
    (format t "~&INSTANCE-OF-OBSERVATION: ~S~%  source CTM SHA256 ~A~%  map CXTM SHA256 ~A~%  source Association, players, map and revision retained by EQ; scope ~S~%"
            (e:statement-atom statement) (e:statement-source-sha256 statement)
            (e:statement-cxtm-sha256 statement) (e:statement-scope statement))
    (format t "~&INSTANCE-OF-EXPORT-PASS: ~D checks; actual Project snapshot, source EQ links, unchanged CXTM/octets/items; no inference, Case Record or planning action.~%" *checks*)
    *checks*))
