(in-package #:dreyeck/work/catalog-deployment-pr52)

(defun test-git-controls ()
  (let* ((directory (uiop:ensure-directory-pathname
                     (uiop:run-program '("mktemp" "-d" "/tmp/catalog-git-test.XXXXXXXX")
                                       :output '(:string :stripped t))))
         (author (merge-pathnames "author/" directory))
         (peer (merge-pathnames "peer/" directory))
         (checkout (merge-pathnames "checkout/" directory)))
    (labels ((run (dir &rest args) (git:trim-git-output (apply #'git:git-run-string dir args)))
             (configure-git-author (dir)
               (run dir "config" "user.email" "fixture@example.invalid")
               (run dir "config" "user.name" "Catalog fixture"))
             (write-fixture (value)
               (with-open-file (stream (merge-pathnames "source" author) :direction :output :if-exists :supersede)
                 (write-line value stream))
               (run author "add" "source")
               (run author "commit" "--no-gpg-sign" "-m" value)
               (run author "rev-parse" "HEAD")))
      (unwind-protect
           (progn
             (run directory "init" "--initial-branch=dreyeck.ch" (namestring author))
             (run directory "init" "--bare" "--initial-branch=dreyeck.ch" (namestring peer))
             (configure-git-author author)
             (let ((+reviewed-base+ (write-fixture "base")))
               (run author "push" (namestring peer) (format nil "HEAD:~A" +target-ref+))
               (run directory "clone" "--single-branch" "--branch" "dreyeck.ch"
                    (format nil "file://~A" (namestring peer)) (namestring checkout))
               (configure-git-author checkout)
               (let* ((+reviewed-head+ (write-fixture "reviewed candidate"))
                      (deployment (make-deployment :repository checkout :remote "origin")))
                 (run author "push" (namestring peer) (format nil "HEAD:~A" +candidate-ref+))
                 (assert (not (commit-present-p deployment +reviewed-head+)))
                 (play-step deployment :observe-git)
                 (assert (and (null (message-of deployment)) (commit-present-p deployment +reviewed-head+)))
                 (play-step deployment :integrate)
                 (let ((merge (second (assoc :integrate (observations deployment))))
                       (initial-status (run checkout "status" "--porcelain"))
                       (drift (write-fixture "unrelated branch advance")))
                   (assert (equal +reviewed-base+ (run checkout "rev-parse" "HEAD")))
                   (assert (equal (revision-tree deployment merge) (revision-tree deployment +reviewed-head+)))
                   (play-step deployment :publish-ref)
                   (assert (and (message-of deployment) (not (assoc :publish-ref (observations deployment)))))
                   (setf (publish-enabled-p deployment) t)
                   (run author "push" (namestring peer) (format nil "~A:~A" drift +target-ref+))
                   (play-step deployment :publish-ref)
                   (assert (and (message-of deployment) (not (assoc :publish-ref (observations deployment)))))
                   (run peer "update-ref" +target-ref+ +reviewed-base+ drift)
                   (play-step deployment :publish-ref)
                   (assert (equal merge (run peer "rev-parse" +target-ref+)))
                   (assert (equal merge (target-revision deployment)))
                   ;; Simulate a lost Play response, then observe the already-published ref.
                   (setf (observations deployment) (remove :publish-ref (observations deployment) :key #'first))
                   (play-step deployment :publish-ref)
                   (assert (equal merge (target-revision deployment)))
                   (assert (equal +reviewed-base+ (run checkout "rev-parse" "HEAD")))
                   (assert (equal initial-status (run checkout "status" "--porcelain")))
                   (let* ((preassembled (local-git deployment "commit-tree" (revision-tree deployment merge)
                                                   "-p" merge "-p" +reviewed-base+ "-m" "Release fixture"))
                          (ref "refs/heads/fixture-release")
                          (release (make-deployment :repository checkout :remote "origin"
                                                    :candidate preassembled :expected-base merge
                                                    :candidate-ref ref)))
                     (setf (publish-enabled-p release) t)
                     (run checkout "push" "origin" (format nil "~A:~A" preassembled ref))
                     (play-step release :observe-git)
                     (assert (eq :review-candidate (offered-step (plan-next release))))
                     (play-step release :publish-ref)
                     (assert (equal merge (run peer "rev-parse" +target-ref+)))
                     (play-step release :review-candidate)
                     (assert (eq :publish-ref (offered-step (plan-next release))))
                     (run peer "update-ref" +target-ref+ +reviewed-base+ merge)
                     (play-step release :publish-ref)
                     (assert (null (target-revision release)))
                     (assert (equal +reviewed-base+ (run peer "rev-parse" +target-ref+)))
                     (run peer "update-ref" +target-ref+ merge +reviewed-base+)
                     (play-step release :publish-ref)
                     (assert (equal preassembled (run peer "rev-parse" +target-ref+)))
                     (assert (equal preassembled (target-revision release))))))))
        (uiop:delete-directory-tree directory :validate t)))))

(defun test-server-observation ()
  (let* ((deployment (make-deployment :remote "fixture"))
         (observation (ensure-server-observation deployment))
         (running (make-string 40 :initial-element #\a))
         (other (make-string 40 :initial-element #\b))
         (system (format nil "/nix/store/~A-nixos-system-dreyeck-test" (make-string 32 :initial-element #\a)))
         (server-calls 0)
         (remote-calls 0))
    (labels ((expected-step (step)
               (assert (eq step (next-observation-step (observation-plan observation)))))
             (read-server (ignored)
               (declare (ignore ignored))
               (incf server-calls)
               (validate-service-observation "active" running system 137 200 200))
             (read-remotes (ignored)
               (declare (ignore ignored))
               (incf remote-calls)
               (list :at (get-universal-time)
                     :peers (list (list "fixture" :heads
                                        (list (list +target-ref+ running) (list "refs/heads/other" other)))
                                  (list "unavailable-peer" :unavailable "Git Exit 128"))))
             (play (step generation)
               (play-observation observation step generation
                                 :read-server #'read-server :read-remotes #'read-remotes)))
      (expected-step :observe-server)
      (assert (eq :observe-remotes
                  (next-observation-step (observation-plan observation :remotes-first))))
      (choose-observation-plan observation :remotes-first 0)
      (expected-step :observe-remotes)
      (play :observe-server 0)
      (assert (zerop server-calls))
      (play :observe-remotes 1)
      (play :observe-remotes 1)
      (assert (= 1 remote-calls))
      (expected-step :observe-server)
      (play :observe-server 2)
      (assert (= 1 server-calls))
      (expected-step :compare-revisions)
      (play :compare-revisions 3)
      (expected-step nil)
      (assert (equal '(nil) (dreyeck/shop3:plans-of (observation-plan observation))))
      (assert (equal '(:same :unknown :unavailable)
                     (mapcar #'fourth (getf (observed-comparison observation) :rows))))
      (let ((branch-view (find "Branches" (v:all-views observation) :key #'v:view-title :test #'equal)))
        (assert (search "L&#228;uft auf dem Server" (v:view-html branch-view))))
      (assert (null (observations deployment)))
      (restart-observation observation 4)
      (expected-step :observe-remotes)
      (let ((task-view (find "DITA Task" (v:all-views observation) :key #'v:view-title :test #'equal)))
        (assert (search "Play" (v:view-html task-view)))
        (assert (search "Server dreyeck.ch und Git-Branches vergleichen" (v:view-html task-view)))))))

(defun test-service-request ()
  (let* ((revision (make-string 40 :initial-element #\a))
         (other (make-string 40 :initial-element #\b))
         (candidate-tree (make-string 40 :initial-element #\c))
         (deployment (make-deployment :remote "fixture" :candidate revision
                                      :expected-base other :candidate-ref "refs/heads/fixture-release"))
         (service (deployment-catalog-service deployment))
         (system (format nil "/nix/store/~A-nixos-system-dreyeck-test" (make-string 32 :initial-element #\a))))
    (assert (eq :systemd-service (tm:topicmap-topic-type-of service)))
    (assert (nth-value 1 (ignore-errors (prepare-service-observation service :purpose :baseline))))
    (setf (publish-enabled-p deployment) t
          (observations deployment)
          (list (list :publish-ref revision (expected-base-of deployment) revision "fixture")
                (list :review-candidate revision candidate-tree)
                (list :observe-git (expected-base-of deployment) revision "fixture")))
    (assert (eq :baseline (offered-step (plan-next deployment))))
    (let* ((request (prepare-service-observation service :purpose :baseline))
           (id (service-request-id request))
           (receipt (list id "active" other system 137 200 200)))
      (assert (eq :prepared (service-request-status request)))
      (assert (eq request (prepare-service-observation service :purpose :baseline)))
      (assert (null (latest-service-observation service)))
      (assert (nth-value 1 (ignore-errors
                            (submit-service-observation (list id "invalid" other system 137 200 200)))))
      (assert (eq request (pending-service-observation service)))
      (submit-service-observation receipt)
      (assert (eq :recorded (service-request-status request)))
      (assert (equal other (getf (latest-service-observation service) :revision)))
      (assert (eq :baseline (offered-step (plan-next deployment))))
      (assert (nth-value 1 (ignore-errors (submit-service-observation receipt)))))
    (let* ((request (prepare-service-observation service :purpose :baseline))
           (id (service-request-id request)))
      (submit-service-observation (list id "active" revision system 137 200 200))
      (assert (equal '(nil) (dreyeck/shop3:plans-of (plan-next deployment)))))))

(defun test-remote-transport-policy ()
  (let ((root (asdf:system-source-directory "dreyeck")))
    (dolist (argv '(("ls-remote" "--" "ssh://no-network.invalid/repo")
                    ("ls-remote" "--" "no-network.invalid:repo")
                    ("-c" "url.ssh://no-network.invalid/.insteadOf=https://no-network.invalid/"
                     "ls-remote" "--" "https://no-network.invalid/repo")))
      (multiple-value-bind (out diagnostic status)
          (apply #'git:git-run-values root argv)
        (declare (ignore out))
        (assert (and (not (zerop status)) (search "transport 'ssh' not allowed" diagnostic)))))))

(defun run-tests ()
  (test-git-controls)
  (test-server-observation)
  (test-service-request)
  (test-remote-transport-policy)
  (let* ((state (make-deployment :remote "fixture"))
         (book (make-instance 'deployment-book :id +task-book-id+))
         (page (attach-task-page book state))
         (server (hb:find-page book (hb:main-page-id-of book) :signal-error? t))
         (topic (deployment-server-topic state))
         (view (find "DITA Task" (v:all-views page) :key #'v:view-title :test #'equal)))
    (assert (eq page (hb:find-page book +task-page-id+ :signal-error? t)))
    (assert (eq page (hb:lookup-path book (list (hb:path-item-of page)))))
    (assert (eq server (hb:lookup-path book (list (hb:path-item-of server)))))
    (assert (eq page (task-page-of server)))
    (assert (eq state (tm:topicmap-topic-object-of topic)))
    (assert (string= +server-topic-id+ (tm:topicmap-topic-id-of topic)))
    (assert (and view (search "HyperDoc-Stand" (v:view-html view))))
    (assert (some (lambda (entry) (typep (cdr entry) 'dreyeck/shop3:hyperdoc-htn-plan-result))
                  (v:view-references view)))
    (assert (null (observations state))))
  (let* ((deployment (make-deployment :remote "fixture"))
         (revision (make-string 40 :initial-element #\a))
         (other (make-string 40 :initial-element #\b))
         (dir "/var/tmp/hyperdoc-pr52.z12AB345")
         (old (format nil "/nix/store/~A-nixos-system-dreyeck-old" (make-string 32 :initial-element #\a)))
         (new (format nil "/nix/store/~A-nixos-system-dreyeck-new" (make-string 32 :initial-element #\b))))
    (flet ((expect (step)
             (let ((result (plan-next deployment)))
               (assert (eq :plan-only (dreyeck/shop3:execution-mode-of result)))
               (assert (eq step (offered-step result)))))
           (reject (evidence)
             (let ((before (copy-tree (observations deployment))))
               (assert (nth-value 1 (ignore-errors (record-receipt deployment evidence))))
               (assert (equal before (observations deployment))))))
      (expect :observe-git)
      (reject (list :baseline revision dir old other :other))
      (play-step deployment :activate)
      (assert (and (message-of deployment) (null (command deployment))))
      ;; Seed the server fixture with a published Git ref; actual Git is tested above.
      (setf (observations deployment) (list (list :publish-ref revision other +reviewed-head+ "fixture")
                                           (list :integrate revision other +reviewed-head+)
                                           (list :observe-git other +reviewed-head+ "fixture")))
      (let ((active (make-deployment :remote "fixture"))
            (readback (list :active-readback revision new 137 200 200)))
        (assert (nth-value 1 (ignore-errors (record-receipt active readback))))
        (setf (observations active) (copy-tree (observations deployment)))
        (assert (nth-value 1 (ignore-errors
                              (record-receipt active (list :active-readback other new 137 200 200)))))
        (assert (nth-value 1 (ignore-errors
                              (record-receipt active (list :active-readback revision new 137 200 503)))))
        (assert (eq :baseline (offered-step (plan-next active))))
        (assert (equal '(nil) (dreyeck/shop3:plans-of (record-receipt active readback))))
        (record-receipt active readback)
        (setf (message-of active) "Previous plan-tree error")
        (let ((task-html (v:view-html (task-view active)))
              (server-html (v:view-html (catalog-server-view (deployment-server-topic active) active))))
          (assert (search ":COMPLETE" task-html))
          (assert (search "Letzter Readback dieses Laufs" server-html))
          (assert (not (search "Previous plan-tree error" task-html)))
          (assert (not (search "Previous plan-tree error" server-html))))
        (assert (equal (cons readback (observations deployment)) (observations active))))
      (expect :baseline)
      (play-step deployment :baseline)
      (assert (search (format nil "bash -s -- baseline '~A'" revision) (command deployment)))
      (reject (list :baseline other dir old revision :other))
      (reject (list :baseline revision "/var/tmp/hyperdoc-pr52.1234567'" old other :other))
      (record-receipt deployment (list :baseline revision dir old other :other))
      (expect :git-source)
      (play-step deployment :git-source)
      (reject (list :git-source revision dir new))
      (record-receipt deployment (list :git-source revision dir old))
      (expect :build)
      (reject (list :build revision dir new))
      (play-step deployment :build)
      (record-receipt deployment (list :build revision dir new))
      (expect :activate)
      (play-step deployment :activate)
      (reject (list :activate revision dir old))
      (record-receipt deployment (list :activate revision dir new))
      (expect :verify)
      (play-step deployment :verify)
      (reject (list :verify revision dir new 137 200 503))
      (reject (list :verify other dir new 137 200 200))
      (record-receipt deployment (list :verify revision dir new 137 200 200))
      (expect nil)
      (assert (equal '(nil) (dreyeck/shop3:plans-of (plan-next deployment))))
      (assert (null (command deployment)))))
  (format t "~&CATALOG-DEPLOYMENT-PR52-PASS~%")
  t)
