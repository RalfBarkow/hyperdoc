(in-package #:dreyeck/work/catalog-deployment-pr52)

(defun test-github-controls ()
  (let* ((deployment (make-deployment))
         (draft t) (merged nil) (writes nil) (lost-merge-response nil)
         (head +reviewed-head+) (base +reviewed-base+)
         (merge (make-string 40 :initial-element #\c)))
    (labels ((current () (offered-step (plan-next deployment)))
             (endpoint (suffix) (format nil "repos/~A/~A" +github-repository+ suffix))
             (json (&rest pairs)
               (let ((table (make-hash-table :test #'equal)))
                 (loop for (key value) on pairs by #'cddr do (setf (gethash key table) value))
                 table))
             (fake-github (args)
               (shasht:write-json
                (cond
                  ((equal args '("pr" "ready" "52" "--repo" "github.com/RalfBarkow/hyperdoc"))
                   (push :ready-for-review writes) (setf draft nil) (json))
                  (t
                   (destructuring-bind (api host github path &rest options) args
                     (assert (equal (list api host github) '("api" "--hostname" "github.com")))
                     (cond
                       ((equal path (endpoint "pulls/52"))
                        (assert (equal options '("--jq" ".draft |= tostring")))
                        (json "number" 52 "head" (json "sha" head)
                              "base" (json "ref" "dreyeck.ch" "repo" (json "full_name" +github-repository+))
                              "state" (if merged "closed" "open") "draft" (if draft "true" "false")
                              "merged_at" (if merged "2026-11-19T09:00:00Z" nil)
                              "merge_commit_sha" merge))
                       ((equal path (endpoint "branches/dreyeck.ch"))
                        (json "commit" (json "sha" (if merged merge base))))
                       ((equal path (endpoint "pulls/52/merge"))
                        (assert (equal options (list "--method" "PUT" "-f"
                                                     (format nil "sha=~A" +reviewed-head+) "-f" "merge_method=merge")))
                        (push :merge writes) (setf merged t)
                        (when lost-merge-response (error "Fixture: response lost after commit"))
                        (json))
                       ((equal path (endpoint (format nil "commits/~A" merge)))
                        (json "sha" merge "parents" (vector (json "sha" base) (json "sha" head))))
                       (t (error "Unexpected fixture endpoint ~S" path))))))
                nil)))
      (let ((*github-command* #'fake-github))
        (assert (eq :ready-for-review (current)))
        (play-step deployment :ready-for-review)
        (assert (and (message-of deployment) (null writes)))
        (setf (github-writes-enabled-p deployment) t head merge)
        (play-step deployment :ready-for-review)
        (assert (and (eq :ready-for-review (current)) (null writes)))
        (setf head +reviewed-head+ base merge)
        (play-step deployment :ready-for-review)
        (assert (and (eq :ready-for-review (current)) (null writes)))
        (setf base +reviewed-base+)
        (play-step deployment :ready-for-review)
        (assert (and (eq :merge (current)) (equal writes '(:ready-for-review))))
        (play-step deployment :ready-for-review)
        (assert (equal writes '(:ready-for-review)))
        (setf draft t)
        (play-step deployment :merge)
        (assert (and (eq :ready-for-review (current)) (equal writes '(:ready-for-review))))
        (setf draft nil)
        (play-step deployment :ready-for-review)
        (setf base merge)
        (play-step deployment :merge)
        (assert (and (eq :merge (current)) (equal writes '(:ready-for-review))))
        (setf base +reviewed-base+ lost-merge-response t)
        (play-step deployment :merge)
        (assert (and (eq :merge (current)) (equal writes '(:merge :ready-for-review))))
        (setf base merge)
        (play-step deployment :merge)
        (assert (and (eq :merge (current)) (equal writes '(:merge :ready-for-review))))
        (setf base +reviewed-base+)
        (play-step deployment :merge)
        (assert (and (eq :baseline (current)) (equal merge (target-revision deployment))
                     (equal writes '(:merge :ready-for-review))))))))

(defun run-tests ()
  (test-github-controls)
  (let* ((deployment (make-deployment))
         (revision (make-string 40 :initial-element #\a))
         (other (make-string 40 :initial-element #\b))
         (dir "/var/tmp/hyperdoc-pr52.z12AB345")
         (old (format nil "/nix/store/~A-nixos-system-dreyeck-old" (make-string 32 :initial-element #\a)))
         (new (format nil "/nix/store/~A-nixos-system-dreyeck-new" (make-string 32 :initial-element #\b))))
    (flet ((expect (step)
             (let ((result (plan-next deployment)))
               (assert (eq :plan-only (dreyeck/shop3:execution-mode-of result)))
               (assert (eq step (offered-step result)))))
           (reject (evidence)
             (let ((before (copy-tree (observations deployment))))
               (assert (nth-value 1 (ignore-errors (record-receipt deployment evidence))))
               (assert (equal before (observations deployment))))))
      (expect :ready-for-review)
      (reject (list :baseline revision dir old other))
      (play-step deployment :activate)
      (assert (and (message-of deployment) (null (command deployment))))
      ;; Inject a merge observation for this fixture. The test never calls GitHub.
      (push (list :ready-for-review +reviewed-head+ +reviewed-base+) (observations deployment))
      (push (list :merge revision +reviewed-head+) (observations deployment))
      (expect :baseline)
      (play-step deployment :baseline)
      (assert (search (format nil "bash -s -- baseline '~A'" revision) (command deployment)))
      (reject (list :baseline other dir old revision))
      (reject (list :baseline revision "/var/tmp/hyperdoc-pr52.1234567'" old other))
      (record-receipt deployment (list :baseline revision dir old other))
      (expect :build)
      (reject (list :build revision dir new))
      (play-step deployment :build)
      (record-receipt deployment (list :build revision dir new))
      (expect :activate)
      (play-step deployment :activate)
      (reject (list :activate revision dir old))
      (record-receipt deployment (list :activate revision dir new))
      (expect :verify)
      (play-step deployment :verify)
      (reject (list :verify revision dir new 137 200 503))
      (reject (list :verify other dir new 137 200 200))
      (record-receipt deployment (list :verify revision dir new 137 200 200))
      (expect nil)
      (assert (equal '(nil) (dreyeck/shop3:plans-of (plan-next deployment))))
      (assert (null (command deployment)))))
  (format t "~&CATALOG-DEPLOYMENT-PR52-PASS~%")
  t)
