(in-package #:dreyeck/work/catalog-deployment-pr52)

(defun run-tests ()
  (let* ((deployment (make-deployment))
         (revision (make-string 40 :initial-element #\a))
         (other (make-string 40 :initial-element #\b))
         (dir "/var/tmp/hyperdoc-pr52.z12AB345")
         (old (format nil "/nix/store/~A-nixos-system-dreyeck-old" (make-string 32 :initial-element #\a)))
         (new (format nil "/nix/store/~A-nixos-system-dreyeck-new" (make-string 32 :initial-element #\b))))
    (flet ((expect (step)
             (let ((result (plan-next deployment)))
               (assert (eq :plan-only (dreyeck/shop3:execution-mode-of result)))
               (assert (eq step (offered-step result)))))
           (reject (evidence)
             (let ((before (copy-tree (observations deployment))))
               (assert (nth-value 1 (ignore-errors (record-receipt deployment evidence))))
               (assert (equal before (observations deployment))))))
      (expect :merge)
      (reject (list :baseline revision dir old other))
      (play-step deployment :activate)
      (assert (and (message-of deployment) (null (command deployment))))
      ;; Inject a merge observation for this fixture. The test never calls GitHub.
      (push (list :merge revision +reviewed-head+) (observations deployment))
      (expect :baseline)
      (play-step deployment :baseline)
      (assert (search (format nil "bash -s -- baseline '~A'" revision) (command deployment)))
      (reject (list :baseline other dir old revision))
      (reject (list :baseline revision "/var/tmp/hyperdoc-pr52.1234567'" old other))
      (record-receipt deployment (list :baseline revision dir old other))
      (expect :build)
      (reject (list :build revision dir new))
      (play-step deployment :build)
      (record-receipt deployment (list :build revision dir new))
      (expect :activate)
      (play-step deployment :activate)
      (reject (list :activate revision dir old))
      (record-receipt deployment (list :activate revision dir new))
      (expect :verify)
      (play-step deployment :verify)
      (reject (list :verify revision dir new 137 200 503))
      (reject (list :verify other dir new 137 200 200))
      (record-receipt deployment (list :verify revision dir new 137 200 200))
      (expect nil)
      (assert (equal '(nil) (dreyeck/shop3:plans-of (plan-next deployment))))
      (assert (null (command deployment)))))
  (format t "~&CATALOG-DEPLOYMENT-PR52-PASS~%")
  t)
