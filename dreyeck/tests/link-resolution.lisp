(defpackage #:dreyeck/work/link-resolution/tests
  (:use #:cl)
  (:local-nicknames (#:m #:dreyeck/work/link-resolution) (#:h #:dreyeck/shop3))
  (:export #:run-tests))
(in-package #:dreyeck/work/link-resolution/tests)
(defun selected-sites (result)
  (mapcar #'first (first (m:fixture-outcomes result))))
(defun matches (result expected &optional (repeat 1))
  (if expected
      (and (= 1 (length (h:plans-of result)))
           (equal (make-list repeat :initial-element expected) (selected-sites result)))
      (null (h:raw-plans-of result))))
(defun check (label state candidates expected &key (policy :collaborative) prepare (repeat 1)
                                                  (domain 'm::fedwiki-ordered-resolution))
  (let* ((before (copy-tree state))
         (result (m:plan-resolution state candidates :policy policy :prepare prepare :repeat repeat :domain domain))
         (count (if expected 1 0)))
    (assert (equal before state))
    (assert (eq :plan-only (h:execution-mode-of result)))
    (assert (= count (length (h:plans-of result)) (length (h:raw-plans-of result))
                    (length (h:plan-trees-of result)) (length (h:final-states-of result))))
    (assert (matches result expected repeat))
    (dolist (final (h:final-states-of result))
      (assert (subsetp state (shop3:state-atoms final) :test #'equal)))
    (format t "~&LINK-RESOLUTION PASS ~A ~A: ~D plans, selected ~S, execution NOT-EXECUTED~%"
            label policy count (selected-sites result))
    result))
(defun plan-trace (result)
  (loop for step in (first (h:plans-of result))
        collect (if (eq (first step) 'm::!record-miss) (second step) (third step))))
(defun with-gate-mutant (test)
  (let ((name (gensym "LOCAL-GATE-MUTANT-")))
    (unwind-protect
         (let* ((shop3:*domain* shop3:*domain*)
                (*package* (find-package :dreyeck/work/link-resolution)) (*read-eval* nil)
                (definition (with-open-file (in (asdf:system-relative-pathname "dreyeck/work/link-resolution"
                                                  "dreyeck/work/link-resolution.lisp"))
                              (loop for form = (read in nil :eof) until (eq form :eof)
                                    when (and (consp form) (eq (car form) 'shop3:defdomain)) return (copy-tree form))))
                (gate (find-if (lambda (item) (equal (second item) '(m::allowed :local-only m::?origin m::?origin)))
                               (third definition))))
           (assert gate)
           (setf (second gate) '(m::allowed :local-only m::?origin m::?site))
           (setf (second definition) (list name :noset t :silently t))
           (eval definition) (funcall test name))
      (shop3:delete-domain name))))
(defun run-tests ()
  (let ((java (with-open-file (in (asdf:system-relative-pathname "dreyeck/work/link-resolution"
                                   "docs/fedwiki-java-link-resolution-evidence/java.json"))
                (shasht:read-json in))))
    (assert (equal m:*reference-commit* (gethash "commit" java)))
    (dolist (case (m:fixture-cases))
      (let* ((id (gethash "id" case)) (state (m:fixture-state case))
             (candidates (m:fixture-candidates case)) (expected (m::site-key (gethash "expectedSite" case)))
             (repeat (or (gethash "repeat" case) 1))
             (result (check id state candidates expected :repeat repeat)))
        (assert (equal candidates (map 'list #'m::site-key (gethash "expectedCandidates" case))))
        (when expected
          (let ((observed (find id (gethash "cases" java) :test #'equal :key (lambda (x) (gethash "id" x)))))
            (assert observed)
            (assert (equal (plan-trace result) (map 'list #'m::site-key (gethash "linkTrace" observed))))))
        (check id state candidates (and (eq expected :origin) :origin) :policy :local-only))))
  ;; Verified local snapshot may suffice only under an explicitly chosen policy.
  (let* ((state '((m::page-absent :origin :target) (m::verified-copy :a :target :sha256-fixture)
                  (m::fork-permitted :origin :target) (m::fork-source-policy :cached-copy-sufficient)))
         (sites '(:origin :a))
         (result (check :fork state sites :origin :prepare t :policy :local-only :repeat 2))
         (plan (first (h:plans-of result))) (atoms (shop3:state-atoms (first (h:final-states-of result)))))
    (assert (= 1 (count 'm::!prepare-fork plan :key #'first)))
    (assert (equal '((:origin :modeled) (:origin :modeled)) (first (m:fixture-outcomes result))))
    (assert (member '(m::page-absent :origin :target) atoms :test #'equal))
    (assert (not (member '(m::page-present :origin :target) atoms :test #'equal)))
    (let ((continued (check :replan-from-hypothetical-final-state atoms sites :origin
                            :prepare t :policy :local-only)))
      (assert (zerop (count 'm::!prepare-fork (first (h:plans-of continued)) :key #'first)))
      (assert (equal '((:origin :modeled)) (first (m:fixture-outcomes continued)))))
    ;; A new independent planning call starts from the supplied evidence again.
    (check :same-request-fresh-search state sites :origin :prepare t :policy :local-only)
    (dolist (predicate '(m::verified-copy m::fork-permitted m::fork-source-policy m::page-absent))
      (check (list :missing predicate) (remove predicate state :key #'first) sites nil :prepare t :policy :local-only))
    (let ((fresh (substitute '(m::fork-source-policy :require-remote-evidence)
                             '(m::fork-source-policy :cached-copy-sufficient) state :test #'equal)))
      (check :require-remote-unknown fresh sites nil :prepare t :policy :local-only)
      (check :remote-evidence-supplied (cons '(m::page-present :a :target) fresh) sites :origin :prepare t :policy :local-only))
    (check :conflicting-local (cons '(m::page-present :origin :target) state) sites nil :prepare t)
    (check :http500-not-absence (cons '(m::http-miss :origin :target 500)
                                     (remove 'm::page-absent state :key #'first)) sites nil :prepare t))
  ;; The same acceptance predicates MUST reject these targeted mutants.
  (let* ((case (m:fixture-by-id "context-order")) (state (m:fixture-state case))
         (mutated-candidates
           (let ((original (symbol-function 'm:candidate-context)))
             (unwind-protect
                  (progn
                    (setf (symbol-function 'm:candidate-context)
                          (lambda (&rest args)
                            (let ((sites (apply original args))) (cons (car sites) (reverse (cdr sites))))))
                    (m:fixture-candidates case))
               (setf (symbol-function 'm:candidate-context) original))))
         (mutant (m:plan-resolution state mutated-candidates)))
    (assert (not (matches mutant :b)))
    (assert (matches mutant :a))
    (format t "~&MUTANT-KILLED candidate-order: expected :B, mutant selected :A.~%")
    (with-gate-mutant
      (lambda (domain)
        (let ((mutant (m:plan-resolution state (m:fixture-candidates case) :policy :local-only :domain domain)))
          (assert (not (matches mutant nil))) (assert (matches mutant :b))
          (format t "~&MUTANT-KILLED local-only-gate: expected refusal, mutant selected remote :B.~%")))))
  (let* ((case (m:fixture-by-id "unknown-before-hit"))
         (state (m:fixture-state case)))
    (check :unknown-not-absence state (m:fixture-candidates case) nil)
    (check :absence-evidence-added (cons '(m::page-absent :b :target) state) (m:fixture-candidates case) :a))
  (format t "~&LINK-RESOLUTION-TESTS-PASS: real SHOP3, Java trace comparison, two killed mutants; no Wiki effects.~%") t)
