(defpackage #:dreyeck/topic-maps-reading/tests
  (:use #:cl)
  (:local-nicknames (#:r #:dreyeck/topic-maps-reading)
                    (#:a #:dreyeck/work/item-edit-proposal)
                    (#:tmdm #:topic-maps.tmdm)
                    (#:tm #:dreyeck/topicmap)
                    (#:v #:html-inspector-views))
  (:export #:run-tests))
(in-package #:dreyeck/topic-maps-reading/tests)

(defvar *checks* 0)
(defmacro check (form) `(progn (incf *checks*) (assert ,form)))
(defun view (object title)
  (let ((view (or (find title (v:all-views object) :key #'v:view-title :test #'equal) (error "Missing ~A view of ~S" title object))))
    (v:view-html view)
    (check (notany (lambda (ref) (typep (cdr ref) 'condition)) (v:view-references view)))
    view))
(defun refs (object title) (mapcar #'cdr (v:view-references (view object title))))
(defun html (object title) (v:view-html (view object title)))
(defun all-views-of (object)
  (dolist (view (remove-if-not (lambda (view) (typep view 'v::html-view)) (v:all-views object))) (v:view-html view)))
(defun topic-named (reading label)
  (find label (tmdm:topic-map-topics (r:reading-map reading)) :key #'r:topic-label :test #'equal))
(defun refuses (condition-type thunk)
  (check (handler-case (progn (funcall thunk) nil) (condition (c) (typep c condition-type)))))
(defun registry-directory () (asdf:system-source-directory "topic-maps/ctm"))

(defun fresh-facts ()
  (let ((program (or (uiop:argv0) (first sb-ext:*posix-argv*)))
        (form (format nil "(progn (pushnew ~S asdf:*central-registry* :test (function equal))
  (asdf:load-system \"dreyeck/topic-maps-reading\")
  (let* ((package \"DREYECK/TOPIC-MAPS-READING\")
         (reading (funcall (find-symbol \"READ-CTM-READING\" package)))
         (map (funcall (find-symbol \"READING-MAP\" package) reading))
         (projection (funcall (find-symbol \"READING-PROJECTION\" package) reading)))
    (dolist (part (append (list reading projection) (funcall (find-symbol \"TOPIC-MAP-TOPICS\" \"TOPIC-MAPS.TMDM\") map)
                          (funcall (find-symbol \"TOPICMAP-PROJECTION-TOPICS-OF\" \"DREYECK/TOPICMAP\") projection)))
      (dolist (view (funcall (find-symbol \"ALL-VIEWS\" \"HTML-INSPECTOR-VIEWS\") part))
        (when (typep view (find-symbol \"HTML-VIEW\" \"HTML-INSPECTOR-VIEWS\"))
          (funcall (find-symbol \"VIEW-HTML\" \"HTML-INSPECTOR-VIEWS\") view))))
    (format t \"~~&FRESH-TMDM ~~S~~%\"
            (list (funcall (find-symbol \"READING-SHA256\" package) reading)
                  (length (funcall (find-symbol \"TOPIC-MAP-TOPICS\" \"TOPIC-MAPS.TMDM\") map))
                  (mapcar (find-symbol \"TOPIC-LABEL\" package) (funcall (find-symbol \"TOPIC-MAP-TOPICS\" \"TOPIC-MAPS.TMDM\") map))
                  (getf (funcall (find-symbol \"READING-FIDELITY\" package) reading) :equal)
                  (and (find-package \"DREYECK/FEDWIKI-PAGE-AUTHORING\") t)))))"
                      (namestring (registry-directory)))))
    (multiple-value-bind (output error-output status)
        (uiop:run-program (list program "--noinform" "--non-interactive" "--eval" "(require :asdf)" "--eval" form)
                          :output :string :error-output :output :ignore-error-status t)
      (declare (ignore error-output))
      (let ((at (search "FRESH-TMDM " output)))
        (unless (and (zerop status) at) (error "Fresh image failed (status ~S):~%~A" status output))
        (let ((*read-eval* nil) (*package* (find-package "COMMON-LISP-USER")))
          (read-from-string output t nil :start (+ at (length "FRESH-TMDM "))))))))

(defun run-tests ()
  (let* ((*checks* 0)
         (writer-before (and (find-package "DREYECK/FEDWIKI-PAGE-AUTHORING") t))
         (path (r:default-ctm-path))
         (ctm-digest (a::file-digest path))
         (reading (r:read-ctm-reading))
         (map (r:reading-map reading)))
    ;; 1. The source: the unchanged file, the documented identity; a different digest is refused.
    (check (equal r:+ctm-sha256+ ctm-digest))
    (check (equal r:+ctm-sha256+ (r:reading-sha256 reading)))
    (refuses 'r:reading-error (lambda () (r:read-ctm-reading :expected-sha256 "0000")))
    (check (r:read-ctm-reading :expected-sha256 ctm-digest))
    ;; 2. TMDM fidelity: five Topics, one Association, two Roles, objects of the real reader.
    (check (typep map 'tmdm:topic-map))
    (check (= 5 (length (tmdm:topic-map-topics map))))
    (check (every (lambda (topic) (typep topic 'tmdm:topic)) (tmdm:topic-map-topics map)))
    (check (equal '("assoctype" "roletype1" "roletype2" "topic1" "topic2")
                  (sort (mapcar #'r:topic-label (tmdm:topic-map-topics map)) #'string<)))
    (let* ((association (first (tmdm:topic-map-associations map))) (roles (tmdm:association-roles association)))
      (check (= 1 (length (tmdm:topic-map-associations map))))
      (check (= 2 (length roles)))
      (check (every (lambda (role) (typep role 'tmdm:association-role)) roles))
      (check (eq (topic-named reading "assoctype") (tmdm:association-type association)))
      (check (equal '(("roletype1" "topic1") ("roletype2" "topic2"))
                    (mapcar (lambda (role) (list (r:topic-label (tmdm:association-role-type role)) (r:topic-label (tmdm:association-role-player role)))) roles)))
      (check (every (lambda (role) (eq association (tmdm:association-role-parent role))) roles))
      ;; Roles played are computed: one for each player, none for the types.
      (check (= 1 (length (tmdm:topic-roles-played (topic-named reading "topic1")))))
      (check (= 1 (length (tmdm:topic-roles-played (topic-named reading "topic2")))))
      (check (null (tmdm:topic-roles-played (topic-named reading "roletype1"))))
      (check (every (lambda (topic) (and (null (tmdm:topic-subject-identifiers topic)) (null (tmdm:topic-subject-locators topic))
                                         (= 1 (length (tmdm:topic-item-identifiers topic)))))
                    (tmdm:topic-map-topics map))))
    ;; The canonical form equals the unchanged baseline: the objects are the document's, not a lookalike.
    (check (getf (r:reading-fidelity reading) :equal))
    (check (= 833 (getf (r:reading-fidelity reading) :canonical-octets) (getf (r:reading-fidelity reading) :baseline-octets)))
    (check (equal r:+document-iri+ (subseq (first (tmdm:topic-item-identifiers (topic-named reading "topic1")))
                                           0 (position #\# (first (tmdm:topic-item-identifiers (topic-named reading "topic1")))))))
    ;; 3. The four projections: counts, EQ objects, and the edge only where it is chosen.
    (flet ((counts (variant show) (let ((p (r:reading-projection reading variant show)))
                                    (list (length (tm:topicmap-projection-topics-of p)) (length (tm:topicmap-projection-associations-of p))))))
      (check (equal '(6 2) (counts :association-node t)))
      (check (equal '(3 2) (counts :association-node nil)))
      (check (equal '(5 1) (counts :association-edge t)))
      (check (equal '(2 1) (counts :association-edge nil))))
    (let* ((node (r:reading-projection reading :association-node t)) (edge (r:reading-projection reading :association-edge t)))
      (check (eq node (r:reading-projection reading :association-node t)))
      (dolist (topic (tm:topicmap-projection-topics-of node))
        (check (typep topic 'r:projected-tmdm-topic))
        (check (or (member (tm:topicmap-topic-object-of topic) (tmdm:topic-map-topics map) :test #'eq)
                   (member (tm:topicmap-topic-object-of topic) (tmdm:topic-map-associations map) :test #'eq))))
      ;; In the node candidate the two players are not joined to each other; in the edge candidate they are. Control and contrast.
      (flet ((joined (projection from to)
               (find-if (lambda (e) (or (and (equal from (tm:topicmap-association-from-of e)) (equal to (tm:topicmap-association-to-of e)))
                                        (and (equal to (tm:topicmap-association-from-of e)) (equal from (tm:topicmap-association-to-of e)))))
                        (tm:topicmap-projection-associations-of projection))))
        (check (null (joined node "topic1" "topic2")))
        (check (joined edge "topic1" "topic2")))
      ;; The Role edges carry their Role, which is the Role of the Association.
      (dolist (e (tm:topicmap-projection-associations-of node))
        (let ((role (getf (tm:topicmap-association-properties-of e) :tmdm-role)))
          (check (typep role 'tmdm:association-role))
          (check (member role (tmdm:association-roles (first (tmdm:topic-map-associations map))) :test #'eq))
          (check (equal (r:topic-label (tmdm:association-role-type role)) (tm:topicmap-association-type-of e)))))
      ;; Keys are unique, and a projection that mentions a missing Topic would be refused by dreyeck/topicmap itself.
      (check (= 6 (length (remove-duplicates (mapcar #'tm:topicmap-topic-id-of (tm:topicmap-projection-topics-of node)) :test #'equal)))))
    ;; An Association with three Roles has no single edge, but is a node with three Role edges.
    (let* ((three (tmdm:make-topic-map))
           (iri (lambda (name) (format nil "https://example.invalid/three#~A" name)))
           (topics (loop for name in '("t" "r1" "r2" "r3" "p1" "p2" "p3") collect (tmdm:intern-topic three :item-identifier (funcall iri name)))))
      (destructuring-bind (type r1 r2 r3 p1 p2 p3) topics
        (tmdm:make-association three type (list (list r1 p1) (list r2 p2) (list r3 p3))))
      (let ((fake (make-instance 'r:ctm-reading :path path :sha256 "-" :map three :fidelity nil)))
        (let ((projection (r:reading-projection fake :association-node t)))
          (check (= 8 (length (tm:topicmap-projection-topics-of projection))))
          (check (= 3 (length (tm:topicmap-projection-associations-of projection)))))
        (refuses 'r:tmdm-projection-error (lambda () (r:reading-projection fake :association-edge t)))))
    ;; 4. Navigation: both objects' views, in both directions, and the difference stated.
    (let* ((workspace (r:reading-workspace reading :association-node t))
           (objects (refs reading "TMDM objects")))
      (check (member map objects :test #'eq))
      (dolist (topic (tmdm:topic-map-topics map)) (check (member topic objects :test #'eq)))
      (check (member (first (tmdm:topic-map-associations map)) objects :test #'eq))
      (dolist (role (tmdm:association-roles (first (tmdm:topic-map-associations map)))) (check (member role objects :test #'eq)))
      (let ((listed (refs reading "Projections")))
        (dolist (topic (tm:topicmap-projection-topics-of (r:reading-projection reading))) (check (member topic listed :test #'eq)))
        (check (member workspace listed :test #'eq))
        (dolist (variant (r:reading-variants))
          (check (member (r:reading-projection reading (first variant) (second variant)) listed :test #'eq))))
      (let* ((projected (find "topic1" (tm:topicmap-projection-topics-of (r:reading-projection reading)) :key #'tm:topicmap-topic-label-of :test #'equal))
             (text (html projected "TMDM object or projected topic?")) (links (refs projected "TMDM object or projected topic?")))
        (check (member (topic-named reading "topic1") links :test #'eq))
        (check (member projected links :test #'eq))
        (check (member reading links :test #'eq))
        (check (not (eq projected (tm:topicmap-topic-object-of projected))))
        (check (eq (topic-named reading "topic1") (tm:topicmap-topic-object-of projected)))
        (check (search "item identifier" text))
        (check (search "E4" text))
        (check (search "not a Work Topic" text)))
      ;; The projected Topic and the TMDM Topic are different objects of different kinds.
      (check (typep (find "topic1" (tm:topicmap-projection-topics-of (r:reading-projection reading)) :key #'tm:topicmap-topic-label-of :test #'equal) 'tm:topicmap-topic))
      (check (not (typep (topic-named reading "topic1") 'tm:topicmap-topic)))
      (let ((edge (first (tm:topicmap-projection-associations-of (r:reading-projection reading)))))
        (check (member (getf (tm:topicmap-association-properties-of edge) :tmdm-role) (refs edge "TMDM object or projected edge?") :test #'eq))
        (check (search "no direction" (html edge "TMDM object or projected edge?"))))
      ;; The Topicmap view of the reading itself is the node candidate.
      (check (eq (tm:topicmap-projection-source-of (tm:topicmap-projection-of reading)) reading))
      ;; Every view of every part renders without a condition.
      (dolist (part (append (list reading (r:reading-projection reading) workspace map) (tmdm:topic-map-topics map)
                            (tmdm:topic-map-associations map) (tm:topicmap-projection-topics-of (r:reading-projection reading))
                            (tm:topicmap-projection-associations-of (r:reading-projection reading))))
        (all-views-of part)))
    ;; 5. Entry from the proposal anatomy: the example is reached from E3, and E3 stays undecided.
    (let* ((anatomy (a:read-proposal-anatomy)) (example (html anatomy "TMDM example")))
      (check (find-if (lambda (object) (typep object 'r:ctm-reading)) (refs anatomy "TMDM example")))
      (check (search "No candidate is chosen here." example))
      (check (search "open decision" example))
      (check (search "No candidate is chosen here." example))
      (check (member (a:anatomy-item anatomy) (refs anatomy "TMDM example") :test #'eq))
      (check (find "TMDM example" (v:all-views anatomy) :key #'v:view-title :test #'equal))
      (check (search "TMDM example" (html anatomy "Operation or topic?"))))
    ;; 6. Nothing was written, no writer loaded, the CTM file and the topic-maps checkout are as they were.
    (check (equal ctm-digest (a::file-digest path)))
    (check (eq writer-before (and (find-package "DREYECK/FEDWIKI-PAGE-AUTHORING") t)))
    ;; 7. A new image reconstructs the reading from the registry.
    (destructuring-bind (sha count labels fidelity writer) (fresh-facts)
      (check (equal r:+ctm-sha256+ sha))
      (check (= 5 count))
      (check (equal (sort (copy-list labels) #'string<) (sort (mapcar #'r:topic-label (tmdm:topic-map-topics map)) #'string<)))
      (check fidelity)
      (check (null writer)))
    (format t "~&TOPIC-MAPS-READING-PASS: ~D checks; association-binary.ctm read with the topic-maps reader: 5 Topics, 1 Association, 2 Roles, canonical form equal to the baseline; four candidate projections whose Topics keep the TMDM object as EQ object; the TMDM object and the projected Topic told apart; E3 not decided; nothing written, no writer; fresh image reconstructs it.~%" *checks*)
    t))
