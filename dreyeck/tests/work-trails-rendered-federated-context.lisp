                 (assert (eq page-b (views:eval-thunk (reference point-view follow-button))))
                 (assert (equal (list page-b) follows))
                 (dolist (label '("Inspect represented object" "Inspect Topicmap sign"))
                   (let ((element (find label (remove-if-not (lambda (e) (plump:attribute e "id"))
                                                            (plump:get-elements-by-tag-name point-dom "span"))
                                        :key #'plump:text :test #'equal)))
                     (assert (uiop:string-prefix-p "inspect-" (plump:attribute element "id")))
                     (assert (eq (if (equal label "Inspect represented object") page-b topic-b)
                                 (reference point-view element)))))
                 (assert (equal b (dreyeck/topicmap:topicmap-workspace-point-of workspace)))
                 (assert (= 10 (reading::context-cursor context)))
                 ;; Every relation endpoint is graph navigation through the same action.
                 (dolist (row (plump:get-elements-by-tag-name point-dom "tr"))
                   (let* ((association (find (plump:attribute row "data-point-relation")
                                            (dreyeck/topicmap::topicmap-associations-of-point workspace)
                                            :key #'dreyeck/topicmap:topicmap-association-id-of :test #'equal))
                          (element (first (plump:get-elements-by-tag-name row "button")))
                          (action (reference point-view element)))
                     (assert association)
                     (assert (typep action 'reading::context-point-action))
                     (assert (equal (dreyeck/topicmap::topicmap-association-other-topic-id workspace association)
