                                     (dreyeck/inspector/topicmap::action-topic action))))))
                 (let* ((topic-c (dreyeck/topicmap::topicmap-projection-topic-by-id projection c))
                        (element (button point-dom (dreyeck/topicmap:topicmap-topic-label-of topic-c))))
                   (assert (null (views:eval-thunk (reference point-view element))))
                   (assert (= 2 updates))
                   (assert (equal c (dreyeck/topicmap:topicmap-workspace-point-of workspace)))
                   (assert (equal (list b a) (dreyeck/topicmap:topicmap-workspace-history-of workspace)))
                   (assert (equal (list page-b) follows))
