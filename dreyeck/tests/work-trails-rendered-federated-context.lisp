                 (assert (equal "true" (plump:attribute sign-c "data-selected")))
                 (assert (search "How We Think" (plump:text point)))
                 (assert (= (length (dreyeck/topicmap::topicmap-associations-of-point workspace))
                            (length (plump:get-elements-by-tag-name point "tr")))))
               ;; Temporal selection re-projects the same editing session.
               (let ((event-sign (sign (gethash "id" (aref (reading::context-events context) 8)))))
                 (assert (views:eval-thunk (reference view event-sign))))
               (assert (= 8 (reading::context-cursor context)))
               (let ((current (reading::context-current-workspace context)))
                 (assert (equal c (dreyeck/topicmap:topicmap-workspace-point-of current)))
                 (assert (eq current workspace))
                 (assert (equal (list b a) (dreyeck/topicmap:topicmap-workspace-history-of current))))
               (assert (equal (list page-b) follows)))))
      (setf (symbol-function 'reading::follow-context-object) follow)))
  (format t "~&ORTHOGONAL-CONTEXT-OPERATIONS-PASS: primary B moves Point/no follow/NIL; Follow and inspections at B preserve Point/time; relation to C uses the same movement; temporal selection retains Workspace/Point/history.~%"))

(defun check-context-topic-operations ()
  (let* ((context (reading:federated-context))
         (workspace (reading::context-current-workspace context))
         (projection (tm:topicmap-workspace-projection-of workspace))
         (a (tm:topicmap-workspace-point-of workspace))
         (history (tm:topicmap-workspace-history-of workspace))
         (cursor (reading::context-cursor context))
         (b (tm:topicmap-projection-topic-by-id projection "fedwiki:thompson.voices.ustawi.wiki/how-we-think"))
         (object (tm:topicmap-topic-object-of b))
         (follow (symbol-function 'reading::follow-context-object))
         (follows nil))
    (assert (not (equal a (tm:topicmap-topic-id-of b))))
    (unwind-protect
         (progn
           (setf (symbol-function 'reading::follow-context-object)
                 (lambda (target) (push target follows) (funcall follow target)))
           (dolist (case (list (list (w:follow-operation) 90 object)
                               (list (w:inspect-represented-object-operation) 180 object)
                               (list (w:inspect-topicmap-sign-operation) 270 b)))
             (destructuring-bind (operation angle expected) case
               (dolist (kind '(:radial-menu :learned-mark))
                 (let ((occurrence (gt::%production-occurrence workspace b)))
                   (assert (= 6 (length (m:workspace-action-sign-bindings occurrence))))
                   (gt::check-topic-binding-sectors occurrence)
                   (gt::check-topic-binding-pair occurrence operation angle)
                   (gt::%feed occurrence (gt::%sector-trace angle kind))
                   (assert (eq :completed (getf (gt::%result occurrence) :state)))
                   (assert (eq operation (w:gesture-binding-operation
                                         (dreyeck/gesture/clog:gesture-window-selection
                                          (m:occurrence-gesture-window occurrence)))))
                   (assert (eq expected (m:workspace-action-sign-selected-object occurrence)))
                   (assert (equal a (tm:topicmap-workspace-point-of workspace)))
                   (assert (eq history (tm:topicmap-workspace-history-of workspace)))
                   (assert (= cursor (reading::context-cursor context)))))))
           (assert (equal (list object object) follows))
           ;; A Subject offers the same Follow identities; resolution remains the existing function.
           (let ((subject (tm:topicmap-projection-topic-by-id projection "concept:How We Think")))
             (gt::check-topic-binding-pair (gt::%production-occurrence workspace subject) (w:follow-operation) 90))
           ;; Unsupported objects leave Follow's sector vacant and refuse direct execution.
           (let* ((plain (tm:make-topicmap-topic :id "unsupported" :label "Unsupported" :object :unsupported))
                  (ws (tm:make-topicmap-workspace (tm:make-topicmap-projection :topics (list plain)) "unsupported"))
                  (occurrence (gt::%production-occurrence ws plain)))
             (assert (= 4 (length (m:workspace-action-sign-bindings occurrence))))
             (gt::check-topic-binding-sectors occurrence)
             (gt::check-topic-binding-pair occurrence (w:inspect-represented-object-operation) 180)
             (gt::check-topic-binding-pair occurrence (w:inspect-topicmap-sign-operation) 270)
             (assert (handler-case
                         (progn (m:operation-inspectable-object
                                 (w:follow-operation)
                                 (list :type :workspace-action-sign-occurrence :occurrence occurrence)) nil)
                       (m:operation-not-applicable () t))))
           ;; Actual PRIMARY reference retains the ordinary non-refreshing Point operation.
           (let* ((view (context-view context "Topicmap"))
                  (dom (plump:parse (views:view-html view)))
                  (sign (find (tm:topicmap-topic-id-of b) (plump:get-elements-by-tag-name dom "g")
                              :key (lambda (e) (plump:attribute e "data-topic-id")) :test #'equal))
                  (reference (cdr (assoc (plump:attribute sign "id") (views:view-references view) :test #'equal))))
             (assert (null (views:eval-thunk reference)))
             (assert (equal (tm:topicmap-topic-id-of b) (tm:topicmap-workspace-point-of workspace)))
             (assert (equal (list a) (tm:topicmap-workspace-history-of workspace)))
             (assert (= cursor (reading::context-cursor context)))
             (assert (equal (list object object) follows))))
      (setf (symbol-function 'reading::follow-context-object) follow)))
  (format t "~&FEDERATED-TOPIC-OPERATIONS-PASS: same menu/mark identities and sectors, exact B Follow/object/sign, unchanged A/history/time, applicability/refusal, unchanged PRIMARY.~%"))

(defun check-context-persistent-workspace ()
  (let* ((context (reading:federated-context))
         (workspace (reading::context-current-workspace context))
         (a "fedwiki:jan.voices.ustawi.wiki/john-dewey")
         (b "fedwiki:thompson.voices.ustawi.wiki/how-we-think")
         (c "concept:How We Think")
         (d "concept:Reflective Practice")
         (go-to (symbol-function 'dreyeck/topicmap:topicmap-workspace-go-to))
         (follow (symbol-function 'reading::follow-context-object))
         (moves 0))
    (assert (equal a (dreyeck/topicmap:topicmap-workspace-point-of workspace)))
    (unwind-protect
         (progn
           (setf (symbol-function 'dreyeck/topicmap:topicmap-workspace-go-to)
                 (lambda (session id) (incf moves) (funcall go-to session id))
                 (symbol-function 'reading::follow-context-object)
                 (lambda (object) (error "Re-projection followed ~S" object)))
           (labels ((move (id)
                      (let* ((view (context-view context "Topicmap"))
                             (dom (plump:parse (views:view-html view)))
                             (sign (find id (plump:get-elements-by-tag-name dom "g")
                                         :key (lambda (e) (plump:attribute e "data-topic-id")) :test #'equal))
                             (reference (cdr (assoc (plump:attribute sign "id")
                                                    (views:view-references view) :test #'equal))))
                        (assert (uiop:string-prefix-p "action-" (plump:attribute sign "id")))
                        (assert (null (views:eval-thunk reference)))))
                    (render (projected history)
                      (let* ((current (reading::context-current-workspace context))
                             (view (context-view context "Topicmap"))
                             (dom (plump:parse (views:view-html view)))
                             (map (find "context" (plump:get-elements-by-tag-name dom "div")
                                        :key (lambda (e) (plump:attribute e "data-projection")) :test #'equal))
                             (marks (remove-if-not (lambda (e) (equal "true" (plump:attribute e "data-selected")))
                                                   (plump:get-elements-by-tag-name map "g")))
                             (point-view (reading::context-point-view context))
                             (panel (views:view-html point-view)))
                        (assert (eq workspace current))
                        (assert (eq workspace (reading::context-workspace context)))
                        (assert (equal c (dreyeck/topicmap:topicmap-workspace-point-of current)))
                        (assert (eq history (dreyeck/topicmap:topicmap-workspace-history-of current)))
                        (assert (eq projected (dreyeck/topicmap:topicmap-workspace-point-projected-p current)))
                        (assert (= (if projected 1 0) (length marks)))
                        (if projected
                            (progn
                              (assert (equal c (plump:attribute (first marks) "data-topic-id")))
                              (assert (search "Follow" panel))
                              (assert (member (dreyeck/topicmap:topicmap-workspace-current-object current)
                                              (mapcar #'cdr (views:view-references point-view)) :test #'eq)))
                            (progn
                              (assert (search c panel))
                              (assert (search "Not present in current projection" panel))
                              (dolist (operation '("Follow" "Inspect represented object" "Inspect Topicmap sign" "Relations at Point"))
                                (assert (not (search operation panel))))
                              (assert (null (views:view-references point-view)))))
                        (assert (= 2 moves)))))
             (move b) (move c)
             (let ((history (dreyeck/topicmap:topicmap-workspace-history-of workspace)))
               (assert (equal (list b a) history))
               (reading::select-context-event context 8)
               (render t history)
               (setf (reading::context-mode context) :delta)
               (render nil history)
               (assert (plusp (length (dreyeck/topicmap:topicmap-projection-topics-of
                                      (dreyeck/topicmap:topicmap-workspace-projection-of workspace)))))
               ;; Both real empty Deltas preserve the editing session and Point.
               (dolist (index '(6 2))
                 (reading::select-context-event context index)
                 (render nil history)
                 (assert (null (dreyeck/topicmap:topicmap-projection-topics-of
                                (dreyeck/topicmap:topicmap-workspace-projection-of workspace)))))
               (setf (reading::context-mode context) :state)
               (render t history)
               (setf (reading::context-mode context) :delta)
               (render nil history)
               (setf (reading::context-mode context) :state)
               (reading::select-context-event context 10)
               (render t history)
               (setf (reading::context-mode context) :delta)
               (render nil history)
               ;; The event page is present here, but must not replace absent C.
               (assert (dreyeck/topicmap:topicmap-projection-topic-by-id
                        (dreyeck/topicmap:topicmap-workspace-projection-of workspace) a))
               (setf (reading::context-mode context) :state)
               (render t history)
               (move d)
               (assert (= 3 moves))
               (assert (eq workspace (reading::context-current-workspace context)))
               (assert (equal d (dreyeck/topicmap:topicmap-workspace-point-of workspace)))
               (assert (eq history (cdr (dreyeck/topicmap:topicmap-workspace-history-of workspace))))
               (assert (equal (cons c history) (dreyeck/topicmap:topicmap-workspace-history-of workspace)))
               (let ((panel (views:view-html (reading::context-point-view context))))
                 (assert (search "Follow" panel))
                 (assert (search "Inspect represented object" panel))
                 (assert (not (search "Not present in current projection" panel)))))))
      (setf (symbol-function 'dreyeck/topicmap:topicmap-workspace-go-to) go-to
            (symbol-function 'reading::follow-context-object) follow)))
  (format t "~&PERSISTENT-WORKSPACE-PASS: same session, Point/history retained through time/mode, absent and empty projections, zero/one Cursor, fresh projected objects, no Follow or fallback, explicit D records C only.~%"))

(defun check-attribution-negative-control ()
  (let ((context (reading:federated-context)))
    (context-native-fixture
     context
     (lambda ()
       (loop for cursor from 0 to 9
             do (reading::select-context-event context cursor)
                (dolist (mode '(:state :delta))
                  (setf (reading::context-mode context) mode)
                  (let ((projection (reading::context-projection context)))
                    (dolist (association (dreyeck/topicmap:topicmap-projection-associations-of projection))
                      (assert (null (getf (dreyeck/topicmap:topicmap-association-properties-of association) :attribution)))
                      (assert (not (search "Textual attribution"
                                           (views:view-html (context-view association "Evidence")))))))
                  (assert (not (search "Textual attribution"
                                       (views:view-html (context-view context "Topicmap"))))))))))
  (format t "~&ATTRIBUTION-NEGATIVE-CONTROL-PASS: cursors 0–9, State/Delta associations and Topicmap/Evidence views have no attribution.~%"))

(defun check-attribution-mutation-control ()
  ;; Trace the one interpreter as well as checking the result. A duplicated
  ;; textual test could also hide the mutated attribution, but must fail this
  ;; control because it bypasses the shared operation.
  (let* ((name 'reading::context-item-attribution)
         (interpreter (symbol-function name)) (calls nil))
    (unwind-protect
         (progn
           (setf (symbol-function name)
                 (lambda (item) (push item calls) (funcall interpreter item)))
           (let* ((context (reading:federated-context))
                  (page (reading::context-page context "jan-dewey"))
                  (action (find 1790877831968 (gethash "journal" (gethash "raw" page))
                                :key (lambda (entry) (gethash "date" entry))))
                  (item (gethash "item" action)))
             ;; DERIVE-FEDERATED-DATA must use the same interpreter. Its saved
             ;; observed link deliberately remains attributed after the mutation.
             (assert (member item calls :test #'eq))
             (assert (some (lambda (link) (gethash "attribution" link))
                           (gethash "links" (gethash "observed" (reading::context-data context)))))
             (assert (search " via Thompson" (gethash "text" item)))
             (setf (gethash "text" item)
                   (cl-ppcre:regex-replace " via Thompson" (gethash "text" item) ""))
             (assert (null (funcall interpreter item)))
             (context-native-fixture
              context
              (lambda ()
                (dolist (mode '(:state :delta))
                  (setf (reading::context-mode context) mode calls nil)
                  (let ((projection (reading::context-projection context)))
                    ;; Use the actual, already page-scoped item, not its bare ID.
                    (assert (find item (dreyeck/topicmap:topicmap-projection-associations-of projection)
                                  :key (lambda (association)
                                         (getf (dreyeck/topicmap:topicmap-association-properties-of association) :item))
                                  :test #'eq))
                    (assert (member item calls :test #'eq))
                    (dolist (association (dreyeck/topicmap:topicmap-projection-associations-of projection))
                      (assert (null (getf (dreyeck/topicmap:topicmap-association-properties-of association) :attribution)))
                      (assert (not (search "Textual attribution"
                                           (views:view-html (context-view association "Evidence")))))))
                  ;; Warm the map caches so calls from association construction
                  ;; cannot conceal an independent interpreter in the view.
                  (reading::context-rendering context :context)
                  (reading::context-rendering context :temporal)
                  (setf calls nil)
                  (assert (not (search "Textual attribution"
                                       (views:view-html (context-view context "Topicmap")))))
                  (assert (member item calls :test #'eq)))))))
      (setf (symbol-function name) interpreter)))
  (format t "~&ATTRIBUTION-MUTATION-CONTROL-PASS: removing the raw attribution suppresses association/Topicmap/Evidence attribution despite stale observed metadata; derivation, association and view decisions use the single interpreter.~%"))
