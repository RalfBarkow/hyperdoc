;;;; Discourse Graph Experiment Reading Acceptance

(defpackage #:dreyeck/traverse/discourse-tests
  (:use #:cl)
  (:local-nicknames (#:c #:dreyeck/traverse)
                    (#:ct #:dreyeck/traverse/tests)
                    (#:n #:dreyeck/nested-actions)
                    (#:tm #:dreyeck/topicmap)
                    (#:v #:html-inspector-views)
                    (#:git #:dreyeck/git))
  (:export #:run-tests))

(in-package #:dreyeck/traverse/discourse-tests)

(defvar *checks* 0)

(defun check (value &optional (description "Discourse Graph reading contract"))
  (incf *checks*)
  (unless value (error "Failed: ~A" description))
  value)

(defparameter +texts+
  '("What Did Ward Propose?" "How Were Discourse Relations Collected?" "From WALK to TRAVERSE"
    "Reading an Actual Discourse Graph" "What Remains to Be Demonstrated?"))

(defparameter +codes+
  '("Wiki Pages Retained from the Experiment" "Replaying Mech on the Retained Pages"
    "Experiment and Implementation Projections"))

(defparameter +technical+
  '("From Git Revision to Nix Package" "How TRAVERSE Enters Mech"
    "From PageFold to Discourse Graph" "What the Deployment Proves"))

(defparameter +named-pages+
  '(("ward.dojo.fed.wiki" "discourse-graphs") ("discourse.dreyeck.ch" "discourse-graphs")
    ("discourse.dreyeck.ch" "claim-template") ("discourse.dreyeck.ch" "claim-link-survey-probe")
    ("discourse.dreyeck.ch" "claim-link-survey") ("discourse.dreyeck.ch" "how-i-use-my-wiki")
    ("discourse.dreyeck.ch" "can-a-wiki-page-represent-a-claim")
    ("discourse.dreyeck.ch" "a-wiki-page-can-represent-a-claim"))
  "The Wiki pages the experiment names; each must be retained.")

(defun render (object title)
  (let ((view (find title (v:all-views object) :key #'v:view-title :test #'equal)))
    (check view (format nil "~A view of ~A" title object))
    (v:view-html view)
    (check (notany (lambda (ref) (typep (cdr ref) 'condition)) (v:view-references view))
           (format nil "native references of the ~A view resolve" title))
    view))

(defun references (view) (mapcar #'cdr (v:view-references view)))

(defun live-target (href)
  "(site slug) of a link to a live Wiki page, or NIL."
  (let ((view (search "/view/" href)))
    (when (and view (or (eql 0 (search "http://" href)) (eql 0 (search "https://" href))))
      (list (subseq href (+ 3 (search "://" href)) view) (subseq href (+ view 6))))))

(defun check-catalog ()
  (let ((book (hyperbook:find-hyperbook c:+book-id+ :signal-error? t)))
    (check (= 1 (count c:+book-id+ (hyperbook:hyperbooks-of hyperbook:*catalog*)
                       :key #'hyperbook:id-of :test #'equal))
           "the Catalog still contains the companion once")
    (check (equal (first +texts+) (hyperbook:main-page-id-of book)) "the companion opens with Ward's proposal")
    (check (eq (c:companion-page (first +texts+)) (hyperbook:find-page book (hyperbook:main-page-id-of book))))
    (dolist (title (append +texts+ +codes+ +technical+))
      (check (hyperbook:find-page book title :signal-error? nil) (format nil "page ~A in the companion" title)))
    (dolist (title +technical+)
      (let ((dom (plump-parser:parse (hyperdoc:file-of (c:companion-page title)))))
        (check (find "What Did Ward Propose?" (plump-dom:get-elements-by-tag-name dom "a")
                     :key (lambda (a) (plump-dom:attribute a "page")) :test #'equal)
               (format nil "the technical page ~A leads to the experiment" title))))))

(defun check-pages ()
  (let ((book (hyperbook:find-hyperbook c:+book-id+ :signal-error? t))
        (snapshot (c::experiment-snapshot)))
    (dolist (title +texts+)
      (let* ((page (c:companion-page title))
             (dom (plump-parser:parse (hyperdoc:file-of page)))
             (view (render page "Content"))
             (live 0))
        (dolist (tag '("title" "h1"))
          (check (equal title (plump-dom:text (first (plump-dom:get-elements-by-tag-name dom tag))))
                 (format nil "~A in ~A" tag title)))
        (dolist (anchor (plump-dom:get-elements-by-tag-name dom "a"))
          (let ((target (plump-dom:attribute anchor "page"))
                (expression (plump-dom:attribute anchor "expr"))
                (view-title (plump-dom:attribute anchor "view"))
                (href (plump-dom:attribute anchor "href")))
            (when target
              (check (hyperbook:find-page book target :signal-error? nil) (format nil "page link ~A" target)))
            (when href
              (let ((site-slug (live-target href)))
                (check site-slug (format nil "~A is a link to a Wiki page" href))
                (check (c::wiki-page-of (first site-slug) (second site-slug) snapshot)
                       (format nil "~A names a retained page" href))
                (incf live)))
            (when expression
              (let* ((*package* (find-package :dreyeck/traverse))
                     (value (eval (read-from-string (plump-dom:decode-entities expression)))))
                (check (and value (not (typep value 'condition))) (format nil "expression ~A" expression))
                (when view-title (render value view-title))
                (when (typep value 'tm:topicmap-workspace)
                  (check (tm:topicmap-workspace-current-object value)))))))
        (check (plusp live) (format nil "~A links a Wiki page" title))
        (dolist (code +codes+)
          (check (member (c:companion-page code) (references view) :test #'eq)
                 (format nil "~A links ~A" title code)))))
    (dolist (technical +technical+)
      (check (some (lambda (title) (member (c:companion-page technical) (references (render (c:companion-page title) "Content"))
                                           :test #'eq))
                   +texts+)
             (format nil "~A is a technical deepening reached from the experiment" technical)))
    (dolist (code +codes+)
      (let ((page (c:companion-page code)))
        (render page "Source")
        (hyperdoc:load-page page)
        (dolist (title +texts+)
          (let ((link (find title (hyperbook:page-links-of (hyperbook:links-of page))
                            :test #'equal :key #'hyperbook:target-page-of)))
            (check link (format nil "~A links back to ~A" code title))
            (check (eq (c:companion-page title) (v:eval-thunk (hyperbook:thunk-of link))))))))))

(defun check-snapshot ()
  (let* ((snapshot (c::experiment-snapshot))
         (manifest (c::snapshot-manifest snapshot)))
    (check (= (count "page" (gethash "files" manifest) :key (lambda (e) (gethash "kind" e)) :test #'equal)
              (length (c::snapshot-pages snapshot)))
           "every retained page document is read")
    (loop for entry across (gethash "files" manifest)
          do (check (equal (gethash "sha256" entry)
                           (c::file-digest (c::discourse-path (gethash "file" entry))))
                    (format nil "~A matches its SHA-256" (gethash "file" entry)))
             (check (= 200 (gethash "httpStatus" entry)))
             (when (equal "page" (gethash "kind" entry))
               (check (search (format nil "/~A.json" (gethash "slug" entry)) (gethash "url" entry))
                      "the URL names the retained slug"))
             (check (eql 0 (search "2026-10-21T" (gethash "fetchedAt" entry))) "fetched on 2026-10-21"))
    (check (= 110 (count "discourse.dreyeck.ch" (c::snapshot-pages snapshot) :key #'c::page-site :test #'equal))
           "every page of the discourse.dreyeck.ch sitemap is retained")
    (dolist (site-slug +named-pages+)
      (let ((page (c::wiki-page-of (first site-slug) (second site-slug))))
        (check (equal (format nil "/view/~A" (second site-slug)) (subseq (c::live-url page) (search "/view/" (c::live-url page)))))
        (check (eql 0 (search (format nil "~A://~A/" (if (equal "ward.dojo.fed.wiki" (first site-slug)) "http" "https") (first site-slug))
                              (c::live-url page))))
        (dolist (item (c::page-items page))
          (check (and (c::item-id item) (eq page (c::item-page item))))
          (render item "Story item"))
        (render page "Wiki page")
        (render page "Journal")))
    ;; Concrete identities the pages cite.
    (let ((proposal (c::wiki-item-of "ward.dojo.fed.wiki" "discourse-graphs" "31bd93ad173f651c")))
      (check (search "distributed graph across cooperating federated wiki sites" (c::item-text proposal))))
    (check (search "ClaimLinkSurvey" (c::item-text (c::wiki-item-of "ward.dojo.fed.wiki" "discourse-graphs" "44fac82ef4111fc2"))))
    (let ((trav (c::dg-item "discourse-graphs" "268693278cf3e65b")))
      (check (equal "mech" (c::item-type trav)))
      (check (search "TRAVERSE question claim support oppose" (c::item-text trav))))
    (let ((fold (c::dg-item "can-a-wiki-page-represent-a-claim" "7324b5ac4d729ea7"))
          (link (c::dg-item "can-a-wiki-page-represent-a-claim" "c790b11985cb2099")))
      (check (equal "Claims" (c::item-text fold)))
      (check (eq fold (c::item-fold link)) "the link stands in the Claims fold")
      (check (equal "claim" (c::item-role link)))
      (check (equal '(("discourse.dreyeck.ch" . "a-wiki-page-can-represent-a-claim")) (c::item-links link))))
    (let ((fork (first (c::page-forks (c::wiki-page-of "discourse.dreyeck.ch" "discourse-graphs")))))
      (check (equal "ward.dojo.fed.wiki" (c::step-site fork)))
      (check (eql 0 (search "2025-11-26" (c::iso-date (c::step-date fork)))))
      (render fork "Journal step"))
    (check (equal "claim" (c::item-text (c::dg-item "how-i-use-my-wiki" "29c28902048db774"))) "the template's fold id is reused")
    (dolist (source (c::snapshot-sources snapshot))
      (render source "Source definition")
      (if (typep source 'c::served-source)
          (check (eql 0 (search "https://discourse.dreyeck.ch/assets/" (c::source-url source))))
          (check (member (gethash "revision" (n:source-metadata source))
                         '("a83c3e0d6662a10af000696fc3f1401524cef818" "a028b4bba04e539dcaa090423d38a00a0050489d")
                         :test #'equal)
                 (format nil "~A at a fixed revision" (c:source-key source)))))
    (check (equal "export const asSlug = title =>" (subseq (n:source-text (c::discourse-source "upstream:asSlug")) 0 30)))
    (render snapshot "Snapshot")))

(defun check-replay ()
  (let ((replay (c::discourse-replay)))
    (check (zerop (gethash "networkAttempts" (c::replay-value replay))))
    (check (equal ct::+bundle+ (gethash "sha256" (gethash "bundle" (c::replay-value replay)))))
    ;; The reading's restatement of EXTRACT's rules finds the story item behind every recorded edge.
    (dolist (edge (c::replay-edges replay))
      (check (c::edge-origins edge) (format nil "story item behind ~A" (v:text-representation edge))))
    (check (= 86 (length (c::replay-edges replay))))
    (let ((failed (c::failed-traversal)))
      (check (eq :no-relations (c::case-outcome failed)))
      (check (member "TRAVERSE found no question/claim/support/oppose relations from discourse.dreyeck.ch+discourse-graphs"
                     (c::case-troubles failed) :test #'equal))
      (check (member "\"SOLO\" expects \"aspect\" state, like from \"WALK\"." (c::case-troubles failed) :test #'equal))
      (check (null (c::case-solo failed)) "nothing is handed to SOLO")
      (check (null (c::edges-from (c::case-page failed))) "no edge starts at Discourse Graphs")
      (check (notany #'c::item-role (c::page-items (c::case-page failed))) "no item of the page stands in a role fold")
      (render failed "Replay"))
    (let* ((claim (c::claim-traversal))
           (edges (c::case-traversal-edges claim)))
      (check (eq :traversed (c::case-outcome claim)))
      (check (member "TRAVERSE claim ⇒ 1 relations, 2 nodes, 0 unresolved" (c::case-statuses claim) :test #'equal))
      (check (= 1 (length edges)))
      (check (equal "discourse.dreyeck.ch+a-wiki-page-can-represent-a-claim" (gethash "toId" (first edges))))
      (check (equal "resolved" (gethash "status" (gethash "target" (first edges)))))
      (let* ((batch (gethash "data" (first (c::case-solo claim))))
             (handed (gethash "graph" (aref (gethash "aspects" (aref (gethash "sources" batch) 0)) 0))))
        (check (c::json-equal handed (gethash "graph" (gethash "exported" (c::case-value claim))))
               "SOLO hands over exactly the presented graph"))
      (render claim "Replay"))
    (let ((path (c::claim-reading-path)))
      (check (equal '("Claims pagefold" "story item with the link" "extracted edge" "target resolution"
                      "TRAVERSE result" "presented graph" "SOLO batch")
                    (mapcar #'c::step-name path)))
      (check (equal (list (c::dg-item "can-a-wiki-page-represent-a-claim" "c790b11985cb2099"))
                    (c::edge-origins (c::path-value (third path))))
             "the extracted edge leads back to the concrete story item")
      (dolist (step path)
        (check (c::path-source step) "every step names its JavaScript definition")
        (render step "Path step")))
    (let ((walk (c::role-walk-selection)))
      (check (eq :selected (c::case-outcome walk)))
      (check (member "WALK 60 questions ⇒ 6 aspects, 29 nodes" (c::case-statuses walk) :test #'equal))
      (check (member "WALK 30 claims ⇒ 3 aspects, 15 nodes" (c::case-statuses walk) :test #'equal))
      (check (= 102 (gethash "surveyed" (gethash "neighborhood" (c::case-value walk)))))
      (render walk "Replay"))
    (let* ((cross (c::cross-site-question))
           (edges (c::case-traversal-edges cross))
           (elsewhere (remove-if-not (lambda (edge) (eql 0 (search "wiki.planetnineisaspaceship.com+" (gethash "toId" edge)))) edges)))
      (check (eq :constructed (c::case-outcome cross)))
      (check (= 49 (length elsewhere)))
      (check (every (lambda (edge) (equal "unresolved" (gethash "status" (gethash "target" edge)))) elsewhere)
             "no target on another site is resolved")
      (render cross "Replay"))
    (let ((comparison (c::collection-comparison)))
      (check (= 87 (gethash "edges" (getf comparison :stored-survey))))
      (check (= 91 (gethash "edges" (getf comparison :probe-on-snapshot))))
      (check (= 86 (getf (getf comparison :extract-on-snapshot) :edges))))
    (check (eq :not-demonstrated (c::statement-status (c::federation-gap))))
    (check (eq :asserted-unverified (c::statement-status (c::answer-assertion))))
    (render (c::federation-gap) "Open statement")))

(defun check-projection (mode point)
  (let* ((workspace (c::discourse-workspace mode))
         (projection (tm:topicmap-workspace-projection-of workspace)))
    (check (equal point (tm:topicmap-workspace-point-of workspace)))
    (dolist (topic (tm:topicmap-projection-topics-of projection))
      (let ((object (tm:topicmap-topic-object-of topic)))
        (check object (format nil "~A represents an object" (tm:topicmap-topic-id-of topic)))
        ;; The Topicmap view writes a topic's label into a single-quoted attribute without escaping it.
        (check (not (find #\' (tm:topicmap-topic-label-of topic)))
               (format nil "the label of ~A survives the view's attribute quoting" (tm:topicmap-topic-id-of topic)))
        (typecase object
          (c::wiki-page (check (and (c::page-site object) (c::page-slug object) (c::live-url object)))
                        (render object "Wiki page"))
          (c::wiki-item (check (and (c::item-id object) (c::page-site (c::item-page object)) (c::page-slug (c::item-page object))))
                        (render object "Story item"))
          (c::journal-step (render object "Journal step"))
          (n:message-source (render object "Source definition")))))
    (dolist (association (tm:topicmap-projection-associations-of projection))
      (let* ((warrant (getf (tm:topicmap-association-properties-of association) :warrant))
             (status (getf warrant :status))
             (type (tm:topicmap-association-type-of association)))
        (check (member status c::+discourse-statuses+))
        (check (getf warrant :source) "every association names its evidence")
        (check (getf warrant :basis))
        (when (member type '("links to") :test #'equal)
          (check (eq :observed-link status) "a written Wiki link is an observed link"))
        (when (member type '("claim" "question" "support" "oppose") :test #'equal)
          (check (eq :derived-from-pagefold status) "a role relation is derived from a pagefold")
          (check (typep (getf warrant :source) 'c::extracted-edge)))
        (when (member type '("forked from" "edited to" "written as") :test #'equal)
          (check (eq :documented-history status))
          (check (typep (getf warrant :source) '(or c::journal-step c::wiki-item))))
        (when (member (tm:topicmap-association-to-of association) '("assert:answer" "fed:open") :test #'equal)
          (check (member status '(:asserted-unverified :not-demonstrated))
                 "an open statement is reached only as asserted or not demonstrated"))))
    (let ((visited nil))
      (dolist (topic (tm:topicmap-projection-topics-of projection))
        (tm:topicmap-workspace-go-to workspace (tm:topicmap-topic-id-of topic))
        (push (tm:topicmap-topic-id-of topic) visited)
        (check (eq (tm:topicmap-topic-object-of topic) (tm:topicmap-workspace-current-object workspace))
               "Point navigates to the represented object"))
      (check (equal (first visited) (tm:topicmap-workspace-point-of workspace)))
      (check (equal (subseq (reverse visited) 0 (1- (length visited)))
                    (subseq (reverse (tm:topicmap-workspace-history-of workspace))
                            (- (length (tm:topicmap-workspace-history-of workspace)) (1- (length visited)))))
             "history records the path"))
    (render workspace "Topicmap")
    workspace))

(defun check-projections ()
  (check-projection :experiment "ward:proposal")
  (check-projection :implementation "q:link")
  (let ((workspace (c::discourse-workspace :experiment)))
    (tm:topicmap-workspace-go-to workspace "q:link")
    (let ((object (tm:topicmap-workspace-current-object workspace))
          (history (copy-list (tm:topicmap-workspace-history-of workspace))))
      (c::switch-discourse-projection workspace :implementation)
      (check (equal "q:link" (tm:topicmap-workspace-point-of workspace)) "switching keeps the shared Point")
      (check (eq object (tm:topicmap-workspace-current-object workspace))
             "the shared topic represents the same story item in both projections")
      (check (equal history (tm:topicmap-workspace-history-of workspace)))
      (tm:topicmap-workspace-go-to workspace "edge:claim")
      (check (typep (tm:topicmap-workspace-current-object workspace) 'c::extracted-edge))
      (tm:topicmap-workspace-go-to workspace "solo:claim")
      (c::switch-discourse-projection workspace :experiment)
      (tm:topicmap-workspace-go-to workspace "step:traverse-added")
      (check (typep (tm:topicmap-workspace-current-object workspace) 'c::journal-step)))))

(defun run-tests ()
  (setf *checks* 0)
  (let ((actions (ct::call-with-action-guard
                  (lambda ()
                    (check-catalog)
                    (check-pages)
                    (check-snapshot)
                    (check-replay)
                    (check-projections)))))
    (check (zerop actions) "rendering started no process and opened no connection"))
  (format t "~&TRAVERSE-DISCOURSE-PASS: ~D checks; ~D text pages, ~D code pages, ~D retained pages, ~D extracted edges.~%"
          *checks* (length +texts+) (length +codes+) (length (c::snapshot-pages (c::experiment-snapshot)))
          (length (c::replay-edges (c::discourse-replay))))
  t)
