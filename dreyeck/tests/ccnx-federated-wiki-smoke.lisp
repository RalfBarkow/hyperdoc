;;;; The CCNx Federated Wiki reading: it loads, its example pages are consistent and open as ordinary local pages, its links
;;;; resolve, every reference to the two historical repositories is pinned to the reviewed commit, and no key material is
;;;; quoted. No historical code is loaded and no network is used.
(defpackage #:dreyeck/ccnx-federated-wiki/tests
  (:use #:cl)
  (:local-nicknames (#:cw #:dreyeck/ccnx-federated-wiki)
                    (#:hv #:html-inspector-views)
                    (#:ppcre #:cl-ppcre))
  (:export #:run-tests))
(in-package #:dreyeck/ccnx-federated-wiki/tests)

(defparameter +id+ "dreyeck/ccnx-federated-wiki")
(defparameter +main-sha+ "8426dc5cd326fa0d395d5bef2f73b8be33e34a8e")
(defparameter +prototype-sha+ "c5b1b93c632ef9834a598406a25c20ad47bab26e")
(defparameter +titles+ '("Reading the CCNx Federated Wiki" "One Page From Browser to NDN and Back"
                         "Identity, Versions and Signatures" "Plain Text After CCNx"))

(defun %root () (asdf:system-source-directory "dreyeck/ccnx-federated-wiki"))
(defun %pages-directory () (merge-pathnames "dreyeck/pages/ccnx-federated-wiki/" (%root)))
(defun %page-text (title) (uiop:read-file-string (merge-pathnames (format nil "~A.html" title) (%pages-directory))))
(defun %json-file (slug)
  (with-open-file (in (merge-pathnames (format nil "pages/~A" slug) (cw:example-site-root)) :external-format :utf-8)
    (shasht:read-json in)))
(defun %get (key json) (gethash key json))

(defun %json-equal (a b)
  (cond ((and (hash-table-p a) (hash-table-p b))
         (and (= (hash-table-count a) (hash-table-count b))
              (loop for key being the hash-keys of a using (hash-value value)
                    always (multiple-value-bind (other present) (gethash key b) (and present (%json-equal value other))))))
        ((and (vectorp a) (vectorp b) (not (stringp a)) (not (stringp b)))
         (and (= (length a) (length b)) (every #'%json-equal a b)))
        (t (equal a b))))

(defun %excludes (journal)
  "The rule of pageHandler.coffee L86-L93 at the reviewed commit: from the newest action backwards, every action's date until the first fork action."
  (let ((dates '()))
    (loop for action across (reverse journal)
          until (equal "fork" (%get "type" action))
          do (push (%get "date" action) dates))
    (nreverse dates)))

(defun %replay (journal)
  "The story the journal builds, by the rules of revision.coffee at the reviewed commit, for the action types the example uses: create, add (after an item id, else at the end), edit, remove."
  (let ((story '()))
    (loop for action across journal
          for type = (%get "type" action)
          do (cond ((equal type "create") (setf story (coerce (or (%get "story" (%get "item" action)) #()) 'list)))
                   ((equal type "add")
                    (let ((at (position (%get "after" action) story :key (lambda (item) (%get "id" item)) :test #'equal)))
                      (if at
                          (setf story (append (subseq story 0 (1+ at)) (list (%get "item" action)) (nthcdr (1+ at) story)))
                          (setf story (append story (list (%get "item" action)))))))
                   ((equal type "edit")
                    (let ((at (position (%get "id" action) story :key (lambda (item) (%get "id" item)) :test #'equal)))
                      (if at (setf (nth at story) (%get "item" action)) (setf story (append story (list (%get "item" action)))))))
                   ((equal type "remove")
                    (setf story (remove (%get "id" action) story :key (lambda (item) (%get "id" item)) :test #'equal)))))
    (coerce story 'vector)))

(defun %story-view-html (page)
  (let ((view (find "Story" (hv:all-views page) :key #'hv:view-title :test #'string=)))
    (assert view () "no Story view")
    (progv (list (find-symbol "*SERVER-PARAMETERS*" :hyperbook/server)) (list (list "700px" nil))
      (hv:view-html view))))

(defun check-loads ()
  (let ((book (hyperbook:find-hyperbook +id+ :signal-error? t)))
    (assert (equal "Reading the CCNx Federated Wiki" (hyperbook:title-of (hyperbook:find-page book "Reading the CCNx Federated Wiki" :signal-error? t))))
    (dolist (title +titles+)
      (assert (hyperbook:find-page book title :signal-error? t) () "page ~S does not load" title)
      (assert (search "<in-package>dreyeck/ccnx-federated-wiki</in-package>" (%page-text title)) () "~S has no package context" title)))
  ;; Additive: the reading is loaded by HYPERDOC_CATALOG_SYSTEM, not made a member of dreyeck/catalog by this change.
  (assert (not (member +id+ (asdf:system-depends-on (asdf:find-system "dreyeck/catalog")) :test #'equal)))
  t)

(defun check-links ()
  (dolist (title +titles+)
    (let ((text (%page-text title)))
      ;; internal links name pages of the reading
      (ppcre:do-register-groups (target) ("<a page=\"([^\"]+)\"" text)
        (assert (member target +titles+ :test #'string=) () "~S links to a missing page ~S" title target))
      ;; expressions open the two example pages only
      (ppcre:do-register-groups (kind) ("<a expr=\"\\(example-page :([a-z-]+)\\)\"" text)
        (assert (assoc (intern (string-upcase kind) :keyword) cw:+example-kinds+) () "~S: unknown example kind ~S" title kind))
      (assert (not (ppcre:scan "<a expr=\"(?!\\(example-page :)" text)) () "~S evaluates an expression other than EXAMPLE-PAGE" title)
      ;; every reference to the historical repositories is pinned to the reviewed commit of that repository
      (ppcre:do-register-groups (repository kind sha) ("github\\.com/rynomad/(CCNx-Federated-Wiki(?:-Prototype)?)/(blob|tree)/([0-9a-f]+)" text)
        (assert (equal sha (if (string= repository "CCNx-Federated-Wiki-Prototype") +prototype-sha+ +main-sha+)) ()
                "~S: ~A reference is pinned to ~A, not the reviewed commit" title repository sha)
        (assert (= 40 (length sha)) () "~S: not a full commit id: ~A" title sha))
      (assert (not (ppcre:scan "github\\.com/rynomad/[^/\"]+/(?!blob/|tree/)" text)) () "~S: an unpinned reference to a rynomad repository" title)
      (assert (not (ppcre:scan "github\\.com/rynomad/[^/\"]+/(?:blob|tree)/(?![0-9a-f]{40}[/\"])" text)) ()
              "~S: a blob or tree reference to a rynomad repository that is not a full commit id" title)
      (ppcre:do-register-groups (from to) ("#L(\\d+)-L(\\d+)\"" text)
        (assert (<= (parse-integer from) (parse-integer to)) () "~S: reversed line range L~A-L~A" title from to))))
  t)

(defun check-claims-kept-apart ()
  "What the review of the reading asked for stays in the pages: the three kinds of survival are separate sections, and the version is said not to be a content identity."
  (let ((after (%page-text "Plain Text After CCNx"))
        (identity (%page-text "Identity, Versions and Signatures"))
        (report (uiop:read-file-string (merge-pathnames "docs/ccnx-federated-wiki/SOURCE-REPORT.md" (%root)))))
    (dolist (heading '("1. JSON readability and the Story Item structure" "2. Semantic compatibility" "3. Preserved and lost provenance"))
      (assert (search (format nil "<h3>~A</h3>" heading) after) () "Plain Text After CCNx lacks the section ~S" heading))
    (assert (search "not a content identity" identity))
    (assert (search "claimed time" identity))
    (assert (search "### `version` is not a content identity" report))
    (assert (and (search "### 8.1 JSON readability" report) (search "### 8.2 Semantic compatibility" report)
                 (search "### 8.3 Preserved and lost provenance" report)))
    ;; a source reading is not a run: the pages and the report say so
    (assert (search "Nothing was run" (%page-text "One Page From Browser to NDN and Back")))
    (assert (search "No code of either repository was run" (%page-text "Reading the CCNx Federated Wiki")))
    (assert (search "A reading of source is not an execution" report)))
  t)

(defun check-no-key-material ()
  "The embedded private key is not quoted anywhere in the reading or the report (a base64 private-key header, a PEM marker)."
  (dolist (file (append (mapcar (lambda (title) (merge-pathnames (format nil "~A.html" title) (%pages-directory))) +titles+)
                        (list (merge-pathnames "docs/ccnx-federated-wiki/SOURCE-REPORT.md" (%root)))))
    (let ((text (uiop:read-file-string file)))
      (assert (not (search "PRIVATE KEY" text)) () "~A mentions a PEM private key" file)
      (assert (not (search "MIICXQIBAAKBg" text)) () "~A quotes private key material" file)))
  t)

(defun check-example-pages ()
  (let* ((sfw (%json-file (cw:example-slug :sfw)))
         (record (%json-file (cw:example-slug :ccnx-record)))
         (journal (%get "journal" sfw)))
    ;; the example is built for the reading, with no link to another page: nothing can leave the machine when it is shown
    (dolist (page (list sfw record))
      (loop for item across (%get "story" page)
            do (assert (not (search "[[" (%get "text" item))) () "an example item holds a wiki link")))
    (assert (= 2 (length (%get "story" sfw))))
    ;; the story is what the journal says it is (the semantic claim the reading makes for the page content)
    (assert (%json-equal (%get "story" sfw) (%replay journal)) () "the story is not the replay of the journal")
    (assert (= 5 (length journal)))
    (assert (equal '("create" "add" "add" "edit" "edit") (map 'list (lambda (a) (%get "type" a)) journal)))
    ;; the CCNx record is the same page plus exactly the four fields, with the values the cited rules give
    (assert (equal '("excludes" "favicon" "page" "version")
                   (sort (remove-if (lambda (k) (nth-value 1 (gethash k sfw))) (loop for k being the hash-keys of record collect k)) #'string<)))
    (dolist (key '("title" "story" "journal"))
      (assert (%json-equal (%get key sfw) (%get key record)) () "~A differs between the two forms" key))
    (assert (equal "plain-text-example.json" (%get "page" record)))
    (assert (equal (%get "date" (aref journal 4)) (%get "version" record)) () "version is the date of the last journal action")
    (assert (equal (%excludes journal) (coerce (%get "excludes" record) 'list)) () "excludes follows the rule of pageHandler.coffee L86-L93")
    (assert (uiop:string-prefix-p "data:image/png;base64," (%get "favicon" record))))
  ;; the rule stops at a fork action
  (let ((forked (vector (make-hash-table) (make-hash-table) (make-hash-table))))
    (loop for action across forked for type in '("add" "fork" "edit") for date in '(1 2 3)
          do (setf (gethash "type" action) type (gethash "date" action) date))
    (assert (equal '(3) (%excludes forked))))
  t)

(defun check-pages-open-as-ordinary-local-pages ()
  (dolist (kind '(:sfw :ccnx-record))
    (let* ((page (cw:example-page kind))
           (html (%story-view-html page)))
      (assert (= 2 (length (hyperbook/fedwiki::story-of page))))
      (assert (equal '("a1b2c3d4e5f60001" "a1b2c3d4e5f60002") (map 'list #'hyperbook/fedwiki::id-of (hyperbook/fedwiki::story-of page))))
      (assert (search "Plain text outlives the program that wrote it." html))
      (assert (search "the story is what the journal says it is." html))
      (assert (not (search "class='internal'" html)))))
  t)

(defun run-tests ()
  (check-loads)
  (check-links)
  (check-no-key-material)
  (check-claims-kept-apart)
  (check-example-pages)
  (check-pages-open-as-ordinary-local-pages)
  (format t "~&CCNX-FEDERATED-WIKI-PASS: the reading and its four pages load; links resolve and expressions open only the example pages; every reference to the two repositories is pinned to the reviewed commit; no key material is quoted; the example pages are consistent with the cited rules (version, excludes, added fields) and open as ordinary local pages with the existing Story view; it is not a member of dreyeck/catalog.~%")
  t)
