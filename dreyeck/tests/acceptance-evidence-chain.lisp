;;;; Fixed-source inspection plus explicitly temporary Git fixtures. Never run the reported command.
(defpackage #:dreyeck/work/acceptance-evidence-chain/tests
  (:use #:cl)
  (:local-nicknames (#:c #:dreyeck/work/acceptance-evidence-chain) (#:g #:dreyeck/git)
                    (#:ev #:dreyeck/evaluation-record) (#:v #:html-inspector-views))
  (:export #:run-tests))
(in-package #:dreyeck/work/acceptance-evidence-chain/tests)
(defvar *checks* 0)
(defmacro check (form) `(progn (incf *checks*) (assert ,form () "Evidence-chain check failed: ~S" ',form)))
(defun field (chain predicate)
  (find predicate (c:chain-statements chain) :key (lambda (s) (getf s :predicate))))
(defun refuses (reason thunk)
  (check (handler-case (progn (funcall thunk) nil)
           (c:evidence-chain-refused (condition) (eq reason (c:refusal-reason condition))))))
(defun inspect-view (object title)
  (let ((view (find title (v:all-views object) :key #'v:view-title :test #'equal)))
    (check view) (v:view-html view) view))
(defun actual-source-tests (repository)
  (let* ((before (g:git-run-string (g:git-repository-root-of repository) "status" "--porcelain"))
         (chain (c:inspect-acceptance-evidence-chain repository))
         (report-file (c:chain-report-file chain)) (log-file (c:chain-log-file chain))
         (source (c:chain-source-revision chain)) (tested (c:chain-tested-revision chain))
         (descriptor (c:chain-descriptor-file chain)))
    (check (equal c:+evidence-revision+ (g:git-commit-hash-of source)))
    (check (equal c:+tested-revision+ (g:git-commit-hash-of tested)))
    (check (not (eq source tested)))
    (dolist (file (list report-file log-file descriptor))
      (check (typep file 'g:git-evidence-file))
      (check (eq source (g:git-file-commit-of file)))
      (check (eq file (g:ensure-git-evidence-file source (g:git-file-path-of file)))))
    (check (equal "2f9276424cd418cfe55db57a22cbfb542115659d1b98f390a3d0aacd1fa24adf" (c:chain-log-sha256 chain)))
    (check (= 121067 (c:chain-log-octets chain)))
    (check (> (c:chain-log-octets chain) (length (c:chain-log-text chain))))
    (check (equalp (c:chain-report chain) (shasht:read-json (c:chain-report-text chain) t nil t)))
    (check (eq :reported (getf (field chain :reported-exit-code) :warrant)))
    (check (eql 0 (getf (field chain :reported-exit-code) :value)))
    (check (eq :artifact-verified (getf (field chain :log-sha256-matches-report) :warrant)))
    (check (eq t (getf (field chain :log-sha256-matches-report) :value)))
    (check (eq :specified-context (getf (field chain :tested-revision-context) :warrant)))
    (check (eq :not-established (getf (getf (field chain :tested-revision-context) :basis) :historical-execution-binding)))
    (check (eq tested (getf (field chain :tested-revision-context) :value)))
    (check (eq :inspected (ev:evaluation-status-of chain)))
    (check (eq (c:chain-report chain) (ev:evaluation-result-of chain)))
    (check (eq (c:chain-statements chain) (ev:evaluation-evidence-of chain)))
    (check (eq :none (getf (ev:evaluation-annotation-of chain) :acceptance-decision)))
    (check (eq :not-assessed (getf (ev:evaluation-annotation-of chain) :independent-author-review)))
    (check (eq :none (getf (ev:evaluation-annotation-of chain) :deployment-authority)))
    (check (equal (ev:evaluation-identity-of chain)
                  (ev:evaluation-identity-of (c:inspect-acceptance-evidence-chain repository))))
    (dolist (s (c:chain-statements chain))
      (check (getf s :warrant)) (check (getf s :sources)) (check (getf s :basis)))
    (loop repeat 2 do
      (let* ((view (inspect-view chain "Evidence chain")) (html (v:view-html view))
             (references (mapcar #'cdr (v:view-references view))))
        (check (not (search "<button" html)))
        (check (search "JSON has no tested-revision field" html))
        (dolist (object (list report-file log-file descriptor source tested (c:chain-report chain)))
          (check (member object references :test #'eq)))))
    (check (search "exitCode" (v:view-html (inspect-view chain "Retained report text"))))
    (check (search "INSTANCE-OF-EXPORT-PASS" (v:view-html (inspect-view chain "Retained log text"))))
    (check (equal before (g:git-run-string (g:git-repository-root-of repository) "status" "--porcelain")))
    (format t "~&FIXED-ARTIFACT-READING: ~D original log octets, SHA256 ~A; inspection only; no recorded command replay.~%"
            (c:chain-log-octets chain) (c:chain-log-sha256 chain))))

(defun write-text (path text)
  (with-open-file (out path :direction :output :if-exists :supersede :external-format :utf-8) (write-string text out)))
(defun fixture-tests ()
  (let ((root (merge-pathnames (format nil "evidence-chain-fixture-~A/" (gensym)) (uiop:temporary-directory))))
    (ensure-directories-exist root)
    (unwind-protect
         (let* ((repo (make-instance 'g:git-repository-checkout :root root :root-source :explicit-temporary-fixture))
                (log-text (format nil "Retained ~C observation~%" (code-char #x3bb)))
                (log-path (merge-pathnames "run.log" root)) (report-path (merge-pathnames "run.json" root))
                (descriptor-path (merge-pathnames "candidate.nix" root)))
           (flet ((git (&rest args) (apply #'g:git-run-string root args)))
             (git "init" "--quiet") (git "config" "user.name" "Evidence Chain Fixture")
             (git "config" "user.email" "fixture@example.invalid")
             (write-text (merge-pathnames "subject.txt" root) "Synthetic tested source.")
             (git "add" "subject.txt") (git "commit" "--quiet" "-m" "Fixture tested source")
             (let* ((tested (g:trim-git-output (git "rev-parse" "HEAD")))
                    (data (make-hash-table :test #'equal)) (env (make-hash-table :test #'equal)))
               ;; Deliberately inert command/env data; the public artifact reader never invokes it.
               (setf (gethash "command" data) #("NEVER-EXECUTE-THIS-COMMAND" "(error \"not code\")")
                     (gethash "cwd" data) "/not/a/runtime/path" (gethash "environmentOverrides" data) env
                     (gethash "startedAtUTC" data) "2026-11-12T00:00:00Z"
                     (gethash "finishedAtUTC" data) "2026-11-12T00:00:01Z"
                     (gethash "exitCode" data) 17 (gethash "log" data) "run.log"
                     (gethash "logSHA256" data) (c::sha256 (sb-ext:string-to-octets log-text :external-format :utf-8)))
               (write-text log-path log-text)
               (write-text descriptor-path (format nil "source = \"git+file:///fixture?rev=~A\";" tested))
               (write-text report-path (shasht:write-json data nil))
               (git "add" ".") (git "commit" "--quiet" "-m" "Fixture report and retained log")
               (let ((evidence (g:trim-git-output (git "rev-parse" "HEAD"))))
                 (labels ((read-at (&optional (oid evidence))
                            (c::%inspect-chain repo oid tested "run.json" "run.log" "candidate.nix" "https://example.invalid/fixture"))
                          (commit-change () (git "add" ".") (git "commit" "--quiet" "-m" "Fixture changed artifacts")
                            (g:trim-git-output (git "rev-parse" "HEAD"))))
                   (let ((chain (read-at)))
                     (check (eql 17 (getf (field chain :reported-exit-code) :value)))
                     (check (eq :inspected (ev:evaluation-status-of chain))))
                   ;; Dirty worktree and then moving HEAD do not replace the pinned reading.
                   (write-text log-path "Working-tree poison, not retained evidence.")
                   (write-text report-path "not JSON in the working tree")
                   (check (equal log-text (c:chain-log-text (read-at))))
                   (let ((changed (commit-change)))
                     (check (equal log-text (c:chain-log-text (read-at))))
                     (refuses :invalid-json (lambda () (read-at changed))))
                   (write-text report-path (shasht:write-json data nil))
                   (refuses :retained-log-sha256-mismatch (lambda () (read-at (commit-change))))
                   (write-text log-path log-text)
                   (setf (gethash "log" data) "../../unrelated-file")
                   (write-text report-path (shasht:write-json data nil))
                   (refuses :invalid-execution-report (lambda () (read-at (commit-change))))
                   (setf (gethash "log" data) "run.log" (gethash "exitCode" data) "0")
                   (write-text report-path (shasht:write-json data nil))
                   (refuses :invalid-execution-report (lambda () (read-at (commit-change))))
                   (setf (gethash "exitCode" data) 17)
                   (write-text report-path (shasht:write-json data nil))
                   (write-text descriptor-path "No revision reference is supplied here.")
                   (refuses :descriptor-revision-reference-absent (lambda () (read-at (commit-change))))
                   (refuses :git-object-read-failed
                            (lambda () (c::%inspect-chain repo evidence tested "missing.json" "run.log" "candidate.nix"
                                                         "https://example.invalid/fixture")))
                   (refuses :git-object-read-failed
                            (lambda () (c::%inspect-chain repo evidence (make-string 40 :initial-element #\0)
                                                         "run.json" "run.log" "candidate.nix" "https://example.invalid/fixture"))))))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))

(defun run-tests ()
  (let* ((*checks* 0)
         (root (or (uiop:getenv "EVIDENCE_CHAIN_REPOSITORY")
                   (error "Set EVIDENCE_CHAIN_REPOSITORY to a local HyperDoc repository containing the fixed objects.")))
         (repo (make-instance 'g:git-repository-checkout :root (truename (uiop:ensure-directory-pathname root))
                                                        :root-source :explicit-fixed-source-test))
         (packages (mapcar #'find-package '("SHOP3" "TOPIC-MAPS.TMDM"))))
    (actual-source-tests repo) (fixture-tests)
    (check (equal packages (mapcar #'find-package '("SHOP3" "TOPIC-MAPS.TMDM"))))
    (format t "~&EVIDENCE-CHAIN-CHECKS-COMPLETED: ~D checks; fixed Git evidence and explicit temporary fixtures; no acceptance decision.~%" *checks*)
    *checks*))
