(defpackage #:dreyeck/work/link-resolution/evidence/tests
  (:use #:cl)
  (:local-nicknames (#:e #:dreyeck/work/link-resolution/evidence) (#:m #:dreyeck/work/link-resolution)
                    (#:er #:dreyeck/evaluation-record) (#:v #:html-inspector-views))
  (:export #:run-tests))
(in-package #:dreyeck/work/link-resolution/evidence/tests)
(defun assert-ref (source target title)
  (let ((view (find title (v:all-views source) :key #'v:view-title :test #'equal)))
    (assert view) (v:view-html view)
    (assert (find target (v:view-references view) :key #'cdr :test #'eq))))
(defun run-tests ()
  (let ((engine-before (find-package :lisp-critic))
        (records (e:study)))
    (assert (eq records (e:study)))
    (assert (= (* 2 (length (m:fixture-cases))) (length records)))
    (dolist (record records)
      (assert (eq :completed (er:evaluation-status-of record)))
      (assert (getf (er:evaluation-result-of record) :matches-expected))
      (assert (null (er:evaluation-failure-of record)))
      (assert (eq :not-executed (getf (er:evaluation-annotation-of record) :wiki-execution)))
      (assert (null (getf (er:evaluation-evidence-of record) :new-engine-critiques)))
      (assert-ref record (getf (e:context-of record) :result) "Resolution evaluation")
      (assert-ref record (e::reference-of record) "Resolution evaluation")
      (assert-ref record (e::methods-of record) "Resolution evaluation"))
    (let ((page (hyperbook:find-page e:*link-resolution-book* "Learning Federated Wiki Link Resolution" :signal-error? t)))
      (assert-ref page records "Content"))
    ;; Compare the actual HyperDoc helper with recorded Java Page.context.
    ;; No proxy resolution: only journal strings are read, never get-fedwiki.
    (loop for observed across (gethash "cases" (e::reference-evidence))
          for fixture = (m:fixture-by-id (gethash "id" observed))
          for entries = (map 'vector
                             (lambda (site)
                               (let ((entry (make-hash-table :test #'equal)))
                                 (setf (gethash "type" entry) "edit" (gethash "site" entry) site) entry))
                             (gethash "journal" fixture))
          for actual = (hyperbook/fedwiki::context-site-references
                        (hyperbook/fedwiki::make-journal entries))
          do (assert (equal actual (coerce (gethash "pageContext" observed) 'list))))
    (format t "~&HYPERDOC-JAVA-CONTEXT-PASS: actual journal helper agrees on 12 direct-site fixtures.~%")
    (let ((failed (e:evaluate-fixture "nonexistent")))
      (assert (eq :failed (er:evaluation-status-of failed)))
      (assert (er:evaluation-failure-of failed))
      (assert (null (getf (er:evaluation-evidence-of failed) :java-case-observation))))
    (assert (eq engine-before (find-package :lisp-critic)))
    (format t "~&LINK-RESOLUTION-INSPECTOR-PASS: ~D completed model evaluations, original plan/method/source references; HyperBook; no live Critic.~%"
            (length records))) t)
