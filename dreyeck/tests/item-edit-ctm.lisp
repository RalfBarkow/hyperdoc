(defpackage #:dreyeck/item-edit-ctm/tests
  (:use #:cl)
  (:local-nicknames (#:c #:dreyeck/item-edit-ctm)
                    (#:p #:dreyeck/fedwiki-item-edit-preview)
                    (#:x #:dreyeck/fedwiki-item-edit-execution)
                    (#:lp #:dreyeck/local-fedwiki-page)
                    (#:tr #:dreyeck/topic-maps-reading)
                    (#:tmdm #:topic-maps.tmdm)
                    (#:v #:html-inspector-views))
  (:export #:run-tests))
(in-package #:dreyeck/item-edit-ctm/tests)

;; A completion is made on a temporary copy of the retained page, by the existing operations. Its CTM is read back by the
;; topic-maps reader of the checkout that is loaded, and what the reader made is compared with the Lisp objects. Every
;; negative check has its positive control: the same fixture without the disturbance.

(defvar *checks* 0)
(defmacro check (form) `(progn (incf *checks*) (assert ,form)))

(defparameter +slug+ "ctm-and-tmdm-in-hyperdoc")
(defparameter +e3+ "ed37e9bac2fcd548")
(defparameter +now+ 1792267528767)

(defun file-sha (path) (ironclad:byte-array-to-hex-string (ironclad:digest-file :sha256 path)))

(defun call-with-fixture (function)
  "FUNCTION is called with the page file of a temporary copy, and a proposal, preview and completion made from it."
  (let* ((root (uiop:ensure-directory-pathname (merge-pathnames (format nil "item-edit-ctm-~D/" (random 1000000000)) (uiop:temporary-directory))))
         (page (merge-pathnames (format nil "pages/~A" +slug+) root)))
    (ensure-directories-exist page)
    (uiop:copy-file (asdf:system-relative-pathname "dreyeck/work/reading" "dreyeck/work/ctm-page-evidence/site/pages/ctm-and-tmdm-in-hyperdoc") page)
    (unwind-protect
         (let* ((source (lp:observe-local-fedwiki-page-source root +slug+))
                (item (lp:find-story-item source +e3+))
                (proposal (p:propose-item-edit item "E3 - a text for the CTM test, not a decision."))
                (preview (p:preview-item-edit proposal))
                (completion (x:complete-item-edit preview :now +now+)))
           (funcall function page proposal preview completion))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))

(defun label (topic) (tr:topic-label topic))
(defun type-label (association) (label (tmdm:association-type association)))
(defun scope-labels (association) (sort (mapcar #'label (tmdm:association-scope association)) #'string<))
(defun role-pairs (association)
  (sort (mapcar (lambda (role) (list (label (tmdm:association-role-type role)) (label (tmdm:association-role-player role))))
                (tmdm:association-roles association))
        #'string< :key #'first))
(defun the-association (projection type roles)
  "The one Association of TYPE with exactly ROLES ((role-type player-id)...), in the Topic Map the reader made."
  (let ((found (remove-if-not (lambda (association) (and (equal type (type-label association))
                                                         (equal (sort (copy-list roles) #'string< :key #'first) (role-pairs association))))
                              (tmdm:topic-map-associations (c:ctm-map projection)))))
    (and (= 1 (length found)) (first found))))
(defun occurrences (projection id)
  (mapcar (lambda (o) (list (label (tmdm:occurrence-type o)) (tmdm:occurrence-value o) (tmdm:occurrence-datatype o)))
          (tmdm:topic-occurrences (c:ctm-topic-of projection id))))
(defun occurrence (projection id type) (second (find type (occurrences projection id) :key #'first :test #'equal)))
(defun snapshot (value) (shasht:write-json value nil))

(defun check-completion-projection (page proposal preview completion)
  (let* ((before-page (file-sha page)) (before-proposed (snapshot (p:preview-action preview)))
         (before-completed (snapshot (x:completion-action completion))) (before-expected (snapshot (p:preview-expected-item preview)))
         (before-body (copy-seq (x:completion-body completion))) (before-text (p:proposal-text proposal))
         (projection (c:project-item-edit completion)))
    ;; The CTM is read by the reader; what it made is a Topic Map of the objects.
    (check (typep (c:ctm-map projection) 'tmdm:topic-map))
    (check (eq :completion (c:ctm-stage projection)))
    (check (eq completion (c:ctm-origin projection)))
    (dolist (id '("the-proposal" "the-preview" "the-proposed-action" "the-completion" "the-completed-action" "the-expected-item" "the-signed-body"))
      (check (c:ctm-topic-of projection id)))
    ;; The Topics are distinguished by their types, and the two Actions are two Topics bound to two Lisp objects.
    (check (equal "item-edit-proposal" (label (find-type projection "the-proposal"))))
    (check (equal "item-edit-preview" (label (find-type projection "the-preview"))))
    (check (equal "item-edit-completion" (label (find-type projection "the-completion"))))
    (check (equal "story-item" (label (find-type projection "the-expected-item"))))
    (check (equal "signed-body" (label (find-type projection "the-signed-body"))))
    (check (equal "edit-action" (label (find-type projection "the-proposed-action"))))
    (check (equal "edit-action" (label (find-type projection "the-completed-action"))))
    (check (not (eq (c:ctm-topic-of projection "the-proposed-action") (c:ctm-topic-of projection "the-completed-action"))))
    (check (eq (p:preview-action preview) (c:ctm-binding projection "the-proposed-action")))
    (check (eq (x:completion-action completion) (c:ctm-binding projection "the-completed-action")))
    (check (not (eq (c:ctm-binding projection "the-proposed-action") (c:ctm-binding projection "the-completed-action"))))
    (check (eq proposal (c:ctm-binding projection "the-proposal")))
    (check (eq preview (c:ctm-binding projection "the-preview")))
    (check (eq completion (c:ctm-binding projection "the-completion")))
    (check (eq (p:preview-expected-item preview) (c:ctm-binding projection "the-expected-item")))
    (check (eq (x:completion-body completion) (c:ctm-binding projection "the-signed-body")))
    ;; Associations, Role types and Scopes: exactly these, each once.
    (loop for (type roles scope) in
          '(("proposes" (("proposal" "the-proposal") ("action" "the-proposed-action")) ("derived"))
            ("previews" (("preview" "the-preview") ("action" "the-proposed-action")) ("observed"))
            ("completes" (("completion" "the-completion") ("preview" "the-preview")) ("observed"))
            ("yields" (("completion" "the-completion") ("action" "the-completed-action")) ("observed"))
            ("has-body" (("completion" "the-completion") ("body" "the-signed-body")) ("observed"))
            ("completed-from" (("completed" "the-completed-action") ("original" "the-proposed-action")) ("derived"))
            ("contains" (("body" "the-signed-body") ("content" "the-expected-item")) ("derived"))
            ("contains" (("body" "the-signed-body") ("content" "the-completed-action")) ("derived")))
          do (let ((association (the-association projection type roles)))
               (check association)
               (check (equal scope (scope-labels association)))))
    (check (= 8 (count-if #'tmdm:association-scope (tmdm:topic-map-associations (c:ctm-map projection)))))
    ;; No relation is stated that no object shows: every scoped Association is observed or derived, none hypothetical.
    (check (every (lambda (a) (subsetp (scope-labels a) '("observed" "derived") :test #'equal))
                  (remove-if-not #'tmdm:association-scope (tmdm:topic-map-associations (c:ctm-map projection)))))
    ;; The date: only on the completed Action, from the completion, in milliseconds; the proposed Action has none.
    (check (eql +now+ (parse-integer (occurrence projection "the-completed-action" "date"))))
    (check (eql (x:completion-date completion) (parse-integer (occurrence projection "the-completed-action" "date"))))
    (check (equal "http://www.w3.org/2001/XMLSchema#integer" (third (find "date" (occurrences projection "the-completed-action") :key #'first :test #'equal))))
    (check (null (find "date" (occurrences projection "the-proposed-action") :key #'first :test #'equal)))
    (check (null (find "date" (occurrences projection "the-expected-item") :key #'first :test #'equal)))
    (check (= 1 (count-subseq (princ-to-string +now+) (c:ctm-text projection))))
    (check (not (nth-value 1 (gethash "date" (p:preview-action preview)))))
    ;; The two Actions are equal but for the date.
    (check (x:json-equal (let ((copy (make-hash-table :test #'equal)))
                           (maphash (lambda (key value) (unless (equal key "date") (setf (gethash key copy) value))) (x:completion-action completion)) copy)
                         (p:preview-action preview)))
    ;; The signed body: its digest is the completion's, and its content is what the Lisp objects hold.
    (check (equal (x:completion-body-keccak-256 completion) (occurrence projection "the-signed-body" "body-digest")))
    (check (eql (length (x:completion-body completion)) (parse-integer (occurrence projection "the-signed-body" "body-octets"))))
    (let ((body (shasht:read-json (sb-ext:octets-to-string (x:completion-body completion) :external-format :utf-8))))
      (check (x:json-equal (gethash "expected" body) (p:preview-expected-item preview)))
      (check (x:json-equal (gethash "action" body) (x:completion-action completion))))
    ;; Item, page and revision are the objects'.
    (check (equal +e3+ (occurrence projection "the-expected-item" "item-id")))
    (check (equal +slug+ (occurrence projection "the-expected-item" "page-slug")))
    (check (equal (lp:page-source-sha256 (p:preview-source preview)) (occurrence projection "the-expected-item" "source-sha256")))
    (check (equal "paragraph" (occurrence projection "the-expected-item" "item-type")))
    (check (equal "edit" (occurrence projection "the-proposed-action" "action-type")))
    (check (equal "edit" (occurrence projection "the-completed-action" "action-type")))
    ;; Nothing is claimed about authorization, execution or persistence.
    (check (equal "no" (occurrence projection "the-completion" "request-attached")))
    (check (search "not an authorization" (occurrence projection "the-completion" "scope-of-statement")))
    (check (search "no execution and no persistence" (occurrence projection "the-completion" "scope-of-statement")))
    (check (notany (lambda (word) (search word (string-downcase (c:ctm-text projection))))
                   '("authorized: " "executed: " "persisted: " "is authorized" "was executed" "was persisted")))
    (check (notany (lambda (association) (some (lambda (word) (search word (type-label association))) '("authoriz" "execut" "persist")))
                   (tmdm:topic-map-associations (c:ctm-map projection))))
    (check (notany (lambda (topic) (some (lambda (word) (search word (label topic))) '("authoriz" "execut" "persist")))
                   (tmdm:topic-map-topics (c:ctm-map projection))))
    ;; The Item's text is not in the CTM, so nothing needs escaping.
    (check (not (search "a text for the CTM test" (c:ctm-text projection))))
    ;; A projection writes nothing and changes none of the objects.
    (check (equal before-page (file-sha page)))
    (check (equal before-proposed (snapshot (p:preview-action preview))))
    (check (equal before-completed (snapshot (x:completion-action completion))))
    (check (equal before-expected (snapshot (p:preview-expected-item preview))))
    (check (equalp before-body (x:completion-body completion)))
    (check (equal before-text (p:proposal-text proposal)))
    (check (= 2 (length (gethash "journal" (lp:page-source-json (lp:observe-local-fedwiki-page-source (lp:page-source-site-root (p:preview-source preview)) +slug+))))))
    ;; Each projection is made anew: two are two objects; the original is the same one.
    (let ((again (c:project-item-edit completion)))
      (check (not (eq projection again)))
      (check (not (eq (c:ctm-map projection) (c:ctm-map again))))
      (check (equal (c:ctm-text projection) (c:ctm-text again)))
      (check (eq completion (c:ctm-binding again "the-completion"))))
    ;; The native Topicmap projection of the Topic Map, as the reading of an example draws it; it leads back to this projection.
    (let ((native (c::native-projection projection)))
      (dolist (id '("the-proposal" "the-preview" "the-proposed-action" "the-completion" "the-completed-action" "the-expected-item" "the-signed-body"))
        (check (find id (dreyeck/topicmap:topicmap-projection-topics-of native) :key #'dreyeck/topicmap:topicmap-topic-id-of :test #'equal)))
      (check (= (length (tmdm:topic-map-associations (c:ctm-map projection)))
                (count-if (lambda (topic) (equal "TMDM association" (getf (dreyeck/topicmap:topicmap-topic-view-properties-of topic) :kind)))
                          (dreyeck/topicmap:topicmap-projection-topics-of native))))
      (check (every (lambda (topic) (eq projection (tr:projection-origin topic))) (dreyeck/topicmap:topicmap-projection-topics-of native)))
      (check (eq (dreyeck/topicmap:topicmap-topic-object-of
                  (find "the-completed-action" (dreyeck/topicmap:topicmap-projection-topics-of native) :key #'dreyeck/topicmap:topicmap-topic-id-of :test #'equal))
                 (c:ctm-topic-of projection "the-completed-action")))
      (check (eq native (c::native-projection projection)))
      (check (typep (c::native-workspace projection) 'dreyeck/topicmap:topicmap-workspace)))
    projection))

(defun core-role-p (role-type word)
  "Whether ROLE-TYPE is the TMDM core type-instance Role type WORD, by its subject identifier."
  (some (lambda (identifier) (let ((end (position #\/ identifier :from-end t))) (and end (equal word (subseq identifier (1+ end))))))
        (tmdm:topic-subject-identifiers role-type)))

(defun find-type (projection id)
  "The type Topic of the Topic ID: the player of the type Role of the type-instance Association in which ID is the instance."
  (let ((topic (c:ctm-topic-of projection id)))
    (loop for role in (tmdm:topic-roles-played topic)
          for association = (tmdm:association-role-parent role)
          when (core-role-p (tmdm:association-role-type role) "instance")
            do (return (tmdm:association-role-player
                        (find-if (lambda (other) (core-role-p (tmdm:association-role-type other) "type")) (tmdm:association-roles association)))))))

(defun count-subseq (needle haystack)
  (loop with start = 0 for at = (search needle haystack :start2 start) while at count t do (setf start (1+ at))))

(defun check-stages (page proposal preview)
  ;; The same projection for a preview and for a proposal; the differences stay visible.
  (let ((from-preview (c:project-item-edit preview)) (from-proposal (c:project-item-edit proposal)) (before (file-sha page)))
    (check (eq :preview (c:ctm-stage from-preview)))
    (check (c:ctm-topic-of from-preview "the-preview"))
    (check (null (c:ctm-topic-of from-preview "the-completion")))
    (check (null (c:ctm-topic-of from-preview "the-completed-action")))
    (check (eq (p:preview-action preview) (c:ctm-binding from-preview "the-proposed-action")))
    (check (equal '("observed") (scope-labels (the-association from-preview "previews" '(("preview" "the-preview") ("action" "the-proposed-action"))))))
    (check (eq :proposal (c:ctm-stage from-proposal)))
    (check (null (c:ctm-topic-of from-proposal "the-preview")))
    (check (null (c:ctm-topic-of from-proposal "the-completion")))
    ;; Before a preview the Action is the one the proposal makes now, which is another object and is said to be derived.
    (check (not (eq (p:preview-action preview) (c:ctm-binding from-proposal "the-proposed-action"))))
    (check (x:json-equal (p:preview-action preview) (c:ctm-binding from-proposal "the-proposed-action")))
    (check (equal '("derived") (scope-labels (the-association from-proposal "proposes" '(("proposal" "the-proposal") ("action" "the-proposed-action"))))))
    (check (null (find "date" (occurrences from-proposal "the-proposed-action") :key #'first :test #'equal)))
    (check (null (find "date" (occurrences from-preview "the-proposed-action") :key #'first :test #'equal)))
    (check (equal before (file-sha page)))))

(defun check-refusals (page proposal preview completion)
  (declare (ignore proposal page))
  ;; Positive control: the untouched objects project. A completion whose objects disagree is refused, not projected.
  (check (typep (c:project-item-edit completion) 'c:item-edit-ctm))
  (let* ((completed (x:completion-action completion)) (date (gethash "date" completed)))
    (setf (gethash "date" completed) (1+ date))
    (check (handler-case (progn (c:project-item-edit completion) nil) (c:item-edit-ctm-refused (condition) (search "date" (princ-to-string condition)))))
    (setf (gethash "date" completed) date)
    (check (typep (c:project-item-edit completion) 'c:item-edit-ctm))
    (setf (gethash "type" completed) "add")
    (check (handler-case (progn (c:project-item-edit completion) nil) (c:item-edit-ctm-refused () t)))
    (setf (gethash "type" completed) "edit")
    (check (typep (c:project-item-edit completion) 'c:item-edit-ctm)))
  (check (typep preview 'p:item-edit-preview)))

(defun html-of (object title) (v:view-html (find title (v:all-views object) :key #'v:view-title :test #'equal)))
(defun references-of (object title) (mapcar #'cdr (v:view-references (find title (v:all-views object) :key #'v:view-title :test #'equal))))

(defun check-views (proposal preview completion)
  (dolist (object (list proposal preview completion))
    (let ((html (html-of object "CTM")) (refs (references-of object "CTM")))
      (check (search "CTM text" html))
      (check (search "isa" html))
      (check (find-if (lambda (r) (typep r 'c:item-edit-ctm)) refs))
      (check (find-if (lambda (r) (typep r 'tmdm:topic-map)) refs))
      (check (find-if (lambda (r) (typep r 'dreyeck/topicmap:topicmap-workspace)) refs))
      (check (member object refs :test #'eq))
      (check (search "not stored" html))))
  (check (search "is not an authorization" (html-of completion "CTM")))
  (check (search "intended change" (html-of proposal "CTM")))
  (check (search "writes nothing" (html-of preview "CTM")))
  ;; The projection's own views lead to the Lisp objects, and to the Topic Map's.
  (let* ((projection (find-if (lambda (r) (typep r 'c:item-edit-ctm)) (references-of completion "CTM")))
         (html (html-of projection "TMDM objects")) (refs (references-of projection "TMDM objects")))
    (check (search "Topics for the objects of the Item edit" html))
    (check (member completion refs :test #'eq))
    (check (member (x:completion-action completion) refs :test #'eq))
    (check (member (p:preview-action preview) refs :test #'eq))
    (check (member (x:completion-body completion) refs :test #'eq))
    (check (member (c:ctm-map projection) refs :test #'eq))
    (check (some (lambda (r) (typep r 'tmdm:association)) refs))
    (check (some (lambda (r) (typep r 'tmdm:association-role)) refs))
    (check (some (lambda (r) (typep r 'tmdm:topic)) refs))
    (check (find "Projections" (v:all-views projection) :key #'v:view-title :test #'equal))
    (check (search "Back to the TMDM objects" (html-of projection "Projections")))))

(defun run-tests ()
  (let ((*checks* 0))
    (call-with-fixture
     (lambda (page proposal preview completion)
       (check-completion-projection page proposal preview completion)
       (check-stages page proposal preview)
       (check-refusals page proposal preview completion)
       (check-views proposal preview completion)))
    (format t "~&ITEM-EDIT-CTM-PASS: ~D checks; the CTM of a real completion is read by the topic-maps reader; its seven Topics, eight Associations with Role types and observed/derived Scopes, the date only on the completed Action, the signed body and the Item as the objects hold them; nothing about authorization, execution or persistence; proposal, preview and completion kept apart; the objects, their page file and the journal unchanged; CTM, TMDM objects and Projections views with links to the Lisp objects.~%" *checks*)
    t))
