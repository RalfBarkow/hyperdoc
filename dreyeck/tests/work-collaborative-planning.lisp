(defpackage #:dreyeck/work/collaborative-planning/tests
  (:use #:cl)
  (:local-nicknames (#:p #:dreyeck/work/collaborative-planning) (#:work #:dreyeck/work/reading)
                    (#:h #:dreyeck/work/hubs) (#:tm #:dreyeck/topicmap)
                    (#:v #:html-inspector-views) (#:r #:dreyeck/work/trails-rendered-reading/tests))
  (:export #:run-tests #:source-identities))
(in-package #:dreyeck/work/collaborative-planning/tests)

(defun view (object title)
  (let ((view (r::following-view object title)))
    (assert (notany (lambda (entry) (typep (cdr entry) 'condition)) (v:view-references view)))
    view))
(defun refs (object title) (mapcar #'cdr (v:view-references (view object title))))
(defun source-identities ()
  "Serializable observation for independent fresh-process comparison, not EQ."
  (cons (p::source-identity (p::planning-case))
        (mapcar #'p::source-identity (p::case-subjects (p::planning-case)))))
(defun fresh-record ()
  (shasht:read-json (uiop:read-file-string (p::case-pathname (p::planning-case)) :external-format :utf-8)))
(defun rejected-record (change)
  (let ((record (fresh-record)))
    (funcall change record)
    (assert (handler-case (progn (p::build-planning-case record (p::evidence-directory)) nil) (error () t)))))

(defun run-tests ()
  (let* ((case (p::planning-case)) (subjects (p::case-subjects case))
         (before (mapcar (lambda (entry) (p::file-digest (merge-pathnames (car entry) (p::evidence-directory))))
                        (mapcar (lambda (entry) (cons (first entry) (second entry))) p::+submitted-documents+)))
         (reconstructed (p::read-planning-case))
         (work (work:work-projection))
         (item (tm:topicmap-projection-topic-by-id work "collaborative-planning-case"))
         (page (work:work-page "Collaborative Planning with Codex and SHOP3")))
    (assert (= 21 (length subjects)))
    (assert (eq case (p::planning-case)))
    (assert (not (eq case reconstructed)))
    (assert (equal (p::source-identity case) (p::source-identity reconstructed)))
    (assert (equal (mapcar #'p::source-identity subjects) (mapcar #'p::source-identity (p::case-subjects reconstructed))))
    (assert (eq page (tm:topicmap-topic-object-of item)))
    (assert (equal "work item" (getf (tm:topicmap-topic-view-properties-of item) :kind)))
    (assert (equal "open" (getf (tm:topicmap-topic-view-properties-of item) :status)))
    (assert (eq (work:work-page "Work Breakdown") (work:topic-occurrence-page (work:topic-source-occurrence item))))
    (dolist (id '("work:planning:contains:collaborative-planning-case" "work:dogfooding:current-work:collaborative-planning-case"))
      (assert (find id (tm:topicmap-projection-associations-of work) :key #'tm:topicmap-association-id-of :test #'equal)))
    (assert (member case (refs page "Content") :test #'eq))
    (assert (typep (work:work-page "Reading a Collaborative Planning Case") 'hyperdoc::code-page))
    (dolist (entry p::+submitted-documents+)
      (assert (equal (second entry) (p::file-digest (merge-pathnames (first entry) (p::evidence-directory))))))
    (dolist (subject subjects)
      (if (typep subject 'p::planning-document-version)
          (let* ((text-view (view subject "Original text"))
                 (pre (first (plump:get-elements-by-tag-name (plump:parse (v:view-html text-view)) "pre"))))
            (assert (equal (p::document-text subject) (plump:decode-entities (plump:text pre))))
            (assert (equal (gethash "sha256" (p::subject-record subject)) (p::file-digest (p::document-pathname subject))))
            (assert (find "Text" (v:all-views (p::document-pathname subject)) :key #'v:view-title :test #'equal))
            (assert (member (p::document-pathname subject) (refs subject "Document provenance") :test #'equal)))
          (let ((document (p::reading-document subject)))
            (assert (member document (refs subject "Planning evidence") :test #'eq))
            (assert (member page (refs subject "Planning evidence") :test #'eq)))))
    (assert (typep (p::case-subject "F1") 'p::planning-review-finding))
    (assert (search "not a SHOP3 assessment" (v:view-html (view (p::case-subject "F1") "Planning evidence"))))
    (assert (not (typep (p::case-subject "F1") 'p::planning-interpretation)))
    (dolist (id '("interpretation-v1" "interpretation-v2"))
      (assert (equal "proposed, not a human approval" (gethash "status" (p::subject-record (p::case-subject id))))))
    (assert (equal "not-yet-granted" (gethash "status" (p::subject-record (p::case-subject "approval-pending")))))
    (assert (equal "slice-1-only" (gethash "status" (p::subject-record (p::case-subject "slice-1-approved")))))
    ;; The erroneous statements remain in original Plan v2, with a separate
    ;; correction source. Neither import nor rendering turns them into facts.
    (assert (search "Die Nichtfreigabe wird als vom Nutzer übermittelte Entscheidung dokumentiert."
                    (p::document-text (p::case-subject "plan-v2"))))
    (assert (member (p::case-subject "user-clarification") (refs (p::case-subject "plan-v2") "Document provenance") :test #'eq))
    (assert (not (eq (p::case-subject "chatgpt-recommendation") (p::case-subject "approval-pending"))))
    (assert (search "not an inferred browser event log" (v:view-html (view case "Planning case"))))
    ;; Each rejection has the untouched source as its positive control.
    (assert (typep (p::build-planning-case (fresh-record) (p::evidence-directory)) 'p::recorded-planning-case))
    (rejected-record (lambda (r) (remhash "states" r)))
    (rejected-record (lambda (r) (setf (gethash "authority" (aref (gethash "documents" r) 0)) "another-authority")))
    (rejected-record (lambda (r) (setf (gethash "file" (aref (gethash "documents" r) 0)) "codex-plan-v2-submitted.txt")))
    (rejected-record (lambda (r) (setf (gethash "id" (aref (gethash "documents" r) 1)) "plan-v1")))
    (rejected-record (lambda (r) (setf (gethash "sha256" (aref (gethash "documents" r) 0)) (make-string 64 :initial-element #\0))))
    (rejected-record (lambda (r) (setf (gethash "start" (aref (gethash "interpretations" r) 0)) -1)))
    (rejected-record (lambda (r) (setf (gethash "end" (aref (gethash "interpretations" r) 0)) 1000000)))
    (rejected-record (lambda (r) (setf (gethash "quote" (aref (gethash "findings" r) 0)) "not original source")))
    (rejected-record (lambda (r) (setf (gethash "status" (aref (gethash "interpretations" r) 0)) "approved")))
    (rejected-record (lambda (r) (setf (gethash "status" (aref (gethash "states" r) 0)) "user-rejected")))
    (rejected-record (lambda (r) (setf (gethash "status" (aref (gethash "states" r) 1)) "all-slices-authorized")))
    (rejected-record (lambda (r) (setf (gethash "to" (aref (gethash "relations" r) 0)) "unresolved-target")))
    (rejected-record (lambda (r) (setf (gethash "warrant" (aref (gethash "relations" r) 0)) "authenticated-human")))
    ;; A modified file is rejected even when metadata is unchanged. All writes
    ;; are test fixtures outside the checkout, never the retained originals.
    (uiop:with-temporary-file (:pathname marker :stream stream)
      (close stream)
      (let ((directory (merge-pathnames (format nil "~A-evidence/" (pathname-name marker))
                                       (uiop:pathname-directory-pathname marker))))
        (unwind-protect
             (progn
               (ensure-directories-exist directory)
               (dolist (file (uiop:directory-files (p::evidence-directory)))
                 (uiop:copy-file file (merge-pathnames (file-namestring file) directory)))
               (assert (p::read-planning-case directory))
               (with-open-file (out (merge-pathnames "codex-plan-v1-submitted.txt" directory)
                                    :direction :output :if-exists :append :external-format :utf-8)
                 (write-string "changed" out))
               (assert (handler-case (progn (p::read-planning-case directory) nil) (error () t))))
          (uiop:delete-directory-tree directory :validate t :if-does-not-exist :ignore))))
    (assert (equal before (mapcar (lambda (entry) (p::file-digest (merge-pathnames (first entry) (p::evidence-directory))))
                                 p::+submitted-documents+))))
  (let* ((workspace (p::collaborative-planning-workspace))
         (projection (tm:topicmap-workspace-projection-of workspace))
         (point (tm:topicmap-workspace-point-of workspace))
         (history (copy-list (tm:topicmap-workspace-history-of workspace)))
         (base (h::hub-investigation-projection)))
    (assert (= 25 (length (tm:topicmap-projection-topics-of projection))))
    (assert (= 31 (length (tm:topicmap-projection-associations-of projection))))
    (assert (= 26 (length (tm:topicmap-projection-topics-of base))))
    (assert (= 28 (length (tm:topicmap-projection-associations-of base))))
    (assert (every #'tm:topicmap-topic-object-of (tm:topicmap-projection-topics-of projection)))
    (assert (eq h::*hub-investigation-plan* (tm:topicmap-topic-object-of (tm:topicmap-projection-topic-by-id projection "hub-investigation"))))
    (view workspace "Topicmap")
    (assert (equal point (tm:topicmap-workspace-point-of workspace)))
    (assert (equal history (tm:topicmap-workspace-history-of workspace)))
    (unwind-protect
         (progn
           (dolist (id '("plan-v1" "claude-review" "F1" "approval-pending" "plan-v2"))
             (let ((previous (tm:topicmap-workspace-point-of workspace)))
               (tm:topicmap-workspace-go-to workspace id)
               (assert (equal previous (first (tm:topicmap-workspace-history-of workspace))))
               (assert (member (p::case-subject id) (refs workspace "Topicmap") :test #'eq))))
           (let ((history-now (copy-list (tm:topicmap-workspace-history-of workspace))))
             (tm:topicmap-workspace-reproject workspace (p::collaborative-planning-projection))
             (assert (equal "plan-v2" (tm:topicmap-workspace-point-of workspace)))
             (assert (equal history-now (tm:topicmap-workspace-history-of workspace))))
           (dolist (edge (tm:topicmap-projection-associations-of projection))
             (unless (search "work:" (tm:topicmap-association-id-of edge) :end2 5)
               (assert (typep (getf (tm:topicmap-association-properties-of edge) :source) 'p::planning-subject))
               (view edge "Planning relation evidence")))
           (assert (notany (lambda (edge) (or (equal "references" (tm:topicmap-association-type-of edge))
                                            (equal "P3" (tm:topicmap-association-to-of edge))))
                           (tm:topicmap-projection-associations-of projection))))
      (setf (tm:topicmap-workspace-point-of workspace) point (tm:topicmap-workspace-history-of workspace) history)))
  (format t "~&COLLABORATIVE-PLANNING-PASS: unchanged submitted bytes; distinct documents/interpretations/F1-F11/procedural states; source keys and negative controls; Work 25/25, case 25/31; Point/History; no planner, authoring or P3 contract.~%"))
