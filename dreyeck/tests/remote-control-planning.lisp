(in-package #:dreyeck/work/remote-control-planning)

(defun run-tests ()
  "Run five real SHOP3 searches and verify enumeration, states and boundaries."
  (loop for case in '(:a :b :c :d :e)
        for expected in '(1 1 2 0 0)
        for result = (remote-control-plan case)
        for plans = (dreyeck/shop3:plans-of result)
        for trees = (dreyeck/shop3:plan-trees-of result)
        for states = (dreyeck/shop3:final-states-of result)
        do (assert (eq :plan-only (dreyeck/shop3:execution-mode-of result)))
           (assert (= expected (length plans)))
           (assert (= expected (length trees) (length states)
                      (length (dreyeck/shop3:raw-plans-of result))))
           (assert (= expected (length (remove-duplicates trees :test #'equal))))
           (assert (= expected (length (remove-duplicates plans :test #'equal))))
           (when (zerop expected)
             (assert (null (dreyeck/shop3:raw-plans-of result))))
           (loop for plan in plans for tree in trees for state in states
                 do
                    (assert tree)
                    ;; FIND-PLANS returns native legacy s-expression trees.
                    ;; PLAN-TREE->SEXP is for FIND-PLANS-STACK CLOS nodes.
                    (assert (equal '(enable-mobile-control zettelkasten macbook-a android)
                                   (caar tree)))
                    (assert (member (second (first tree))
                                    '(agent-session-method direct-api-method)))
                    (assert (= 3 (length plan)))
                    (assert (member (caar plan)
                                    '(!model-agent-route !model-direct-route)))
                    (assert (eq '!model-control-surface (car (second plan))))
                    (assert (eq '!verify-modeled-control (car (third plan))))
                    (let* ((route (fifth (third plan)))
                           (atoms (shop3:state-atoms state)))
                      (assert (member route '(agent direct)))
                      (assert (eq (second (first tree))
                                  (ecase route
                                    (agent 'agent-session-method)
                                    (direct 'direct-api-method))))
                      (assert (eq (caar plan)
                                  (ecase route
                                    (agent '!model-agent-route)
                                    (direct '!model-direct-route))))
                      (when (eq case :a) (assert (eq route 'agent)))
                      (when (eq case :b) (assert (eq route 'direct)))
                      (assert (member `(mobile-control-verified zettelkasten
                                        macbook-a android ,route) atoms :test #'equal))
                      (assert (member '(execution-authority zettelkasten macbook-a)
                                      atoms :test #'equal))
                      (assert (member '(model-authority zettelkasten macbook-a)
                                      atoms :test #'equal))
                      (assert (subsetp (case-initial-state case) atoms :test #'equal))))
           (format t "~&REMOTE-CONTROL ~A PASS: ~D plans, ~D trees, ~D states~%~S~%"
                   case (length plans) (length trees) (length states) plans))
  (let ((context (remote-control-experiment :c)))
    (assert (getf context :problem))
    (assert (getf context :methods))
    (assert (eq :planned (getf context :outcome)))
    (assert (typep (getf context :result) 'dreyeck/shop3:hyperdoc-htn-plan-result)))
  t)
