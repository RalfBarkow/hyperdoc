;;;; PR35 F1–F3: assertions about the corrected boundary, separate from the historic review.
(in-package #:dreyeck/work/fedwiki-local-only/tests)
(define-condition unexpected-input-test-error (error) ())
(defun run-input-tests ()
  (let* ((source (asdf:system-relative-pathname "dreyeck/work/fedwiki-local-only"
                   "dreyeck/tests/fixtures/fedwiki-local-only/"))
         (root (merge-pathnames (format nil "hyperdoc-inputs-~A/" (gensym)) (uiop:temporary-directory)))
         (count 0))
    (unwind-protect
         (progn
           (dolist (sub '("" "pages/" "snapshots/"))
             (ensure-directories-exist (merge-pathnames sub root))
             (dolist (file (uiop:directory-files (merge-pathnames sub source)))
               (uiop:copy-file file (merge-pathnames (file-namestring file) (merge-pathnames sub root)))))
           (let ((site (i:make-own-site root "fedwiki:local")))
             (labels ((put (path text)
                        (let ((file (merge-pathnames path root)))
                          (with-open-file (out file :direction :output :if-exists :supersede :external-format :utf-8)
                            (write-string text out)) file))
                      (reject (id thunk)
                        (let ((c (assert-condition 'i:invalid-observation thunk)))
                          (assert (i::detail c))
                          (incf count) (format t "~&INPUT-PASS ~A ~A~%" id c)))
                      (bad-evidence (id json &optional (item 1))
                        (reject id (lambda () (i:observe-link site "source" item
                                                 :evidence-file (put "test.json" json)))))
                      (sha (path)
                        (ironclad:byte-array-to-hex-string
                         (ironclad:digest-sequence :sha256 (dreyeck/local-fedwiki-page::%read-octets (merge-pathnames path root)))))
                      (copy-json (path digest &optional (copy-site "remote-item") (copy-slug "missing"))
                        (format nil "{\"facts\":[[\"remote-snapshot\",\"fedwiki:local\",\"missing\",\"remote-item\",\"~A\"],[\"fork-permitted\",\"fedwiki:local\",\"missing\"],[\"fork-source-policy\",\"fedwiki:local\",\"missing\",\"cached-copy-sufficient\"]],\"copies\":[{\"site\":\"~A\",\"slug\":\"~A\",\"path\":\"~A\",\"sha256\":\"~A\"}]}" digest copy-site copy-slug path digest)))
               ;; P1e is explicitly the original own-site HTTP 500, regardless of revised shipped fixtures.
               (loop for (id item fact) in
                     '(("P1a" 3 "[\"page-available\",\"fedwiki:local\",\"broken\"]")
                       ("P1b" 1 "[\"page-available\",\"fedwiki:local\",\"missing\"]")
                       ("P1c" 3 "[\"page-unavailable\",\"fedwiki:local\",\"broken\",404]")
                       ("P1d" 0 "[\"request-error\",\"fedwiki:local\",\"target\"]")
                       ("P1e" 3 "[\"page-unavailable\",\"fedwiki:local\",\"broken\",500]"))
                     do (bad-evidence id (format nil "{\"facts\":[~A]}" fact) item))
               (put "outside-copy.json" "{\"title\":\"Not a remote copy\"}")
               (let ((digest (sha "snapshots/missing.json")))
                 (bad-evidence "P2a" (copy-json "pages/source" (sha "pages/source")))
                 (bad-evidence "P2b" (copy-json "outside-copy.json" (sha "outside-copy.json")))
                 (bad-evidence "P2c" (copy-json (namestring (merge-pathnames "snapshots/missing.json" root)) digest))
                 (bad-evidence "P2d" (copy-json "snapshots/missing.json" digest "remote-item" "other"))
                 (bad-evidence "P2e" (copy-json "snapshots/missing.json" digest "other"))
                 (dolist (path '("snapshots/../pages/source" "../snapshots/missing.json" "snapshots/absent.json"))
                   (bad-evidence (list :path path) (copy-json path digest)))
                 (bad-evidence "wrong digest" (copy-json "snapshots/missing.json" "00"))
                 (put "snapshots/invalid.json" "not json")
                 (bad-evidence "snapshot JSON" (copy-json "snapshots/invalid.json" (sha "snapshots/invalid.json")))
                 (put "snapshots/nonpage.json" "{\"arbitrary\":true}")
                 (bad-evidence "snapshot structure" (copy-json "snapshots/nonpage.json" (sha "snapshots/nonpage.json")))
                 (dolist (target '("../pages/source" "missing.json"))
                   (let ((link (merge-pathnames "snapshots/link.json" root)))
                     (uiop:run-program (list "ln" "-s" target (namestring link)))
                     (unwind-protect
                          (bad-evidence (list :symlink target) (copy-json "snapshots/link.json" (sha "snapshots/link.json")))
                       (delete-file link))))
                 ;; A symlink of the evidence area's snapshots directory is also refused.
                 (let ((dir (merge-pathnames "snapshots/" root)) (real (merge-pathnames "real-snapshots/" root)))
                   (rename-file dir real)
                   (unwind-protect
                        (progn (uiop:run-program (list "ln" "-s" "real-snapshots" (namestring (merge-pathnames "snapshots" root))))
                               (bad-evidence "symlink directory" (copy-json "snapshots/missing.json" digest)))
                     (delete-file (merge-pathnames "snapshots" root)) (rename-file real dir)))
                 (let* ((o (i:observe-link site "source" 1 :evidence-file (put "positive.json" (copy-json "snapshots/missing.json" digest))))
                        (p (check-plan (i:prepare-link o :repeat 2))))
                   (assert (= 1 (count 'd::!simulate-fork (first (h:plans-of p)) :key #'car)))
                   (assert (not (has-step (check-plan (i:continue-preparation o p)) 'd::!simulate-fork)))
                   (assert (eq :confirmed-local-absence (i:finding o)))
                   (format t "~&INPUT-PASS positive verified snapshot / fork once / continuation~%")))
               (dolist (case '(("P3a" "{\"copies\":[]}") ("P3b" "{\"facts\":\"x\"}")
                               ("P3c" "{\"facts\":[\"fork-permitted\"]}") ("P3d" "{\"facts\":[[]]}")
                               ("P3e" "{\"facts\":[[\"fork-source-policy\"]]}")
                               ("P3f" "{\"facts\":[[\"fork-permitted\",null,null]]}")
                               ("P3g" "{\"facts\":[[\"fork-permitted\",true,\"missing\"]]}")
                               ("P3h" "{\"facts\":[[\"page-unavailable\",\"remote-item\",\"missing\",404.5]]}")
                               ("P3i" "{\"facts\":[[\"fork-permitted\",[\"a\"],\"missing\"]]}")
                               ("P3j" "{\"facts\":[[\"LOCAL-PAGE\",\"fedwiki:local\",\"missing\"]]}")
                               ("P3k" "{\"facts\":[[\"MODELED-FORK\",\"fedwiki:local\",\"missing\",\"r\",\"s\"]]}")
                               ("P3l" "{\"facts\":[[\"fork-source-policy\",\"fedwiki:local\",\"missing\",\"whatever\"]]}")
                               ("P3m" "not json") ("P3n" "{\"facts\":[[\"fork-permitted\",\"fedwiki:local\"]]}")
                               ("P3o" "{\"facts\":[[\"page-unavailable\",\"remote-item\",\"missing\",\"500\"]]}")
                               ("trailing JSON" "{\"facts\":[]} garbage")
                               ("copies null" "{\"facts\":[],\"copies\":null}")
                               ("copy incomplete" "{\"facts\":[],\"copies\":[{}]}")
                               ("policy missing value" "{\"facts\":[[\"fork-source-policy\",\"fedwiki:local\",\"missing\"]]}")))
                 (bad-evidence (first case) (second case)))
               (dolist (index '(9 -1 "0" 0.0 nil))
                 (reject (list "P4a" index) (lambda () (i:observe-link site "source" index))))
               (put "pages/empty-story" "{\"title\":\"Empty\",\"journal\":[]}")
               (reject "P4b" (lambda () (i:observe-link site "empty-story" 0)))
               (put "pages/no-link" "{\"title\":\"No link\",\"story\":[{\"type\":\"paragraph\",\"text\":\"ordinary text\"}],\"journal\":[]}")
               (reject "no wiki link" (lambda () (i:observe-link site "no-link" 0)))
               (put "pages/invalid-link" "{\"title\":\"Empty target\",\"story\":[{\"type\":\"paragraph\",\"text\":\"[[.]]\"}],\"journal\":[]}")
               (reject "invalid wiki target" (lambda () (i:observe-link site "invalid-link" 0)))
               (reject "missing source" (lambda () (i:observe-link site "absent" 0)))
               (reject "malformed source JSON" (lambda () (i:observe-link site "broken" 0)))
               ;; A local target's actual read failure remains unknown. A programming error escapes.
               (assert (eq :unknown (i:finding (i:observe-link site "source" 3))))
               (let ((original (symbol-function 'hb:find-page)))
                 (unwind-protect
                      (progn
                        (setf (symbol-function 'hb:find-page)
                              (lambda (site slug &rest keys)
                                (if (equal slug "target") (error 'file-error :pathname "target")
                                    (apply original site slug keys))))
                        (assert (eq :unknown (i:finding (i:observe-link site "source" 0))))
                        (setf (symbol-function 'hb:find-page)
                              (lambda (site slug &rest keys)
                                (if (equal slug "target") (error 'unexpected-input-test-error)
                                    (apply original site slug keys))))
                        (assert-condition 'unexpected-input-test-error (lambda () (i:observe-link site "source" 0))))
                   (setf (symbol-function 'hb:find-page) original)))
               (format t "~&INPUT-PASS local read failure UNKNOWN / unexpected error propagates~%")
               ;; Retain remote HTTP semantics and ordering, while local-only ignores remote availability.
               (dolist (status '(500 302 :transport))
                 (let* ((fact (if (eq status :transport) "[\"request-error\",\"remote-item\",\"remote-only\"]"
                                  (format nil "[\"page-unavailable\",\"remote-item\",\"remote-only\",~D]" status)))
                        (file (put "remote.json" (format nil "{\"facts\":[~A,[\"page-available\",\"remote-new\",\"remote-only\"]]}" fact)))
                        (o (i:observe-link site "source" 2 :evidence-file file :reader-origin "fedwiki:local" :panel-site "fedwiki:local"))
                        (p (check-plan (i:resolve-link o :policy :collaborative))))
                   (assert (equal (if (eq status :transport) '("fedwiki:local" "remote-item") '("fedwiki:local" "remote-item" "remote-new"))
                                  (loop for step in (first (h:plans-of p)) when (eq (car step) 'r::!request) collect (third step))))
                   (assert (has-step p (if (eq status :transport) 'r::!abort-resolution 'r::!open-panel)))
                   (assert (has-step (check-plan (i:resolve-link o)) 'r::!conclude-unresolved))
                   (format t "~&INPUT-PASS remote ~A / collaborative order / no local-only fallback~%" status)))
               (format t "~&INPUT-REGRESSIONS-PASS ~D invalid inputs rejected with details~%" count))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore)))
  (run-r1-tests)
  t)

;;; R1: source roles must not alias the explicit local destination.
(defun run-r1-tests ()
  (let* ((source (asdf:system-relative-pathname "dreyeck/work/fedwiki-local-only"
                   "dreyeck/tests/fixtures/fedwiki-local-only/"))
         (root (merge-pathnames (format nil "hyperdoc-r1-~A/" (gensym)) (uiop:temporary-directory))))
    (unwind-protect
         (progn
           (dolist (sub '("" "pages/" "snapshots/"))
             (ensure-directories-exist (merge-pathnames sub root))
             (dolist (file (uiop:directory-files (merge-pathnames sub source)))
               (uiop:copy-file file (merge-pathnames (file-namestring file) (merge-pathnames sub root)))))
           (let* ((site (i:make-own-site root "fedwiki:local"))
                  (original (shasht:read-json (uiop:read-file-string (merge-pathnames "evidence.json" root))))
                  (copy (aref (gethash "copies" original) 0))
                  (digest (gethash "sha256" copy))
                  (own "fedwiki:local"))
             (labels ((snapshot (remote) (vector "remote-snapshot" own "missing" remote digest))
                      (copy-for (remote)
                        (let ((c (alexandria:copy-hash-table copy))) (setf (gethash "site" c) remote) c))
                      (facts-for (remote policy)
                        (list (snapshot remote) (vector "fork-permitted" own "missing")
                              (vector "fork-source-policy" own "missing" policy)))
                      (observe (facts copies)
                        (let ((json (make-hash-table :test #'equal)) (file (merge-pathnames "r1.json" root)))
                          (setf (gethash "facts" json) (coerce facts 'vector)
                                (gethash "copies" json) (coerce copies 'vector))
                          (with-open-file (out file :direction :output :if-exists :supersede :external-format :utf-8)
                            (shasht:write-json json out))
                          (i:observe-link site "source" 1 :evidence-file file)))
                      (unchanged (before after)
                        (assert (= (hash-table-count before) (hash-table-count after)))
                        (maphash (lambda (k v) (assert (eq v (gethash k after)))) before))
                      (reject (id facts copies &optional (detail :own-site-cannot-be-remote-source))
                        (let ((observations (alexandria:copy-hash-table i::*observations*))
                              (results (alexandria:copy-hash-table i::*results*))
                              (problems (copy-list shop3::*all-problems*)))
                          ;; If observation succeeds, actually ask for a plan: rejection must happen before that.
                          (let ((c (assert-condition 'i:invalid-observation
                                     (lambda () (i:prepare-link (observe facts copies))))))
                            (assert (eq detail (first (i::detail c))))
                            (unchanged observations i::*observations*)
                            (unchanged results i::*results*)
                            (assert (equal problems shop3::*all-problems*))
                            (format t "~&R1-PASS ~A: ~A; no observation/result/problem registered~%" id c))))
                      (positive (policy)
                        (let* ((facts (facts-for "remote-item" policy))
                               (facts (if (equal policy "require-remote-evidence")
                                          (cons (vector "remote-page" "remote-item" "missing") facts) facts))
                               (obs (observe facts (list copy)))
                               (plan (check-plan (i:prepare-link obs :repeat 2))))
                          (assert (eq :confirmed-local-absence (i:finding obs)))
                          (assert (= 1 (count 'd::!simulate-fork (first (h:plans-of plan)) :key #'car)))
                          (assert (equal "remote-item" (fourth (has-step plan 'd::!simulate-fork))))
                          (assert (member '(d::local-page-absent "fedwiki:local" "missing") (i::facts-of obs) :test #'equal))
                          (assert (not (find 'd::local-page (shop3:state-atoms (first (h:final-states-of plan))) :key #'car)))
                          (assert (not (has-step (check-plan (i:continue-preparation obs plan)) 'd::!simulate-fork)))
                          (assert (has-step (check-plan (i:resolve-link obs :prepared plan)) 'r::!use-modeled-page))
                          (assert (null (hb:find-page site "missing")))
                          (format t "~&R1-PASS ~A: one fork, native tree/final state, continuation without fork; store remains absent~%" policy))))
               (assert (eq :confirmed-local-absence (i:finding (i:observe-link site "source" 1))))
               (reject "B7" (facts-for own "cached-copy-sufficient") (list (copy-for own)))
               (reject "B8" (cons (vector "remote-page" own "missing") (facts-for own "require-remote-evidence")) (list (copy-for own)))
               ;; Isolate each guard: another violation must not hide a missing branch.
               (reject "remote-page alone" (cons (vector "remote-page" own "missing")
                                                 (facts-for "remote-item" "require-remote-evidence")) (list copy))
               (reject "remote-page-absent" (list (vector "remote-page-absent" own "missing")) nil)
               (reject "unreferenced own copy" nil (list (copy-for own)) :own-site-cannot-be-remote-copy)
               (positive "cached-copy-sufficient")
               (positive "require-remote-evidence")
               ;; A real remote absence is admissible evidence, not grounds for rejecting the input.
               (let ((obs (observe (cons (vector "remote-page-absent" "remote-item" "missing")
                                         (facts-for "remote-item" "require-remote-evidence")) (list copy))))
                 (assert (null (h:plans-of (i:prepare-link obs))))
                 (format t "~&R1-PASS remote absence: accepted observation, no strict-policy plan~%"))
               ;; Local destination permissions remain legal, including an explicit prohibition.
               (let ((obs (observe (list (snapshot "remote-item") (vector "fork-forbidden" own "missing")
                                         (vector "fork-source-policy" own "missing" "cached-copy-sufficient")) (list copy))))
                 (assert (null (h:plans-of (i:prepare-link obs))))
                 (format t "~&R1-PASS own destination fork-forbidden: accepted observation, no plan~%"))
               (let* ((obs (observe (cons (snapshot "remote-new") (facts-for "remote-item" "cached-copy-sufficient"))
                                    (list copy (copy-for "remote-new"))))
                      (plan (i:prepare-link obs :repeat 2)))
                 (assert (= 2 (length (h:plans-of plan)) (length (h:plan-trees-of plan)) (length (h:final-states-of plan))))
                 (assert (equal '("remote-item" "remote-new")
                                (sort (loop for p in (h:plans-of plan)
                                            do (assert (= 1 (count 'd::!simulate-fork p :key #'car)))
                                            collect (fourth (find 'd::!simulate-fork p :key #'car))) #'string<)))
                 (dolist (index '(0 1))
                   (assert (not (has-step (check-plan (i:continue-preparation obs plan :index index)) 'd::!simulate-fork)))
                   (assert (has-step (check-plan (i:resolve-link obs :prepared plan :index index)) 'r::!use-modeled-page)))
                 (format t "~&R1-PASS two alternatives: one fork each; both continuations without fork~%")))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore)))
  (format t "~&R1-REGRESSIONS-PASS~%") t)
