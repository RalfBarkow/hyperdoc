(in-package #:dreyeck/work/welcome-development)

(defun test-refusal (label records &optional reason)
  (handler-case
      (progn (development-state records) (error "Expected refusal: ~S" label))
    (invalid-development-record (condition)
      (when reason (assert (equal reason (refusal-reason condition))))
      (format t "~&WELCOME REFUSAL ~A PASS: ~S~%" label (refusal-reason condition)))))

(defun check-scenario (scenario expected outcome)
  (let* ((records (fixture-records scenario))
         (before (development-state records))
         (run (development-workflow records))
         (result (development-plan-result run))
         (plans (dreyeck/shop3:plans-of result))
         (trees (dreyeck/shop3:plan-trees-of result))
         (states (dreyeck/shop3:final-states-of result))
         (actual (mapcar #'first plans)))
    (assert (typep result 'dreyeck/shop3:hyperdoc-htn-plan-result))
    (assert (eq :plan-only (dreyeck/shop3:execution-mode-of result)))
    (assert (= (length expected) (length plans) (length trees) (length states)
               (length (dreyeck/shop3:raw-plans-of result))))
    (assert (and (subsetp expected actual :test #'equal) (subsetp actual expected :test #'equal)))
    (assert (every (lambda (p) (= 1 (length p))) plans))
    (assert (eq outcome (development-outcome run)))
    (assert (equal before (development-state records)))
    (assert (equal before (development-initial-state run)))
    (loop for tree in trees for state in states for alternative in (development-next-action-view run)
          do (assert (equal '(advance-welcome) (caar tree)))
             (assert (symbolp (second (first tree))))
             (assert (subsetp before (shop3:state-atoms state) :test #'equal))
             (assert (eq :not-executed (getf alternative :execution)))
             (when (member outcome '(:blocked :complete :awaiting))
               (assert (not (getf alternative :assignment-proposal-p)))))
    (let ((*package* (find-package '#:dreyeck/work/welcome-development)))
      (format t "~&WELCOME ~A PASS: ~S; ~D plans/trees/states; :PLAN-ONLY; :FIXTURE~%  ~S~%"
              scenario outcome (length plans) actual))
    run))

(shop3:defdomain (welcome-qualified-probe :noset t)
  ((:operator (!qualified-ok) () () ((qualification-passed)))
   (:method (qualification-task) call-and-forall
    ((shop3:call < 1 2)
     (shop3:forall (?x) ((probe ?x)) ((probe-done ?x))))
    ((!qualified-ok)))))
(shop3:defdomain (welcome-unqualified-call-probe :noset t)
  ((:operator (!qualified-ok) () () ())
   (:method (qualification-task) unqualified-call ((call < 1 2)) ((!qualified-ok)))))
(shop3:defdomain (welcome-unqualified-forall-probe :noset t)
  ((:operator (!qualified-ok) () () ())
   (:method (qualification-task) unqualified-forall
    ((forall (?x) ((probe ?x)) ((probe-done ?x)))) ((!qualified-ok)))))

(shop3:defproblem welcome-qualified-positive welcome-qualified-probe
  ((probe a) (probe-done a)) ((qualification-task)))
(shop3:defproblem welcome-qualified-negative welcome-qualified-probe
  ((probe a)) ((qualification-task)))
(shop3:defproblem welcome-unqualified-call welcome-unqualified-call-probe
  () ((qualification-task)))
(shop3:defproblem welcome-unqualified-forall welcome-unqualified-forall-probe
  ((probe a) (probe-done a)) ((qualification-task)))

(defun test-qualification ()
  (dolist (spec '((welcome-qualified-positive 1) (welcome-qualified-negative 0)
                  (welcome-unqualified-call 0) (welcome-unqualified-forall 0)))
    (multiple-value-bind (raw time trees states)
        (shop3:find-plans (first spec) :which :all :verbose 0 :plan-tree t :collect-state t)
      (declare (ignore time))
      (assert (= (second spec) (length raw) (length trees) (length states)))
      (format t "~&WELCOME QUALIFICATION ~A PASS: ~D plans/trees/states~%" (first spec) (length raw)))))

(defun test-record-evidence ()
  (let* ((records (fixture-records :p3))
         (verification (car (last records)))
         (assignment (second records))
         (commit (data verification :commit)))
    (test-refusal :opposite-verifications
                  (append records (list (fixture-verification assignment commit :rejected)))))
  (let* ((records (fixture-records :p4))
         (assignment (second records))
         (commit (fixture-sha #\1)))
    (test-refusal :opposite-reviews
                  (append records (list (fixture-review assignment commit :rejected)))))
  (dolist (case '(:self-verifier :not-independent :missing-marker :nonzero-test-exit
                  :wrong-test-commit :wrong-test-tree :scope-violation :not-ancestor
                  :missing-platform :missing-verifier :unsupported-positive-verdict))
    (let* ((records (fixture-records :p3))
           (verification (car (last records)))
           (properties (record-data verification))
           (test (first (getf properties :tests)))
           (repository (getf properties :repository-evidence)))
      (ecase case
        (:self-verifier (setf (getf properties :verifier) 'codex))
        (:not-independent (setf (getf properties :independent) nil))
        (:missing-marker (setf (getf test :markers) '("NOT-PASSED")))
        (:nonzero-test-exit (setf (getf test :exit-code) 1))
        (:wrong-test-commit (setf (getf test :commit) (fixture-sha #\0)))
        (:wrong-test-tree (setf (getf test :tree) (fixture-sha #\0)))
        (:scope-violation (setf (getf repository :files) '("production/forbidden.lisp")))
        (:not-ancestor (setf (getf repository :ancestor) nil))
        (:missing-platform (setf (getf properties :platform) nil))
        (:missing-verifier (setf (getf properties :verifier) nil))
        (:unsupported-positive-verdict (setf (getf properties :verdict) :returned)))
      (test-refusal case records)))
  (let* ((records (fixture-records :p4))
         (review (car (last records))))
    (let ((properties (record-data review)))
      (setf (getf properties :reviewer) 'codex))
    (let ((properties (record-data (first records))))
      (push '(codex s1) (getf properties :reviewers)))
    (test-refusal :self-review records :implementer-cannot-review))
  (let* ((records (fixture-records :p3))
         (carrier (make-instance 'dreyeck/workspace-operation:workspace-operation-invocation
                                :status :returned :value (car (last records))))
         (run (development-workflow (append (butlast records) (list carrier)))))
    (assert (eq :returned (dreyeck/evaluation-record:evaluation-status-of carrier)))
    (assert (eq '!request-review (first (getf (first (development-next-action-view run)) :step))))
    run))

(defun test-carrier-and-replanning ()
  (let* ((records (fixture-records :p2))
         (before (development-state records))
         (run (development-workflow records)))
    (dolist (carrier (list (make-instance 'dreyeck/workspace-operation:workspace-operation-invocation
                                         :status :returned :value '(:verdict :verified))
                          (make-instance 'dreyeck/workspace-operation:workspace-operation-invocation
                                         :status :failed :condition (make-condition 'simple-error))))
      (assert (equal before (development-state (append records (list carrier)))))
      (let* ((next (development-workflow (append records (list carrier))))
             (step (getf (first (development-next-action-view next)) :step)))
        (assert (eq '!verify-submission (first step)))))
    (dolist (effect '((planned-verification s1 :a1 "claim")
                       (planned-review-request s1 "claim" claude-code)
                       (planned-integration-proposal s1 "claim")))
      (test-refusal :p2b-injected-planned-effect (append records (list effect))
                    :records-required-not-planned-effects))
    (test-refusal :planned-final-state
                  (shop3:state-atoms (first (dreyeck/shop3:final-states-of (development-plan-result run))))
                  :records-required-not-planned-effects)
    (assert (equal before (development-state records)))
    (let ((a (dreyeck/shop3:plans-of (development-plan-result run)))
          (b (dreyeck/shop3:plans-of (welcome-development-plan records))))
      (assert (equal a b)))
    (format t "~&WELCOME P2b/carriers/replanning PASS: returned is not verified; planned effects refused.~%")))

(defun test-additional-boundaries ()
  (let* ((records (fixture-records :p4))
         (properties (record-data (car (last records)))))
    (setf (getf properties :findings) nil)
    (assert (= 2 (length (development-next-action-view (development-workflow records)))))
    (format t "~&WELCOME EMPTY-REVIEW-FINDINGS PASS: explicit empty findings remain an accepted review.~%"))
  (let* ((records (fixture-records :p4))
         (review (car (last records)))
         (properties (record-data review)))
    (setf (getf properties :decision) :rejected)
    (let* ((run (development-workflow records))
           (steps (mapcar (lambda (a) (getf a :step)) (development-next-action-view run))))
      (assert (equal `((!assign s1 claude-code ,+fixture-base+)) steps))
      (format t "~&WELCOME REVIEW-REJECTION PASS: reassignment proposed; no integration/S2.~%")))
  (let* ((records (fixture-records :p6))
         (carrier (make-instance 'dreyeck/workspace-operation:workspace-operation-invocation
                                :status :returned :value (car (last records))))
         (run (development-workflow (append (butlast records) (list carrier)))))
    (assert (eq '!assign (first (getf (first (development-next-action-view run)) :step))))
    (assert (notany (lambda (f) (eq 'slice-verified (first f))) (development-initial-state run)))
    (format t "~&WELCOME RETURNED-REJECTION PASS: invocation transport did not turn rejection into verified.~%"))
  (let* ((records (fixture-records :p3))
         (a (fixture-assignment :second-implementer 's1 'claude-code +fixture-base+))
         (commit (fixture-sha #\1))
         (review (fixture-review a commit)))
    (let ((properties (record-data (first records))))
      (push '(codex s1) (getf properties :reviewers)))
    (test-refusal :cross-assignment-self-review
                  (append records (list a (fixture-submission a commit) review))
                  :implementer-cannot-review))
  (let* ((records (fixture-records :p3))
         (properties (record-data (car (last records)))))
    (setf (getf properties :verdict) :rejected)
    (test-refusal :negative-verdict-positive-evidence records :negative-verdict-with-passing-evidence))
  (let* ((records (fixture-records :p3))
         (verification (car (last records))))
    (setf (slot-value verification 'source) :observed)
    (test-refusal :fixture-laundering records :mixed-fixture-and-observed-records))
  (let* ((records (fixture-records :complete))
         (incomplete (remove-if (lambda (r) (and (typep r 'integration-observation)
                                                 (eq 's4 (data r :slice)))) records)))
    (let ((steps (mapcar (lambda (a) (getf a :step))
                         (development-next-action-view (development-workflow incomplete)))))
      (assert (equal `((!propose-integration s4 ,(fixture-sha #\4))) steps))
      (format t "~&WELCOME INCOMPLETE-INTEGRATION PASS: integration proposal, no complete report.~%")))
  (let* ((policy (fixture-policy))
         (integration (fixture-integration (fixture-assignment :a1 's1 'codex +fixture-base+)
                                            (fixture-sha #\1))))
    (setf (slot-value policy 'source) :observed (slot-value integration 'source) :observed)
    (test-refusal :missing-remote-observer (list policy integration)
                  :remote-integration-observer-unavailable))
  (let* ((root (asdf:system-source-directory "dreyeck/work/welcome-development"))
         (repository (make-instance 'dreyeck/git:git-repository-checkout
                                    :root root :root-source :explicit-w1-test))
         (base "99dbe5599dc6c0b080bec1b743dd864aa5635e0b")
         (commit "20ad13e650cd1aca0c40192080e724b3cb4e0304")
         (evidence (observe-local-development-repository
                    repository base commit '("docs/welcome-development/*")))
         (out-of-scope (observe-local-development-repository repository base commit '("other/*"))))
    (assert (equal commit (getf evidence :commit)))
    (assert (sha-p (getf evidence :tree)))
    (assert (eq t (getf evidence :ancestor)))
    (assert (eq t (getf evidence :scope-compliant)))
    (assert (null (getf out-of-scope :scope-compliant)))
    (assert (eq repository (dreyeck/git:git-commit-repository-of (getf evidence :commit-object))))
    (assert (= 2 (length (getf evidence :files))))
    (format t "~&WELCOME LOCAL-GIT-OBSERVER PASS: actual handoff ~A tree ~A; explicit checkout; full base..commit scope.~%"
            commit (getf evidence :tree))
    ;; Existing immutable history supplies a real rename, without creating a
    ;; repository, committing test changes, integrating anything, or fetching.
    (let* ((rename (observe-local-development-repository
                    repository "e2dcf884c2f030ccd8d11efa02839071025a2bc5"
                    "ee888de1ae09c4d2b9110ea3426f73b40c6c778f"
                    '("dreyeck.asd" "dreyeck/src/*" "dreyeck/tests/*"
                      "dreyeck/pages/lisp-image/*"))))
      (assert (member "dreyeck/pages/Lisp image HyperBook refactor.html"
                      (getf rename :files) :test #'equal))
      (assert (member "dreyeck/pages/lisp-image/Lisp image HyperBook refactor.html"
                      (getf rename :files) :test #'equal))
      (assert (not (getf rename :scope-compliant)))
      (format t "~&WELCOME RENAME-SCOPE PASS: old/deleted path checked, not only the allowed destination.~%"))))

(defun test-inspection ()
  (let* ((records (fixture-records :p4))
         (verification (fourth records))
         (carrier (make-instance 'dreyeck/workspace-operation:workspace-operation-invocation
                                :status :returned :value verification))
         (entries (substitute carrier verification records :test #'eq))
         (run (development-workflow entries))
         (projection (development-topicmap run))
         (objects (mapcar #'dreyeck/topicmap:topicmap-topic-object-of
                          (dreyeck/topicmap:topicmap-projection-topics-of projection)))
         (view (development-next-actions run))
         (html (html-inspector-views:view-html view))
         (refs (mapcar #'cdr (html-inspector-views:view-references view))))
    (assert (= 2 (length (development-next-action-view run))))
    (assert (search "Alternative 0" html))
    (assert (search "Alternative 1" html))
    (assert (search "FIXTURE" html))
    (assert (not (search "<button" html)))
    (assert (member (development-plan-result run) refs :test #'eq))
    (dolist (record records) (assert (member record objects :test #'eq)))
    (assert (member carrier objects :test #'eq))
    (dolist (edge (dreyeck/topicmap:topicmap-projection-associations-of projection))
      (assert (getf (dreyeck/topicmap:topicmap-association-properties-of edge) :epistemic-status)))
    (format t "~&WELCOME INSPECTION PASS: both P4 choices, record/carrier/result EQ links, labelled edges, no buttons.~%")))

(defun run-tests ()
  (let ((c1 (fixture-sha #\1)) (c2 (fixture-sha #\2)))
    (check-scenario :p0 `((!assign s1 codex ,+fixture-base+) (!assign s1 claude-code ,+fixture-base+)) :actionable)
    (check-scenario :p1 '((!await-submission s1 :a1 codex)) :awaiting)
    (check-scenario :p2 `((!verify-submission s1 :a1 ,c1)) :actionable)
    (check-scenario :p3 `((!request-review s1 ,c1 claude-code)) :actionable)
    (check-scenario :p4 `((!propose-integration s1 ,c1) (!assign s2 codex ,c1)) :actionable)
    (check-scenario :p4b `((!request-review s1 ,c1 claude-code)) :actionable)
    (check-scenario :p5 `((!assign s2 codex ,c1)) :actionable)
    (check-scenario :p6 `((!assign s1 claude-code ,+fixture-base+)) :actionable)
    (check-scenario :p7 '((!report-blocker s1 attempts-exhausted)) :blocked)
    (check-scenario :p8 '((!report-blocker s2 no-alternative-executor)) :blocked)
    (check-scenario :p9 '((!report-blocker s1 no-eligible-reviewer)) :blocked)
    (check-scenario :p10 `((!verify-submission s1 :a1 ,c1)) :actionable)
    (check-scenario :p11 `((!propose-integration s1 ,c1) (!propose-integration s2 ,c2)
                           (!assign s3 codex ,c2)) :actionable)
    (check-scenario :complete '((!report-complete)) :complete))
  (test-qualification)
  (test-record-evidence)
  (test-carrier-and-replanning)
  (test-additional-boundaries)
  (test-inspection)
  (format t "~&WELCOME-DEVELOPMENT-PASS: W1 only; real SHOP3; fixture scenario evidence; no action executed.~%")
  t)
