(defpackage #:dreyeck/work/conversation-coordinates/tests
  (:use #:cl)
  (:local-nicknames (#:cc #:dreyeck/work/conversation-coordinates)
                    (#:c #:dreyeck/work/ctm-page-authoring)
                    (#:p #:dreyeck/work/collaborative-planning)
                    (#:work #:dreyeck/work/reading)
                    (#:tm #:dreyeck/topicmap) (#:v #:html-inspector-views)
                    (#:occ #:dreyeck/gesture/operation-request)
                    (#:r #:dreyeck/work/trails-rendered-reading/tests))
  (:export #:run-tests #:reconstruction-keys))
(in-package #:dreyeck/work/conversation-coordinates/tests)
(defvar *checks* 0)
(defmacro check (form) `(progn (incf *checks*) (assert ,form)))
(defun view (object title) (r::following-view object title))
(defun refs (object title) (mapcar #'cdr (v:view-references (view object title))))
(defun refuses (thunk)
  (check (handler-case (progn (funcall thunk) nil) (cc::conversation-source-error () t))))
(defun reconstruction-keys ()
  (let ((session (cc:read-conversation)))
    (mapcar #'cc:source-key (append (list session) (cc::session-messages session) (cc::session-spans session)))))
(defun projection-keys (projection)
  (list (mapcar #'tm:topicmap-topic-id-of (tm:topicmap-projection-topics-of projection))
        (mapcar (lambda (e) (list (tm:topicmap-association-id-of e) (tm:topicmap-association-from-of e)
                                  (tm:topicmap-association-type-of e) (tm:topicmap-association-to-of e)))
                (tm:topicmap-projection-associations-of projection))))

(defun run-tests ()
  (let* ((*checks* 0)
         (paths (append (mapcar (lambda (title) (hyperdoc:file-of (work:work-page title)))
                               '("Work Breakdown" "Conversation Coordinates" "Authoring the CTM Plan Page" "CTM Plan Page WBS Dictionary"))
                        (list (cc::evidence-file "coordinates.json")
                              (asdf:system-relative-pathname "dreyeck/work/reading" "dreyeck/work/ctm-page-evidence/ctm-and-tmdm-in-hyperdoc.json"))))
         (digests (mapcar #'p::file-digest paths))
         (planning-before (projection-keys (p::collaborative-planning-projection)))
         (ctm-before (projection-keys (c:ctm-authoring-projection (c:read-ctm-authoring))))
         (work-before (projection-keys (work:work-projection)))
         (session (cc:read-conversation))
         (cc::*conversation* session)
         (messages (cc::session-messages session))
         (m2 (cc::message-at session 2)) (m20 (cc::message-at session 20))
         (span20 (cc::span-at session 20))
         (p1 (cc::subject-at session "ctm-plan-p1"))
         (wp1 (cc::subject-at session "ctm-wp-1"))
         (workspace (cc::workspace-of session))
         (projection (tm:topicmap-workspace-projection-of workspace)))
    (check (equal '(2 8 16 20) (mapcar #'cc:message-number messages)))
    ;; N1: format is separate from session role and unauthenticated authorship.
    (dolist (pair '((16 . "unwrapped") (20 . "pasted-wrapper")))
      (let* ((message (cc::message-at session (car pair)))
             (record (cc::message-record message))
             (html (v:view-html (view message "Message coordinates"))))
        (check (equal "user" (gethash "role" record)))
        (check (equal (cdr pair) (gethash "origin" record)))
        (check (equal "not-recorded" (gethash "author" record)))
        (check (search (cdr pair) html))
        (check (search "not-recorded" html))))
    (check (equal (reconstruction-keys) (reconstruction-keys)))
    (let ((fresh (cc:read-conversation)))
      (check (not (eq m20 (cc::message-at fresh 20))))
      (check (equal (cc:source-key m20) (cc:source-key (cc::message-at fresh 20)))))
    (dolist (message messages)
      (check (member message (refs session "Chronology") :test #'eq))
      (check (eq message (tm:topicmap-topic-object-of (tm:topicmap-projection-topic-by-id projection (cc::object-id message)))))
      (let* ((span (cc::span-at session (cc:message-number message)))
             (record (cc::message-record message)))
        (check (member span (refs message "Message coordinates") :test #'eq))
        (check (member message (refs span "Source span") :test #'eq))
        (check (eq :body-not-published (occ:occurrence-status span)))
        (check (null (occ:occurrence-source span)))
        (refuses (lambda () (occ:resolve-occurrence span)))
        (check (eq :false (gethash "decision" record)))
        (check (not (search "/Users/" (v:view-html (view message "Message coordinates")))))))
    ;; Exact retained review, all F1-F11 with correct offset, then counterprobes.
    (let ((text (subseq (p::document-text (p::case-subject "claude-review")) 1386 14103)))
      (check (cc:verify-review-binding text))
      (refuses (lambda () (cc:verify-review-binding text :offset -1385)))
      (refuses (lambda () (cc:verify-review-binding (concatenate 'string "X" (subseq text 1))))))
    (dolist (field '("role" "origin" "author" "decision" "parentUuid" "lineSha256" "textSha256"))
      (let* ((records (map 'vector (lambda (m) (work::%copy-json (cc::message-record m))) messages)))
        (setf (gethash field (aref records 0)) (if (equal field "decision") t "user"))
        (refuses (lambda () (cc::validate-records records)))))
    (refuses (lambda () (cc::validate-records (coerce (reverse (mapcar #'cc::message-record messages)) 'vector))))
    (let ((records (map 'vector (lambda (m) (work::%copy-json (cc::message-record m))) messages)))
      (setf (gethash "origin" (aref records 2)) "generated")
      (refuses (lambda () (cc::validate-records records))))
    (let ((record (cc::message-record (cc::message-at session 16))))
      (unwind-protect
           (progn (setf (gethash "role" record) "assistant")
                  (refuses (lambda () (cc::relation-warrant session (cc::span-at session 16)
                                                           "reports-observation" "ctm-pre-transfer"))))
        (setf (gethash "role" record) "user")))
    (refuses (lambda () (cc::relation-warrant session span20 "retained-as" "claude-review")))
    (refuses (lambda () (cc::relation-warrant session (cc::span-at session 2) "decides" "ctm-plan-p1")))
    (refuses (lambda () (cc::relation-warrant session m2 "follows" m20)))
    (let ((alien (cc:read-conversation)))
      (refuses (lambda () (cc::relation-warrant session m20 "follows" (cc::message-at alien 2)))))
    (let* ((range (occ:occurrence-range span20)) (old (car range)))
      (unwind-protect
           (progn (setf (car range) 1)
                  (refuses (lambda () (cc::relation-warrant session span20 "reports-observation" "ctm-plan-p1"))))
        (setf (car range) old)))
    ;; Both native Inspector paths, including the backward EQ message handle.
    (check (eq p1 (cc::resolve-ctm-source-key session (cc:source-key p1))))
    (let ((key (copy-list (cc:source-key p1))))
      (setf (third key) "Wrong declaring page")
      (refuses (lambda () (cc::resolve-ctm-source-key session key))))
    (let ((fresh (cc:read-conversation)))
      (check (equal (cc:source-key p1) (cc:source-key (cc::subject-at fresh "ctm-plan-p1")))))
    (check (member p1 (refs span20 "Source span") :test #'eq))
    (check (member wp1 (refs p1 "Plan step") :test #'eq))
    (check (member m20 (refs wp1 "Conversation sources") :test #'eq))
    (check (member span20 (refs wp1 "Conversation sources") :test #'eq))
    (let ((e3 (cc::subject-at session "e3-evidence")))
      (check (member e3 (refs wp1 "Conversation sources") :test #'eq))
      (check (member span20 (refs e3 "Conversation E3 evidence") :test #'eq))
      (check (equal "ed37e9bac2fcd548" (work:fedwiki-item-observation-item-id e3))))
    ;; Page revision is independent from the declaration and Subject identity.
    (let* ((fresh (c:read-ctm-authoring)) (subject (c::%subject fresh "ctm-wp-1"))
           (snapshot (work:topic-occurrence-snapshot (work:topic-source-occurrence (c::subject-topic subject))))
           (old (char snapshot 0)))
      (unwind-protect
           (progn (setf (char snapshot 0) #\X)
                  (check (eq :current (cc::binding-status session subject)))
                  (view subject "Conversation sources"))
        (setf (char snapshot 0) old)))
    ;; A changed declaration has the same Subject but STALE evidence.
    (let* ((fresh (c:read-ctm-authoring)) (subject (c::%subject fresh "ctm-wp-1"))
           (occurrence (work:topic-source-occurrence (c::subject-topic subject)))
           (snapshot (work:topic-occurrence-snapshot occurrence))
           (start (car (work:topic-occurrence-element-range occurrence)))
           (old (char snapshot start)))
      (unwind-protect
           (progn (setf (char snapshot start) #\X)
                  (check (equal (cc:source-key wp1) (cc:source-key subject)))
                  (check (eq :stale (cc::binding-status session subject)))
                  (check (search "stale" (v:view-html (view subject "Conversation sources")))))
        (setf (char snapshot start) old)))
    (check (search "checked here" (v:view-html (view m2 "Message coordinates"))))
    (check (search "NOT-RUN" (v:view-html (view (cc::message-at session 8) "Message coordinates"))))
    (check (search "recorded offline PASS" (v:view-html (view m20 "Message coordinates"))))
    (let ((html (v:view-html (view (cc::subject-at session "original-report") "Report source"))))
      (check (search "404" html))
      (check (search "localhost:3000" html))
      (check (not (search "href=" html))))
    (check (equal "localhost:3000" (work:fedwiki-item-observation-site (cc::subject-at session "e3-evidence"))))
    (check (< (- (cdr (occ:occurrence-range span20)) (car (occ:occurrence-range span20)))
              (gethash "characters" (cc::message-record m20))))
    ;; All introduced edge types have role, warrant, source and status contracts.
    (dolist (edge (tm:topicmap-projection-associations-of projection))
      (when (search "conversation:" (tm:topicmap-association-id-of edge))
        (let ((properties (tm:topicmap-association-properties-of edge)))
          (dolist (key '(:from-role :to-role :source-key :warrant :check-status :binding-status))
            (check (getf properties key))))))
    (refuses (lambda () (cc::relation-warrant session m20 "has-message" session)))
    (refuses (lambda () (cc::relation-warrant session m2 "has-span" span20)))
    (refuses (lambda () (cc::relation-warrant session p1 "source-evidence" (cc::subject-at session "e3-evidence"))))
    (refuses (lambda () (cc::relation-warrant session wp1 "source-evidence" "e3-evidence")))
    (let* ((observation (cc::subject-at session "e3-evidence"))
           (item (work:fedwiki-item-observation-item observation)) (text (gethash "text" item)))
      (unwind-protect
           (progn (setf (gethash "text" item) "Synthetic wrong observation")
                  (refuses (lambda () (cc::relation-warrant session wp1 "source-evidence" observation))))
        (setf (gethash "text" item) text)))
    ;; Work Topics retain the same first native view as an ordinary carrier.
    (dolist (id '("collaborative-planning-case" "ctm-plan-page-authoring"))
      (let* ((topic (cc::subject-at session id))
             (plain (tm:make-topicmap-topic :id id :object (tm:topicmap-topic-object-of topic)
                       :label (tm:topicmap-topic-label-of topic) :type (tm:topicmap-topic-type-of topic))))
        (check (equal (v:view-title (first (v:all-views plain)))
                      (v:view-title (first (v:all-views topic)))))))
    (let* ((span2 (cc::span-at session 2)) (review (p::case-subject "claude-review")))
      (check (member review (refs span2 "Source span") :test #'eq))
      (loop for n from 1 to 11 for finding = (p::case-subject (format nil "F~D" n)) do
        (check (member finding (refs review "Conversation findings") :test #'eq))
        (check (eq finding (tm:topicmap-topic-object-of (tm:topicmap-projection-topic-by-id projection (format nil "F~D" n)))))
        (check (member (p::planning-case) (refs review "Conversation findings") :test #'eq))))
    ;; Explicit report reference; no network fetch or report text is materialized.
    (check (member (cc::subject-at session "original-report") (refs (cc::span-at session 8) "Source span") :test #'eq))
    (view (cc::subject-at session "original-report") "Report source")
    ;; Cursor selection and thematic navigation remain independent.
    (let ((point (tm:topicmap-workspace-point-of workspace))
          (history (copy-list (tm:topicmap-workspace-history-of workspace))))
      (cc:select-message session 3)
      (check (eq m20 (cc::selected-message session)))
      (check (equal point (tm:topicmap-workspace-point-of workspace)))
      (check (equal history (tm:topicmap-workspace-history-of workspace))))
    (dolist (id '("message-20" "ctm-plan-p1" "ctm-wp-1" "F3"))
      (let ((before (tm:topicmap-workspace-point-of workspace)))
        (tm:topicmap-workspace-go-to workspace id)
        (check (equal before (first (tm:topicmap-workspace-history-of workspace))))
        (check (eq m20 (cc::selected-message session)))
        (check (equal '(2 8 16 20) (mapcar #'cc:message-number (cc::session-messages session))))))
    (let ((history (copy-list (tm:topicmap-workspace-history-of workspace))))
      (tm:topicmap-workspace-reproject workspace (cc::conversation-projection session))
      (check (equal "F3" (tm:topicmap-workspace-point-of workspace)))
      (check (equal history (tm:topicmap-workspace-history-of workspace)))
      (check (member (p::case-subject "F3") (refs workspace "Topicmap") :test #'eq)))
    (check (member session (refs (work:work-page "Conversation Coordinates") "Content") :test #'eq))
    (check (member m20 (refs (cc::subject-at session "ctm-plan-page-authoring") "Conversation sources") :test #'eq))
    ;; Explicit context, independent of the globally cached default reading.
    (let ((cc::*conversation* (cc:read-conversation)))
      (check (member m20 (refs (cc::subject-at session "ctm-plan-page-authoring") "Conversation sources") :test #'eq))
      (check (member m20 (refs wp1 "Conversation sources") :test #'eq)))
    (check (notany #'c::authorization-permitted-p (mapcar #'c::step-authorization (c::plan-steps (cc::session-ctm session)))))
    (dolist (edge (tm:topicmap-projection-associations-of projection))
      (dolist (id (list (tm:topicmap-association-from-of edge) (tm:topicmap-association-to-of edge)))
        (check (= 1 (count id (tm:topicmap-projection-topics-of projection) :key #'tm:topicmap-topic-id-of :test #'equal)))))
    ;; Reusing the projections does not change them. No total Catalog count.
    (check (equal planning-before (projection-keys (p::collaborative-planning-projection))))
    (check (equal ctm-before (projection-keys (c:ctm-authoring-projection (c:read-ctm-authoring)))))
    (check (equal work-before (projection-keys (work:work-projection))))
    (check (equal digests (mapcar #'p::file-digest paths)))
    (format t "~&CONVERSATION-COORDINATES-PASS: ~D checks; stable keys, attribution refusals, both native reference paths, cursor/Point/History, unchanged source/projections. Original transcript and #8 report equality require scripts/verify-conversation-sources.py (NOT-RUN by this Lisp suite).~%" *checks*)))
