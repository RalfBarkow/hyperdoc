;;;; Controlled fixtures only. No observation of Ward's site is claimed.
(in-package #:dreyeck/work/fedwiki-source-acquisition)
(defvar *checks* 0)
(defmacro check (form) `(progn (incf *checks*) (assert ,form () "S1 check failed: ~S" ',form)))
(defparameter *fixture-title* "Safe and Familiar Welcome")
(defparameter *fixture-slug* "safe-and-familiar-welcome")
(defun fixture-bytes (text) (sb-ext:string-to-octets text :external-format :utf-8))
(defun fixture-sitemap (&optional (title *fixture-title*))
  (fixture-bytes (format nil "[{\"slug\":\"~A\",\"title\":\"~A\",\"links\":{\"other\":1},\"extra\":\"retained\"}]"
                        *fixture-slug* title)))
(defun fixture-page ()
  (fixture-bytes
   "{\"title\":\"Safe and Familiar Welcome\",\"story\":[{\"type\":\"paragraph\",\"id\":\"p1\",\"text\":\"Hello café [[Other]]\",\"extra\":{\"nested\":[1,2]}},{\"type\":\"unknown-plugin\",\"id\":\"u1\",\"text\":\"raw\",\"payload\":{\"arbitrary\":true}}],\"journal\":[{\"type\":\"fork\",\"site\":\"never-fetch.invalid\",\"date\":1000,\"extra\":\"kept\"}],\"page-extra\":[42]}"))
(defun fixture-transport (&key (sitemap (fixture-sitemap)) (page (fixture-page))
                              (status 200) (type "application/json; charset=utf-8") encoding effective
                              length-header broken page-status)
  (let ((urls nil) (streams nil))
    (values
     (lambda (url)
       (push url urls)
       (let* ((map-p (search "/system/sitemap.json" url))
              (bytes (if map-p sitemap page))
              (stream (if (and broken (not map-p))
                          (make-instance 'broken-byte-stream :bytes bytes :delay (eq broken :timeout))
                          (flexi-streams:make-in-memory-input-stream bytes))))
         (push stream streams)
         (values stream (if map-p status (or page-status status))
                 (append (list (cons :content-type type)
                               (cons :content-length (or length-header (write-to-string (length bytes)))))
                         (when encoding (list (cons :content-encoding encoding))))
                 (or effective url) stream t "fixture status")))
     (lambda () (reverse urls))
     (lambda () streams))))
(defclass broken-byte-stream (sb-gray:fundamental-binary-input-stream)
  ((bytes :initarg :bytes) (index :initform 0) (closed :initform nil)
   (delay :initarg :delay :initform nil)))
(defmethod sb-gray:stream-read-byte ((stream broken-byte-stream))
  (with-slots (bytes index delay) stream
    (when delay (sleep 0.2))
    (when (= index 9) (error "Injected interrupted response"))
    (prog1 (aref bytes index) (incf index))))
(defmethod close ((stream broken-byte-stream) &key abort)
  (declare (ignore abort)) (setf (slot-value stream 'closed) t))
(defun fixture-closed-p (stream)
  (if (typep stream 'broken-byte-stream) (slot-value stream 'closed) (not (open-stream-p stream))))
(defun capture-fixture (root &rest options)
  (multiple-value-bind (transport urls streams) (apply #'fixture-transport options)
    (let ((result (acquire-source "fixture.invalid" *fixture-slug* "http" root
                                  :expected-title *fixture-title* :transport transport)))
      (check (every #'fixture-closed-p (funcall streams)))
      (values result (funcall urls)))))
(defun refusal-check (result reason &optional stage)
  (check (eq :refused (acquisition-status result)))
  (check (eq reason (acquisition-reason result)))
  (when stage (check (eq stage (acquisition-stage result))))
  (check (typep (acquisition-condition result) 'condition))
  (check (null (acquisition-page result))) result)
(defun fixture-write (path bytes)
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :element-type '(unsigned-byte 8)
                           :if-exists :supersede :if-does-not-exist :create)
    (write-sequence bytes out)))
(defun view-refs (object title)
  (let ((view (find title (v:all-views object) :key #'v:view-title :test #'equal)))
    (check view) (v:view-html view) (mapcar #'cdr (v:view-references view))))

(defun test-offline (result)
  (let ((symbols '(fw::get-fedwiki fw::get-plugin-page fw::render-story-item
                   fw::reload-page drakma:http-request usocket:socket-connect
                   sb-bsd-sockets:socket-connect))
        (calls 0))
    (let ((originals (mapcar #'symbol-function symbols)))
      (unwind-protect
           (progn
             (dolist (symbol symbols)
               (setf (symbol-function symbol)
                     (lambda (&rest args) (declare (ignore args)) (incf calls)
                       (error "Forbidden offline network/render call"))))
             ;; Positive control: swallowed exceptions cannot manufacture a zero count.
             (ignore-errors (fw::get-fedwiki "control.invalid"))
             (check (= 1 calls)) (setf calls 0)
             (let* ((page (acquisition-page result))
                    (story (fw::story-of page))
                    (journal (fw::journal-of page))
                    (links (hb:links-of page))
                    (source (acquisition-local-source result))
                    (references (view-refs result "Source acquisition evidence")))
               (check (typep page 'offline::own-page))
               (check (null (fw::context-of page)))
               (let ((buttons (v:title-bar-action-buttons page)))
                 ;; Inspector wraps a NIL method body as an empty HTML view.
                 (check (or (null buttons) (not (search "Reload" (v:view-html buttons))))))
               (check (eq source (offline::source-of page)))
               (dolist (object (list page source (acquisition-sitemap result)
                                     (acquisition-entry result) (acquisition-sitemap-state result)
                                     (acquisition-page-response result) (acquisition-sitemap-response result)))
                 (check (member object references :test #'eq)))
               ;; Page source is in the broader optional local-fedwiki-view system;
               ;; the acquisition retains its native source object without loading a server/Catalog layer.
               (dolist (title '("Story" "Journal")) (view-refs page title))
               (dolist (item (coerce story 'list)) (view-refs item "Data"))
               (let ((raw (fw::raw-json-of page)))
                 (check (equalp #(42) (gethash "page-extra" raw)))
                 (check (gethash "payload" (aref (gethash "story" raw) 1)))
                 (check (equalp #(1 2) (gethash "nested" (gethash "extra" (aref (gethash "story" raw) 0))))))
               (check (gethash "payload" (fw::data-of (aref story 1))))
               (check (equal "kept" (gethash "extra" (fw::data-of (aref journal 0)))))
               (check (eq story (fw::story-of page)))
               (check (eq journal (fw::journal-of page)))
               (check (eq links (hb:links-of page)))
               (let ((link (first (fw::wiki-links-of links))))
                 (check (typep link 'fw::wiki-link))
                 (check (equal "other" (fw::target-slug-of link)))
                 (check (typep (v:eval-thunk (hb:thunk-of link)) 'condition)))
               (check (typep (verify-snapshot result) 'local:local-fedwiki-page-source)))
             (check (zerop calls)))
        (loop for symbol in symbols for original in originals do (setf (symbol-function symbol) original))))))

(defun test-s2-boundary (result parent)
  (let* ((root (merge-pathnames "destination/" parent))
         (evidence (merge-pathnames "evidence.json" root))
         (relative (concatenate 'string "snapshots/" *fixture-slug* ".json"))
         (response (acquisition-page-response result))
         (digest (response-sha256 response))
         (source-bytes (copy-seq (response-octets response))))
    (fixture-write (merge-pathnames "pages/source" root)
                   (fixture-bytes "{\"title\":\"Source\",\"story\":[{\"type\":\"paragraph\",\"id\":\"link\",\"text\":\"[[Safe and Familiar Welcome]]\"}],\"journal\":[]}"))
    (fixture-write (merge-pathnames relative root) source-bytes)
    (fixture-write evidence
      (fixture-bytes
       (format nil "{\"facts\":[[\"remote-snapshot\",\"fedwiki:destination\",\"~A\",\"fixture.invalid\",\"~A\"],[\"fork-permitted\",\"fedwiki:destination\",\"~A\"],[\"fork-source-policy\",\"fedwiki:destination\",\"~A\",\"cached-copy-sufficient\"]],\"copies\":[{\"site\":\"fixture.invalid\",\"slug\":\"~A\",\"path\":\"~A\",\"sha256\":\"~A\"}]}"
               *fixture-slug* digest *fixture-slug* *fixture-slug* *fixture-slug* relative digest)))
    (let* ((site (offline:make-own-site root "fedwiki:destination"))
           (obs (offline:observe-link site "source" 0 :evidence-file evidence))
           (plan (offline:prepare-link obs :repeat 2))
           (continued (offline:continue-preparation obs plan :index 0))
           (resolved (offline:resolve-link obs :prepared plan :index 0)))
      (check (eq :confirmed-local-absence (offline:finding obs)))
      (check (null (offline:target-page obs)))
      (check (= 1 (length (dreyeck/shop3:plans-of plan))))
      (check (= 1 (count 'dreyeck/work/defederation-planning::!simulate-fork
                         (first (dreyeck/shop3:plans-of plan)) :key #'first)))
      (check (not (find 'dreyeck/work/defederation-planning::!simulate-fork
                       (first (dreyeck/shop3:plans-of continued)) :key #'first)))
      (check (find 'dreyeck/work/local-only-resolution::!use-modeled-page
                   (first (dreyeck/shop3:plans-of resolved)) :key #'first))
      (dolist (r (list plan continued resolved))
        (check (eq :plan-only (dreyeck/shop3:execution-mode-of r)))
        (check (= (length (dreyeck/shop3:plans-of r)) (length (dreyeck/shop3:plan-trees-of r))
                  (length (dreyeck/shop3:final-states-of r)))))
      (check (null (hb:find-page site *fixture-slug*)))
      (check (equalp source-bytes (local::%read-octets (merge-pathnames relative root)))))
    ;; No runtime S2 writer or destination observer is hidden in the acquisition adapter.
    (check (equalp source-bytes (local::%read-octets
                               (local:page-source-pathname (acquisition-local-source result)))))))

(defun test-loopback (parent &optional redirect)
  ;; Actual Drakma/HTTP fixture; no proxy, public address, persistent service or agent.
  (let* ((listener (usocket:socket-listen "127.0.0.1" 0 :reuse-address t
                                         :element-type '(unsigned-byte 8)))
         (port (usocket:get-local-port listener)) (requests nil) (failure nil)
         (thread
           (bt:make-thread
            (lambda ()
              (handler-case
                  (sb-ext:with-timeout 10
                    (dotimes (i (if redirect 1 2))
                      (let ((client (usocket:socket-accept listener :element-type '(unsigned-byte 8))))
                        (unwind-protect
                             (let ((stream (usocket:socket-stream client)) (header ""))
                               (loop for b = (read-byte stream) do
                                 (setf header (concatenate 'string header (string (code-char b))))
                                 (when (search (format nil "~C~C~C~C" #\Return #\Newline #\Return #\Newline) header)
                                   (return))
                                 (when (> (length header) 8192) (error "Fixture request too large")))
                               (push header requests)
                               (let ((body (if (= i 0) (fixture-sitemap) (fixture-page))))
                                 (write-sequence
                                  (fixture-bytes
                                   (format nil "HTTP/1.1 ~A~C~CContent-Type: application/json~C~CLocation: /must-not-fetch~C~CContent-Length: ~D~C~CConnection: close~C~C~C~C"
                                           (if redirect "302 Found" "200 OK")
                                           #\Return #\Newline #\Return #\Newline #\Return #\Newline (length body)
                                           #\Return #\Newline #\Return #\Newline #\Return #\Newline)) stream)
                                 (write-sequence body stream) (finish-output stream)))
                          (usocket:socket-close client)))))
                (error (c) (setf failure c)))) :name "S1 controlled HTTP fixture")))
    (unwind-protect
         (let* ((drakma:*default-http-proxy* nil)
                (result (acquire-source (format nil "127.0.0.1:~D" port) *fixture-slug* "http"
                                        (merge-pathnames (if redirect "http-redirect/" "http/") parent)
                                        :allow-network t :timeout 5)))
           (bt:join-thread thread)
           (check (null failure))
           (when redirect
             (refusal-check result :unexpected-http-status :sitemap)
             (check (= 1 (length requests)))
             (check (eql 302 (response-status (acquisition-sitemap-response result))))
             (return-from test-loopback t))
           (check (eq :acquired (acquisition-status result)))
           (check (= 2 (length requests)))
           (check (every (lambda (r) (search "Accept-Encoding: identity" r :test #'char-equal)) requests))
           (check (search "GET /system/sitemap.json HTTP/1.1" (second requests)))
           (check (search (concatenate 'string "GET /" *fixture-slug* ".json HTTP/1.1") (first requests)))
           (check (eq :http (response-kind (acquisition-page-response result))))
           (check (equalp (fixture-page) (response-octets (acquisition-page-response result))))
           (check (typep (verify-snapshot result) 'local:local-fedwiki-page-source)))
      (usocket:socket-close listener)
      (when (bt:thread-alive-p thread) (bt:destroy-thread thread)))))

(defun run-tests ()
  (setf *checks* 0)
  (let* ((parent (uiop:ensure-directory-pathname
                  (string-trim '(#\Newline #\Return)
                    (uiop:run-program '("mktemp" "-d" "/tmp/hyperdoc-s1-XXXXXX") :output :string))))
         (catalog (copy-list (hb:hyperbooks-of hb:*catalog*))))
    (ensure-directories-exist parent)
    (unwind-protect
         (progn
           (multiple-value-bind (result urls) (capture-fixture (merge-pathnames "success/" parent))
             (check (eq :acquired (acquisition-status result)))
             (check (equal urls (list "http://fixture.invalid/system/sitemap.json"
                                      "http://fixture.invalid/safe-and-familiar-welcome.json")))
             (check (eq :fixture (response-kind (acquisition-page-response result))))
             (check (eq (acquisition-entry result) (aref (acquisition-sitemap result) 0)))
             (check (equal "ready" (gethash "state" (acquisition-sitemap-state result))))
             (check (equalp (acquisition-sitemap result) (gethash "sitemap" (acquisition-sitemap-state result))))
             (check (not (eq (acquisition-sitemap result) (gethash "sitemap" (acquisition-sitemap-state result)))))
             (format t "~&S1-SITEMAP-PROVENANCE-PASS: fixture response, retained sitemap, coherent snapshot and selected native entry.~%")
             (test-loopback parent)
             (test-loopback parent t)
             (format t "~&S1-HTTP-ACQUISITION-PASS: two actual loopback HTTP requests; HTTP preserved; binary response evidence, no Ward request.~%")
             (let ((source (verify-snapshot result)) (response (acquisition-page-response result)))
               (check (not (eq source (acquisition-local-source result))))
               (check (equal (response-sha256 response) (sha256 (fixture-page)))))
             (test-offline result)
             (format t "~&S1-OFFLINE-INSPECTION-PASS: native objects/EQ references, unknown fields preserved, zero network/context/plugin/render calls; positive control observed.~%")
             (test-s2-boundary result parent)
             (format t "~&S1-S2-BOUNDARY-PASS: separate destination observation, existing evidence reader and native plan-only fork; store still absent.~%")
             (fixture-write (local:page-source-pathname (acquisition-local-source result)) (fixture-bytes "{}"))
             (check (handler-case (progn (verify-snapshot result) nil)
                      (source-acquisition-refusal () t)))
             (fixture-write (local:page-source-pathname (acquisition-local-source result)) (fixture-page))
             (fixture-write (merge-pathnames "sitemap.json" (acquisition-root result)) (fixture-bytes "[]"))
             (check (handler-case (progn (verify-snapshot result) nil)
                      (source-acquisition-refusal (c) (eq :sitemap-snapshot-mismatch (refusal-reason c)))))
             (format t "~&S1-SNAPSHOT-INTEGRITY-PASS: independent disk reads, exact original octets/digest, later tampering refused.~%"))
           (loop for (label reason options) in
             `((redirect :unexpected-http-status (:status 302))
               (status :unexpected-http-status (:status 503))
               (type :unsupported-content-type (:type "text/html"))
               (charset :unsupported-content-type (:type "application/json; charset=latin-1"))
               (encoding :unsupported-content-encoding (:encoding "gzip"))
               (uri :response-url-mismatch (:effective "https://fixture.invalid/system/sitemap.json"))
               (length :content-length-mismatch (:length-header "1"))
               (duplicate :duplicate-sitemap-slug (:sitemap ,(fixture-bytes
                 (format nil "[{\"slug\":\"~A\",\"title\":\"A\"},{\"slug\":\"~A\",\"title\":\"A\"}]" *fixture-slug* *fixture-slug*))))
               (mismatch :sitemap-target-mismatch (:sitemap ,(fixture-sitemap "Different")))
               (missing :sitemap-target-mismatch (:sitemap ,(fixture-bytes "[]")))
               (bad-json :invalid-json (:sitemap ,(fixture-bytes "{")))
               (trailing :invalid-json (:sitemap ,(fixture-bytes "[] false")))
               (utf8 :invalid-utf-8 (:sitemap ,(make-array 1 :element-type '(unsigned-byte 8) :initial-element 255)))
               (page-title :page-title-mismatch (:page ,(fixture-bytes "{\"title\":\"Other\",\"story\":[],\"journal\":[]}")))
               (page-array :invalid-page-json (:page ,(fixture-bytes "{\"title\":\"Safe and Familiar Welcome\",\"story\":false,\"journal\":[]}")))
               (interrupted :operation-error (:broken t)))
             do (let ((result (apply #'capture-fixture (merge-pathnames (format nil "~(~A~)/" label) parent) options)))
                  (refusal-check result reason)
                  (when (eq label 'interrupted)
                    (check (= 9 (length (response-octets (acquisition-page-response result)))))
                    (check (not (response-complete-p (acquisition-page-response result)))))
                  (when (member label '(bad-json trailing utf8 page-array))
                    (check (typep (refusal-cause (acquisition-condition result)) 'condition)))
                  (format t "~&S1 refusal ~A PASS: ~S at ~S~%" label reason (acquisition-stage result))))
           (multiple-value-bind (transport) (fixture-transport)
             (refusal-check (acquire-source "fixture.invalid" *fixture-slug* "http"
                                            (merge-pathnames "limit/" parent) :transport transport :max-bytes 5)
                            :body-limit)
             (refusal-check (acquire-source "fixture.invalid" *fixture-slug* "http" parent :transport transport)
                            :capture-root-exists))
           (multiple-value-bind (transport urls streams) (fixture-transport :broken :timeout)
             (declare (ignore urls))
             (refusal-check
              (acquire-source "fixture.invalid" *fixture-slug* "http"
                              (merge-pathnames "timeout/" parent) :transport transport :timeout 0.05)
              :timeout :page)
             (check (every #'fixture-closed-p (funcall streams))))
           (refusal-check (acquire-source "fixture.invalid" *fixture-slug* "http"
                                          (merge-pathnames "disabled/" parent)) :network-not-authorized :inputs)
           (refusal-check (acquire-source "fixture.invalid" "../escape" "http" parent)
                          :invalid-inputs :inputs)
           (refusal-check (acquire-source "fixture.invalid" *fixture-slug* "http"
                           (merge-pathnames "transport/" parent)
                           :transport (lambda (url) (declare (ignore url)) (error "Fixture transport unavailable")))
                          :operation-error :sitemap)
           (check (equal catalog (hb:hyperbooks-of hb:*catalog*)))
           (format t "~&S1-REFUSALS-PASS: invalid responses, interrupted reads/closure, limits, identity, no-network default and unchanged Catalog.~%")
           (format t "~&S1-ALL-PASS: ~D assertions; controlled fixtures only; no observed Ward source or development submission.~%" *checks*))
      (uiop:delete-directory-tree parent :validate t :if-does-not-exist :ignore))))
