(defpackage #:dreyeck/work/trails-rendered-reading/tests
  (:use #:cl)
  (:local-nicknames (#:reading #:dreyeck/work/trails-rendered-reading)
                    (#:views #:html-inspector-views))
  (:export #:run-tests))
(in-package #:dreyeck/work/trails-rendered-reading/tests)

(defun render-page (book title)
  (let* ((page (hyperbook:find-page book title :signal-error? t))
         (view (find "Content" (views:all-views page)
                     :key #'views:view-title :test #'equal)))
    (assert view)
    (views:view-html view)
    (assert (notany (lambda (reference) (typep (cdr reference) 'condition))
                    (views:view-references view)))
    (values page view)))

(defun items-view (object)
  (let ((view (find "Items" (views:all-views object)
                    :key #'views:view-title :test #'equal)))
    (assert view () "No navigable Items view for ~S" object)
    (views:view-html view)
    view))

(defun check-inspector-child (parent child)
  "Rendering the parent's Items view must expose the actual child object."
  (assert (member child (mapcar #'cdr (views:view-references (items-view parent)))
                  :test #'eq)))

(defun check-solo-batch ()
  (let* ((batch (reading:solo-batch))
         (sources (gethash "sources" batch))
         (source (aref sources 0))
         (aspects (gethash "aspects" source))
         (provenance (reading:solo-batch-provenance))
         (capture (gethash :batch-capture provenance)))
    ;; Pin the observed bytes, rather than regenerating a source-derived fixture.
    (assert (equal (getf capture :sha256)
                   (ironclad:byte-array-to-hex-string
                    (ironclad:digest-file
                     :sha256 (asdf:system-relative-pathname
                              "dreyeck/work/reading" (getf capture :file))))))
    (assert (= 3 (hash-table-count batch)))
    (assert (equal "batch" (gethash "type" batch)))
    (assert (equal (getf capture :page-key) (gethash "pageKey" batch)))
    (assert (and (vectorp sources) (= 1 (length sources))))
    (assert (equal "Trails Rendered" (gethash "source" source)))
    (assert (and (vectorp aspects) (= 2 (length aspects))))
    (assert (equal '("trail 1" "trail 2")
                   (map 'list (lambda (aspect) (gethash "name" aspect)) aspects)))
    (check-inspector-child batch sources)
    (check-inspector-child sources source)
    (check-inspector-child source aspects)
    (loop for aspect across aspects
          for names in (list (list (format nil "Susan~%Kare") (format nil "John~%Dewey")
                                  (format nil "Reflective~%Practice"))
                            (list (format nil "Jean~%Lave") (format nil "Dorothy~%Smith")
                                  (format nil "Reflective~%Practice")))
          do (assert (= 2 (hash-table-count aspect)))
             ;; Solo adds label after receiving the message; it must be absent here.
             (assert (not (nth-value 1 (gethash "label" aspect))))
             (check-inspector-child aspects aspect)
             (check-inspector-child aspect (gethash "name" aspect))
             (let* ((graph (gethash "graph" aspect))
                    (nodes (gethash "nodes" graph))
                    (rels (gethash "rels" graph)))
               (assert (and (vectorp nodes) (= 3 (length nodes))))
               (assert (and (vectorp rels) (= 2 (length rels))))
               (check-inspector-child aspect graph)
               (check-inspector-child graph nodes)
               (check-inspector-child graph rels)
               (loop for node across nodes for name in names
                     do (assert (equal name (gethash "name" (gethash "props" node))))
                        (assert (find #\Newline (gethash "name" (gethash "props" node))))
                        (assert (vectorp (gethash "in" node)))
                        (assert (vectorp (gethash "out" node)))
                        (check-inspector-child nodes node)
                        (check-inspector-child node (gethash "props" node)))
               (assert (equalp #() (gethash "in" (aref nodes 0))))
               (assert (equalp #(0) (gethash "out" (aref nodes 0))))
               (assert (equalp #(0) (gethash "in" (aref nodes 1))))
               (assert (equalp #(1) (gethash "out" (aref nodes 1))))
               (assert (equalp #(1) (gethash "in" (aref nodes 2))))
               (assert (equalp #() (gethash "out" (aref nodes 2))))
               (loop for rel across rels for from from 0
                     do (assert (equal "Trail" (gethash "type" rel)))
                        (assert (= from (gethash "from" rel)))
                        (assert (= (1+ from) (gethash "to" rel)))
                        (assert (hash-table-p (gethash "props" rel)))
                        (assert (zerop (hash-table-count (gethash "props" rel))))
                        (check-inspector-child rels rel))))
    (assert (eq :debugger-breakpoint (getf capture :method)))
    (assert (getf capture :event-source-is-opener))
    (assert (= 47 (getf capture :line)))
    ;; Each inspection is independent, even at nested mutable fields.
    (let ((fresh (reading:solo-batch)))
      (assert (equalp batch fresh))
      (setf (gethash "name" (aref aspects 0)) "mutated")
      (setf (gethash "props" (aref (gethash "rels" (gethash "graph" (aref aspects 1))) 0)) nil)
      (assert (equalp fresh (reading:solo-batch))))
    ;; The captured representation cannot depend on the caller's JSON defaults.
    (let ((shasht:*read-default-object-format* :plist)
          (shasht:*read-default-array-format* :list))
      (assert (hash-table-p (reading:solo-batch)))
      (assert (vectorp (gethash "sources" (reading:solo-batch)))))))

(defun check-solo-beam ()
  (let* ((batch (reading:solo-batch))
         (source (aref (gethash "sources" batch) 0))
         (aspects (gethash "aspects" source))
         (beam (reading:solo-beam))
         (provenance (reading:solo-batch-provenance))
         (capture (gethash :beam-capture provenance)))
    (assert (and (vectorp beam) (= 2 (length beam))))
    (assert (equal (getf capture :sha256)
                   (ironclad:byte-array-to-hex-string
                    (ironclad:digest-file
                     :sha256 (asdf:system-relative-pathname
                              "dreyeck/work/reading" (getf capture :file))))))
    (loop for output across beam for input across aspects
          for expected-name in '("trail 1" "trail 2")
          do (assert (= 3 (hash-table-count output)))
             (assert (equal expected-name (gethash "name" output)))
             (assert (equal "Trails Rendered" (gethash "label" output)))
             (assert (equal (gethash "source" source) (gethash "label" output)))
             (assert (not (nth-value 1 (gethash "source" output))))
             (assert (not (nth-value 1 (gethash "label" input))))
             ;; Only label was added; compare every other key/value recursively.
             (let ((without-label (alexandria:copy-hash-table output)))
               (remhash "label" without-label)
               (assert (dreyeck/work/reading::%json-equal input without-label)))
             (check-inspector-child beam output)
             (check-inspector-child output (gethash "label" output))
             (let* ((graph (gethash "graph" output))
                    (nodes (gethash "nodes" graph))
                    (rels (gethash "rels" graph)))
               (assert (= 3 (length nodes)))
               (assert (= 2 (length rels)))
               (check-inspector-child output graph)
               (check-inspector-child graph nodes)
               (check-inspector-child graph rels)
               (loop for node across nodes
                     do (check-inspector-child nodes node)
                        (check-inspector-child node (gethash "props" node)))
               (loop for rel across rels for from from 0
                     do (assert (equal "Trail" (gethash "type" rel)))
                        (assert (= from (gethash "from" rel)))
                        (assert (= (1+ from) (gethash "to" rel)))
                        (check-inspector-child rels rel))))
    ;; A JSON snapshot preserves values, not cross-snapshot runtime aliases.
    (assert (not (eq (aref beam 0) (aref aspects 0))))
    (let ((fresh (reading:solo-beam)))
      (setf (gethash "label" (aref beam 0)) "mutated")
      (setf (aref beam 1) nil)
      (assert (dreyeck/work/reading::%json-equal fresh (reading:solo-beam)))
      (assert (not (nth-value 1 (gethash "label" (aref aspects 0))))))))

(defun check-result-and-boundary ()
  (let* ((provenance (reading:solo-batch-provenance))
         (result (reading:public-result))
         (summary (reading:interpretation-path))
         (boundary (reading:public-source-boundary)))
    (assert (hash-table-p provenance))
    (check-inspector-child provenance (gethash :batch-capture provenance))
    ;; All domain readings reference one canonical witness object.
    (dolist (object (list result summary boundary))
      (assert (eq provenance (getf object :provenance))))
    (assert (eq :observed (getf result :status)))
    (assert (equal '(("2" "Reflective Practice") ("0" "Susan Kare") ("1" "John Dewey")
                     ("3" "Jean Lave") ("4" "Dorothy Smith"))
                   (getf result :nodes)))
    (assert (equal '(("0->1" "Trail") ("1->2" "Trail") ("3->4" "Trail") ("4->2" "Trail"))
                   (getf result :edges)))
    ;; Both incoming paths converge on the same rendered node, not two labels.
    (assert (= 1 (count "Reflective Practice" (getf result :nodes) :key #'second :test #'equal)))
    (assert (eq :derived (getf summary :status)))
    (assert (= 2 (getf summary :aspects)))
    (assert (equal '("trail 1" "trail 2")
                   (mapcar (lambda (trail) (getf trail :name)) (getf summary :trails))))
    (assert (equal '(("Susan Kare" "John Dewey" "Reflective Practice")
                     ("Jean Lave" "Dorothy Smith" "Reflective Practice"))
                   (mapcar (lambda (trail) (getf trail :nodes)) (getf summary :trails))))
    (assert (equal '(2 2) (mapcar (lambda (trail) (getf trail :trail-relations)) (getf summary :trails))))
    (assert (equal '("Reflective Practice") (getf summary :shared-node-names)))
    (assert (= 5 (length (getf result :nodes)) (getf summary :rendered-nodes)))
    (assert (= 4 (length (getf result :edges)) (getf summary :rendered-trail-relations)))
    (assert (eq :inferred (getf boundary :status)))
    (assert (search "not found in the searched public sources" (getf boundary :finding)))
    (let ((search (getf boundary :searched-public-sources)))
      (dolist (plugin '(:mech :solo))
        (assert (getf (getf search plugin) :scope))
        (assert (zerop (getf (getf search plugin) :hits)))))
    (assert (getf (getf boundary :report) :url))
    (assert (getf boundary :falsified-by))))

(defun check-federated-context ()
  (let* ((context (reading::context-data (reading:federated-context)))
         (observed (gethash "observed" context))
         (pages (gethash "pages" observed))
         (links (gethash "links" observed))
         (fork (aref (gethash "forks" observed) 0))
         (change (gethash "relation-type-change" observed))
         (derived (gethash "derived" context))
         (timeline (gethash "temporal-order" derived)))
    (assert (= 9 (length pages)))
    (loop for page across pages
          for (site title slug) in '(("ward.voices.ustawi.wiki" "Trails Rendered" "trails-rendered")
                                     ("thompson.voices.ustawi.wiki" "How We Think" "how-we-think")
                                     ("thompson.voices.ustawi.wiki" "As We May Think" "as-we-may-think")
                                     ("jan.voices.ustawi.wiki" "Alan Cooper" "alan-cooper")
                                     ("jan.voices.ustawi.wiki" "Ethnomethodology" "ethnomethodology")
                                     ("jan.voices.ustawi.wiki" "John Dewey" "john-dewey")
                                     ("jan.voices.ustawi.wiki" "How We Think" "how-we-think")
                                     ("thompson.fed.wiki" "How We Think" "how-we-think")
                                     ("thompson.forage.ustawi.wiki" "As We May Think" "as-we-may-think"))
          do (assert (equal site (gethash "site" page)))
             (assert (equal title (gethash "title" page)))
             (assert (equal slug (gethash "slug" page)))
             (assert (equal (format nil "http://~A/~A" site slug) (gethash "url" page)))
             (assert (equal (format nil "http://~A/~A.json" site slug) (gethash "json-url" page)))
             (check-inspector-child pages page)
             (check-inspector-child page (gethash "items" page))
             (check-inspector-child page (gethash "journal" page)))
    (assert (equal '(("thompson-think" "John Dewey") ("thompson-think" "Reflective Practice")
                     ("thompson-think" "As We May Think") ("jan-cooper" "Susan Kare")
                     ("jan-ethnomethodology" "Dorothy Smith") ("jan-dewey" "How We Think"))
                   (map 'list (lambda (link) (list (gethash "from" link) (gethash "target" link))) links)))
    ;; Every graph link has a corresponding observed wiki-link item. Dated links
    ;; must also match a selected journal action, not an inherited sitemap date.
    (loop for link across links
          for page = (find (gethash "from" link) pages :key (lambda (page) (gethash "id" page)) :test #'equal)
          for item = (find (gethash "item" link) (gethash "items" page)
                           :key (lambda (item) (gethash "id" item)) :test #'equal)
          do (assert (search (format nil "[[~A]]" (gethash "target" link)) (gethash "text" item)))
             (when (gethash "date" link)
               (let ((action (find (gethash "date" link) (gethash "journal" page)
                                   :key (lambda (action) (gethash "date" action)))))
                 (assert action)
                 (assert (equal (gethash "item" link) (gethash "id" action)))
                 (assert (equal (gethash "at" link) (gethash "at" action))))))
    (let ((attribution (aref links 5))
          (action (aref (gethash "journal" (aref pages 6)) 0)))
      (assert (equal "via Thompson" (gethash "attribution" attribution)))
      (assert (equal "thompson-think" (gethash "credited-page" attribution)))
      (assert (equal "[[How We Think]] via Thompson" (gethash "text" (aref (gethash "items" (aref pages 5)) 0))))
      (assert (equal "2026-10-01T18:03:51.968Z" (gethash "at" attribution)))
      (assert (equal "2026-10-01T18:03:05.302Z" (gethash "at" fork)))
      (assert (equal "thompson-think" (gethash "from" fork)))
      (assert (equal "jan-think" (gethash "to" fork)))
      (assert (equal "thompson.voices.ustawi.wiki" (gethash "source-site" fork)))
      (assert (equal (gethash "source-site" fork) (gethash "site" action)))
      (assert (equal "fork" (gethash "type" action)))
      (assert (= (gethash "date" fork) (gethash "date" action)))
      (assert (< (gethash "date" change) (gethash "date" fork) (gethash "date" attribution))))
    (assert (equal "2026-10-01T17:13:54.907Z" (gethash "at" (aref links 2))))
    (assert (equal "2026-10-01T17:18:24.009Z" (gethash "at" change)))
    (assert (equal "" (gethash "before" change)))
    (assert (equal "Trail" (gethash "after" change)))
    (assert (equal "84da00fa76850971" (gethash "item" change)))
    (assert (equal '(("Susan Kare" "John Dewey" "Reflective Practice")
                     ("Jean Lave" "Dorothy Smith" "Reflective Practice"))
                   (map 'list (lambda (trail) (coerce (gethash "nodes" trail) 'list))
                        (gethash "trails" observed))))
    (assert (equal (mapcar (lambda (trail) (getf trail :nodes)) (getf (reading:interpretation-path) :trails))
                   (map 'list (lambda (trail) (coerce (gethash "nodes" trail) 'list))
                        (gethash "trails" observed))))
    (loop for trail across (gethash "trails" observed)
          do (assert (equal "Trail" (gethash "relation-type" trail))))
    (let* ((memex (aref pages 2))
           (item (aref (gethash "items" memex) 0)))
      (assert (equal "38a6eb8423fa6f7c" (gethash "id" item)))
      (assert (search "sharing" (gethash "content-summary" item)))
      (assert (equal "2020-04-23T17:37:53.792Z" (gethash "at" (gethash "last-text-edit" item)))))
    (assert (= 6 (length timeline)))
    (assert (apply #'< (map 'list (lambda (event) (gethash "date" event)) timeline)))
    (assert (eq change (aref timeline 3)))
    (assert (eq fork (aref timeline 4)))
    (assert (eq (aref links 5) (aref timeline 5)))
    (assert (eq :true (gethash "jan-fork-after-ward-trail-change" derived)))
    (assert (eq :true (gethash "jan-attribution-after-ward-trail-change" derived)))
    (assert (equalp #("Susan Kare" "John Dewey" "Reflective Practice" "Dorothy Smith")
                    (gethash "shared-concepts" derived)))
    (assert (equal "That Jan or Thompson caused Ward's change to relation type \"Trail\"."
                   (gethash "not-established" context)))
    (assert (search "concurrently connected and exchanged" (gethash "falsifiable-claim" context)))
    (assert (gethash "falsified-by" context))
    (check-inspector-child context observed)
    (check-inspector-child observed pages)
    (check-inspector-child observed links)
    (check-inspector-child context derived)
    (check-inspector-child derived timeline)
    (let ((fresh (reading::context-data (reading:federated-context))))
      (setf (gethash "title" (aref pages 0)) "changed")
      (assert (dreyeck/work/reading::%json-equal fresh (reading::context-data (reading:federated-context))))))
  (format t "~&FEDERATED-CONTEXT-PASS: seven named pages, observed links/fork attribution, older Memex trails, Ward trail nodes, derived ordering after Trail change and inspector navigation.~%"))

(defun check-page-contract ()
  (let ((book (hyperbook:find-hyperbook "dreyeck/work/reading" :signal-error? t)))
    (multiple-value-bind (landing view) (render-page book "Work Breakdown")
      (declare (ignore landing))
      (assert (member (render-page book "Trails Rendered public reproduction")
                      (mapcar #'cdr (views:view-references view)) :test #'eq)))
    (multiple-value-bind (page view) (render-page book "Trails Rendered public reproduction")
      (let* ((html (views:view-html view))
             (references (mapcar #'cdr (views:view-references view)))
             (dom (plump:parse (uiop:read-file-string (hyperdoc:file-of page))))
             (expressions (remove nil (mapcar (lambda (node) (plump:attribute node "expr"))
                                              (plump:get-elements-by-tag-name dom "a")))))
        ;; Each reader-facing object link actually evaluates to an inspector value.
        (dolist (function '(reading:solo-batch reading:solo-beam reading:solo-batch-provenance
                            reading:public-result reading:interpretation-path reading:public-source-boundary))
          (assert (member (funcall function) references :test #'equalp)))
        (assert (find-if (lambda (object) (typep object 'reading::federated-context)) references))
        (assert (search "Inspect the SOLO batch" html))
        (assert (search "Inspect the SOLO beam" html))
        (assert (search "Inspect the federated context" html))
        (dolist (label '("Observed:" "Derived:" "Not established:"))
          (assert (search label html)))
        (assert (search "PUBLIC REPRODUCTION ENDS HERE." html))
        (assert (equal '("Question" "Observed path" "Inspect" "Result" "Boundary" "Falsification")
                       (mapcar #'plump:text (plump:get-elements-by-tag-name dom "h2"))))
        (assert (= 7 (length expressions)))
        (assert (null (plump:get-elements-by-tag-name dom "source-of-function")))
        (let ((rows (rest (plump:get-elements-by-tag-name dom "tr"))))
          (assert (= 5 (length rows)))
          (dolist (row rows)
            (let ((cells (plump:get-elements-by-tag-name row "td")))
              (assert (= 2 (length cells)))
              (assert (every (lambda (cell) (plusp (length (plump:text cell)))) cells))))))
      ;; Removed work-session readings are neither exported nor page dependencies.
      (dolist (name '("PROVENANCE-EVIDENCE" "INITIAL-STATE" "INTEGRATION-DECISION"
                      "RUNTIME-VERIFICATION" "PROVENANCE-CHAIN" "OPERATIONS-RECORD"
                      "COMMIT-RECORD" "INTEGRATION-RECORD" "EVIDENCE-REFS"
                      "CODEBERG-FOLLOW-UP" "SOLO-BEAM-PROVENANCE"))
        (assert (null (find-symbol name :dreyeck/work/trails-rendered-reading)))))))

(defun observed-edge (state title)
  (find title (gethash "edges" state) :key (lambda (edge) (gethash "title" edge)) :test #'equal))

(defun check-hoverbold ()
  (let* ((observation (reading:hoverbold-observation))
         (provenance (reading:solo-batch-provenance))
         (capture (gethash :hoverbold-capture provenance))
         (source (gethash "source-function" observation))
         (installation (gethash "installation" source))
         (solo (getf (gethash :public-plugins provenance) :solo))
         (before (gethash "before-state" observation))
         (hover (gethash "hover-state" observation))
         (after (gethash "after-state" observation)))
    (assert (equal (getf capture :sha256)
                   (ironclad:byte-array-to-hex-string
                    (ironclad:digest-file :sha256
                     (asdf:system-relative-pathname "dreyeck/work/reading" (getf capture :file))))))
    (assert (equal (getf solo :revision) (gethash "revision" source)))
    (assert (equal (getf solo :sha256) (gethash "servedDialogSha256" source)))
    (assert (equal (getf solo :version) (gethash "version" source)))
    (assert (equalp #(450 485) (gethash "range" source)))
    (assert (= 451 (gethash "line" installation)))
    (assert (= 200 (gethash "callerLine" installation)))
    (assert (equal "target" (gethash "div" installation)))
    (assert (equal "both" (gethash "select" installation)))
    (assert (= 5 (gethash "nodeCount" installation)))
    (assert (= 4 (gethash "edgeCount" installation)))
    (assert (equal "1" (gethash "node-title" observation)))
    (assert (equal "node3" (gethash "id" (gethash "hovered-node" observation))))
    (assert (equal "John Dewey" (gethash "label" (gethash "hovered-node" observation))))
    (loop for key in '("incoming-edges" "outgoing-edges" "unrelated-edges")
          for titles in '(("0->1") ("1->2") ("3->4" "4->2"))
          for entries = (gethash key observation)
          do (assert (equal titles (map 'list (lambda (edge) (gethash "title" edge)) entries)))
             (check-inspector-child observation entries)
             (loop for edge across entries do (check-inspector-child entries edge)))
    (assert (eq :false (gethash "pointerOnNode" before)))
    (assert (eq :true (gethash "pointerOnNode" hover)))
    (assert (eq :false (gethash "pointerOnNode" after)))
    (dolist (state (list before hover after))
      (assert (= 4 (length (gethash "edges" state))))
      (assert (dreyeck/work/reading::%json-equal (gethash "hoveredNode" before)
                                               (gethash "hoveredNode" state)))
      (check-inspector-child observation state)
      (check-inspector-child state (gethash "hoveredNode" state))
      (check-inspector-child state (gethash "edges" state)))
    (dolist (title '("0->1" "1->2" "3->4" "4->2"))
      (let* ((baseline (observed-edge before title))
             (incident (member title '("0->1" "1->2") :test #'equal)))
        (assert baseline)
        (assert (equal "Trail" (gethash "label" baseline)))
        (loop for state in (list before hover after)
              for expected-attribute in (if incident '(:null "3" "1") '(:null :null :null))
              for expected-width in (if incident '("1px" "3px" "1px") '("1px" "1px" "1px"))
              for edge = (observed-edge state title)
              do (assert (equal expected-attribute (gethash "strokeWidthAttribute" edge)))
                 (assert (equal expected-width (gethash "computedStrokeWidth" edge)))
                 ;; Only the edge group's width attribute changes. Child markup,
                 ;; geometry, labels and all other group attributes stay exact.
                 (let ((attributes (alexandria:copy-hash-table (gethash "attributes" edge))))
                   (remhash "stroke-width" attributes)
                   (assert (dreyeck/work/reading::%json-equal (gethash "attributes" baseline) attributes)))
                 (assert (equal (subseq (gethash "outerHTML" baseline) (position #\> (gethash "outerHTML" baseline)))
                                (subseq (gethash "outerHTML" edge) (position #\> (gethash "outerHTML" edge)))))
                 (loop for child across (gethash "descendants" edge)
                       do (assert (eq :null (gethash "strokeWidthAttribute" child)))
                          (assert (equal expected-width (gethash "computedStrokeWidth" child))))
                 (unless incident
                   (assert (dreyeck/work/reading::%json-equal baseline edge))))))
    (let ((calls (gethash "captured-calls" observation)))
      (assert (= 2 (length calls)))
      (loop for call across calls for event in '("mouseenter" "mouseleave")
            for width in '(3 1) for prior in '(:null "3")
            do (assert (equal event (gethash "type" call)))
               (assert (eq :true (gethash "trusted" call)))
               (assert (equal "1" (gethash "nodeTitle" call)))
               (assert (equal "both" (gethash "select" call)))
               (assert (= 479 (gethash "line" call)))
               (assert (= width (gethash "width" call)))
               (assert (equal '("1->2" "0->1")
                              (map 'list (lambda (write) (gethash "title" write)) (gethash "writes" call))))
               (loop for write across (gethash "writes" call)
                     do (assert (= 478 (gethash "line" write)))
                        (assert (= width (gethash "width" write)))
                        (assert (equal prior (gethash "before" write))))))
    (assert (eq :false (gethash "pluginSourceChanges" (gethash "capture" observation))))
    (assert (eq :true (gethash "breakpointsRemoved" (gethash "capture" observation))))
    (check-inspector-child observation source)
    (check-inspector-child source (gethash "source" source))
    (let ((fresh (reading:hoverbold-observation)))
      (setf (gethash "title" (gethash "hovered-node" observation)) "changed")
      (assert (dreyeck/work/reading::%json-equal fresh (reading:hoverbold-observation)))))
  (let* ((book (hyperbook:find-hyperbook "dreyeck/work/reading" :signal-error? t))
         (page (render-page book "Solo hoverbold")))
    (dolist (title '("Work Breakdown" "Trails Rendered public reproduction"))
      (multiple-value-bind (parent view) (render-page book title)
        (declare (ignore parent))
        (assert (member page (mapcar #'cdr (views:view-references view)) :test #'eq))))
    (multiple-value-bind (object view) (render-page book "Solo hoverbold")
      (declare (ignore object))
      (let ((references (mapcar #'cdr (views:view-references view)))
            (observation (reading:hoverbold-observation)))
        (assert (member observation references :test #'equalp))
        (dolist (key '("source-function" "hovered-node" "incoming-edges" "outgoing-edges"
                       "unrelated-edges" "before-state" "hover-state" "after-state"))
          (assert (member (gethash key observation) references :test #'equalp)))
        (assert (search "Counter-observation" (views:view-html view))))))
  (format t "~&SOLO-HOVERBOLD-PASS: observed source and installation, trusted enter/leave writes, incident edge widths, unchanged controls/child DOM/node, fresh snapshots, native inspector references and linked page.~%"))

(defun run-tests ()
  (check-solo-batch)
  (check-solo-beam)
  (check-result-and-boundary)
  (check-federated-context)
  (check-temporal-federation)
  (check-coordinated-context-workspace)
  (check-context-represented-objects)
  (check-attribution-negative-control)
  (check-attribution-mutation-control)
  (check-page-contract)
  (check-hoverbold)
  (format t "~&TRAILS-RENDERED-EXPERIMENT-PASS: exact inspectable batch/beam, expected trails and relations, observed 5/4 result, derived summary, shared provenance, scoped boundary, falsification and working page links.~%")
  t)
