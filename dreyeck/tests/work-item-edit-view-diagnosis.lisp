(defpackage #:dreyeck/work/item-edit-view-diagnosis/tests
  (:use #:cl)
  (:local-nicknames (#:d #:dreyeck/work/item-edit-view-diagnosis)
                    (#:work #:dreyeck/work/reading)
                    (#:tm #:dreyeck/topicmap) (#:v #:html-inspector-views)
                    (#:r #:dreyeck/work/trails-rendered-reading/tests))
  (:export #:run-tests))
(in-package #:dreyeck/work/item-edit-view-diagnosis/tests)

(defvar *checks* 0)
(defmacro check (form) `(progn (incf *checks*) (assert ,form)))
(defun view (object title) (r::following-view object title))
(defun refs (object title) (mapcar #'cdr (v:view-references (view object title))))
(defun refuses (thunk)
  (check (handler-case (progn (funcall thunk) nil) (d::diagnosis-source-error () t))))
(defun finding (diagnosis id)
  (or (find id (d:diagnosis-findings diagnosis) :key #'d:finding-id :test #'equal) (error "no finding ~A" id)))
(defun observation (diagnosis id)
  (or (find id (d:diagnosis-observations diagnosis) :key #'d:observation-id :test #'equal) (error "no observation ~A" id)))
(defun digest (path) (d::file-digest path))
(defun preview-image-state ()
  "What an activation of the preview system would change, read without causing it."
  (list (and (find-package d::+preview-package+) t)
        (let ((system (asdf:find-system d::+preview-system+ nil)))
          (and system (asdf:component-loaded-p system) t))
        (and (find-package d::+writer-package+) t)))
(defun all-views-of (object)
  (dolist (view (remove-if-not (lambda (view) (typep view 'v::html-view)) (v:all-views object)))
    (v:view-html view)
    (check (notany (lambda (reference) (typep (cdr reference) 'condition)) (v:view-references view)))))
(defun leaves (finding)
  "The observed findings FINDING finally rests on; itself, if it is observed."
  (if (eq :observed (d:finding-epistemic finding))
      (list finding)
      (remove-duplicates (mapcan #'leaves (copy-list (d:finding-basis finding))))))

(defun with-site-root-holding-retained-page (function)
  (let* ((root (uiop:ensure-directory-pathname
                (merge-pathnames (format nil "item-edit-view-diagnosis-~D/" (random 1000000000))
                                 (uiop:temporary-directory))))
         (path (dreyeck/fedwiki-assets:local-fedwiki-page-pathname root d::+slug+)))
    (ensure-directories-exist path)
    (uiop:copy-file (d::repo-file "dreyeck/work/ctm-page-evidence/ctm-and-tmdm-in-hyperdoc.json") path)
    (unwind-protect (funcall function root path)
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore))))

(defun fresh-image-report ()
  "Read the diagnosis in a new SBCL that loads dreyeck/work/reading and nothing else."
  (let* ((program (or (uiop:argv0) (first sb-ext:*posix-argv*)))
         (form "(let* ((package \"DREYECK/WORK/ITEM-EDIT-VIEW-DIAGNOSIS\")
                      (read (find-symbol \"READ-DIAGNOSIS\" package))
                      (findings (find-symbol \"DIAGNOSIS-FINDINGS\" package))
                      (id (find-symbol \"FINDING-ID\" package))
                      (diagnosis (funcall read :site-root #p\"/nonexistent-site-root/\"))
                      (parts (append (funcall findings diagnosis)
                                     (funcall (find-symbol \"DIAGNOSIS-OBSERVATIONS\" package) diagnosis)
                                     (funcall (find-symbol \"DIAGNOSIS-SOURCES\" package) diagnosis)
                                     (list diagnosis (funcall (find-symbol \"DIAGNOSIS-CLOSURE\" package) diagnosis)
                                           (funcall (find-symbol \"DIAGNOSIS-E3\" package) diagnosis)
                                           (funcall (find-symbol \"DIAGNOSIS-AVAILABILITY\" package) diagnosis)))))
                 (dolist (part parts)
                   (dolist (view (funcall (find-symbol \"ALL-VIEWS\" \"HTML-INSPECTOR-VIEWS\") part))
                     (when (typep view (find-symbol \"HTML-VIEW\" \"HTML-INSPECTOR-VIEWS\"))
                       (funcall (find-symbol \"VIEW-HTML\" \"HTML-INSPECTOR-VIEWS\") view))))
                 (format t \"~&FRESH-DIAGNOSIS ~S~%\"
                         (list (mapcar id (funcall findings diagnosis))
                               (and (find-package \"DREYECK/FEDWIKI-ITEM-EDIT-PREVIEW\") t)
                               (and (find-package \"DREYECK/FEDWIKI-PAGE-AUTHORING\") t)
                               (getf (funcall (find-symbol \"AVAILABILITY-LIVE-PAGE\" package)
                                              (funcall (find-symbol \"DIAGNOSIS-AVAILABILITY\" package) diagnosis))
                                     :state))))"))
    (multiple-value-bind (output error-output status)
        (uiop:run-program (list program "--noinform" "--non-interactive"
                                "--eval" "(require :asdf)"
                                "--eval" "(asdf:load-system \"dreyeck/work/reading\")"
                                "--eval" form)
                          :output :string :error-output :output :ignore-error-status t)
      (declare (ignore error-output))
      (let ((at (search "FRESH-DIAGNOSIS " output)))
        (unless (and (zerop status) at)
          (error "Fresh image failed (status ~S):~%~A" status output))
        (let ((*read-eval* nil) (*package* (find-package "COMMON-LISP-USER")))
          (read-from-string output t nil :start (+ at (length "FRESH-DIAGNOSIS "))))))))

(defun run-tests ()
  (let* ((*checks* 0)
         (state-before (preview-image-state))
         (files (mapcar #'d::repo-file
                        '("dreyeck/work/ctm-page-evidence/ctm-and-tmdm-in-hyperdoc.json"
                          "dreyeck/src/fedwiki-item-edit-preview.lisp" "dreyeck.asd"
                          "scripts/test-item-edit-preview-activation.mjs")))
         (digests (mapcar #'digest files))
         (diagnosis (d:read-diagnosis :site-root #p"/nonexistent-site-root/"))
         (closure (d:diagnosis-closure diagnosis)))
    ;; 1. Entry from the existing Work Topic; the other view there stays.
    (let* ((topic (tm:topicmap-projection-topic-by-id (work:work-projection) "ctm-plan-page-authoring"))
           (entry (view topic "E3 edit-view diagnosis"))
           (references (mapcar #'cdr (v:view-references entry)))
           (entered (find-if (lambda (object) (typep object 'd:diagnosis)) references)))
      (check (typep topic 'work:work-topic))
      (check entered)
      (check (equal (mapcar #'d:finding-id (d:diagnosis-findings entered))
                    (mapcar #'d:finding-id (d:diagnosis-findings diagnosis))))
      (check (v:all-views topic))
      (check (find "Conversation sources" (v:all-views topic) :key #'v:view-title :test #'equal))
      (check (null (find "E3 edit-view diagnosis" (v:all-views (tm:topicmap-projection-topic-by-id (work:work-projection) "planning"))
                         :key #'v:view-title :test #'equal))))
    ;; 2. The five classes occur, and the diagnosis reaches every finding and every part.
    (dolist (class d::+epistemic-classes+)
      (check (find class (d:diagnosis-findings diagnosis) :key #'d:finding-epistemic)))
    (let ((by-class (refs diagnosis "Findings by how they are known")))
      (dolist (finding (d:diagnosis-findings diagnosis))
        (check (member finding by-class :test #'eq))))
    ;; The main view: question, explanation, evidence, falsification, next observation, in that order,
    ;; every essential statement leading to its evidence, and no finding identity as primary text.
    (let* ((html (v:view-html (view diagnosis "Diagnosis")))
           (references (refs diagnosis "Diagnosis"))
           (headings '("Question" "Explanation (provisional)" "Evidence" "Falsification" "What we do not know yet" "Next observation"))
           (positions (mapcar (lambda (heading) (search (format nil ">~A<" heading) html)) headings)))
      (check (every #'identity positions))
      (check (apply #'< positions))
      (check (search "Why was E3's Edit tab missing?" html))
      (check (search "Provisional for the original browser observation" html))
      (check (search "is not established" html))
      (check (search "not run in this session" html))
      (check (search "Prediction:" html))
      (check (search "A preview writes nothing" html))
      (dolist (finding (d:diagnosis-findings diagnosis))
        (check (null (search (d:finding-id finding) html))))
      (flet ((reaches (object) (check (member object references :test #'eq))))
        (dolist (id '("derived-preview-not-in-catalog-closure" "inferred-edit-view-absent-because-system-not-loaded"
                      "unresolved-screenshot-image" "unresolved-warning-meaning"
                      "unresolved-original-transcripts" "unresolved-browser-check"))
          (reaches (finding diagnosis id)))
        (dolist (id '("before-1" "before-2" "before-3" "after-1" "load" "load-warnings"))
          (reaches (observation diagnosis id)))
        (dolist (id '("src-preview-system" "src-catalog-application" "src-defview"
                      "src-activation-default" "src-activation-activated"))
          (reaches (find id (d:diagnosis-sources diagnosis) :key #'d:source-id :test #'equal)))
        (reaches closure) (reaches (d:diagnosis-availability diagnosis)) (reaches (d:diagnosis-e3 diagnosis))
        (reaches diagnosis)))
    ;; The before/after table compares only measurements of one kind.
    (let* ((rows (d::comparison-rows (d:diagnosis-observations diagnosis)))
           (row (lambda (key) (or (assoc key rows) (error "no row ~S" key))))
           (ids (lambda (entries) (mapcar (lambda (entry) (d:observation-id (car entry))) entries))))
      (check (equal '("before-3") (funcall ids (second (funcall row :view-registered)))))
      (check (equal '("after-1") (funcall ids (third (funcall row :view-registered)))))
      (check (equal "No → Yes" (d::comparison-text (second (funcall row :view-registered)) (third (funcall row :view-registered)))))
      (check (equal '("before-1") (funcall ids (second (funcall row :writer-loaded)))))
      (check (equal '("after-1") (funcall ids (third (funcall row :writer-loaded)))))
      (check (null (third (funcall row :writer-package-present))))
      (check (equal '("before-3") (funcall ids (second (funcall row :writer-package-present)))))
      (check (null (third (funcall row :registered))))
      (check (search "nothing to compare" (d::comparison-text (second (funcall row :registered)) (third (funcall row :registered)))))
      (check (not (eq (funcall row :writer-loaded) (funcall row :writer-package-present))))
      (check (not (eq (funcall row :view-registered) (funcall row :registered))))
      (dolist (row rows)
        (check (every (lambda (entry) (eq :before (d:observation-phase (car entry)))) (second row)))
        (check (every (lambda (entry) (eq :after (d:observation-phase (car entry)))) (third row)))))
    (let ((subjects (refs diagnosis "Subjects"))
          (objects (d::availability-objects (d:diagnosis-availability diagnosis))))
      (check (member (asdf:find-system "dreyeck/catalog-application") subjects :test #'eq))
      (check (member (asdf:find-system "dreyeck/fedwiki-item-edit-preview") subjects :test #'eq))
      (check (member closure subjects :test #'eq))
      (check (member (d:diagnosis-e3 diagnosis) subjects :test #'eq))
      (check (member (d:diagnosis-availability diagnosis) subjects :test #'eq))
      (check (eq (getf objects :preview-system) (asdf:find-system "dreyeck/fedwiki-item-edit-preview")))
      (dolist (id '("src-preview-system" "src-defview"))
        (check (member (find id (d:diagnosis-sources diagnosis) :key #'d:source-id :test #'equal) subjects :test #'eq))))
    (dolist (part (append (d:diagnosis-findings diagnosis) (d:diagnosis-observations diagnosis)
                          (d:diagnosis-sources diagnosis)
                          (list diagnosis closure (d:diagnosis-e3 diagnosis) (d:diagnosis-availability diagnosis))))
      (all-views-of part))
    ;; 3. The two historical states apart: own observations, own phases, verbatim, never the present.
    (let ((before (finding diagnosis "observed-before-loading"))
          (after (finding diagnosis "observed-after-loading")))
      (check (equal '("before-1" "before-2" "before-3")
                    (mapcar #'d:observation-id (d:finding-evidence before))))
      (check (equal '("after-1") (mapcar #'d:observation-id (d:finding-evidence after))))
      (check (every (lambda (o) (eq :before (d:observation-phase o))) (d:finding-evidence before)))
      (check (every (lambda (o) (eq :after (d:observation-phase o))) (d:finding-evidence after)))
      (check (null (intersection (d:finding-evidence before) (d:finding-evidence after))))
      (dolist (o (append (d:finding-evidence before) (d:finding-evidence after)))
        (check (member o (refs (if (eq :before (d:observation-phase o)) before after) "Finding") :test #'eq))
        (check (eq :operator-supplied (getf (d:observation-provenance o) :kind)))
        (check (eq :not-supplied (getf (d:observation-provenance o) :observation-time)))
        (check (eq :not-supplied (getf (d:observation-provenance o) :expression)))
        (check (eq :not-supplied (getf (d:observation-provenance o) :remote-id)))
        (check (eq :none (getf (d:observation-provenance o) :evaluation-record)))
        (check (search (d:observation-text o) (v:view-html (view o "Observation")))))
      (check (null (d::%value (observation diagnosis "before-3") :view-registered)))
      (check (eq t (d::%value (observation diagnosis "after-1") :view-registered)))
      (check (null (d::%value (observation diagnosis "after-1") :writer-loaded)))
      (check (< (d:observation-sequence (observation diagnosis "before-3"))
                (d:observation-sequence (observation diagnosis "load"))
                (d:observation-sequence (observation diagnosis "after-1"))))
      ;; The present is another object with another origin.
      (check (not (typep (d:diagnosis-availability diagnosis) 'd:runtime-observation)))
      (check (not (member (d:diagnosis-availability diagnosis) (mapcan (lambda (f) (copy-list (d:finding-evidence f)))
                                                                       (d:diagnosis-findings diagnosis))))))
    ;; 4. Every derived or inferred statement leads back to observed findings and their evidence.
    (dolist (finding (d:diagnosis-findings diagnosis))
      (when (member (d:finding-epistemic finding) '(:derived :inferred))
        (check (d:finding-basis finding))
        (check (leaves finding))
        (dolist (basis (d:finding-basis finding))
          (check (member basis (refs finding "Finding") :test #'eq)))
        (dolist (leaf (leaves finding))
          (check (d:finding-evidence leaf)))))
    (let ((cause (finding diagnosis "inferred-edit-view-absent-because-system-not-loaded")))
      (check (equal '("derived-preview-not-in-catalog-closure" "derived-registration-changed-across-load"
                      "observed-view-definition" "observed-additive-loading" "observed-white-image-start")
                    (mapcar #'d:finding-id (d:finding-basis cause))))
      (check (subsetp (list (observation diagnosis "before-1") (observation diagnosis "after-1"))
                      (mapcan (lambda (f) (copy-list (d:finding-evidence f))) (leaves cause)))))
    ;; 5. The source findings point at the lines they name, and the closure does not hold the preview.
    (dolist (source (d:diagnosis-sources diagnosis))
      (let ((text (d::file-text (d::repo-file (d:source-file source)))))
        (check (= (d:source-line source) (1+ (count #\Newline text :end (search (d::source-marker source) text)))))
        (check (equal (d:source-digest source) (digest (d::repo-file (d:source-file source)))))))
    (check (not (d:closure-contains-p closure "dreyeck/fedwiki-item-edit-preview")))
    (check (not (d:closure-contains-p closure "dreyeck/fedwiki-page-edit-plan")))
    (check (not (d:closure-contains-p closure "dreyeck/fedwiki-page-authoring")))
    ;; Positive controls: the closure does reach what it should, so an exclusion is observable...
    (check (d:closure-contains-p closure "dreyeck/local-fedwiki-view"))
    (check (d:closure-contains-p closure "dreyeck/work/reading"))
    ;; ...and a wrongly claimed exclusion is refused.
    (refuses (lambda () (d:read-diagnosis :excluded "dreyeck/local-fedwiki-view")))
    (refuses (lambda () (d:read-diagnosis :excluded "dreyeck/work/reading")))
    (check (d:read-diagnosis :excluded "dreyeck/fedwiki-item-edit-preview"))
    ;; The same refusal on a system that depends on the preview.
    (check (d:closure-contains-p (d:system-load-closure "dreyeck/fedwiki-item-edit-preview/tests") "dreyeck/fedwiki-item-edit-preview"))
    ;; 6. Supplied observations that do not show the claimed change refuse the reading.
    (flet ((mutated (id text)
             (mapcar (lambda (spec) (if (equal id (getf spec :id)) (list* :id id :text text (loop for (k v) on spec by #'cddr
                                                                                              unless (member k '(:id :text)) append (list k v)))
                                        spec))
                     d:+operator-observations+)))
      (refuses (lambda () (d:read-diagnosis :operator-observations
                                            (mutated "after-1" "(:SYSTEM-LOADED T :VIEW-REGISTERED NIL :WRITER-LOADED NIL)"))))
      (refuses (lambda () (d:read-diagnosis :operator-observations
                                            (mutated "before-2" "(:REGISTERED T :METHODS NIL)"))))
      (refuses (lambda () (d:read-diagnosis :operator-observations
                                            (mutated "after-1" "(:SYSTEM-LOADED T :WRITER-LOADED NIL)"))))
      (check (d:read-diagnosis :operator-observations (mutated "load-warnings" "Other words."))))
    ;; Source that does not say what is claimed is refused.
    (let ((spec (copy-list (first d::+source-specs+))))
      (check (d::read-source-observation spec))
      (setf (getf spec :declares) '("dreyeck/local-fedwiki-view"))
      (refuses (lambda () (d::read-source-observation spec)))
      (setf spec (copy-list (first d::+source-specs+)) (getf spec :marker) "(defsystem \"dreyeck/no-such-system\"")
      (refuses (lambda () (d::read-source-observation spec)))
      (setf spec (copy-list (first d::+source-specs+)) (getf spec :marker) "(defsystem ")
      (refuses (lambda () (d::read-source-observation spec))))
    ;; Findings that stand on more than their class allows are refused.
    (flet ((with-finding (replacement)
             (make-instance 'd:diagnosis
                            :findings (cons replacement (remove (d:finding-id replacement) (d:diagnosis-findings diagnosis)
                                                                :key #'d:finding-id :test #'equal))
                            :observations (d:diagnosis-observations diagnosis) :sources (d:diagnosis-sources diagnosis)
                            :closure closure :e3 (d:diagnosis-e3 diagnosis) :availability (d:diagnosis-availability diagnosis))))
      (check (d::validate-diagnosis diagnosis))
      (refuses (lambda () (d::validate-diagnosis
                           (with-finding (d::%finding "orphan" :observed "no evidence" "none")))))
      (refuses (lambda () (d::validate-diagnosis
                           (with-finding (d::%finding "orphan" :derived "no basis" "none")))))
      (refuses (lambda () (d::validate-diagnosis
                           (with-finding (d::%finding "orphan" :derived "rests on a hypothesis" "none"
                                                      :basis (list (finding diagnosis "hypothesized-redefinition-warnings")))))))
      (refuses (lambda () (d::validate-diagnosis
                           (with-finding (d::%finding "orphan" :hypothesized "claims a basis" "none"
                                                      :basis (list (finding diagnosis "observed-before-loading"))))))))
    ;; 7. Reading and navigating activated nothing and wrote nothing.
    (check (equal state-before (preview-image-state)))
    (check (equal digests (mapcar #'digest files)))
    ;; Positive control for the activation guard: the guard sees a package appear.
    (unless (find-package d::+preview-package+)
      (make-package d::+preview-package+ :use nil)
      (unwind-protect (check (not (equal state-before (preview-image-state))))
        (delete-package d::+preview-package+))
      (check (equal state-before (preview-image-state))))
    ;; 8. Present state: the page file unavailable keeps the diagnosis readable and says so; an
    ;; available one is read and left byte-for-byte as it was.
    (let ((live (d:availability-live-page (d:diagnosis-availability diagnosis))))
      (check (eq :unavailable (getf live :state)))
      (check (getf live :reason))
      (check (search "could not be read" (v:view-html (view (d:diagnosis-availability diagnosis) "Image now"))))
      (check (view (d:diagnosis-e3 diagnosis) "E3 evidence")))
    (with-site-root-holding-retained-page
        (lambda (root path)
          (let* ((before (digest path))
                 (journal (with-open-file (s path :element-type '(unsigned-byte 8))
                            (let ((octets (make-array (file-length s) :element-type '(unsigned-byte 8))))
                              (read-sequence octets s) octets)))
                 (live (d:availability-live-page (d:diagnosis-availability (d:read-diagnosis :site-root root)))))
            (check (eq :available (getf live :state)))
            (check (getf live :same-revision-as-retained))
            (check (getf live :e3-present))
            (check (= 18 (getf live :items)))
            (check (equal before (digest path)))
            (check (equalp journal (with-open-file (s path :element-type '(unsigned-byte 8))
                                     (let ((octets (make-array (file-length s) :element-type '(unsigned-byte 8))))
                                       (read-sequence octets s) octets)))))))
    ;; 9. A new image reconstructs the same diagnosis without the preview system or the writer,
    ;; and navigating all of it does not load them.
    (destructuring-bind (ids preview-package writer-package page-state) (fresh-image-report)
      (check (equal ids (mapcar #'d:finding-id (d:diagnosis-findings diagnosis))))
      (check (null preview-package))
      (check (null writer-package))
      (check (eq :unavailable page-state)))
    (check (equal state-before (preview-image-state)))
    (format t "~&ITEM-EDIT-VIEW-DIAGNOSIS-PASS: ~D checks; entry from the Work Topic; ~D findings in five classes, each traced to evidence; before and after kept apart from the present; false closure claims and unsupported observations refused; no activation, no write; fresh image reconstructs it.~%"
            *checks* (length (d:diagnosis-findings diagnosis)))
    t))
