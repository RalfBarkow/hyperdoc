;;;; Focused inventory/proposal and native identity demonstration; no TMCL validator.
(in-package #:dreyeck/work/project/tests)

(defun run-inventory-design-tests ()
  (let* ((*checks* 0)
         (reading (p:project-workspace))
         (model (p:reading-model reading))
         (revision (p:reading-document reading))
         (map (p:revision-map revision))
         (index (p::%index map))
         (page (%project-page "Implementation Assignments"))
         (ids (loop for node in (%with "a" "data-proposed-topic" page)
                    for id = (plump:attribute node "data-proposed-topic")
                    when (and (equal (plump:attribute node "page") "Topic Maps Standards Inventory and TMCL Design")
                              (equal (plump:attribute node "hyperbook") "dreyeck/work/project")) collect id))
         (ws (p:reading-workspace reading))
         (reading-key "page/dreyeck/work/project/topic-maps-standards-inventory-and-tmcl-design"))
    (check "inventory:reader-pin" (getf (p::topic-maps-source-identity) :pinned))
    (check "inventory:native-read-without-refusal" (and map (null (p:revision-refusal revision))))
    (check "inventory:trace-to-authored-sources" (null (p:trace-project-map map model)))
    (check "inventory:proposals-have-distinct-authored-identities" (and ids (= (length ids) (length (remove-duplicates ids :test #'equal)))))
    (dolist (id '("iso13250-2-2006" "iso13250-3-2007" "iso13250-3-2013" "iso13250-4-2009"
                  "iso13250-5-2015" "iso13250-6-2010" "iso19756-2011"))
      (check (format nil "inventory:requested-edition:~A" id) (member id ids :test #'equal)))
    (dolist (id ids)
      (let ((topic (gethash (p:topic-iri id) index)))
        (check (format nil "inventory:~A:proposed-not-declared-or-statused" id)
               (and topic (p::%of-role map topic "proposed-on" "proposal")
                    (null (p::%of-role map topic "declared-on" "declaration"))
                    (null (p::%occurrences topic (p:schema-iri "work-status")))))
        (check (format nil "inventory:~A:source-and-reading-navigation" id)
               (let ((neighbours (%neighbours ws id)))
                 (and (member reading-key neighbours :test #'equal)
                      (member "page/dreyeck/work/project/implementation-assignments" neighbours :test #'equal))))))
    (dolist (s (remove-if-not (lambda (s) (eql 0 (search "iso-tm-" (p:statement-from s)))) (p:model-statements model)))
      (check (format nil "inventory:proposed-relation:~A" (p:statement-iri s))
             (and (p::statement-proposal-p s)
                  (member (p:statement-relation s) '("work:relation/produces" "work:relation/decomposes-into" "work:relation/depends-on") :test #'equal)
                  (find-if (lambda (a)
                             (and (eq (topic-maps.tmdm:association-type a) (gethash (p:relation-type-iri (p:statement-relation s)) index))
                                  (eq (p::%player a (p:role-type-iri (p:statement-relation s) :source))
                                      (gethash (p:topic-iri (p:statement-from s)) index))
                                  (eq (p::%player a (p:role-type-iri (p:statement-relation s) :target))
                                      (gethash (p:topic-iri (p:statement-to s)) index))))
                           (topic-maps.tmdm:topic-map-associations map)))))
    (check "inventory:no-acceptance-record-source" (null (p:model-acceptance model)))
    (check "inventory:deterministic-source-materialization" (equal (p:model-text model) (p:materialize-project-ctm)))
    (let ((comparison (p:compare-revisions revision (p::reading-fresh reading))))
      (check "inventory:same-document-iri-octets-and-cxtm" (and (getf comparison :octets-equal) (getf comparison :cxtm-equal))))
    (check "inventory:unchanged-octet-export" (equalp (p:revision-octets revision) (p:revision-export-octets revision)))
    ;; Compare the authored declarations and existing assignments with the exact
    ;; observed target. Only this page's proposal block differs; Work stays Work.
    (let* ((baseline (uiop:run-program
                      (list "git" "-C" (namestring (p::repository-root)) "show"
                            "573fe37611a61d984260ebf43c797f7534211bdd:dreyeck/pages/project/Implementation Assignments.html") :output :string))
           (old (p:build-project-model (p:read-project-sources :texts `((:assignments . ,baseline))))))
      (flet ((declarations (m)
               (loop for d in (p:model-declarations m) unless (p::declaration-proposal-p d)
                     collect (list (p:declaration-id d) (p:declaration-kind d) (p:declaration-status d) (p::declaration-text d))))
             (assignments (m)
               (mapcar (lambda (a) (list (p::assignment-id a) (p::assignment-fields a) (p::assignment-refs a) (p::assignment-lists a)))
                       (p:model-assignments m))))
        (check "inventory:declared-work-and-status-unchanged" (equal (declarations old) (declarations model)))
        (check "inventory:existing-assignment-reports-unchanged" (equal (assignments old) (assignments model))))
      (dolist (s (p:model-statements old))
        (check (format nil "inventory:existing-statement-preserved:~A" (p:statement-iri s))
               (find (p:statement-iri s) (p:model-statements model) :key #'p:statement-iri :test #'equal))))
    (dreyeck/topicmap:topicmap-workspace-go-to ws "iso-tm-review")
    (let* ((view (find "Topicmap" (v:all-views ws) :key #'v:view-title :test #'equal))
           (html (v:view-html view)) (refs (mapcar #'cdr (v:view-references view))))
      (check "inventory:inspector-links-native-proposal-and-reading"
             (and (plusp (length html)) (member (gethash (p:topic-iri "iso-tm-review") index) refs :test #'eq)
                  (find-if (lambda (r) (typep r 'hyperbook:page)) refs))))
    ;; Ordinary CTM fixtures ONLY. No TMCL PSI, constraint or authoring template.
    (let* ((shared (p:schema-iri "implementation-assignment"))
           (goal (p:schema-iri "goal")) (note (p:schema-iri "source-authority-note"))
           (doc-a "tag:dreyeck.ch,2026:hyperdoc/design/project-identity.ctm")
           (doc-b "tag:dreyeck.ch,2026:hyperdoc/design/schema-identity-demo.ctm")
           (source-a (format nil "<~A> - ~S; <~A>: ~S. <~A> - ~S." shared "Implementation assignment" note "project-author assertion" goal "goal"))
           (source-b (format nil "<~A> - ~S; <~A>: ~S. <~A> - ~S." shared "Implementation assignment" note "schema-author design only" goal "goal"))
           (a (topic-maps.ctm:deserialize-string source-a :document-iri doc-a))
           (b (topic-maps.ctm:deserialize-string source-b :document-iri doc-b))
           (target (topic-maps.ctm:deserialize-string "" :document-iri "tag:dreyeck.ch,2026:hyperdoc/design/import-demo.ctm"))
           (a-topic (gethash shared (p::%index a))) (b-topic (gethash shared (p::%index b)))
           (a-cxtm (topic-maps.cxtm:canonicalize-octets a :base-locator doc-a))
           (b-cxtm (topic-maps.cxtm:canonicalize-octets b :base-locator doc-b)))
      (check "identity:actual-project-and-design-share-existing-si" (and (gethash shared index) a-topic b-topic))
      (check "identity:separately-authored-maps-have-separate-objects" (not (eq a-topic b-topic)))
      (multiple-value-bind (ignored resolve-a) (topic-maps.tmdm:import-map-content target a)
        (declare (ignore ignored))
        (let ((held (funcall resolve-a a-topic)))
          (multiple-value-bind (ignored resolve-b) (topic-maps.tmdm:import-map-content target b)
            (declare (ignore ignored))
            (let ((current (topic-maps.tmdm:canonical-topic held)))
              (check "identity:shared-subject-normalizes-and-retained-handle-resolves"
                     (and (eq current (funcall resolve-b b-topic)) (eq current (funcall resolve-a a-topic))))
              (check "identity:one-canonical-subject-for-the-shared-si"
                     (= 1 (count-if (lambda (tp) (member shared (topic-maps.tmdm:topic-subject-identifiers tp) :test #'equal))
                                    (topic-maps.tmdm:topic-map-topics target))))
              (check "identity:source-objects-not-reused-as-target-objects" (and (not (eq current a-topic)) (not (eq current b-topic))))
              (check "identity:both-authored-note-values-retained"
                     (equal '("project-author assertion" "schema-author design only")
                            (sort (copy-list (p::%occurrences current note)) #'string<)))))))
      (check "identity:content-import-preserves-each-source-cxtm"
             (and (equalp a-cxtm (topic-maps.cxtm:canonicalize-octets a :base-locator doc-a))
                  (equalp b-cxtm (topic-maps.cxtm:canonicalize-octets b :base-locator doc-b))))
      (check "identity:repeat-read-same-explicit-document-and-base"
             (equalp a-cxtm (topic-maps.cxtm:canonicalize-octets
                            (topic-maps.ctm:deserialize-string source-a :document-iri doc-a) :base-locator doc-a))))
    (format t "~&INVENTORY-DESIGN-PASS: ~D checks; ordinary CTM identity/import only, no TMCL schema validation~%" *checks*)
    *checks*))
