(defpackage #:dreyeck/work/topic-maps-project-example/tests
  (:use #:cl)
  (:local-nicknames (#:m #:topic-maps.tmdm) (#:e #:topic-maps.project-work.example)
                    (#:p #:dreyeck/work/topic-maps-project-example) (#:v #:html-inspector-views)
                    (#:nav #:dreyeck/inspector/tmdm) (#:ev #:dreyeck/evaluation-record))
  (:export #:run-tests))
(in-package #:dreyeck/work/topic-maps-project-example/tests)
(defvar *checks* nil)
(defmacro check (label form)
  `(progn (unless ,form (error "22U integration check failed: ~A" ,label)) (push ,label *checks*)))
(defun view (object title)
  (let ((view (find title (v:all-views object) :key #'v:view-title :test #'equal)))
    (unless view (error "Missing Inspector view ~S on ~S" title object))
    (v:view-html view) view))
(defun refs (object title) (mapcar #'cdr (v:view-references (view object title))))
(defun binary (path)
  (with-open-file (in path :element-type '(unsigned-byte 8))
    (let ((data (make-array (file-length in) :element-type '(unsigned-byte 8))))
      (assert (= (length data) (read-sequence data in))) data)))
(defun selected-targets-exist (object title)
  (every (lambda (entry)
    (let ((parts (uiop:split-string (car entry) :separator "-")))
      (or (/= (length parts) 3) (not (string= (first parts) "inspect"))
          (find (v:decode-base32 (third parts)) (v:all-views (cdr entry)) :key #'v:view-title :test #'equal))))
    (v:view-references (view object title))))
(defun path-to (question type target)
  ;; Follow actual Inspector references, checking the native Role/Association
  ;; endpoints at every step; no copied graph, label lookup or HTML-only claim.
  (let ((role (find type (refs question "Roles") :test
                (lambda (type item) (and (typep item 'm:association-role)
                  (eq type (m:association-type (m:association-role-parent item))))))))
    (check :question-role-inverse (and role (eq question (m:association-role-player role))
                                      (member role (m:topic-roles-played question) :test #'eq)))
    (let* ((association (m:association-role-parent role))
           (next (find target (refs association "Association") :test
                   (lambda (target item) (and (typep item 'm:association-role)
                                              (eq target (m:association-role-player item)))))))
      (check :role-to-association-EQ (member association (refs role "Role") :test #'eq))
      (check :association-to-role-EQ (and next (member next (m:association-roles association) :test #'eq)))
      (check :role-player-Topic-EQ (member target (refs next "Role") :test #'eq))
      (dolist (item (list role next))
        (check :native-role-types (member (m:association-role-type item) (refs item "Role") :test #'eq))
        (check :selected-role-destinations-exist (selected-targets-exist item "Role")))
      (check :destination-native-Topic-view (selected-targets-exist target "Topic"))
      (list role association next target))))
(defun stated-source-evidence ()
  "The source evidence this run must produce, stated by the caller and never inferred: a Git checkout unless
HYPERDOC_EXPECTED_TOPIC_MAPS_SOURCE says nix-store-snapshot."
  (let ((stated (uiop:getenv "HYPERDOC_EXPECTED_TOPIC_MAPS_SOURCE")))
    (cond ((member stated '(nil "" "git-checkout") :test #'equal) :git-checkout)
          ((equal stated "nix-store-snapshot") :verified-nix-store-snapshot)
          (t (error "Unknown HYPERDOC_EXPECTED_TOPIC_MAPS_SOURCE ~S." stated)))))
(defun run-tests ()
  (let* ((*checks* nil) (path (p:checked-source-path)) (source (binary path))
         (run (p:run-example)) (map (p:run-map run))
         (question (e:find-topic map "urn:topic-maps:question:Q-XTM-LOOP"))
         (project (e:find-topic map "urn:topic-maps:project"))
         (disposition (e:local-topic map "disposition")) (state (e:model-view map)))
    (check :source-evidence-of-the-stated-kind
      (and (eq (stated-source-evidence) (p:source-evidence-kind (p:checked-source-evidence)))
           (eq (stated-source-evidence) (getf (ev:evaluation-annotation-of run) :source-evidence))))
    (check :source-via-registered-ASDF (equal (truename path)
      (truename (asdf:system-relative-pathname "topic-maps/project-work-example" "examples/project-work.ctm"))))
    (check :productive-reader-native-result (typep map 'm:topic-map))
    (check :native-source-identities (and (eq question (e:local-topic map "question"))
                                         (eq project (e:local-topic map "project"))))
    (check :map-native-view (member question (refs map "Topics") :test #'eq))
    (check :old-topic-view-preserved (member map (refs question "Topic") :test #'eq))
    (path-to question (e:local-topic map "concerns") project)
    (path-to question (e:local-topic map "documented-by") disposition)
    (check :canonical-entire-map (e:references-current-p map))
    (check :existing-evaluation-provenance-reused
      (and (member run (nav:executions-of map) :test #'eq) (member run (refs question "Evidence") :test #'eq)
           (eq map (ev:evaluation-result-of run))))
    (check :current-run-not-old-12a-evidence
      (and (member map (refs run "22U execution") :test #'eq)
           (search "Older Slice 12A reports are not new 22U evidence." (v:view-html (view run "22U execution")))))
    (check :rendering-native-views-does-not-mutate (equal state (e:model-view map)))
    (let* ((page (hyperbook:find-page (hyperbook:find-hyperbook "dreyeck/work/topic-maps-project-example" :signal-error? t)
                                    "Reading Slice 22U" :signal-error? t))
           (work (dreyeck/work/reading:work-page "Work Breakdown"))
           (saved (symbol-function 'p:run-example)) (calls 0))
      (unwind-protect
        (progn
          (setf (symbol-function 'p:run-example) (lambda () (incf calls) (funcall saved)))
          (dolist (page (list page work))
            (let ((view (view page "Topic Maps 22U")))
              (check :discoverable-explicit-example (member #'p:inspect-project-example (mapcar #'cdr (v:view-references view)) :test #'eq))
              (check :explicit-run-control-present (search "Read a fresh 22U Map" (v:view-html view)))))
          (check :rendering-does-not-execute (zerop calls)))
        (setf (symbol-function 'p:run-example) saved)))
    (let* ((exercise (p:exercise-project-example))
           (q (e:find-topic exercise "urn:topic-maps:question:Q-XTM-LOOP"))
           (notes (remove-if-not (lambda (item) (eq (m:occurrence-type item) (e:local-topic exercise "note")))
                                 (m:topic-occurrences q))))
      (check :exercise-is-a-separate-native-map (and (not (eq exercise map)) (not (eq q question))))
      (check :only-explicit-exercise-gets-scoped-note
        (and (= 1 (length notes)) (equal (list (e:local-topic exercise "exercise")) (m:occurrence-scope (first notes)))
             (string= e:*exercise-note* (m:occurrence-value (first notes)))))
      (check :ordinary-map-unchanged-after-exercise (equal state (e:model-view map)))
      (check :exercise-canonical-references (e:references-current-p exercise)))
    ;; A separate disposable diagnostic map tests a stale observation. This is
    ;; neither the ordinary reading above nor an edit of the historical source.
    (let* ((diagnostic (p:run-example)) (diagnostic-map (p:run-map diagnostic))
           (q (e:find-topic diagnostic-map "urn:topic-maps:question:Q-XTM-LOOP"))
           (name (first (m:topic-names q))))
      (setf (char (m:topic-name-value name) 0) #\X)
      (check :observation-does-not-alias-mutable-values
        (not (equal (p:run-state diagnostic) (e:model-view diagnostic-map))))
      (check :changed-model-not-mistaken-for-source-state
        (search "Native state changed after the reading" (v:view-html (view diagnostic "22U execution")))))
    (check :source-bytes-unchanged (equalp source (binary path)))
    (check :no-persistence-writer-loaded (not (find-package "DREYECK/FEDWIKI-PAGE-AUTHORING")))
    (format t "~&TOPIC-MAPS-22U-INSPECTOR-PASS: ~D assertions; project and disposition reached through native Role/Association references.~%" (length *checks*))
    t))
