(defpackage #:dreyeck/work/item-edit-proposal/tests
  (:use #:cl)
  (:local-nicknames (#:a #:dreyeck/work/item-edit-proposal)
                    (#:c #:dreyeck/work/ctm-page-authoring)
                    (#:lp #:dreyeck/local-fedwiki-page)
                    (#:p #:dreyeck/fedwiki-item-edit-preview)
                    (#:plan #:dreyeck/fedwiki-page-edit-plan)
                    (#:v #:html-inspector-views))
  (:export #:run-tests))
(in-package #:dreyeck/work/item-edit-proposal/tests)

(defvar *checks* 0)
(defmacro check (form) `(progn (incf *checks*) (assert ,form)))
(defun html-views (object) (remove-if-not (lambda (view) (typep view 'v::html-view)) (v:all-views object)))
(defun view (object title)
  (let ((view (or (find title (v:all-views object) :key #'v:view-title :test #'equal) (error "Missing ~A view of ~S" title object))))
    (v:view-html view)
    (check (notany (lambda (ref) (typep (cdr ref) 'condition)) (v:view-references view)))
    view))
(defun refs (object title) (mapcar #'cdr (v:view-references (view object title))))
(defun html (object title) (v:view-html (view object title)))
(defun all-views-of (object) (dolist (view (html-views object)) (v:view-html view)))

(defun inline-ref (view text)
  "The object the link whose text is TEXT refers to, found through the id in the view's own html."
  (let* ((html (v:view-html view)) (at (search (format nil ">~A</span>" text) html)))
    (assert at)
    (let* ((id-at (search "id='" html :end2 at :from-end t)) (start (+ id-at 4)) (end (position #\' html :start start)))
      (cdr (assoc (subseq html start end) (v:view-references view) :test #'equal)))))
(defun repo (relative) (a::repo-file relative))
(defun digest (relative) (a::file-digest (repo relative)))
(defun refused (thunk) (check (handler-case (progn (funcall thunk) nil) (a:proposal-reading-error () t))))
(defun preview-image-state ()
  (list (and (find-package a::+writer-package+) t)
        (let ((system (asdf:find-system "dreyeck/fedwiki-item-edit-preview" nil))) (and system (asdf:component-loaded-p system) t))))
(defun directory-state (root)
  (mapcar (lambda (path) (list (namestring path) (a::file-digest path)))
          (directory (merge-pathnames "pages/*" root))))

(defun fresh-image-facts ()
  (let ((program (or (uiop:argv0) (first sb-ext:*posix-argv*)))
        (form "(let* ((package \"DREYECK/WORK/ITEM-EDIT-PROPOSAL\")
                      (anatomy (funcall (find-symbol \"READ-PROPOSAL-ANATOMY\" package)))
                      (parts (list anatomy (funcall (find-symbol \"ANATOMY-TRIAL\" package) anatomy)
                                   (funcall (find-symbol \"ANATOMY-SOURCE\" package) anatomy)
                                   (funcall (find-symbol \"ANATOMY-PREVIEW\" package) anatomy)
                                   (funcall (find-symbol \"ANATOMY-PROPOSAL\" package) anatomy))))
                 (dolist (part parts)
                   (dolist (view (funcall (find-symbol \"ALL-VIEWS\" \"HTML-INSPECTOR-VIEWS\") part))
                     (when (typep view (find-symbol \"HTML-VIEW\" \"HTML-INSPECTOR-VIEWS\"))
                       (funcall (find-symbol \"VIEW-HTML\" \"HTML-INSPECTOR-VIEWS\") view))))
                 (format t \"~&FRESH-PROPOSAL ~S~%\"
                         (list (funcall (find-symbol \"PAGE-SOURCE-SHA256\" \"DREYECK/LOCAL-FEDWIKI-PAGE\")
                                        (funcall (find-symbol \"ANATOMY-SOURCE\" package) anatomy))
                               (mapcar (lambda (name) (and (find-package name) t))
                                       (list \"DREYECK/FEDWIKI-PAGE-AUTHORING\" \"DREYECK/AUTHENTICATED-PAGE-AUTHORING\"
                                             \"DREYECK/AUTHORING-ENVELOPE\" \"DREYECK/FEDWIKI-ITEM-EDIT-EXECUTION\"))
                               (length (gethash \"journal\" (funcall (find-symbol \"ANATOMY-NEXT-PAGE\" package) anatomy))))))"))
    (multiple-value-bind (output error-output status)
        (uiop:run-program (list program "--noinform" "--non-interactive" "--eval" "(require :asdf)"
                                "--eval" "(asdf:load-system \"dreyeck/work/item-edit-proposal\")" "--eval" form)
                          :output :string :error-output :output :ignore-error-status t)
      (declare (ignore error-output))
      (let ((at (search "FRESH-PROPOSAL " output)))
        (unless (and (zerop status) at) (error "Fresh image failed (status ~S):~%~A" status output))
        (let ((*read-eval* nil) (*package* (find-package "COMMON-LISP-USER")))
          (read-from-string output t nil :start (+ at (length "FRESH-PROPOSAL "))))))))

(defun check-dating-reread ()
  "The recorded lines can be read again where an installation is given; each outcome apart, none from outside a temporary directory."
  (let* ((record (p::read-dating-record)) (sources (coerce (gethash "sources" record) 'list))
         (root (merge-pathnames (format nil "fedwiki-installation-~D/" (random 1000000000)) (uiop:temporary-directory))))
    (flet ((install (&key (shift 0) (version-of (lambda (source) (gethash "version" source))) (omit nil))
             (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore)
             (dolist (source sources)
               (unless (equal omit (gethash "file" source))
                 (let ((file (merge-pathnames (format nil "~A/~A" (gethash "package" source) (gethash "file" source)) root))
                       (manifest (merge-pathnames (format nil "~A/package.json" (gethash "package" source)) root)))
                   (ensure-directories-exist file)
                   (with-open-file (out file :direction :output :if-exists :supersede :external-format :utf-8)
                     (dotimes (n (+ shift (1- (gethash "line" source)))) (write-line "// filler" out))
                     (write-line (gethash "marker" source) out))
                   (with-open-file (out manifest :direction :output :if-exists :supersede :external-format :utf-8)
                     (format out "{\"name\": ~S, \"version\": ~S}" (gethash "package" source) (funcall version-of source)))))))
           (statuses () (let ((p::*fedwiki-node-modules* root)) (mapcar #'p::%reread-dating-source sources))))
      (unwind-protect
           (progn
             ;; Not given: recorded only.
             (check (every (lambda (source) (eq :not-reread (p::%reread-dating-source source))) sources))
             ;; Given and the same: positive control for every refusal below.
             (install) (check (every (lambda (status) (eq :same status)) (statuses)))
             ;; The lines moved, the version differs, a file is missing: each reported as itself.
             (install :shift 3) (check (every (lambda (status source) (and (consp status) (= (second status) (+ 3 (gethash "line" source))))) (statuses) sources))
             (install :version-of (lambda (source) (declare (ignore source)) "0.0.1")) (check (every (lambda (status) (eq :other-version status)) (statuses)))
             (install :omit "lib/page.js") (check (equal '(:same :same :file-absent) (statuses))))
        (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore)))))

(defun run-tests ()
  (let* ((*checks* 0)
         (state-before (preview-image-state))
         (pages '("dreyeck/pages/work/Work Breakdown.html" "dreyeck/pages/work/Authoring the CTM Plan Page.html"
                  "dreyeck/pages/work/CTM Plan Page WBS Dictionary.html"))
         (files (append pages '("dreyeck/work/ctm-page-evidence/ctm-and-tmdm-in-hyperdoc.json"
                                "dreyeck/work/ctm-page-evidence/persisted-edit-trial.json"
                                "dreyeck/work/ctm-page-evidence/site/pages/ctm-and-tmdm-in-hyperdoc")))
         (digests (mapcar #'digest files))
         (site-before (directory-state (a:retained-site-root)))
         (reading (c:read-ctm-authoring))
         (wp2 (c::%subject reading "ctm-wp-2"))
         (wp1 (c::%subject reading "ctm-wp-1")))
    ;; The retained site root holds the retained page, byte for byte.
    (check (equal (digest "dreyeck/work/ctm-page-evidence/ctm-and-tmdm-in-hyperdoc.json")
                  (digest "dreyeck/work/ctm-page-evidence/site/pages/ctm-and-tmdm-in-hyperdoc")))
    (check (equal "d7215c50f4efa07b3e94749b060b7d7b828654f2a44caab7f1034415c6003dff"
                  (digest "dreyeck/work/ctm-page-evidence/site/pages/ctm-and-tmdm-in-hyperdoc")))
    ;; 1. Entry from the existing Work package ctm-wp-2, and from no other.
    (check (typep wp2 'c::wbs-element))
    (let* ((entry (view wp2 "Proposal anatomy"))
           (anatomy (find-if (lambda (object) (typep object 'a:proposal-anatomy)) (mapcar #'cdr (v:view-references entry)))))
      (check anatomy)
      (check (null (find "Proposal anatomy" (v:all-views wp1) :key #'v:view-title :test #'equal)))
      (check (> (length (v:all-views wp2)) 1))
      ;; 2. Each part is the object the preview and the proposal hold.
      (let ((anatomy (a:read-proposal-anatomy :subject wp2)))
        (let ((table (refs anatomy "Anatomy")))
          (dolist (object (list (a:anatomy-source anatomy) (a:anatomy-item anatomy) (a:anatomy-proposal anatomy)
                                (a:anatomy-preview anatomy) (a:anatomy-expected anatomy) (a:anatomy-replacement anatomy)
                                (a:anatomy-action anatomy) (a:anatomy-next-page anatomy)
                                (fdefinition 'p:propose-item-edit) (fdefinition 'p:preview-item-edit)
                                (fdefinition 'p:proposal-action) (fdefinition 'p:proposal-replacement-item)
                                (fdefinition 'plan:plan-fedwiki-page-edit) (fdefinition 'lp:observe-local-fedwiki-page-source)))
            (check (member object table :test #'eq))))
        ;; The parts are what they say: one Item, same id, one Action, one more journal entry.
        (let ((expected (a:anatomy-expected anatomy)) (replacement (a:anatomy-replacement anatomy)) (action (a:anatomy-action anatomy)))
          (check (every (lambda (object) (equal "ed37e9bac2fcd548" (gethash "id" object))) (list expected replacement action)))
          (check (equal "edit" (gethash "type" action)))
          (check (null (nth-value 1 (gethash "date" action))))
          (check (not (equal (gethash "text" expected) (gethash "text" replacement))))
          (check (= 10 (a:anatomy-index anatomy)))
          (check (= 18 (length (gethash "story" (a:anatomy-next-page anatomy)))))
          (check (= 2 (length (gethash "journal" (lp:page-source-json (a:anatomy-source anatomy))))))
          (check (= 3 (length (gethash "journal" (a:anatomy-next-page anatomy)))))
          (check (equal (lp:page-source-sha256 (a:anatomy-source anatomy))
                        (gethash "pageSha256" (gethash "before" (a:trial-record (a:anatomy-trial anatomy)))))))
        (check (search "Executed: no." (html (a:anatomy-preview anatomy) "Preview")))
        (check (search "example" (html anatomy "Anatomy")))
        (check (search "content decision of E3 is open" (html anatomy "Anatomy")))
;; 2b. The Edit Action view: the Action itself, three states kept apart, the date said to be missing.
        (let* ((preview (a:anatomy-preview anatomy)) (action (a:anatomy-action anatomy))
               (snapshot (shasht:write-json action nil)))
          ;; Navigation: the Preview offers it, and it offers the objects back.
          ;; In the sentence about the journal, only the words "this edit Action" are a link, and it opens the Action itself.
          (let* ((view (view preview "Preview")) (text (v:view-html view)) (at (search ">this edit Action</span>" text)))
            (check at)
            (check (null (search "this edit Action" text :start2 (+ at (length ">this edit Action</span>")))))
            (check (< (search "Expected effect" text) at (search "Executed: no." text)))
            (check (search ", which has no date field" text))
            (check (eq (a:anatomy-action anatomy) (inline-ref view "this edit Action")))
            (check (null (search "The Edit Action in its context" text)))
            (check (null (search "The Action itself" text)))
            (check (null (search "dated when it is executed" text))))
          (check (not (search "its source code" (html preview "Action context"))))
          (check (not (search "its callers" (html preview "Action context"))))
          ;; The mention of plan-fedwiki-page-edit in the sentence about the computation is the link to the function.
          (let* ((view (view preview "Action context")) (text (v:view-html view)) (at (search ">plan-fedwiki-page-edit</span>" text)))
            (check at)
            (check (null (search ">plan-fedwiki-page-edit</span>" text :start2 (1+ at))))
            (check (< (search "How its effect was computed" text) at (search "What an authorized execution would do" text)))
            (check (eq (fdefinition 'plan:plan-fedwiki-page-edit) (inline-ref view "plan-fedwiki-page-edit"))))
          (let* ((text (html preview "Action context")) (table (refs preview "Action context")))
            ;; The very objects the preview holds, not copies; rendering made none.
            (dolist (object (list action (a:anatomy-expected anatomy) (a:anatomy-replacement anatomy) (a:anatomy-source anatomy) (p:preview-source preview)
                                  (lp:page-source-json (a:anatomy-source anatomy)) (gethash "journal" (lp:page-source-json (a:anatomy-source anatomy)))
                                  (a:anatomy-next-page anatomy) (gethash "journal" (a:anatomy-next-page anatomy))
                                  (p:preview-proposal preview) preview))
              (check (member object table :test #'eq)))
            (check (eq action (p:preview-action preview)))
            (check (eq (gethash "item" action) (a:anatomy-replacement anatomy)))
            (check (find-if (lambda (object) (typep object 'p:persisted-trial)) table))
            (check (eq action (find action (refs preview "Action context") :test #'eq)))
            (check (equal snapshot (shasht:write-json action nil)))
            (check (null (nth-value 1 (gethash "date" action))))
            (dolist (expected '("proposed" "previewed" "persisted" "Executed: no." "It has no date field." "nothing in this code adds one"
                                "Not decided here" "Recorded, not performed here." "not by this Inspector"))
              (check (search expected text)))
            ;; The FedWiki lines are shown as recorded, with no machine path; nothing is read from outside the repository.
            (let ((record (p::read-dating-record)))
              (check (null (search "/Users/" text)))
              (check (every (lambda (source) (and (search (gethash "file" source) text) (search (gethash "version" source) text)
                                                  (not (char= #\/ (char (gethash "file" source) 0)))))
                            (coerce (gethash "sources" record) 'list)))
              (check (= 3 (length (gethash "sources" record))))
              (check (null p::*fedwiki-node-modules*))
              (check (search "not read again here" text)))
            ;; The trial shown is the recorded one.
            (let ((record (p:trial-record (find-if (lambda (object) (typep object 'p:persisted-trial)) table))))
              (check (search (gethash "pageSha256" (gethash "before" record)) text))
              (check (search "18 / 2 before, 18 / 3 after" text)))
            (view (find-if (lambda (object) (typep object 'p:persisted-trial)) table) "Persisted trial"))
          ;; Positive control: a date on the Action is reported as present. The Action of a second preview is changed for this and restored.
          (let* ((other (a:read-proposal-anatomy)) (action2 (a:anatomy-action other)))
            (setf (gethash "date" action2) 1790000000000)
            (unwind-protect (check (search "It has a date field." (html (a:anatomy-preview other) "Action context")))
              (remhash "date" action2))
            (check (search "It has no date field." (html (a:anatomy-preview other) "Action context"))))
;; The functions behind the Action are objects, with the Inspector's own Source code and Callers views.
          (dolist (symbol (list 'p:proposal-action 'plan:plan-fedwiki-page-edit 'p:preview-item-edit 'p:proposal-replacement-item 'p:propose-item-edit))
            (let ((function (fdefinition symbol)))
              (check (not (typep function 'generic-function)))
              (check (member function (refs preview "Action context") :test #'eq))
              (check (find "Source code" (v:all-views function) :key #'v:view-title :test #'equal))
              (check (search (string-downcase (symbol-name symbol)) (string-downcase (html function "Source code"))))))
          (check (search "ordinary function, not a generic function" (html preview "Action context")))
          (check (member (fdefinition 'p:preview-item-edit) (refs (fdefinition 'plan:plan-fedwiki-page-edit) "Callers") :test #'eq))
          ;; The writer is not loaded here: its definition is a source file, and the view says so.
          (check (null (find-package a::+writer-package+)))
          (check (member (a::repo-file "dreyeck/src/fedwiki-page-authoring.lisp") (refs preview "Action context") :test #'equal))
          (check (search "writer is not loaded in this image" (html preview "Action context")))
          ;; Navigation needs no registration of objects to previews: none exists, and no hash table gains a view.
          (check (null (find-symbol "*PREVIEW-CONTEXT*" "DREYECK/FEDWIKI-ITEM-EDIT-PREVIEW")))
          (dolist (object (list action (a:anatomy-expected anatomy) (a:anatomy-replacement anatomy) (a:anatomy-next-page anatomy) (make-hash-table)))
            (check (null (find "Where this comes from" (v:all-views object) :key #'v:view-title :test #'equal))))
          ;; Rendering twice is the same Action, and nothing was written.
          (html preview "Action context")
          (check (eq action (p:preview-action preview)))
          (check (equal snapshot (shasht:write-json action nil))))
        ;; 3. Preview or edit: from the classes, the source and the present image.
        (let ((table (refs anatomy "Preview or edit?")) (text (html anatomy "Preview or edit?")))
          (check (member (find-class 'p:item-edit-preview) table :test #'eq))
          (check (member (fdefinition 'plan:plan-fedwiki-page-edit) table :test #'eq))
          (check (member (a:anatomy-trial anatomy) table :test #'eq))
          (check (search "it does not" text))
          (check (search "Neither the preview nor the writer sets a date" text))
          (check (null (find-package a::+writer-package+)))
          (check (search "not loaded in this image" text))
          (check (search "PROPOSAL" (string-upcase text)))
          (check (equal (a::slot-names (find-class 'p:item-edit-preview))
                        (mapcar #'sb-mop:slot-definition-name (sb-mop:class-slots (find-class 'p:item-edit-preview)))))
          (check (not (find "CAPABILITY" (a::slot-names (find-class 'p:item-edit-preview)) :key #'symbol-name :test #'string=))))
        ;; 4. The persisted trial is recorded, kept apart, and ties to the plan's own objects.
        (let* ((trial (a:anatomy-trial anatomy)) (text (html trial "Persisted trial")) (table (refs trial "Persisted trial")))
          (check (search "Recorded, not performed here." text))
          (check (search "check-persisted-trial" text))
          (check (search "18 / 3" text))
          (check (search "18 / 2" text))
          (check (member (a:trial-path trial) table :test #'equal))
          (check (member (a:anatomy-source anatomy) table :test #'eq))
          (check (find-if (lambda (o) (typep o 'c::step-authorization)) table))
          (check (find "ctm-pre-authority" table :key (lambda (o) (and (typep o 'c::ctm-subject) (c::subject-id o))) :test #'equal))
          (check (find "ctm-pre-content" table :key (lambda (o) (and (typep o 'c::ctm-subject) (c::subject-id o))) :test #'equal))
          (check (= (a::source-line "dreyeck/tests/fedwiki-item-edit-preview.lisp" "(defun check-persisted-trial")
                    (1+ (count #\Newline (a::file-text (repo "dreyeck/tests/fedwiki-item-edit-preview.lisp"))
                               :end (search "(defun check-persisted-trial" (a::file-text (repo "dreyeck/tests/fedwiki-item-edit-preview.lisp"))))))))
        ;; 5. Operation, Work package, TMDM Topic: three different things.
        (let ((table (refs anatomy "Operation or topic?")))
          (check (member (fdefinition 'p:propose-item-edit) table :test #'eq))
          (check (member (fdefinition 'p::story-item-edit-offer) table :test #'eq))
          (check (find "ctm-wp-2" table :key (lambda (o) (and (typep o 'c::ctm-subject) (c::subject-id o))) :test #'equal))
          (check (not (typep (fdefinition 'p:propose-item-edit) 'c::ctm-subject))))
        ;; Every view of every part renders without a condition.
        (dolist (part (list anatomy (a:anatomy-trial anatomy) (a:anatomy-source anatomy) (a:anatomy-preview anatomy)
                            (a:anatomy-proposal anatomy) (a:anatomy-item anatomy)))
          (all-views-of part))))
    (check-dating-reread)
    ;; A page file that is not the recorded revision is refused; with the revision check off it reads.
    (let* ((root (merge-pathnames (format nil "proposal-anatomy-~D/" (random 1000000000)) (uiop:temporary-directory)))
           (page (merge-pathnames "pages/ctm-and-tmdm-in-hyperdoc" root)))
      (ensure-directories-exist page)
      (unwind-protect
           (progn
             (uiop:copy-file (repo "dreyeck/work/ctm-page-evidence/ctm-and-tmdm-in-hyperdoc.json") page)
             (check (a:read-proposal-anatomy :site-root root))
             (let ((json (shasht:read-json (a::file-text page))))
               (setf (gethash "text" (find "fa6304a65d40144c" (gethash "story" json) :key (lambda (i) (gethash "id" i)) :test #'equal)) "changed")
               (with-open-file (out page :direction :output :if-exists :supersede :external-format :utf-8)
                 (shasht:write-json json out)))
             (refused (lambda () (a:read-proposal-anatomy :site-root root)))
             (check (a:read-proposal-anatomy :site-root root :check-revision nil)))
        (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore)))
    ;; Reading and rendering wrote nothing and loaded neither the writer nor a capability.
    (check (equal state-before (preview-image-state)))
    (check (equal digests (mapcar #'digest files)))
    (check (equal site-before (directory-state (a:retained-site-root))))
    ;; A new image reconstructs the reading, loads no writer, and the preview still counts three journal entries.
    (destructuring-bind (sha writer journal) (fresh-image-facts)
      (check (equal "d7215c50f4efa07b3e94749b060b7d7b828654f2a44caab7f1034415c6003dff" sha))
      ;; A new image that reads, previews and renders loads no writer, no authenticated path and no execution
      ;; system: no capability can exist in it.
      (check (equal '(nil nil nil nil) writer))
      (check (= 3 journal)))
    (format t "~&ITEM-EDIT-PROPOSAL-PASS: ~D checks; entry from ctm-wp-2; eight parts of the proposal as the objects the preview holds; preview kept apart from the recorded persisted trial and from the writer; operation, Work package and TMDM Topic told apart; stale revision refused; nothing written, no writer loaded; fresh image reconstructs it.~%" *checks*)
    t))
