(defpackage #:dreyeck/pull-request-review/tests
  (:use #:cl)
  (:local-nicknames (#:r #:dreyeck/pull-request-review)
                    (#:tm #:dreyeck/topicmap) (#:v #:html-inspector-views))
  (:export #:run-tests))
(in-package #:dreyeck/pull-request-review/tests)
(defvar *checks* 0)
(defun check (condition label)
  (unless condition (error "PR REVIEW: ~A" label)) (incf *checks*))
(defun refuses (thunk) (handler-case (progn (funcall thunk) nil) (error () t)))
(defun fixture-path ()
  (asdf:system-relative-pathname "dreyeck/pull-request-review" "dreyeck/pr-review/example/github-snapshot.json"))
(defun fixture-json () (r::%json-file (fixture-path)))
(defun with-json (json thunk)
  (uiop:with-temporary-file (:pathname path :stream out :direction :output :type "json")
    (shasht:write-json json out) (finish-output out)
    (funcall thunk path)))
(defun import-json (json) (with-json json #'r:import-snapshot))
(defun view (object title)
  (or (find title (v:all-views object) :key #'v:view-title :test #'equal)
      (error "Missing view ~A on ~S" title (type-of object))))
(defun refs (view) (v:view-html view) (mapcar #'cdr (v:view-references view)))
(defun claim-edges (reading)
  (remove-if-not (lambda (a) (getf (tm:topicmap-association-properties-of a) :claim))
                (tm:topicmap-projection-associations-of (tm:topicmap-projection-of reading))))
(defun alter-claim (claim &key (type (r:claim-type claim)) (level (r:claim-level claim))
                         (quote (r:claim-quote claim)))
  (r::make-relationship-claim
   :type type :level level :quote quote :from (r::claim-from claim) :to (r::claim-to claim)
   :from-sha (r::claim-from-sha claim) :to-revision (r::claim-to-revision claim)
   :source-pr (r::claim-source-pr claim) :body-digest (r::claim-body-digest claim)))

(defun run-tests ()
  (let* ((*checks* 0) (reading (r:example-reading)) (snapshot (r:reading-snapshot reading))
         (original-digest (r:snapshot-digest snapshot)))
    (check (= 6 (length (r:snapshot-prs snapshot))) "dated example captures the six requested PRs")
    (check (= 4 (length (r:reading-claims reading))) "four explicitly warranted source relationships")
    (check (every (lambda (c) (eq :supported (r:claim-status snapshot c))) (r:reading-claims reading))
           "all four example claims have current textual and revision warrants")
    (check (every (lambda (m) (eq :supported (r:mark-status snapshot m))) (r:reading-marks reading))
           "evidence and decision labels have exact source warrants")
    (check (search (r::reading-annotation-digest reading) (v:view-html (view reading "Warrants and notes")))
           "curated annotation provenance is visible separately from GitHub source")
    (check (null (r:reading-notes reading)) "example creates no human acceptance or notes")
    (check (every #'r::pr-draft (r:snapshot-prs snapshot)) "draft metadata retained")
    (check (equal "hauptsache" (r:pr-base-ref (r:find-pr snapshot 5))) "actual differing PR base retained")
    (check (equal "4ef218a6d273e17091f4ee541965a01ae53d39fc"
                  (r:commit-sha (r:pr-head (r:find-pr snapshot 6)))) "latest observed PR6 docs revision retained")
    (check (plusp (length (r::commit-message (r:pr-head (r:find-pr snapshot 6))))) "head commit message retained")
    (format t "~&PR-REVIEW metadata and warranted example PASS~%")

    (dolist (n '(0 1 3))
      (let* ((json (fixture-json)) (prs (coerce (gethash "pullRequests" json) 'list)))
        (setf (gethash "pullRequests" json) (coerce (subseq prs 0 n) 'vector))
        (let* ((s (import-json json)) (r (r:make-reading s)))
          (check (= n (length (r:reading-items r))) "zero/one/multiple imports do not assume six")
          (check (search (format nil "~D PRs observed" n) (v:view-html (view r "Pull requests")))
                 "table count follows imported data")
          (check (= (+ 1 n (length (r:snapshot-issues s)))
                    (length (tm:topicmap-projection-topics-of (tm:topicmap-projection-of r))))
                 "projection follows imported cardinality"))))
    (let* ((json (fixture-json)) (extra (aref (gethash "pullRequests" (fixture-json)) 0)))
      (setf (gethash "number" extra) 42 (gethash "html_url" extra) "https://github.com/RalfBarkow/hyperdoc/pull/42")
      (setf (gethash "pullRequests" json) (concatenate 'vector (gethash "pullRequests" json) (vector extra)))
      (check (= 7 (length (r:snapshot-prs (import-json json)))) "a subsequent seventh PR needs no code change"))
    (let ((unavailable (r:make-reading (r:make-unavailable-snapshot (r:snapshot-observed-at snapshot)))))
      (check (eq :unavailable (r:snapshot-age-status (r:reading-snapshot unavailable))) "unavailable observation is explicit")
      (check (search "not an empty PR list" (v:view-html (view unavailable "Pull requests"))) "unavailability is not rendered as zero open PRs")
      (check (eq :unavailable (r:changed-revisions snapshot (r:reading-snapshot unavailable))) "cannot compare unavailable state as empty"))
    (check (refuses (lambda () (r:import-snapshot #P"/nonexistent/pr-review-snapshot.json"))) "missing import is not an empty snapshot")
    (dolist (mutation (list
                       (lambda (j) (setf (gethash "fullName" (gethash "repository" j)) "Other/repository"))
                       (lambda (j) (setf (gethash "draft" (aref (gethash "pullRequests" j) 0)) "false"))
                       (lambda (j) (setf (gethash "html_url" (aref (gethash "pullRequests" j) 0)) "javascript:alert(1)"))
                       (lambda (j) (setf (gethash "sha" (gethash "head" (aref (gethash "pullRequests" j) 0))) "short"))
                       (lambda (j) (setf (gethash "pullRequests" j) (vector (aref (gethash "pullRequests" j) 0) (aref (gethash "pullRequests" j) 0))))))
      (let ((j (fixture-json))) (funcall mutation j)
        (check (refuses (lambda () (import-json j))) "invalid identities/metadata fail closed")))
    (format t "~&PR-REVIEW cardinality, unavailable and invalid imports PASS~%")

    (let* ((json (fixture-json)) (row (find 6 (coerce (gethash "pullRequests" json) 'list) :key (lambda (p) (gethash "number" p))))
           (sha "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
      (setf (gethash "sha" (gethash "head" row)) sha)
      (let ((history (gethash "commits" row)))
        (setf (gethash "sha" (aref history (1- (length history)))) sha
              (gethash "html_url" (aref history (1- (length history)))) (r::%web (concatenate 'string "commit/" sha))))
      (let* ((new (import-json json))
             (updated (r:make-reading new :claims (r:reading-claims reading) :marks (r:reading-marks reading)))
             (note (r:make-human-review-note :pr 6 :head (r:commit-sha (r:pr-head (r:find-pr snapshot 6)))
                                             :author "Fixture reviewer" :text "Review question; not acceptance")))
        (check (equal '(6) (r:changed-revisions snapshot new)) "explicit observation comparison finds changed head")
        (check (eq :stale-revision (r:note-status new note)) "human note is not silently retargeted")
        (check (= 2 (length (claim-edges updated))) "stale source-port and investigation claims disappear from factual graph")
        (check (= 2 (count :stale-revision (r:reading-claims reading) :key (lambda (c) (r:claim-status new c))))
               "outdated relationship warrants remain inspectable as stale")))
    (let* ((json (fixture-json)) (row (aref (gethash "pullRequests" json) 0)))
      (setf (gethash "sha" (gethash "base" row)) "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
      (check (equal (list (gethash "number" row)) (r:changed-revisions snapshot (import-json json)))
             "changed base revision is visible even when head is unchanged"))
    (let* ((json (fixture-json)) (row (aref (gethash "pullRequests" json) 0)))
      (setf (gethash "body" row) (concatenate 'string (gethash "body" row) " Edited report body."))
      (let* ((new (import-json json))
             (r (r:make-reading new :claims (r:reading-claims reading) :marks (r:reading-marks reading))))
        (check (= 2 (length (claim-edges r))) "body edits without a new head invalidate two source warrants")
        (check (= 2 (count :unsupported-warrant (r:reading-claims reading)
                           :key (lambda (c) (r:claim-status new c))))
               "a still-present quote cannot hide changed source-body digest")))
    (let ((when (r::%utc (r:snapshot-observed-at snapshot))))
      (check (eq :within-age-window-unchecked (r:snapshot-age-status snapshot :now when)) "recent age is not current remote proof")
      (check (eq :stale-by-age (r:snapshot-age-status snapshot :now (+ when 172800))) "old snapshot visibly stale")
      (check (eq :future-observation (r:snapshot-age-status snapshot :now (1- when))) "clock anomaly is not current proof"))
    (format t "~&PR-REVIEW revision qualification and stale observations PASS~%")

    (let ((claim (first (r:reading-claims reading))))
      (dolist (bad (list (alter-claim claim :type :merge-dependency)
                        (alter-claim claim :quote "Unsupported invented source statement")
                        (alter-claim claim :level :design-inference)
                        (alter-claim claim :level :working-hypothesis)))
        (check (not (eq :supported (r:claim-status snapshot bad))) "unsupported/conjectural claim stays unasserted")
        (check (null (claim-edges (r:make-reading snapshot :claims (list bad)))) "unsupported claim cannot become a factual edge")))
    (let* ((note (r:make-human-review-note :pr 1 :head (r:commit-sha (r:pr-head (r:find-pr snapshot 1)))
                                         :author "Human reviewer" :recorded-at (r:snapshot-observed-at snapshot) :text "A review note"))
           (with-note (r:make-reading snapshot :claims (r:reading-claims reading) :notes (list note))))
      (check (eq snapshot (r:reading-snapshot with-note)) "human notes do not rewrite source snapshot")
      (check (equal original-digest (r:snapshot-digest snapshot)) "source digest unaffected by notes")
      (check (eq :review-note-only (r:note-status snapshot note)) "note is not acceptance")
      (check (= 4 (length (claim-edges with-note))) "human note adds no sourced GitHub edge")
      (check (member note (refs (view with-note "Warrants and notes"))) "human note is separately inspectable"))
    (format t "~&PR-REVIEW epistemic warrants and separate human notes PASS~%")

    (let* ((table (view reading "Pull requests")) (table-refs (refs table))
           (projection (tm:topicmap-projection-of reading))
           (map-view (view reading "Topicmap")))
      (check (plusp (length (v:view-html map-view))) "native existing Topicmap Inspector renders")
      (check (= 4 (length (claim-edges reading))) "four required typed relationships projected")
      (dolist (edge (claim-edges reading))
        (let ((props (tm:topicmap-association-properties-of edge)))
          (check (eq :mechanically-derived (getf props :epistemic-status)) "curated source relation identifies its derived warrant")
          (check (not (getf props :git-merge-dependency)) "no source edge is a Git merge dependency")
          (check (stringp (getf props :warrant)) "edge retains exact quoted warrant")))
      (dolist (item (r:reading-items reading))
        (let* ((pr (r:review-pr item)) (item-refs (refs (view item "Review")))
               (metadata-refs (refs (view pr "Observed metadata")))
               (id (format nil "pr:RalfBarkow/hyperdoc:~D" (r:pr-number pr)))
               (topic (tm:topicmap-projection-topic-by-id projection id))
               (workspace (tm:make-topicmap-workspace projection "snapshot")))
          (check (member item table-refs) "overview navigates to actual first-class PR review")
          (check (member pr item-refs) "review navigates to exact observed PR object")
          (check (member (r:pr-source pr) metadata-refs) "PR navigates to exact source document")
          (check (every (lambda (c) (member c metadata-refs)) (r:pr-commits pr)) "all observed commit objects navigable")
          (check (every (lambda (m) (member m item-refs)) (r::review-marks item)) "evidence and question source objects navigable")
          (dolist (claim (r::review-claims item))
            (when (and (eq :supported (r:claim-status snapshot claim))
                       (not (eq :separate-investigation (r:claim-type claim))))
              (let ((other (if (= (r:pr-number pr) (r::claim-from claim))
                               (r::claim-to claim) (r::claim-from claim))))
                (check (member (r:find-pr snapshot other) item-refs)
                       "incoming and outgoing source relationships navigate to the other PR"))))
          (check (eq item (tm:topicmap-topic-object-of topic)) "projection preserves PR review handle identity")
          (tm:topicmap-workspace-go-to workspace id)
          (check (eq item (tm:topicmap-workspace-current-object workspace)) "existing Inspector workspace navigation preserves identity")
          (dolist (v (list table (view item "Review") (view pr "Observed metadata")))
            (check (notany (lambda (entry) (or (search "action-" (car entry)) (search "eval-" (car entry))))
                           (v:view-references v)) "Reading adds inspect references, no execution actions"))))
      (let* ((item (find 6 (r:reading-items reading) :key (lambda (i) (r:pr-number (r:review-pr i)))))
             (issue (find 7 (r:snapshot-issues snapshot) :key #'r::issue-number)))
        (check (member issue (refs (view item "Review"))) "PR6 navigates to native Issue7 observation")
        (check (member (r::issue-source issue) (refs (view issue "Issue"))) "Issue navigates to observed source body")))
    (format t "~&PR-REVIEW Inspector object navigation and native Topicmap PASS~%")

    (let* ((json (fixture-json)) (row (aref (gethash "pullRequests" json) 0)))
      (setf (gethash "title" row) "<script>danger()</script>" (gethash "body" row) "<img src=x onerror=danger()>")
      (let* ((r (r:make-reading (import-json json))) (item (first (last (r:reading-items r)))))
        (check (not (search "<script>danger" (v:view-html (view r "Pull requests")))) "PR title HTML is inert")
        (check (search "&lt;img" (v:view-html (view (r:pr-source (r:review-pr item)) "Observed source")))
               "source body is escaped, not evaluated/rendered as markup")))
    (check (null (hyperbook:find-hyperbook "dreyeck/pull-request-review/reading")) "ASDF load does not admit book into Catalog")
    (let* ((r::*local-reading* reading) (book (r:make-reading-book))
           (page (hyperbook:find-page book "Pull Request Review" :signal-error? t))
           (content (view page "Content")))
      (check (member reading (refs content)) "authored HyperDoc Reading links the prepared in-memory object")
      (check (null (hyperbook:find-hyperbook "dreyeck/pull-request-review/reading")) "book construction does not change Catalog membership")
      (check (not (search "eval-" (v:view-html content))) "page offers navigation without Evaluate widgets"))
    (check (null (find-package :topic-maps/tmdm)) "Reading adds no ISO Topic Maps model dependency")
    (format t "~&PR-REVIEW inert source and separate Catalog admission PASS~%")
    (format t "~&PR-REVIEW-PASS ~D checks~%" *checks*)
    t))
