+(defun empty-or-missing-html-id-p (html-id)
+  (or (null html-id)
+      (and (stringp html-id)
+           (let ((trimmed (string-trim '(#\Space #\Tab #\Newline #\Return)
+                                       html-id)))
+             (or (string= trimmed "")
+                 (string-equal trimmed "undefined")
+                 (string-equal trimmed "null"))))))
+
+(defun normalize-html-id-for-attach (html-id)
+  (if (empty-or-missing-html-id-p html-id)
+      "undefined"
+      html-id))
+
