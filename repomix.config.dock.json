{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 2000000
  },
  "output": {
    "filePath": "repomix-output-hyperdoc.dock.md",
    "style": "markdown",
    "parsableStyle": false,
    "compress": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "topFilesLength": 20,
    "includeFullDirectoryStructure": false,
    "splitOutput": 500000,
    "tokenBudget": 250000,
    "git": {
      "sortByChanges": false,
      "sortByChangesMaxCommits": 200,
      "includeDiffs": false,
      "includeLogs": false,
      "includeLogsCount": 50
    }
  },
  "include": [
    "AGENTS.md",
    "README.md",
    "package.json",
    "hyperdoc/dock.lisp",
    "hyperdoc-explorer/dock.lisp",
    "hyperdoc/dom-annotations.lisp",
    "hyperdoc-explorer/dom-annotations.lisp",
    "assets/hyperdoc/js/dom-annotation-connect.js",
    "assets/hyperdoc/css/dom-annotation-connect.css",
    "hyperdoc/Dock capabilities in HyperDoc.html",
    "hyperdoc/Dock presentation state model.html",
    "hyperdoc/Dock:coachmark:inspector-tabs UX model.md",
    "hyperdoc/A DOM-annotation connect gesture.md",
    "tests/dock-presentation-smoke.lisp",
    "tests/dock-annotation-smoke.lisp",
    "tests/playwright/dock-presentation.spec.js",
    "tests/playwright/dock-capability-modifier-inspection.spec.js",
    "tests/playwright/hyperdoc-inspector.js",
    "tests/playwright/pane-chrome-harness.js"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".direnv/**",
      ".cache/**",
      ".flake-deps/**",
      ".release-verifications/**",
      "node_modules/**",
      "test-results/**",
      "target/**",
      "result",
      "var/**",
      "repomix-output*.xml",
      "repomix-output*.md",
      ".DS_Store",
      "**/quicklisp.lisp",
      "**/*.fasl",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.ico",
      "deps/**/assets/**",
      "assets/dm6-elm/app.js"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
