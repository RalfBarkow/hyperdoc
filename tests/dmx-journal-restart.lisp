;;;; Disposable file-backed regression fixture. Each invocation is a fresh process.
(require :asdf)
(asdf:load-system "hyperdoc/mcp")
(in-package :hyperdoc)
(defparameter *restart-args* (uiop:command-line-arguments))
(defparameter *restart-mode* (first *restart-args*))
(defparameter *restart-key* "urn:issue7:disposable:subject")
(defparameter *restart-workspace* 700007)
(setf *hyperdoc-local-workspace-journal-directory*
      (uiop:ensure-directory-pathname (second *restart-args*)))
(assert (uiop:directory-exists-p *hyperdoc-local-workspace-journal-directory*))
(assert *hyperdoc-local-workspace-journal-write-files-p*)
(assert (zerop (hash-table-count *hyperdoc-local-workspace-journal-streams*)))
(defun restart-snapshot (key text)
  (dmx-workspace-journal-snapshot-from-payload
   key "uri" key *restart-workspace*
   (dmx-workspace-journal-json-object "text" text)
   :subject-uri key :subject-kind "workspace-note"
   :ownership-class "hyperdoc-workspace-note"
   :note-key "issue7-disposable" :note-kind "workspace-note" :topic-id 700008))
(defun restart-write (key before after)
  (multiple-value-bind (events diagnostic)
      (record-workspace-transition
       :hyperdoc-local
       (if before (restart-snapshot key before)
           (dmx-workspace-journal-absent-snapshot
            key "uri" key *restart-workspace* :subject-kind "workspace-note"))
       (restart-snapshot key after) *restart-workspace*)
    (assert (eq :recorded (getf diagnostic :journal-status)))
    (length events)))
(defun restart-seed (key)
  (assert (= 1 (restart-write key nil "A")))
  (assert (= 1 (restart-write key "A" "B"))))
(defun restart-check (key revision text)
  (let* ((journal (read-hyperdoc-topic-journal :subject-key key))
         (revisions (list-hyperdoc-topic-revisions :subject-key key))
         (events (gethash "events" journal)))
    (assert (= revision (gethash "currentRevision" journal)))
    (assert (= revision (length events)))
    (assert (= revision (length (gethash "revisions" revisions))))
    (assert (equal text (gethash "text" (gethash "payload" (gethash "currentState" journal)))))
    (loop for event across events for expected from 1
          do (assert (= expected (gethash "revision" event))))
    (let ((stream (ensure-hyperdoc-local-workspace-journal-stream key)))
      (assert (equal "A" (gethash "text" (gethash "payload"
                        (dmx-workspace-journal-current-snapshot stream :revision 1)))))
      (assert (equal "B" (gethash "text" (gethash "payload"
                        (dmx-workspace-journal-current-snapshot stream :revision 2))))))))
(defun restart-expect-file-error (thunk)
  (handler-case
      (progn (funcall thunk) (error "Expected explicit journal file error"))
    (hyperdoc-local-workspace-journal-file-error (condition)
      (assert (search "Cannot restore HyperDoc-local journal file" (format nil "~A" condition)))
      (format t "~&JOURNAL-EXPECTED-ERROR ~A~%" condition))))
(cond
 ((equal *restart-mode* "seed") (restart-seed *restart-key*))
 ((equal *restart-mode* "seed-two")
  (restart-seed *restart-key*) (restart-seed "urn:issue7:disposable:second"))
 ((equal *restart-mode* "read")
  ;; Workspace discovery must restore streams before any per-subject read.
  (let ((workspace (read-hyperdoc-workspace-journal :workspace-topicmap-id *restart-workspace*)))
    (assert (= 1 (gethash "streamCount" workspace)))
    (assert (= (parse-integer (third *restart-args*)) (gethash "eventCount" workspace))))
  (restart-check *restart-key* (parse-integer (third *restart-args*)) (fourth *restart-args*)))
 ((equal *restart-mode* "subject-read")
  ;; No eager startup/discovery call: exercise direct subject and revision reads.
  (let ((revisions (list-hyperdoc-topic-revisions :subject-key *restart-key*)))
    (assert (= 2 (gethash "currentRevision" revisions))))
  (restart-check *restart-key* 2 "B"))
 ((equal *restart-mode* "update")
  ;; Deliberately write before any read or startup restoration.
  (assert (= 1 (restart-write *restart-key* "B" "C")))
  (restart-check *restart-key* 3 "C"))
 ((equal *restart-mode* "noop")
  (assert (zerop (restart-write *restart-key* "B" "B")))
  (restart-check *restart-key* 2 "B"))
 ((equal *restart-mode* "multi-read")
  (dotimes (_ 2)
    (let ((workspace (read-hyperdoc-workspace-journal :workspace-topicmap-id *restart-workspace*)))
      (assert (= 2 (gethash "streamCount" workspace)))
      (assert (= 4 (gethash "eventCount" workspace)))))
  (restart-check *restart-key* 2 "B")
  (restart-check "urn:issue7:disposable:second" 2 "B"))
 ((equal *restart-mode* "error-read")
  (restart-expect-file-error (lambda () (read-hyperdoc-topic-journal :subject-key *restart-key*)))
  (restart-expect-file-error (lambda () (list-hyperdoc-topic-revisions :subject-key *restart-key*)))
  (restart-expect-file-error (lambda () (read-hyperdoc-workspace-journal :workspace-topicmap-id *restart-workspace*))))
 ((equal *restart-mode* "error-write")
  (restart-expect-file-error (lambda () (restart-write *restart-key* "B" "C")))
  (restart-expect-file-error (lambda () (restart-write *restart-key* "B" "B"))))
 ((equal *restart-mode* "error-startup")
  (restart-expect-file-error #'restore-hyperdoc-local-workspace-journal-streams)
  (assert (zerop (hash-table-count *hyperdoc-local-workspace-journal-streams*))))
 (t (error "Unknown regression mode ~S" *restart-mode*)))
(format t "~&JOURNAL-RESTART-PASS ~A~%" *restart-mode*)
