(in-package :hyperbook/fedwiki/tests)

(defun sitemap-fixture ()
  (with-open-file (in (asdf:system-relative-pathname :hyperbook
                       "tests/fixtures/mech-sitemaps.json"))
    (shasht:read-json in)))

(defun sitemap-page (&optional (mode :ready))
  "Trusted fixture using the real sitemap loader; never contact a Wiki."
  (let* ((fixture (sitemap-fixture))
         (fw::*neighborhood* (make-hash-table :test #'equal)))
    (loop for record across (gethash "sites" fixture)
          for domain = (gethash "domain" record)
          for wiki = (make-instance 'fw::fedwiki :id (concatenate 'string "fedwiki:" domain))
          do (setf (gethash domain fw::*neighborhood*) wiki)
             (fw::fetch-sitemap wiki :json-fetcher
               (lambda (url)
                 (assert (equal url (concatenate 'string "https://" domain "/system/sitemap.json")))
                 (if (eq mode :empty) #() (gethash "sitemap" record)))))
    (let* ((origin (gethash "source.fixture.test" fw::*neighborhood*))
           (context (gethash "context.fixture.test" fw::*neighborhood*))
           (page (fw::make-fedwiki-page origin "mech-sitemap-fixture" "Mech sitemap fixture")))
      (fw::set-page-data page (gethash "page" fixture))
      (case mode
        (:missing (setf (slot-value context 'fw::sitemap-state) :missing))
        (:loading (setf (slot-value context 'fw::sitemap-state) :loading))
        (:failed (setf (slot-value context 'fw::sitemap-state)
                       (make-condition 'simple-error :format-control "Fixture fetch failure"))))
      page)))

(defun check-sitemap-contract ()
  (check-sitemap-worker-snapshot)
  (check-page-selection-contract)
  (let* ((fixture (sitemap-fixture))
         (record (aref (gethash "sites" fixture) 0))
         (raw (gethash "sitemap" record))
         (before (shasht:write-json raw nil))
         (wiki (make-instance 'fw::fedwiki :id "fedwiki:source.fixture.test"))
         (fw::*neighborhood* (make-hash-table :test #'equal)))
    (let ((missing (fw::sitemap-snapshot wiki)))
      (assert (equal "missing" (gethash "state" missing)))
      (with-input-from-string (in (shasht:write-json missing nil))
        (let ((wire (shasht:read-json in)))
          (assert (eq :null (gethash "sourceUrl" wire)))
          (assert (eq :null (gethash "sitemap" wire))))))
    (fw::fetch-sitemap wiki :json-fetcher
      (lambda (url)
        (assert (equal "https://source.fixture.test/system/sitemap.json" url))
        (assert (equal "loading" (gethash "state" (fw::sitemap-snapshot wiki))))
        raw))
    ;; Retaining/projecting one site's data does not register a neighborhood.
    (assert (zerop (hash-table-count fw::*neighborhood*)))
    (let ((snapshot (fw::sitemap-snapshot wiki)))
      (assert (equal "ready" (gethash "state" snapshot)))
      (assert (equal before (shasht:write-json (gethash "sitemap" snapshot) nil)))
      (assert (not (eq raw (gethash "sitemap" snapshot))))
      (setf (gethash "title" (aref (gethash "sitemap" snapshot) 0)) "Mutated copy")
      (assert (equal before (shasht:write-json (fw::sitemap-of wiki) nil))))
    (assert (equal before (shasht:write-json raw nil)))
    ;; Failures remain failures; retained older data is not advertised as ready.
    (let ((failure (make-condition 'simple-error :format-control "Fixture fetch failure")))
      (handler-case
          (fw::fetch-sitemap wiki :json-fetcher (lambda (url) (declare (ignore url)) (error failure)))
        (simple-error (caught) (assert (eq caught failure))))
      (let ((snapshot (fw::sitemap-snapshot wiki)))
        (assert (equal "failed" (gethash "state" snapshot)))
        (assert (eq :null (gethash "sitemap" snapshot)))))
    (fw::fetch-sitemap wiki :json-fetcher (constantly #()))
    (assert (equal "ready" (gethash "state" (fw::sitemap-snapshot wiki))))
    (assert (equalp #() (gethash "sitemap" (fw::sitemap-snapshot wiki))))
    (handler-case (fw::fetch-sitemap wiki :json-fetcher (constantly nil))
      (type-error () nil))
    (assert (equal "failed" (gethash "state" (fw::sitemap-snapshot wiki)))))
  (let* ((page (sitemap-page))
         (origin (fw::origin-of page))
         (context (first (fw::context-of page)))
         (fw::*neighborhood* (make-hash-table :test #'equal))
         (unrelated (make-instance 'fw::fedwiki :id "fedwiki:unrelated.fixture.test")))
    (setf (gethash "unrelated.fixture.test" fw::*neighborhood*) unrelated
          (gethash "source.fixture.test" fw::*neighborhood*) origin)
    (setf (slot-value page 'fw::context) (list context origin context))
    (let* ((snapshot (fw::mech-neighborhood-snapshot page))
           (sites (gethash "sites" snapshot)))
      (assert (= 2 (length sites)))
      (assert (equal "source.fixture.test" (gethash "domain" (aref sites 0))))
      (assert (equal "context.fixture.test" (gethash "domain" (aref sites 1))))
      (assert (equal "mech-sitemap-fixture" (gethash "slug" (gethash "page" snapshot)))))
    (let* ((reader (make-instance 'fw::fedwiki :id "fedwiki:reader.fixture.test"))
           (remote (fw::make-remote reader page))
           (sites (gethash "sites" (fw::mech-neighborhood-snapshot remote))))
      (assert (= 2 (length sites)))
      (assert (equal "source.fixture.test" (gethash "domain" (aref sites 0)))))
    (let* ((fw::*mech-plugin-host-url* "https://host.fixture.test/")
           (html (v:view-html (story-view page))))
      (assert (search "data-neighborhood-json-base64" html))
      (assert (search "No Code item has run" html)))
    (dolist (mode '(:missing :loading :failed))
      (let* ((snapshot (fw::mech-neighborhood-snapshot (sitemap-page mode)))
             (site (aref (gethash "sites" snapshot) 1)))
        (assert (equal (string-downcase (symbol-name mode)) (gethash "state" site)))
        (assert (eq :null (gethash "sitemap" site))))))
  (format t "~&FEDWIKI-MECH-SITEMAPS-PASS: raw fields, provenance, order, scope, loading/failure/empty, actual Story boundary.~%"))

(defun check-page-selection-contract ()
  "The explicit page selection must not become a native browser-session claim."
  (let* ((fixture (sitemap-fixture))
         (example (gethash "selectionReference" fixture))
         (fw::*neighborhood* (make-hash-table :test #'equal))
         (origin-name (gethash "origin" example))
         (domains (concatenate 'list (gethash "nativePageRegistrations" example)
                              (list (gethash "priorSessionSite" example)
                                    (gethash "referenceOnlySite" example)
                                    (gethash "attributionOnlySite" example)))))
    ;; Even fully loaded session/reference sites must not enter this selection.
    (dolist (domain domains)
      (let ((wiki (make-instance 'fw::fedwiki :id (concatenate 'string "fedwiki:" domain))))
        (setf (gethash domain fw::*neighborhood*) wiki)
        (fw::fetch-sitemap wiki :json-fetcher
          (constantly (gethash "sitemap" (aref (gethash "sites" fixture) 0))))))
    (let* ((origin (gethash origin-name fw::*neighborhood*))
           (page (fw::make-fedwiki-page origin "selection-fixture" "Selection fixture"))
           (json (alexandria:plist-hash-table
                  (list "title" "Selection fixture"
                        "journal" (gethash "journal" example)
                        "story" #()) :test 'equal)))
      (fw::set-page-data page json)
      (let* ((snapshot (fw::mech-neighborhood-snapshot page))
             (domains (map 'vector (lambda (s) (gethash "domain" s))
                           (gethash "sites" snapshot))))
        (assert (equal "page-origin-and-context" (gethash "scope" snapshot)))
        (assert (equalp (gethash "hyperdocPageSelection" example) domains))
        (assert (not (equalp (gethash "nativePageRegistrations" example) domains)))
        (assert (find (gethash "attributionOnlySite" example) domains :test #'equal))
        (assert (not (find (gethash "attributionOnlySite" example)
                           (gethash "nativePageRegistrations" example) :test #'equal)))
        (assert (not (find (gethash "priorSessionSite" example) domains :test #'equal)))
        (assert (not (find (gethash "referenceOnlySite" example) domains :test #'equal))))))
  (format t "~&PAGE-SELECTION-CONTRACT-PASS: raw retention is independent; loaded global/session sites excluded; explicit HyperDoc order and attribution membership differ from source-qualified Wiki-client registrations.~%"))

(defun check-sitemap-worker-snapshot ()
  ;; A snapshot must not join/wait for the loader or fabricate empty data.
  (let ((lock (bt:make-lock "Sitemap fixture gate"))
        (gate (bt:make-condition-variable)) (entered nil) (release nil))
    (let* ((wiki (fw::make-fedwiki "worker.fixture.test"
                  :protocol-probe (constantly "https")
                  :sitemap-fetcher
                  (lambda (wiki)
                    (fw::fetch-sitemap wiki :json-fetcher
                      (lambda (url)
                        (declare (ignore url))
                        (bt:with-lock-held (lock)
                          (setf entered t)
                          (bt:condition-notify gate)
                          (loop until release do
                            (unless (bt:condition-wait gate lock :timeout 10)
                              (error "Fixture gate timed out"))))
                        #())))
                  :plugin-data-fetcher (constantly nil)))
           (worker (fw::status-of wiki)))
      (unwind-protect
           (progn
             (bt:with-lock-held (lock)
               (loop until entered do
                 (unless (bt:condition-wait gate lock :timeout 10)
                   (error "Fixture worker did not enter the fetcher"))))
             (let ((snapshot (fw::sitemap-snapshot wiki)))
               (assert (equal "loading" (gethash "state" snapshot)))
               (assert (eq :null (gethash "sitemap" snapshot)))))
        (bt:with-lock-held (lock)
          (setf release t)
          (bt:condition-notify gate))
        (bt:join-thread worker))
      (assert (equal "ready" (gethash "state" (fw::sitemap-snapshot wiki)))))))

(defun serve-sitemap-browser-witness (port host-url stop-file)
  "Fresh fixture-only Inspector routes; no production network or page edits."
  (setf fw::*mech-plugin-host-url* host-url)
  (clog:initialize (lambda (body) (declare (ignore body))) :port port :host "127.0.0.1")
  (dolist (mode '(:ready :empty :missing :loading :failed))
    (let ((page (sitemap-page mode)))
      (clog:set-on-new-window
       (lambda (body)
         (setf (clog:text (clog:create-style-block body)) clog-moldable-inspector::*css*)
         (let ((inspector (clog-moldable-inspector::create-inspector body :pane-width "700px" :playground? nil)))
           (clog-moldable-inspector::create-pane inspector page :select "Story")))
       :path (concatenate 'string "/" (string-downcase (symbol-name mode))))))
  (format t "~&MECH-SITEMAP-BROWSER-READY ~D~%" port)
  (finish-output)
  (unwind-protect
       (loop repeat 2400 until (probe-file stop-file) do (sleep 0.1))
    (clog:shutdown)))
