;;;; Compare two experiment records: the same observations with the same outcomes, digests and statuses. Times, versions and the failure
;;;; wording may differ. Prints RECORDS-EQUIVALENT or RECORDS-DIFFER and exits non-zero in that case.
;;;;   COMPARE_A=committed COMPARE_B=new sbcl --non-interactive --load compare-records.lisp
(require :asdf)
(asdf:initialize-source-registry
 `(:source-registry ,@(loop for p in (uiop:split-string (or (uiop:getenv "CL_SOURCE_REGISTRY") "") :separator ":")
                            unless (zerop (length p)) collect `(:tree ,(uiop:ensure-directory-pathname (string-right-trim "/" p))))
   :ignore-inherited-configuration))
(let ((*error-output* (make-broadcast-stream)) (*standard-output* (make-broadcast-stream)))
  (asdf:load-system "dreyeck/fedwiki-without-dns"))
(defun summary (record)
  (list (dreyeck/fedwiki-without-dns:record-site record) (dreyeck/fedwiki-without-dns:record-slug record)
        (dreyeck/fedwiki-without-dns:record-fixture-sha256 record)
        (loop for o in (dreyeck/fedwiki-without-dns:record-observations record)
              collect (list (dreyeck/fedwiki-without-dns:observation-id o) (dreyeck/fedwiki-without-dns:observation-role o)
                            (dreyeck/fedwiki-without-dns:observation-access o) (dreyeck/fedwiki-without-dns:observation-endpoint o)
                            (dreyeck/fedwiki-without-dns:observation-endpoint-origin o)
                            (getf (dreyeck/fedwiki-without-dns:observation-dns o) :outcome)
                            (getf (dreyeck/fedwiki-without-dns:observation-dns o) :addresses)
                            (getf (dreyeck/fedwiki-without-dns:observation-connection o) :outcome)
                            (getf (dreyeck/fedwiki-without-dns:observation-connection o) :stage)
                            (getf (dreyeck/fedwiki-without-dns:observation-http o) :status)
                            (dreyeck/fedwiki-without-dns:observation-json-sha256 o)
                            (getf (dreyeck/fedwiki-without-dns:observation-content o) :relation)
                            (dreyeck/fedwiki-without-dns:observation-verdict o)))))
(let ((committed (or (uiop:getenv "COMPARE_A") (error "COMPARE_A"))) (new (or (uiop:getenv "COMPARE_B") (error "COMPARE_B"))))
  (let ((a (summary (dreyeck/fedwiki-without-dns:read-record committed))) (b (summary (dreyeck/fedwiki-without-dns:read-record new))))
    (cond ((equal a b) (format t "~&RECORDS-EQUIVALENT: ~D observations with the same outcomes, statuses and digests.~%" (length (fourth a))))
          (t (format t "~&RECORDS-DIFFER~%committed: ~S~%new:       ~S~%" a b) (uiop:quit 1)))))
