{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 2000000
  },
  "output": {
    "filePath": "repomix-output-hyperdoc.deployment.md",
    "style": "markdown",
    "parsableStyle": false,
    "compress": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "topFilesLength": 20,
    "includeFullDirectoryStructure": false,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 200,
      "includeDiffs": false,
      "includeLogs": false,
      "includeLogsCount": 50
    }
  },
  "include": [
    "AGENTS.md",
    "README.md",
    "flake.nix",
    "flake.lock",
    ".envrc",
    "dev.sh",
    "start.sh",
    "dreyeck/**/*.lisp",
    "dreyeck.asd",
    "nix/**",
    "tools/check-release-doc-runtime.lisp",
    "tools/install-dreyeck-hyperdoc-mcp-sidecar.sh",
    "hyperdoc/*dreyeck*.html",
    "hyperdoc/*Dreyeck*.html",
    "hyperdoc/*Nix*.html",
    "hyperdoc/*deployment*.html",
    "hyperdoc/*Deployment*.html",
    "hyperdoc/Deploy dreyeck.ch from the local flake.html",
    "hyperdoc/Deploy or restart dreyeck and confirm live parity.html",
    "hyperdoc/Detect legacy workspace-checkout hyperdoc.service on dreyeck.ch.html",
    "hyperdoc/Verify HyperDoc locally before deployment.html",
    "hyperdoc/Verify HyperDoc on dreyeck.ch.html",
    "hyperdoc/Live parity evidence.html",
    "hyperdoc/Restart dreyeck release service.html",
    "hyperdoc/Roll back HyperDoc on dreyeck.ch.html"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".direnv/**",
      ".cache/**",
      ".flake-deps/**",
      ".release-verifications/**",
      "node_modules/**",
      "test-results/**",
      "target/**",
      "result",
      "var/**",
      "repomix-output*.xml",
      "repomix-output*.md",
      ".DS_Store",
      "**/quicklisp.lisp",
      "**/*.fasl",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.ico",
      "deps/**/assets/**",
      "assets/dm6-elm/app.js"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
